const MODE={sea:{n:'دریایی',c:'#5E9FE8'},short:{n:'کوتاه‌برد',c:'#4FB9C9'},road:{n:'جاده‌ای',c:'#E0A84E'},rail:{n:'ریلی',c:'#A98BE0'},air:{n:'هوایی',c:'#E07FA2'}};
const ISO={IR:['Iran','ایران'],AE:['UAE','امارات'],OM:['Oman','عمان'],QA:['Qatar','قطر'],CN:['China','چین'],KR:['South Korea','کره جنوبی'],SG:['Singapore','سنگاپور'],MY:['Malaysia','مالزی'],LK:['Sri Lanka','سریلانکا'],IN:['India','هند'],PK:['Pakistan','پاکستان'],DE:['Germany','آلمان'],NL:['Netherlands','هلند'],BE:['Belgium','بلژیک'],IT:['Italy','ایتالیا'],GR:['Greece','یونان'],AT:['Austria','اتریش'],HU:['Hungary','مجارستان'],RS:['Serbia','صربستان'],BG:['Bulgaria','بلغارستان'],TR:['Turkey','ترکیه'],RU:['Russia','روسیه'],KZ:['Kazakhstan','قزاقستان'],TM:['Turkmenistan','ترکمنستان'],AZ:['Azerbaijan','جمهوری آذربایجان'],GE:['Georgia','گرجستان'],AM:['Armenia','ارمنستان'],UZ:['Uzbekistan','ازبکستان'],AF:['Afghanistan','افغانستان'],IQ:['Iraq','عراق']};
const cfa=c=>(ISO[c]||[c,c])[1];
const STRAT={};DS.strategic.forEach(s=>{STRAT[s.en.toLowerCase()]=s});
const strat=c=>{const e=(ISO[c]||[c])[0].toLowerCase();return STRAT[e]||STRAT[e.replace('south ','')]||null};
const cRisk=c=>{if(c==='IR')return .25;const s=strat(c);if(!s)return .4;return clamp(1-((s.sanc||5)+(s.stab||5)+(s.pay||5))/30,0,1)};

/* ---------- lake (all sheets, gzip) ---------- */
let LAKE=null,lakeP=null;
function lake(){if(LAKE)return Promise.resolve(LAKE);if(lakeP)return lakeP;
 lakeP=(async()=>{const bin=Uint8Array.from(atob(LAKE_B64),c=>c.charCodeAt(0));
  const st=new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'));const t=await new Response(st).text();LAKE=JSON.parse(t);return LAKE})();return lakeP}

/* ---------- engine context ---------- */
function ctx(){const E=window.__IFA_E;const A=window.__IFA_ARGS;if(!E||!E.G||!A)return null;
 const routes=E.routes||[];const R=routes[E.selected]||routes[0]||null;return {E,G:E.G,routes,R,cargo:A[0],prefs:A[1],rates:A[2]}}
let ARGS0=null;
function yr(legs,cargo,prefs,rates){const C=ctx();const keep=window.__IFA_ARGS;
 try{return window.__IFA_YR(legs,cargo||C.cargo,prefs||C.prefs,rates||C.rates,C.G.nodeById)}catch(e){return null}finally{window.__IFA_ARGS=keep}}
const nname=id=>{const C=ctx();const n=C&&C.G.nodeById[id];return n?n.nameFa:id};

/* ---------- corridor family (for seasonal / price / d2d / risk datasets) ---------- */
function family(r){const cs=new Set(r.countries||[]);const ms=new Set((r.legs||[]).map(l=>l.mode));const casp=(r.legs||[]).some(l=>l.edge&&l.edge.caspian);
 if(ms.has('air')&&r.legs.every(l=>l.mode==='air'))return {k:'air',n:'هوایی',seas:null,price:null,d2d:'Air Freight',risk:null};
 if(cs.has('TR'))return {k:'tr',n:'پل زمینی ترکیه',seas:'Turkey/Black Sea',price:'Turkey Land Bridge',d2d:null,risk:'Trans-Caspian/Middle Corridor (KZ-AZ-GE-TR)'};
 if(cs.has('PK')||cs.has('AF'))return {k:'pk',n:'پاکستان / افغانستان',seas:'Afghanistan/Pakistan',price:'CPEC Road (Karakoram-Pakistan)',d2d:null,risk:cs.has('AF')?'Afghanistan Transit (China-AF-Iran)':'Karakoram Highway (China-Pakistan)'};
 if(cs.has('RU'))return {k:'ru',n:'شمالی (روسیه)',seas:'Northern/Russia Transit',price:'Northern (Russia Transit)',d2d:'Northern/Russia',risk:'Northern Corridor (KZ-RU-Europe)'};
 if(casp||cs.has('AZ'))return {k:'casp',n:'ترانس‌خزر / TITR',seas:'Trans-Caspian/TITR',price:'Trans-Caspian/TITR (Alashankou-KZ-Caspian-Iran)',d2d:'Trans-Caspian/TITR',risk:'Trans-Caspian/Middle Corridor (KZ-AZ-GE-TR)'};
 if(cs.has('KZ')&&cs.has('UZ'))return {k:'south',n:'جنوبی (ازبکستان–ترکمنستان)',seas:'Turkmenistan Transit',price:ms.has('road')?'TIR Direct (Central Asia Road)':'Southern (KG-UZ-TM-Iran)',d2d:ms.has('road')?'Road/TIR':'KG/UZ Southern',risk:'Southern Road (KZ-UZ-TKM-Iran)'};
 if(cs.has('KZ')||cs.has('TM'))return {k:'central',n:'کریدور مرکزی (خورگوس)',seas:'Central/Khorgos',price:ms.has('road')?'TIR Direct (Central Asia Road)':'Central (Khorgos-KZ-TM-Iran)',d2d:ms.has('road')?'Road/TIR':'Central/Khorgos',risk:'Central Corridor (Rail via KZ-TKM)'};
 if(ms.has('sea')||ms.has('short'))return {k:'sea',n:'دریایی خلیج فارس',seas:'Persian Gulf Maritime',price:null,d2d:cs.has('CN')?'Sea-Rail/Bandar Abbas':null,risk:cs.has('CN')?'Maritime Route (China-Bandar Abbas)':null};
 return {k:'other',n:'سایر',seas:null,price:null,d2d:null,risk:null}}
function season(fam,month){if(!fam||!fam.seas)return null;const q='Q'+(Math.floor((month-1)/3)+1);
 const rows=DS.seasonal.filter(s=>s.cor===fam.seas);if(!rows.length)return null;
 const m=rows.filter(s=>s.q.startsWith(q)).sort((a,b)=>b.q.localeCompare(a.q))[0]||rows.find(s=>s.q.startsWith(Math.floor((month-1)/6)?'H2':'H1'))||rows[0];
 const u=m.util?mid(m.util)/100:.75;return {...m,u:clamp(u,.3,.98),s:m.sur||0}}
function famRisks(fam){if(!fam||!fam.risk)return [];return DS.risk.filter(x=>x.cor===fam.risk)}
const PR={'Very High':.9,'High':.7,'Medium-High':.6,'Medium':.5,'Low-Medium':.35,'Low':.2,'Very Low':.1};
const pnum=p=>{p=String(p);for(const k in PR)if(p.startsWith(k))return PR[k];return .4};
function famRiskIdx(fam){const R=famRisks(fam);if(!R.length)return .35;return clamp(avg(R.map(r=>pnum(r.p)*(r.imp||3)/5)),0,1)}

/* ---------- border crossing matching (border DB ↔ graph nodes) ---------- */
const XC=DS.crossings.filter(c=>c.lat!=null&&c.lon!=null);
const XCache={};
function crossFor(node){if(!node)return null;if(node.id in XCache)return XCache[node.id];let best=null,bd=1e9;
 const nm=(node.nameEn||'').toLowerCase().split(/[\s/(-]/)[0];
 for(const c of XC){const d=Math.hypot(c.lat-node.lat,(c.lon-node.lng)*Math.cos(node.lat*Math.PI/180));let s=d;
  if(nm&&nm.length>3&&String(c.n).toLowerCase().includes(nm))s-=.8;if(s<bd){bd=s;best=c}}
 const r=bd<.55?best:null;XCache[node.id]=r;return r}
function openHours(s){s=String(s||'');if(!s||/n\/a/i.test(s))return null;if(/24/.test(s)&&/7|hour|ساعت/i.test(s)||/24\s*\/\s*7|24h/i.test(s))return 24;
 const m=s.match(/(\d{1,2})[:.]?(\d{2})?\s*[-–]\s*(\d{1,2})[:.]?(\d{2})?/);if(m){let a=+m[1]+(+m[2]||0)/60,b=+m[3]+(+m[4]||0)/60;if(b<=a)b+=12;return clamp(b-a,4,24)}return null}
const iranXC=DS.irx;

/* ---------- forwarders by border / route ---------- */
function fwdFor(words){words=words.filter(Boolean).map(w=>w.toLowerCase());return DS.fwd.filter(f=>{const s=(f.borders+' '+f.routes+' '+f.svc).toLowerCase();return words.some(w=>s.includes(w))})}

