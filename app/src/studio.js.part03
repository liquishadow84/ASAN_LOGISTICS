let wrap=null,view='opt',body=null,cleanup=[];
const onClose=f=>cleanup.push(f);
function flush(){cleanup.forEach(f=>{try{f()}catch(e){}});cleanup=[]}
function open(v){if(v)view=v;if(!ctx())return;if(!wrap){wrap=document.createElement('div');wrap.className='sx-wrap';
  wrap.innerHTML=`<div class="sx-sheet" role="dialog" aria-label="استودیوی تحلیل"><header class="sx-head"><div class="sx-title"><span class="sx-logo">${svgI(IC.bolt)}</span><div><h2>استودیوی تحلیل زنجیره</h2><small class="sx-ctx"></small></div></div><nav class="sx-tabs">${TABS.map((t,i)=>`<button data-v="${t.k}">${svgI(IC[t.ic])}<span>${t.n}</span>${i<9?`<kbd>${fa(i+1)}</kbd>`:''}</button>`).join('')}<i class="sx-ink"></i></nav><span class="sx-sp"></span><button class="sx-btn sm sx-hsave" title="ذخیرهٔ وضعیت فعلی به‌عنوان سناریو">${svgI(IC.save)}ذخیرهٔ سناریو</button><button class="sx-btn sm sx-hpdf" title="گزارش PDF کامل">${svgI(IC.pdf)}گزارش PDF</button><button class="sx-x" aria-label="بستن">${svgI(IC.x)}<kbd>Esc</kbd></button></header><main class="sx-body"></main></div>`;
  document.body.appendChild(wrap);body=$('.sx-body',wrap);
  wrap.addEventListener('mousedown',e=>{if(e.target===wrap)close()});$('.sx-x',wrap).onclick=close;$('.sx-hsave',wrap).onclick=()=>saveScenario();$('.sx-hpdf',wrap).onclick=()=>report();
  $$('.sx-tabs button',wrap).forEach(b=>b.onclick=()=>{view=b.dataset.v;render()});
  requestAnimationFrame(()=>wrap.classList.add('in'))}
 render()}
function close(){if(!wrap)return;flush();wrap.classList.remove('in');const w=wrap;wrap=null;setTimeout(()=>w.remove(),280)}
function render(){flush();const C=ctx();
 $$('.sx-tabs button',wrap).forEach(b=>b.classList.toggle('on',b.dataset.v===view));
 const on=$('.sx-tabs button.on',wrap),ink=$('.sx-ink',wrap);if(on){ink.style.width=on.offsetWidth+'px';ink.style.left=on.offsetLeft+'px'}
 $('.sx-ctx',wrap).textContent=C&&C.R?`${C.R.name||''} · ${nname(C.R.nodeSeq[0])} ← ${nname(C.R.nodeSeq[C.R.nodeSeq.length-1])} · ${usd(C.R.total)} · ${nf(C.R.avgDays,1)} روز`:'';
 body.className='sx-body v-'+view;body.innerHTML='';body.scrollTop=0;
 const t0=performance.now();try{({opt:rOpt,cost:rCost,load:rLoad,intel:rIntel,scen:rScen,track:rTrack,fc:rFc,sanc:rSanc,api:rApi,exec:rExec,res:rRes,rfq:rRfq,plan:rPlan,fin:rFin,ops:rOps,risk:rRisk,crm:rCrm,sys:rSys,cty:rCty,om:rOm,cn:rCn,src:rSrc,dd:rDd,tar:rTar,doc:rDoc,pnl:rPnl,rate:rRate,dom:rDom,ins:rIns,srv:rSrv,arc:rArc,ntf:rNtf,einv:rEinv,wb:rWb,inbox:rInbox,sal:rSal,bkg:rBkg,cus:rCus,led:rLed,dg:rDg,flt:rFlt,clm:rClm,job:rJob,tpl:rTpl,pay:rPay,org:rOrg,rail:rRail,wh:rWh,eta:rEta,dmd:rDmd,ocr:rOcr,cnd:rCnd,irl:rIrl,mkt:rMkt})[view](body,C)}catch(e){console.error(e);ERRL.push({t:Date.now(),m:view+': '+String(e.message).slice(0,300),s:'render'});body.innerHTML='<div class="sx-empty">خطا در نمایش: '+esc(e.message)+'</div>'}PERF.push({v:view,ms:performance.now()-t0,t:Date.now()});if(PERF.length>400)PERF.shift();const on2=$('.sx-tabs button.on',wrap);if(on2&&on2.scrollIntoView)on2.scrollIntoView({block:'nearest',inline:'nearest'})}
const PERF=[];
/* tooltip */
const tip=document.createElement('div');tip.className='sx-tip';document.body.appendChild(tip);
function showTip(e,h){tip.innerHTML=h;tip.classList.add('on');const w=tip.offsetWidth,hh=tip.offsetHeight;let x=e.clientX+14,y=e.clientY+14;if(x+w>innerWidth-8)x=e.clientX-w-14;if(y+hh>innerHeight-8)y=e.clientY-hh-14;tip.style.transform=`translate(${x}px,${y}px)`}
function hideTip(){tip.classList.remove('on')}
/* count-up */
function countUp(root){$$('[data-cu]',root).forEach(el=>{const to=+el.dataset.cu,d=+(el.dataset.d||0),pre=el.dataset.pre||'',suf=el.dataset.suf||'';const t0=performance.now();
 const st=()=>{const t=clamp((performance.now()-t0)/700,0,1);el.textContent=pre+nf(to*ease(t),d)+suf;if(t<1)requestAnimationFrame(st)};st()})}
const kpi=(l,v,{d=0,pre='',suf='',sub='',cls=''}={})=>`<div class="sx-kpi ${cls}"><small>${l}</small><b data-cu="${v}" data-d="${d}" data-pre="${esc(pre)}" data-suf="${esc(suf)}">${pre}${nf(v,d)}${suf}</b>${sub?`<em>${sub}</em>`:''}</div>`;
function rng(n){let s=n>>>0||1;return ()=>{s^=s<<13;s^=s>>>17;s^=s<<5;return ((s>>>0)%1e6)/1e6}}
function gauss(r){let u=0,v=0;while(!u)u=r();while(!v)v=r();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v)}
function canvasFit(cv){const r=cv.getBoundingClientRect(),dpr=Math.min(2,devicePixelRatio||1);const w=Math.max(10,r.width),h=Math.max(10,r.height);if(cv.width!==Math.round(w*dpr)||cv.height!==Math.round(h*dpr)){cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr)}const g=cv.getContext('2d');g.setTransform(dpr,0,0,dpr,0,0);return {g,w,h}}
function dlFile(name,text,type='text/csv'){const b=new Blob(['\ufeff'+text],{type:type+';charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000)}
const toast=m=>{let t=$('.fx-toasts');if(!t){return}const d=document.createElement('div');d.className='fx-toast';d.textContent=m;t.appendChild(d);setTimeout(()=>d.remove(),2500)};

/* storage & dates */
const LSG=(k,d)=>{try{return JSON.parse(localStorage.getItem(k))??d}catch(e){return d}};const LSS=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(e){toast('حافظهٔ مرورگر پر است')}};
const DF=new Intl.DateTimeFormat('fa-IR',{year:'numeric',month:'short',day:'numeric'}),DFS=new Intl.DateTimeFormat('fa-IR',{month:'short',day:'numeric'}),DFT=new Intl.DateTimeFormat('fa-IR',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
const fdate=t=>t==null||isNaN(t)?'—':DF.format(new Date(t)),fdS=t=>t==null||isNaN(t)?'—':DFS.format(new Date(t)),fdT=t=>t==null||isNaN(t)?'—':DFT.format(new Date(t));
const DAY=864e5,HR=36e5;const iso=t=>new Date(t).toISOString().slice(0,10);
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const BUS={};const emit=(ev,data)=>{(BUS[ev]||[]).forEach(f=>{try{f(data)}catch(e){}});(BUS['*']||[]).forEach(f=>{try{f(ev,data)}catch(e){}});hook(ev,data)};
function hook(ev,data){const A=LSG('ifa-api',{});if(!A.url||!(A.events||[]).includes(ev))return;fetch(A.url,{method:'POST',headers:{'Content-Type':'application/json',...(A.token?{Authorization:'Bearer '+A.token}:{})},body:JSON.stringify({event:ev,at:new Date().toISOString(),data})}).catch(()=>{})}
IC.check='<path d="M5 12.5l4.5 4.5L19 7.5"/>';IC.copy='<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/>';
IC.exec='<rect x="3" y="3" width="8" height="10" rx="1.5"/><rect x="13" y="3" width="8" height="6" rx="1.5"/><rect x="13" y="11" width="8" height="10" rx="1.5"/><rect x="3" y="15" width="8" height="6" rx="1.5"/>';IC.res='<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M9 11l2 2-1.5 2.5M13 9l2 2.5-2 2"/>';IC.rfq='<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>';IC.cash='<rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/>';

/* ===== Route optimizer: multi-criteria label-setting Dijkstra + penalty diversification + data enrichment + Monte-Carlo + Pareto/TOPSIS ===== */
const OPT={o:null,d:null,w:{cost:40,time:30,risk:20,co2:10},modes:null,avoid:new Set(),month:new Date().getMonth()+1,maxB:6,k:10,res:null,sel:0,sig:''};
let EMC={key:'',m:null};
function edgeMetrics(C){const key=JSON.stringify([C.cargo,C.prefs&&C.prefs.modes]);if(EMC.key===key)return EMC.m;const m={};
 for(const e of C.G.edges){const x=yr([{edge:e,from:e.from,to:e.to}]);const l=x&&x.legs&&x.legs[0];
  m[e.id]={c:l?l.cost:e.distanceKm,h:l?l.runHours+l.waitHours+(l.dwellHours||0):e.distanceKm/25,k:l?l.co2:e.distanceKm*.02,
   r:.35*(1-(e.reliability??.8))+.25*(e.congestion??.5)+.12*((e.choke||[]).length)+(e.caspian?.08:0)}}
 const md=k=>qtl(Object.values(m).map(v=>v[k]),.5)||1;m.__n={c:md('c'),h:md('h'),k:md('k'),r:md('r')};EMC={key,m};return m}
class Heap{constructor(){this.a=[]}push(x){const a=this.a;a.push(x);let i=a.length-1;while(i){const p=(i-1)>>1;if(a[p][0]<=a[i][0])break;[a[p],a[i]]=[a[i],a[p]];i=p}}
 pop(){const a=this.a,t=a[0],l=a.pop();if(a.length){a[0]=l;let i=0;for(;;){let L=2*i+1,R=L+1,m=i;if(L<a.length&&a[L][0]<a[m][0])m=L;if(R<a.length&&a[R][0]<a[m][0])m=R;if(m===i)break;[a[m],a[i]]=[a[i],a[m]];i=m}}return t}get size(){return this.a.length}}
function dijkstra(C,M,o,d,w,pen,opts,trace){const G=C.G,N=M.__n,W=sum(Object.values(w))||1;const tr=C.rates.charges;
 const wc=w.cost/W/N.c,wh=w.time/W/N.h,wr=w.risk/W/N.r,wk=w.co2/W/N.k;
 const dist=new Map(),prev=new Map(),H=new Heap(),done=new Set();const s0=o+'|';dist.set(s0,0);H.push([0,s0,o,'']);
 while(H.size){const [dv,s,u,pm]=H.pop();if(done.has(s))continue;done.add(s);if(trace&&!trace.seen.has(u)){trace.seen.add(u);trace.order.push(u)}
  if(u===d){const path=[];let k=s;while(prev.has(k)){const p=prev.get(k);path.unshift(p.leg);k=p.s}return path}
  for(const e of G.adj[u]||[]){if(!opts.modes[e.mode])continue;if(opts.cE&&opts.cE.has(e.id))continue;const v=e.from===u?e.to:e.from;const nv=G.nodeById[v];if(!nv)continue;if(opts.cN&&opts.cN.has(v)&&v!==d&&v!==o)continue;
   if(v!==d&&v!==o&&(opts.avoid.has(nv.country)))continue;const mm=M[e.id];
   let c=wc*mm.c+wh*mm.h+wr*mm.r+wk*mm.k;
   if(pm&&pm!==e.mode)c+=wc*(tr.transferPerUnit||110)+wh*(tr.transferHours||18);
   if(nv.type==='border'){const x=crossFor(nv);const ch=(x&&x.clr)||nv.avgDwellHours||8;c+=wh*ch+wc*(nv.handlingCostUSD||150)+wr*cRisk(nv.country)*N.r*2}
   c*=(pen[e.id]||1);const ns=v+'|'+e.mode,nd=dv+c;if(nd<(dist.get(ns)??Infinity)){dist.set(ns,nd);prev.set(ns,{s,leg:{edge:e,from:u,to:v}});H.push([nd,ns,v,e.mode])}}}
 return null}
function enrich(x,C,month){const G=C.G,fam=family(x),se=season(fam,month);const borders=[];let dH=0,flags=[];
 const units=x.d.units||1,kgU=x.d.kg/units,roadAdj=new Set();x.legs.forEach(l=>{if(l.mode==='road'){roadAdj.add(l.from);roadAdj.add(l.to)}});
 x.nodeSeq.forEach(id=>{const n=G.nodeById[id];if(!n||n.type!=='border')return;const db=crossFor(n);const clr=db&&db.clr!=null?db.clr:null;const oh=db?openHours(db.hs):null;
  const ohW=oh&&oh<24?(24-oh)**2/48:0;const delta=clr!=null?clr-(n.avgDwellHours||0):0;dH+=delta+ohW;const f=[];
  if(db&&roadAdj.has(id)&&db.gvw&&(kgU+19900)/1000>db.gvw)f.push('وزن ناخالص بیش از سقف '+nf(db.gvw)+' تن');
  if(db&&roadAdj.has(id)&&db.mh&&db.mh<4)f.push('ارتفاع مجاز '+nf(db.mh,1)+' متر');
  if(db&&C.cargo.reefer&&/^n/i.test(String(db.cold)))f.push('بدون سردخانه');
  if(db&&/clos|suspend|بسته|limited/i.test(String(db.st)))f.push('وضعیت: '+String(db.st).slice(0,40));
  f.forEach(t=>flags.push(n.nameFa+': '+t));borders.push({n,db,clr,oh,ohW,delta,f})});
 const qd=se?clamp(6*se.u/(1-se.u),0,96):0;dH+=qd;const sur=se?x.cost.freight*se.s/100:0;
 const cr=avg(x.countries.filter(c=>c!=='IR').map(cRisk));const fr=famRiskIdx(fam);
 const risk=clamp(.5*(x.risk/100)+.3*cr+.2*fr,0,1);const H=x.hours+dH,cost=x.total+sur;
 const fxp=(()=>{const P=fam.price?DS.price.filter(p=>p.cor===fam.price&&p.fx):[];return P.length?avg(P.map(p=>mid(p.fx)))/100:.05})();
 const r=rng(x.nodeSeq.join('').length*7919+x.legs.length*31),D=[],K=[];const cong=avg(x.legs.map(l=>l.edge.congestion??.5));
 for(let s=0;s<400;s++){let h=0;x.legs.forEach(l=>{const rel=l.edge.reliability??.8;h+=l.runHours*Math.exp(gauss(r)*(.05+.22*(1-rel)))+l.waitHours*(.4+r()*1.2)+(l.dwellHours||0)*(.7+r()*r()*(1.2+2*cong))});
  borders.forEach(b=>{const c=b.clr??b.n.avgDwellHours??8;h+=c*(r()*r()*1.8-.25)+b.ohW*(r()*2)});h+=qd*(r()*2)+(x.hours-sum(x.legs.map(l=>l.runHours+l.waitHours+(l.dwellHours||0))));
  D.push(h/24);K.push(cost*(1+gauss(r)*fxp*.5)+Math.max(0,h-H)/24*45*units)}
 const lim=(C.prefs.maxDays||60);const onTime=D.filter(v=>v<=lim).length/D.length;
 return {x,fam,se,borders,qd,sur,cr,fr,risk,H,cost,days:H/24,D,K,p50D:qtl(D,.5),p90D:qtl(D,.9),p10D:qtl(D,.1),p50C:qtl(K,.5),p90C:qtl(K,.9),onTime,flags,co2:x.co2/1000,fxp}}
function runOpt(C){if(!OPT.modes)OPT.modes={...(C.prefs.modes||{sea:1,short:1,road:1,rail:1,air:0})};const M=edgeMetrics(C);const o=OPT.o,d=OPT.d;const opts={modes:OPT.modes,avoid:OPT.avoid};
 const W0=OPT.w,vecs=[W0,{cost:1,time:0,risk:0,co2:0},{cost:0,time:1,risk:0,co2:0},{cost:0,time:0,risk:1,co2:0},{cost:0,time:0,risk:0,co2:1},{cost:1,time:1,risk:0,co2:0},{cost:1,time:1,risk:1,co2:1},{cost:2,time:1,risk:1,co2:0},{cost:1,time:2,risk:1,co2:0}];
 const trace={seen:new Set(),order:[]};const paths=[],sig=new Set();const addP=p=>{if(!p||!p.length)return false;const k=p.map(l=>l.edge.id).join(',');if(sig.has(k))return false;sig.add(k);paths.push(p);return true};
 vecs.forEach((w,vi)=>{const pen={};for(let it=0;it<(vi===0?5:2);it++){const p=dijkstra(C,M,o,d,w,pen,opts,vi===0&&it===0?trace:null);if(!p)break;addP(p);p.forEach(l=>pen[l.edge.id]=(pen[l.edge.id]||1)*1.7)}});
 (C.routes||[]).forEach(R=>{if(R.nodeSeq[0]===o&&R.nodeSeq[R.nodeSeq.length-1]===d)addP(R.legs.map(l=>({edge:l.edge,from:l.from,to:l.to})))});
 let cands=paths.map(p=>yr(p)).filter(x=>x&&isFinite(x.total)).map(x=>enrich(x,C,OPT.month));
 cands.forEach(c=>{c.feas=c.x.borders<=OPT.maxB&&!c.x.countries.some(k=>OPT.avoid.has(k)&&k!==C.G.nodeById[o].country&&k!==C.G.nodeById[d].country)});
 // Pareto on (cost, days, risk, co2)
 const V=c=>[c.p50C,c.p50D,c.risk,c.co2];cands.forEach(a=>{a.pareto=!cands.some(b=>b!==a&&V(b).every((v,i)=>v<=V(a)[i])&&V(b).some((v,i)=>v<V(a)[i]))});
 // TOPSIS
 const w=[W0.cost,W0.time,W0.risk,W0.co2],ws=sum(w)||1;const cols=[0,1,2,3].map(i=>Math.sqrt(sum(cands.map(c=>V(c)[i]**2)))||1);
 const Z=cands.map(c=>V(c).map((v,i)=>v/cols[i]*w[i]/ws));const best=[0,1,2,3].map(i=>Math.min(...Z.map(z=>z[i]))),worst=[0,1,2,3].map(i=>Math.max(...Z.map(z=>z[i])));
 cands.forEach((c,j)=>{const dp=Math.hypot(...Z[j].map((v,i)=>v-best[i])),dn=Math.hypot(...Z[j].map((v,i)=>v-worst[i]));c.score=(dn/(dp+dn||1))*(c.feas?1:.6)});
 cands.sort((a,b)=>b.score-a.score);cands=cands.slice(0,Math.max(OPT.k,4));
 cands.forEach((c,i)=>{c.rank=i+1;const ms=[];c.x.legs.forEach(l=>{if(ms[ms.length-1]!==l.mode)ms.push(l.mode)});c.modeSeq=ms;
  const eng=(C.routes||[]).find(R=>R.nodeSeq.join()===c.x.nodeSeq.join());const bn=c.borders.map(b=>b.n.nameFa.replace(/^مرز\s*/,''));
  c.name=eng?eng.name:(ms.map(m=>MODE[m].n).join(' + ')+(bn.length?' · '+bn.slice(0,2).join('، '):''));c.eng=!!eng});
 const mins={c:Math.min(...cands.map(c=>c.p50C)),d:Math.min(...cands.map(c=>c.p50D)),r:Math.min(...cands.map(c=>c.risk)),k:Math.min(...cands.map(c=>c.co2))};
 cands.forEach(c=>{c.tags=[];if(c.p50C===mins.c)c.tags.push('ارزان‌ترین');if(c.p50D===mins.d)c.tags.push('سریع‌ترین');if(c.risk===mins.r)c.tags.push('کم‌ریسک‌ترین');if(c.co2===mins.k)c.tags.push('سبزترین')});
 return {cands,trace,explored:trace.order.length,evaluated:paths.length}}

function rOpt(b,C){const G=C.G;const R=C.R;if(!OPT.o||!G.nodeById[OPT.o]){OPT.o=R?R.nodeSeq[0]:G.nodes[0].id;OPT.d=R?R.nodeSeq[R.nodeSeq.length-1]:'IR_THR'}
 if(!OPT.modes)OPT.modes={...(C.prefs.modes||{sea:1,short:1,road:1,rail:1,air:0})};
 const opts=[...G.nodes].sort((a,b)=>(a.country==='IR')-(b.country==='IR')||a.country.localeCompare(b.country)||a.nameFa.localeCompare(b.nameFa,'fa'));
 const sel=v=>opts.map(n=>`<option value="${n.id}"${n.id===v?' selected':''}>${esc(n.nameFa)} · ${esc(cfa(n.country))}</option>`).join('');
 const ctys=[...new Set(G.nodes.map(n=>n.country))].filter(c=>c!=='IR');
 b.innerHTML=`<div class="op">
 <aside class="op-ctl sx-card">
  <h4>مبدأ و مقصد</h4><label class="sx-f"><span>مبدأ</span><select data-k="o">${sel(OPT.o)}</select></label>
  <button class="sx-swap" title="جابه‌جایی">⇅</button><label class="sx-f"><span>مقصد</span><select data-k="d">${sel(OPT.d)}</select></label>
  <h4>وزن معیارها <small>TOPSIS</small></h4>
  ${[['cost','هزینه'],['time','زمان'],['risk','ریسک'],['co2','کربن']].map(([k,n])=>`<label class="sx-sl"><span>${n}</span><input type="range" min="0" max="100" value="${OPT.w[k]}" data-w="${k}"><b>${fa(OPT.w[k])}</b></label>`).join('')}
  <div class="sx-pre">${[['متعادل',[40,30,20,10]],['اقتصادی',[75,10,10,5]],['فوری',[10,75,10,5]],['امن',[20,20,55,5]],['سبز',[25,15,10,50]]].map(([n,v])=>`<button data-p="${v}">${n}</button>`).join('')}</div>
  <h4>شیوه‌های مجاز</h4><div class="sx-chips">${Object.keys(MODE).map(m=>`<button class="sx-chip${OPT.modes[m]?' on':''}" data-m="${m}" style="--c:${MODE[m].c}"><i></i>${MODE[m].n}</button>`).join('')}</div>
  <h4>پرهیز از کشورها</h4><div class="sx-chips sm">${ctys.map(c=>`<button class="sx-chip${OPT.avoid.has(c)?' on bad':''}" data-c="${c}">${cfa(c)}</button>`).join('')}</div>
  <h4>محدودیت‌ها و فصل</h4>
  <label class="sx-sl"><span>حداکثر مرز</span><input type="range" min="1" max="8" value="${OPT.maxB}" data-x="maxB"><b>${fa(OPT.maxB)}</b></label>
  <label class="sx-sl"><span>ماه حرکت</span><input type="range" min="1" max="12" value="${OPT.month}" data-x="month"><b>${fa(OPT.month)}</b></label>
  <label class="sx-sl"><span>تعداد گزینه</span><input type="range" min="4" max="16" value="${OPT.k}" data-x="k"><b>${fa(OPT.k)}</b></label>
  <button class="sx-btn pri op-run">${svgI(IC.bolt)}اجرای بهینه‌سازی</button>
  <p class="sx-note">الگوریتم: دایکسترای چندمعیاره با وضعیت (گره، شیوه) و جریمهٔ تعویض شیوه، تنوع‌بخشی با جریمهٔ یال، ارزیابی دقیق هزینه با موتور اطلس، سپس اصلاح با داده‌های اکسل (زمان ترخیص و ساعات کار گذرگاه‌ها، ظرفیت/بهره‌برداری فصلی و سورشارژ، ریسک کشور و کریدور)، شبیه‌سازی مونت‌کارلو (۴۰۰ اجرا) و رتبه‌بندی پارتو + TOPSIS.</p>
 </aside>
 <section class="op-main">
  <div class="op-kpis"></div>
  <div class="op-viz"><div class="sx-card op-map"><header><b>شبکه و مسیرهای کاندید</b><small class="op-mstat"></small><span class="sx-sp"></span><button class="sx-btn sm op-replay">${svgI(IC.play)}بازپخش جستجو</button></header><canvas></canvas><div class="op-leg">${Object.keys(MODE).map(m=>`<span style="--c:${MODE[m].c}"><i></i>${MODE[m].n}</span>`).join('')}<span class="pf"><i></i>جبههٔ پارتو</span></div></div>
  <div class="sx-card op-sc"><header><b>جبههٔ پارتو · زمان × هزینه</b><small>اندازه = CO₂ · رنگ = ریسک · خط‌چین = بازهٔ P10–P90</small></header><svg></svg></div></div>
  <div class="op-bottom"><div class="sx-card op-list"></div><div class="sx-card op-det"></div></div>
 </section></div>`;
 const go=()=>{OPT.res=runOpt(C);OPT.sel=0;paint(true)};
 $$('select',b).forEach(s=>s.onchange=()=>{OPT[s.dataset.k]=s.value;go()});
 $('.sx-swap',b).onclick=()=>{[OPT.o,OPT.d]=[OPT.d,OPT.o];rOpt(b,C)};
 $$('[data-w]',b).forEach(i=>i.oninput=()=>{OPT.w[i.dataset.w]=+i.value;i.nextElementSibling.textContent=fa(i.value)});
 $$('[data-w]',b).forEach(i=>i.onchange=go);
 $$('[data-x]',b).forEach(i=>{i.oninput=()=>{i.nextElementSibling.textContent=fa(i.value)};i.onchange=()=>{OPT[i.dataset.x]=+i.value;go()}});
 $$('[data-p]',b).forEach(x=>x.onclick=()=>{const v=x.dataset.p.split(',').map(Number);['cost','time','risk','co2'].forEach((k,i)=>OPT.w[k]=v[i]);$$('[data-w]',b).forEach(i=>{i.value=OPT.w[i.dataset.w];i.nextElementSibling.textContent=fa(i.value)});go()});
 $$('[data-m]',b).forEach(x=>x.onclick=()=>{OPT.modes[x.dataset.m]=!OPT.modes[x.dataset.m];x.classList.toggle('on');go()});
 $$('[data-c]',b).forEach(x=>x.onclick=()=>{const c=x.dataset.c;OPT.avoid.has(c)?OPT.avoid.delete(c):OPT.avoid.add(c);x.classList.toggle('on');x.classList.toggle('bad');go()});
 $('.op-run',b).onclick=go;$('.op-replay',b).onclick=()=>paint(true);
 /* ---- map canvas ---- */
 const cv=$('.op-map canvas',b);let anim=null,t0=0,hover=null;
 function proj(){const R=OPT.res;const ids=new Set();if(R)R.cands.forEach(c=>c.x.nodeSeq.forEach(i=>ids.add(i)));const ns=[...ids].map(i=>G.nodeById[i]).filter(Boolean);const P=ns.length?ns:G.nodes;
  let a=Math.min(...P.map(n=>n.lng)),z=Math.max(...P.map(n=>n.lng)),lo=Math.min(...P.map(n=>n.lat)),hi=Math.max(...P.map(n=>n.lat));const px=(z-a)*.12+2,py=(hi-lo)*.12+2;a-=px;z+=px;lo-=py;hi+=py;
  const k=Math.cos((lo+hi)/2*Math.PI/180);return {a,z,lo,hi,k}}
 let PJ=null;
 function draw(now){const {g,w,h}=canvasFit(cv);const P=PJ;const sx=(z=>{const W=(P.z-P.a)*P.k,H=P.hi-P.lo,s=Math.min(w/W,h/H);return {s,ox:(w-W*s)/2,oy:(h-H*s)/2}})();
  const X=(lat,lng)=>[sx.ox+(lng-P.a)*P.k*sx.s,sx.oy+(P.hi-lat)*sx.s];g.clearRect(0,0,w,h);
  const t=(now-t0)/1000;const cs=getComputedStyle(document.body);const line=cs.getPropertyValue('--line2')||'#444',faint=cs.getPropertyValue('--faint')||'#777',txt=cs.getPropertyValue('--text')||'#eee';
  g.lineWidth=1;g.strokeStyle=line;g.globalAlpha=.55;for(const e of G.edges){g.beginPath();e.pts.forEach((p,i)=>{const [x,y]=X(p[0],p[1]);i?g.lineTo(x,y):g.moveTo(x,y)});g.stroke()}g.globalAlpha=1;
  const R=OPT.res;const ord=R?R.trace.order:[];const sp=Math.max(1,ord.length/1.4);const shown=Math.min(ord.length,Math.floor(t*sp));
  for(const n of G.nodes){const [x,y]=X(n.lat,n.lng);if(x<-5||y<-5||x>w+5||y>h+5)continue;g.fillStyle=faint;g.globalAlpha=.5;g.beginPath();g.arc(x,y,1.6,0,7);g.fill()}g.globalAlpha=1;
  for(let i=0;i<shown;i++){const n=G.nodeById[ord[i]];const [x,y]=X(n.lat,n.lng);const age=t*sp-i;const a=clamp(1-age/(sp*.6),0,1);g.fillStyle='rgba(94,159,232,'+(.25+.5*a)+')';g.beginPath();g.arc(x,y,2.2+5*a,0,7);g.fill()}
  const tp=Math.max(0,t-1.4);if(R)R.cands.slice().reverse().forEach((c,ri)=>{const i=R.cands.length-1-ri;const isS=i===OPT.sel;const prog=clamp((tp-i*.12)/.9,0,1);if(prog<=0)return;
   const segs=c.x.legs.map(l=>{const pts=l.edge.from===l.from?l.edge.pts:[...l.edge.pts].reverse();return {m:l.mode,p:pts.map(q=>X(q[0],q[1]))}});
   const tot=sum(segs.map(s=>s.p.length-1));let lim=tot*ease(prog),k=0;g.lineCap='round';g.lineJoin='round';
   segs.forEach(s=>{g.beginPath();g.strokeStyle=MODE[s.m].c;g.globalAlpha=isS?1:(hover===i?.85:c.pareto?.42:.18);g.lineWidth=isS?3.2:hover===i?2.4:1.6;if(isS){g.setLineDash([]);}
    s.p.forEach((q,j)=>{if(k+j>lim)return;j?g.lineTo(q[0],q[1]):g.moveTo(q[0],q[1])});k+=s.p.length-1;g.stroke()});g.globalAlpha=1;
   if(isS&&prog>=1){const all=segs.flatMap(s=>s.p);const L=[0];for(let j=1;j<all.length;j++)L.push(L[j-1]+Math.hypot(all[j][0]-all[j-1][0],all[j][1]-all[j-1][1]));const LL=L[L.length-1]||1;
    for(let q=0;q<4;q++){const d=((t*.18+q/4)%1)*LL;let j=L.findIndex(v=>v>=d);if(j<1)j=1;const f=(d-L[j-1])/((L[j]-L[j-1])||1);const x=lerp(all[j-1][0],all[j][0],f),y=lerp(all[j-1][1],all[j][1],f);
     const gr=g.createRadialGradient(x,y,0,x,y,9);gr.addColorStop(0,'rgba(255,255,255,.95)');gr.addColorStop(1,'rgba(255,255,255,0)');g.fillStyle=gr;g.beginPath();g.arc(x,y,9,0,7);g.fill()}
    c.x.nodeSeq.forEach((id,j)=>{const n=G.nodeById[id];const [x,y]=X(n.lat,n.lng);const end=j===0||j===c.x.nodeSeq.length-1;const isB=n.type==='border';
     g.fillStyle=end?'#fff':isB?'#E0A84E':'rgba(255,255,255,.8)';g.beginPath();g.arc(x,y,end?4.5:isB?3.4:2.2,0,7);g.fill();
     if(end||isB){g.font='500 10px Vazirmatn';g.fillStyle=txt;g.textAlign='center';g.globalAlpha=.9;g.fillText(n.nameFa.replace(/^مرز\s*/,''),x,y-7);g.globalAlpha=1}})}});
  anim=requestAnimationFrame(draw)}
 cv.onmousemove=e=>{if(!OPT.res||!PJ)return;const r=cv.getBoundingClientRect();const mx=e.clientX-r.left,my=e.clientY-r.top;const w=r.width,h=r.height,P=PJ;const W=(P.z-P.a)*P.k,H=P.hi-P.lo,s=Math.min(w/W,h/H),ox=(w-W*s)/2,oy=(h-H*s)/2;
  let bn=null,bd=12;for(const n of G.nodes){const x=ox+(n.lng-P.a)*P.k*s,y=oy+(P.hi-n.lat)*s;const d=Math.hypot(x-mx,y-my);if(d<bd){bd=d;bn=n}}
  if(bn){const db=bn.type==='border'?crossFor(bn):null;showTip(e,`<b>${esc(bn.nameFa)}</b> · ${esc(cfa(bn.country))}<br><small>${esc(bn.nameEn)} · ${esc(bn.type)} · توقف ${nf(bn.avgDwellHours||0)} ساعت</small>${db?`<br><small>پایگاه گذرگاه‌ها: ترخیص ${db.clr!=null?nf(db.clr)+' ساعت':'—'} · کامیون/روز ${db.truck?nf(db.truck):'—'} · ${esc(String(db.hs||'').slice(0,30))}</small>`:''}`)}else hideTip()};
 cv.onmouseleave=hideTip;
 onClose(()=>{cancelAnimationFrame(anim);hideTip()});
 /* ---- paint everything ---- */
 function paint(replay){const R=OPT.res;if(!R||!R.cands.length){$('.op-list',b).innerHTML='<div class="sx-empty">مسیری با این محدودیت‌ها پیدا نشد. شیوه‌ها یا کشورهای ممنوع را تغییر دهید.</div>';$('.op-det',b).innerHTML='';$('.op-kpis',b).innerHTML='';return}
  PJ=proj();if(replay){t0=performance.now()}if(!anim)anim=requestAnimationFrame(draw);
  $('.op-mstat',b).textContent=`${fa(R.explored)} گره کاوش‌شده · ${fa(R.evaluated)} مسیر ارزیابی‌شده · ${fa(R.cands.filter(c=>c.pareto).length)} پارتو`;
  const c=R.cands[OPT.sel],base=C.R&&C.R.nodeSeq[0]===OPT.o&&C.R.nodeSeq[C.R.nodeSeq.length-1]===OPT.d?C.R:null;
  const dC=base?c.p50C-base.total:0,dD=base?c.p50D-base.avgDays:0;
  $('.op-kpis',b).innerHTML=kpi('هزینهٔ میانه (P50)',c.p50C,{pre:'$',sub:base?`${dC<=0?'▼':'▲'} ${usd(Math.abs(dC))} نسبت به مسیر فعلی`:'P90: '+usd(c.p90C),cls:dC<0?'good':''})+kpi('زمان میانه',c.p50D,{d:1,suf:' روز',sub:`P10–P90: ${nf(c.p10D,1)}–${nf(c.p90D,1)}`})+kpi('احتمال تحویل به‌موقع',c.onTime*100,{suf:'٪',sub:'سقف '+fa(C.prefs.maxDays||60)+' روز'})+kpi('شاخص ریسک',c.risk*100,{sub:'کشور '+nf(c.cr*100)+' · کریدور '+nf(c.fr*100)})+kpi('CO₂',c.co2,{d:1,suf:' t'})+kpi('امتیاز TOPSIS',c.score*100,{d:0,sub:'رتبهٔ '+fa(c.rank)+' از '+fa(R.cands.length)});countUp($('.op-kpis',b));
  scatter();list();detail()}
 function scatter(){const R=OPT.res,svg=$('.op-sc svg',b);const r=svg.getBoundingClientRect();const w=r.width||500,h=r.height||260,m={l:54,r:14,t:12,b:30};
  const C2=R.cands;const xs=C2.flatMap(c=>[c.p10D,c.p90D]),ys=C2.flatMap(c=>[c.p50C,c.p90C]);const x0=Math.min(...xs)*.92,x1=Math.max(...xs)*1.05,y0=Math.min(...ys)*.9,y1=Math.max(...ys)*1.06;
  const X=v=>m.l+(v-x0)/(x1-x0||1)*(w-m.l-m.r),Y=v=>h-m.b-(v-y0)/(y1-y0||1)*(h-m.t-m.b);const k0=Math.min(...C2.map(c=>c.co2)),k1=Math.max(...C2.map(c=>c.co2));
  const col=r0=>`hsl(${lerp(140,5,clamp(r0,0,1))} 55% 60%)`;const tk=(a,z,n)=>Array.from({length:n+1},(_,i)=>a+(z-a)*i/n);
  const pf=C2.filter(c=>c.pareto).sort((a,b)=>a.p50D-b.p50D);
  svg.setAttribute('viewBox',`0 0 ${w} ${h}`);
  svg.innerHTML=`<g class="ax">${tk(x0,x1,5).map(v=>`<line x1="${X(v)}" x2="${X(v)}" y1="${m.t}" y2="${h-m.b}"/><text x="${X(v)}" y="${h-m.b+16}" text-anchor="middle">${nf(v,0)}</text>`).join('')}${tk(y0,y1,4).map(v=>`<line x1="${m.l}" x2="${w-m.r}" y1="${Y(v)}" y2="${Y(v)}"/><text x="${m.l-6}" y="${Y(v)+3}" text-anchor="end">${kusd(v)}</text>`).join('')}<text x="${w-m.r}" y="${h-4}" text-anchor="end" class="al">روز ←</text></g>
  <path class="pf" d="${pf.map((c,i)=>(i?'L':'M')+X(c.p50D)+','+Y(c.p50C)).join('')}"/>
  ${C2.map((c,i)=>`<g class="pt${i===OPT.sel?' on':''}${c.feas?'':' inf'}" data-i="${i}" style="--d:${i*45}ms"><line x1="${X(c.p10D)}" x2="${X(c.p90D)}" y1="${Y(c.p50C)}" y2="${Y(c.p50C)}"/><line x1="${X(c.p50D)}" x2="${X(c.p50D)}" y1="${Y(c.p50C)}" y2="${Y(c.p90C)}"/><circle cx="${X(c.p50D)}" cy="${Y(c.p50C)}" r="${5+9*((c.co2-k0)/((k1-k0)||1))}" fill="${col(c.risk*1.6)}"/><text x="${X(c.p50D)}" y="${Y(c.p50C)+3.5}" text-anchor="middle">${fa(i+1)}</text></g>`).join('')}`;
  const pth=$('.pf',svg);if(pth.getTotalLength){const L=pth.getTotalLength();pth.style.strokeDasharray=L;pth.style.strokeDashoffset=L;requestAnimationFrame(()=>{pth.style.transition='stroke-dashoffset 1.1s cubic-bezier(.2,.9,.2,1) .3s';pth.style.strokeDashoffset=0})}
  $$('.pt',svg).forEach(g=>{const c=C2[+g.dataset.i];g.onclick=()=>{OPT.sel=+g.dataset.i;paint(false)};g.onmouseenter=e=>{hover=+g.dataset.i;showTip(e,`<b>${fa(c.rank)}. ${esc(c.name)}</b><br>${usd(c.p50C)} · ${nf(c.p50D,1)} روز · ریسک ${nf(c.risk*100)} · ${nf(c.co2,1)} tCO₂${c.pareto?'<br><small>روی جبههٔ پارتو</small>':''}`)};g.onmousemove=e=>showTip(e,tip.innerHTML);g.onmouseleave=()=>{hover=null;hideTip()}})}
 function list(){const R=OPT.res;const mx=Math.max(...R.cands.map(c=>c.score));
  $('.op-list',b).innerHTML=`<header><b>رتبه‌بندی گزینه‌ها</b><small>TOPSIS با وزن‌های شما</small></header><div class="op-rows">${R.cands.map((c,i)=>`<button class="op-row${i===OPT.sel?' on':''}${c.feas?'':' inf'}" data-i="${i}" style="--d:${i*40}ms"><em>${fa(i+1)}</em><div><b>${esc(c.name)}</b><span class="op-ms">${c.modeSeq.map(m=>`<i style="--c:${MODE[m].c}" title="${MODE[m].n}"></i>`).join('')}<small>${fa(c.x.borders)} مرز · ${fa(c.x.transfers)} تعویض${c.pareto?' · پارتو':''}${c.eng?' · مسیر اطلس':''}</small></span>${c.tags.length?`<span class="op-tags">${c.tags.map(t=>`<u>${t}</u>`).join('')}</span>`:''}</div><div class="op-num"><b>${usd(c.p50C)}</b><small>${nf(c.p50D,1)} روز</small><span class="bar"><i style="width:${c.score/mx*100}%"></i></span></div></button>`).join('')}</div>`;
  $$('.op-row',b).forEach(x=>x.onclick=()=>{OPT.sel=+x.dataset.i;paint(false)})}
 function detail(){const R=OPT.res,c=R.cands[OPT.sel],x=c.x;const T=x.timeline,tt=T.length?T[T.length-1].end:x.hours;
  const fw=fwdFor(c.borders.map(b=>(b.n.nameEn||'').split(/[\s/]/)[0]).concat(c.fam.k==='central'?['sarakhs']:[]).filter(s=>s&&s.length>3)).slice(0,6);
  const hist=(()=>{const lo=Math.min(...c.D),hi=Math.max(...c.D),n=28,bins=Array(n).fill(0);c.D.forEach(v=>bins[Math.min(n-1,Math.floor((v-lo)/((hi-lo)||1)*n))]++);const M=Math.max(...bins);return `<svg viewBox="0 0 280 54" class="op-hist">${bins.map((v,i)=>`<rect x="${i*10}" y="${50-v/M*46}" width="8.6" height="${v/M*46}" style="--d:${i*18}ms" class="${lo+(i+.5)/n*(hi-lo)<=(C.prefs.maxDays||60)?'ok':'late'}"/>`).join('')}<line x1="${(c.p50D-lo)/((hi-lo)||1)*280}" x2="${(c.p50D-lo)/((hi-lo)||1)*280}" y1="0" y2="54"/></svg>`})();
  $('.op-det',b).innerHTML=`<header><b>${fa(c.rank)}. ${esc(c.name)}</b><span class="sx-sp"></span><button class="sx-btn sm op-show">${svgI(IC.map)}نمایش روی نقشه</button><button class="sx-btn sm op-cost">${svgI(IC.cost)}هزینهٔ کامل</button><button class="sx-btn sm op-rfq" title="استعلام قیمت از فورواردرها">${svgI(IC.rfq)}استعلام</button><button class="sx-btn sm op-trk" title="ایجاد محموله برای رهگیری">${svgI(IC.track)}رهگیری</button></header>
  <div class="op-tl">${T.map(s=>{const w=(s.end-s.start)/tt*100;if(w<.15)return '';const l=s.kind==='leg'?x.legs[s.legIndex]:null;return `<i class="${s.kind}" style="width:${w}%;--c:${l?MODE[l.mode].c:'var(--line2)'}" title="${esc(s.kind==='leg'?nname(l.from)+' → '+nname(l.to)+' · '+MODE[l.mode].n+' · '+nf(l.distanceKm)+' km':nname(s.nodeId)+' · '+(s.label||''))} · ${nf((s.end-s.start)/24,1)} روز"></i>`}).join('')}</div>
  <div class="op-tlx"><span>${esc(nname(x.nodeSeq[0]))}</span><span>${nf(x.avgDays,1)} روز مدل · ${nf(c.days,1)} روز با داده‌ها</span><span>${esc(nname(x.nodeSeq[x.nodeSeq.length-1]))}</span></div>
  <div class="op-g2"><div><h5>توزیع زمان تحویل (مونت‌کارلو)</h5>${hist}<small class="sx-muted">سبز: تا سقف ${fa(C.prefs.maxDays||60)} روز · خط: میانه</small></div>
  <div><h5>اصلاحات داده‌محور</h5><ul class="op-adj"><li><span>کریدور داده</span><b>${esc(c.fam.n)}</b></li><li><span>فصل (${esc(c.se?c.se.q:'—')})</span><b>${c.se?'بهره‌برداری '+nf(c.se.u*100)+'٪':'—'}</b></li><li><span>صف ظرفیت</span><b>+${nf(c.qd,0)} ساعت</b></li><li><span>سورشارژ فصلی</span><b>${c.sur?usd(c.sur):'—'}</b></li><li><span>اصلاح ترخیص مرزی</span><b>${nf(sum(c.borders.map(b=>b.delta+b.ohW)),0)} ساعت</b></li><li><span>نوسان ارزی کریدور</span><b>±${nf(c.fxp*100,1)}٪</b></li></ul></div></div>
  <details class="op-why" open><summary>${svgI(IC.why)}چرا این مسیر؟</summary>${whyOpt(c,R.cands,C)}</details>
  ${c.flags.length?`<div class="op-flags">${c.flags.map(f=>`<span>⚠ ${esc(f)}</span>`).join('')}</div>`:''}
  <h5>گذرگاه‌های مرزی مسیر <small>(پایگاه ۶۹۷ گذرگاه)</small></h5><div class="op-bx">${c.borders.length?c.borders.map(bb=>`<div class="op-bc"><b>${esc(bb.n.nameFa)}</b><small>${esc(bb.db?bb.db.n:'— بدون تطبیق')}</small><dl><dt>ترخیص</dt><dd>${bb.clr!=null?nf(bb.clr)+' ساعت':nf(bb.n.avgDwellHours||0)+' ساعت (مدل)'}</dd><dt>ساعات کار</dt><dd>${esc(bb.db?String(bb.db.hs||'—').slice(0,26):'—')}</dd><dt>ظرفیت کامیون</dt><dd>${bb.db&&bb.db.truck?nf(bb.db.truck)+'/روز':'—'}</dd><dt>سقف GVW</dt><dd>${bb.db&&bb.db.gvw?nf(bb.db.gvw)+' t':'—'}</dd><dt>سردخانه</dt><dd>${esc(bb.db?String(bb.db.cold||'—').slice(0,18):'—')}</dd></dl></div>`).join(''):'<div class="sx-muted">این مسیر گذرگاه زمینی ندارد (ورود از بندر / فرودگاه).</div>'}</div>
  ${famRisks(c.fam).length?`<h5>ریسک‌های کلیدی کریدور <small>(Risk Assessment)</small></h5><div class="op-risks">${famRisks(c.fam).sort((a,b)=>pnum(b.p)*(b.imp||0)-pnum(a.p)*(a.imp||0)).slice(0,4).map(r=>`<div><i style="--v:${pnum(r.p)*(r.imp||3)/5}"></i><b>${esc(r.f)}</b><small>${esc(r.cat)} · احتمال ${esc(r.p)} · شدت ${fa(r.imp||'-')} — ${esc(String(r.mit).slice(0,120))}</small></div>`).join('')}</div>`:''}
  ${fw.length?`<h5>فورواردرهای ایرانی فعال در این مسیر</h5><div class="op-fw">${fw.map(f=>`<a href="${/^http/.test(f.web)?esc(f.web):'https://'+esc(f.web)}" target="_blank" rel="noopener"><b>${esc(f.fa||f.en)}</b><small>${esc(f.city)} · ${esc(String(f.svc).slice(0,40))}</small><small dir="ltr">${esc(f.tel||'')}</small></a>`).join('')}</div>`:''}`;
  $('.op-rfq',b).onclick=()=>{RFQ.src={x:c.x,name:c.name,fam:c.fam,days:c.p50D};view='rfq';render()};$('.op-trk',b).onclick=()=>{newShipment(C,{x:c.x,name:c.name,fam:c.fam},Date.now()+DAY);view='track';render()};$('.op-show',b).onclick=()=>showOnMap(C,R.cands,OPT.sel);$('.op-cost',b).onclick=()=>{COST.ext=R.cands.map(c=>({name:c.name,x:c.x,days:c.p50D,sur:c.sur,fam:c.fam}));COST.sel='o'+OPT.sel;view='cost';render()}}
 if(!OPT.res||OPT.sig!==OPT.o+OPT.d+JSON.stringify(C.cargo)){OPT.sig=OPT.o+OPT.d+JSON.stringify(C.cargo);go()}else paint(true)}
function showOnMap(C,cands,sel){const E=C.E;const rs=cands.map((c,i)=>({...c.x,id:'opt-'+i,name:c.name,via:c.borders.map(b=>b.n.nameFa).join('، '),corridorId:null,modeSeq:c.modeSeq,badges:i===0?['best']:[],rank:i+1,score:c.score,backbone:null,affinity:0}));
 const ord=[rs[sel],...rs.filter((_,i)=>i!==sel)].slice(0,6);try{E.setRoutes(ord,0);E.fitRoute(ord[0],{top:90,right:440,bottom:260,left:200});E.setPlayback&&E.setPlayback({T:0,playing:true})}catch(e){console.error(e)}
 close();toast('مسیر بهینه روی نقشه نمایش داده شد · برای بازگشت، جستجو را دوباره اجرا کنید')}

/* ===== Full-chain landed cost studio ===== */
const COST={sel:'r0',ext:null,inc:null,pay:'lc',duty:15,vat:10,fx:2,inv:18,broker:250,psi:true,ins:'A',ch:'green',month:new Date().getMonth()+1,season:true,unit:'total',dem:null};
const INC=['EXW','FCA','FOB','CFR','CIF','CPT','CIP','DAP','DPU','DDP'];
const SELLER={EXW:[],FCA:['origin','exp','psi'],FOB:['origin','exp','psi','thc'],CFR:['origin','exp','psi','thc','freight','fuel','peak','special','transfer','docs'],CPT:['origin','exp','psi','thc','freight','fuel','peak','special','transfer','docs']};
SELLER.CIF=[...SELLER.CFR,'ins'];SELLER.CIP=[...SELLER.CFR,'ins'];SELLER.DAP=[...SELLER.CIP,'border','last'];SELLER.DPU=[...SELLER.DAP];SELLER.DDP=[...SELLER.DAP,'imp','broker','duty','vat','dem'];
const PAY={tt:{n:'حواله (T/T)',r:.003,d:0},lc:{n:'اعتبار اسنادی (L/C)',r:.015,d:3},cad:{n:'برات اسنادی (CAD)',r:.006,d:1}};
const CHN={green:{n:'سبز',c:0,d:0},yellow:{n:'زرد',c:120,d:2},red:{n:'قرمز',c:420,d:5}};
const INS={A:{n:'ICC A (تمام‌خطر)',m:1},B:{n:'ICC B',m:.78},C:{n:'ICC C (حداقل)',m:.6}};
const STG=[{n:'مبدأ',c:'#5E9FE8'},{n:'ترخیص صادرات',c:'#4FB9C9'},{n:'ترمینال مبدأ',c:'#6FA8DC'},{n:'حمل اصلی',c:'#A98BE0'},{n:'بیمه',c:'#E07FA2'},{n:'مرز و ترانزیت',c:'#E0A84E'},{n:'ریسک تأخیر',c:'#E97366'},{n:'ترخیص واردات',c:'#DE9255'},{n:'حقوق و مالیات',c:'#C9765B'},{n:'مالی و ارز',c:'#B49A6B'},{n:'تحویل نهایی',c:'#72BC8F'}];
const CAT={transport:'حمل',terminal:'ترمینال و جابه‌جایی',customs:'گمرک و مرز',tax:'حقوق و مالیات',finance:'مالی، ارز و بیمه',admin:'اسناد و خدمات',risk:'ریسک و تأخیر'};
function sources(C){const S=(C.routes||[]).map((R,i)=>({id:'r'+i,name:R.name,x:R,days:R.avgDays,fam:family(R),sur:0}));
 (COST.ext||[]).forEach((e,i)=>S.push({id:'o'+i,name:'بهینه‌ساز '+fa(i+1)+' · '+e.name,x:e.x,days:e.days,fam:e.fam,sur:e.sur,opt:1}));return S}
function landed(C,src,P){const r=src.x,c=r.cost,ch=C.rates.charges,val=+C.cargo.value||0,units=r.d.units||1;const se=P.season?season(src.fam,P.month):null;
 const days=(src.days||r.avgDays)+(CHN[P.ch].d)+(PAY[P.pay].d)+(se?clamp(6*se.u/(1-se.u),0,96)/24:0);
 const sur=se?c.freight*se.s/100:0;const exp=Math.min(c.customs,ch.exportClearanceUSD||120);const ins=c.insurance*INS[P.ins].m;
 const trans=c.origin+c.thc+c.handling+c.freight+c.fuel+c.peak+sur+c.special+c.transfer+c.border+c.docs;const cif=val+trans+ins;
 const duty=cif*P.duty/100,vat=(cif+duty)*P.vat/100;const demD=P.dem!=null?P.dem:Math.max(0,((r.maxDays||days)-(r.avgDays||days))*.35+CHN[P.ch].d*.6);
 const L=[['origin','جمع‌آوری و بارگیری مبدأ',0,'terminal',c.origin],['exp','ترخیص صادراتی',1,'customs',exp],['psi','بازرسی پیش از حمل (PSI)',1,'admin',P.psi?350:0],
  ['thc','THC و عملیات ترمینال',2,'terminal',c.thc+c.handling],['freight','کرایهٔ حمل اصلی',3,'transport',c.freight],['fuel','سوخت / BAF',3,'transport',c.fuel],
  ['peak','سورشارژ فصلی و پیک',3,'transport',c.peak+sur],['special','سورشارژ کالای ویژه',3,'transport',c.special],['transfer','تعویض شیوه / ترانشیپ',3,'terminal',c.transfer],
  ['ins','بیمهٔ باری · '+P.ins,4,'finance',ins],['border','عوارض مرزی و ترانزیت',5,'customs',c.border],['docs','اسناد حمل و گواهی‌ها',5,'admin',c.docs],
  ['dem','دموراژ / دیتنشن مورد انتظار',6,'risk',demD*(r.legs.some(l=>l.mode==='sea')?95:60)*units],
  ['imp','ترخیص وارداتی · مسیر '+CHN[P.ch].n,7,'customs',Math.max(0,c.customs-exp)+CHN[P.ch].c],['broker','حق‌العمل‌کاری',7,'admin',P.broker],
  ['duty','حقوق ورودی ('+fa(P.duty)+'٪ CIF)',8,'tax',duty],['vat','مالیات ارزش افزوده ('+fa(P.vat)+'٪)',8,'tax',vat],
  ['bank','کارمزد بانکی · '+PAY[P.pay].n,9,'finance',val*PAY[P.pay].r],['fx','اسپرد و انتقال ارز',9,'finance',val*P.fx/100],
  ['inv','هزینهٔ سرمایهٔ کالای در راه',9,'finance',val*P.inv/100*days/365],['last','حمل داخلی تا انبار',10,'transport',c.lastMile]]
  .map(([k,n,st,cat,v])=>({k,n,st,cat,v:Math.max(0,v||0)}));
 const sel=new Set(SELLER[P.inc]||[]);L.forEach(x=>x.who=sel.has(x.k)?'s':'b');
 const total=sum(L.map(x=>x.v));return {L,total,seller:sum(L.filter(x=>x.who==='s').map(x=>x.v)),buyer:sum(L.filter(x=>x.who==='b').map(x=>x.v)),days,cif,val,units,r,se,logistic:sum(L.filter(x=>x.cat!=='tax').map(x=>x.v))}}
function rCost(b,C){if(!COST.inc)COST.inc=INC.includes(C.cargo.incoterm)?C.cargo.incoterm:'CFR';
 const S=sources(C);let src=S.find(s=>s.id===COST.sel)||S[C.E.selected]||S[0];if(!src){b.innerHTML='<div class="sx-empty">ابتدا یک جستجوی مسیر اجرا کنید.</div>';return}COST.sel=src.id;
 const seg=(k,o)=>`<div class="sx-seg" data-k="${k}">${Object.entries(o).map(([v,n])=>`<button data-v="${v}"${String(COST[k])===v?' class="on"':''}>${n}</button>`).join('')}</div>`;
 const sl=(k,n,mn,mx,st,suf)=>`<label class="sx-sl"><span>${n}</span><input type="range" min="${mn}" max="${mx}" step="${st}" value="${COST[k]}" data-s="${k}"><b>${fa(COST[k])}${suf}</b></label>`;
 b.innerHTML=`<div class="co">
 <div class="co-bar sx-card"><label class="sx-f"><span>مسیر</span><select class="co-src">${S.map(s=>`<option value="${s.id}"${s.id===src.id?' selected':''}>${esc(s.name)} — ${usd(s.x.total)}</option>`).join('')}</select></label>
  <div class="sx-f"><span>اینکوترمز</span>${seg('inc',Object.fromEntries(INC.map(i=>[i,i])))}</div>
  <div class="sx-f"><span>پرداخت</span>${seg('pay',{tt:'T/T',lc:'L/C',cad:'CAD'})}</div><div class="sx-f"><span>مسیر گمرکی</span>${seg('ch',{green:'سبز',yellow:'زرد',red:'قرمز'})}</div><div class="sx-f"><span>بیمه</span>${seg('ins',{A:'A',B:'B',C:'C'})}</div>
  ${sl('duty','حقوق ورودی',0,55,1,'٪')}${sl('vat','VAT',0,20,1,'٪')}${sl('fx','اسپرد ارز',0,8,.5,'٪')}${sl('inv','نرخ سرمایه',0,40,1,'٪')}${sl('month','ماه',1,12,1,'')}
  <div class="sx-f"><span>نمایش</span>${seg('unit',{total:'کل',unit:'هر واحد',kg:'هر کیلو',pct:'٪ ارزش'})}</div></div>
 <div class="co-kpis"></div>
 <div class="sx-card co-hs"></div>
 <div class="co-g1"><div class="sx-card co-wf"><header><b>آبشار هزینهٔ تمام‌شده</b><small class="co-wfs"></small><span class="sx-sp"></span><button class="sx-btn sm co-csv">${svgI(IC.dl)}CSV</button></header><div class="co-wfb"></div></div>
  <div class="sx-card co-sk"><header><b>جریان هزینه: مرحله ← دسته ← پرداخت‌کننده</b></header><svg></svg></div></div>
 <div class="sx-card co-cb"><header><b>فضای ترکیب‌های هزینهٔ زنجیره</b><small class="co-cbs"></small><span class="sx-sp"></span><div class="sx-seg co-cbc"><button data-v="route" class="on">رنگ: مسیر</button><button data-v="pay">پرداخت</button><button data-v="ch">گمرک</button><button data-v="q">فصل</button></div></header><div class="co-cbw"><canvas></canvas><div class="co-cbl"></div></div></div>
 <div class="co-g2"><div class="sx-card co-cmp"><header><b>مقایسهٔ مسیرها (پشته‌ای بر اساس دسته)</b></header><div class="co-cmpb"></div></div>
  <div class="sx-card co-tor"><header><b>حساسیت هزینهٔ تمام‌شده</b><small>±۲۰٪ هر عامل</small></header><div class="co-torb"></div></div></div>
 <div class="co-g2"><div class="sx-card co-bm"><header><b>محک با دادهٔ بازار درب‌به‌درب</b><small class="co-bms"></small></header><div class="co-bmb"></div></div>
  <div class="sx-card co-tr"><header><b>روند فصلی نرخ کریدور</b><small class="co-trs"></small></header><svg></svg></div></div>
 <div class="sx-card co-cf"></div></div>`;
 const P=()=>({inc:COST.inc,pay:COST.pay,duty:COST.duty,vat:COST.vat,fx:COST.fx,inv:COST.inv,broker:COST.broker,psi:COST.psi,ins:COST.ins,ch:COST.ch,month:COST.month,season:COST.season,dem:COST.dem});
 $('.co-src',b).onchange=e=>{COST.sel=e.target.value;rCost(b,C)};
 $$('.co-bar .sx-seg',b).forEach(sg=>$$('button',sg).forEach(x=>x.onclick=()=>{COST[sg.dataset.k]=x.dataset.v;$$('button',sg).forEach(y=>y.classList.toggle('on',y===x));upd(false)}));
 $$('[data-s]',b).forEach(i=>i.oninput=()=>{COST[i.dataset.s]=+i.value;i.nextElementSibling.textContent=fa(i.value)+(i.dataset.s==='month'?'':'٪');upd(true)});
 let cbMode='route';$$('.co-cbc button',b).forEach(x=>x.onclick=()=>{cbMode=x.dataset.v;$$('.co-cbc button',b).forEach(y=>y.classList.toggle('on',y===x));combos(true)});
 const U=(v,res)=>COST.unit==='unit'?v/res.units:COST.unit==='kg'?v/(C.cargo.weightKg||1):COST.unit==='pct'?v/(res.val||1)*100:v;
 const UF=(v,res)=>COST.unit==='pct'?nf(U(v,res),2)+'٪':COST.unit==='kg'?'$'+nf(U(v,res),3):usd(U(v,res));
 let res,raf=[];onClose(()=>raf.forEach(cancelAnimationFrame));hsCard($('.co-hs',b),C,r=>{COST.duty=Math.round(r*10)/10;toast('حقوق ورودی '+fa(COST.duty)+'٪ اعمال شد');rCost(b,C)});
 function upd(soft){res=landed(C,src,P());try{cashCard($('.co-cf',b),C,src,P(),res)}catch(e){console.error(e)}kp();wf(soft);sk();if(!soft){cmp();tor();bm();trend();combos(true)}else{cmp();tor();combos(false)}}
 function kp(){const r=res;$('.co-kpis',b).innerHTML=kpi('هزینهٔ کل زنجیره',U(r.total,r),{pre:COST.unit==='pct'?'':'$',suf:COST.unit==='pct'?'٪':'',d:COST.unit==='kg'?3:COST.unit==='pct'?1:0,sub:'بهای تمام‌شدهٔ کالا (Landed): '+usd(r.val+r.total)})
  +kpi('هزینهٔ لجستیک (بدون مالیات)',r.logistic,{pre:'$',sub:nf(r.logistic/(r.val||1)*100,1)+'٪ ارزش کالا'})+kpi('سهم فروشنده · '+COST.inc,r.seller,{pre:'$',sub:nf(r.seller/r.total*100)+'٪'})+kpi('سهم خریدار',r.buyer,{pre:'$',sub:nf(r.buyer/r.total*100)+'٪'})
  +kpi('ارزش گمرکی CIF',r.cif,{pre:'$'})+kpi('زمان کل زنجیره',r.days,{d:1,suf:' روز',sub:'به‌ازای هر کیلو '+'$'+nf(r.total/(C.cargo.weightKg||1),2)});countUp($('.co-kpis',b))}
 function wf(soft){const r=res,L=r.L.filter(x=>x.v>.5);const tot=r.total;let cum=0;const order=[...L].sort((a,b2)=>a.st-b2.st);
  const sIdx=order.findIndex(x=>x.who==='b');const rows=order.map(x=>{const o={...x,s:cum};cum+=x.v;return o});
  $('.co-wfs',b).textContent=`${fa(rows.length)} جزء · انتقال مسئولیت هزینه در ${COST.inc}`;
  const h=`<div class="wf">${rows.map((x,i)=>`${i===sIdx&&sIdx>0?`<div class="wf-sep"><span>انتقال هزینه به خریدار · ${COST.inc}</span></div>`:''}<div class="wf-r ${x.who}" style="--d:${soft?0:i*32}ms" data-i="${i}"><span class="wf-n"><i style="background:${STG[x.st].c}"></i>${esc(x.n)}</span><span class="wf-t"><i style="right:${x.s/tot*100}%;width:${Math.max(.25,x.v/tot*100)}%;--c:${STG[x.st].c}"></i></span><b>${UF(x.v,r)}</b></div>`).join('')}<div class="wf-r tot"><span class="wf-n">جمع کل</span><span class="wf-t"><i style="right:0;width:100%"></i></span><b>${UF(tot,r)}</b></div></div>`;
  const w=$('.co-wfb',b);w.innerHTML=h;if(!soft)w.classList.remove('in'),requestAnimationFrame(()=>requestAnimationFrame(()=>w.classList.add('in')));else w.classList.add('in');
  $$('.wf-r[data-i]',w).forEach(el=>{const x=rows[+el.dataset.i];el.onmouseenter=e=>showTip(e,`<b>${esc(x.n)}</b><br>${usd(x.v)} · ${nf(x.v/tot*100,1)}٪ کل<br><small>${STG[x.st].n} · ${CAT[x.cat]} · پرداخت: ${x.who==='s'?'فروشنده':'خریدار'}</small>`);el.onmousemove=e=>showTip(e,tip.innerHTML);el.onmouseleave=hideTip})}
 function sk(){const r=res,svg=$('.co-sk svg',b);const R=svg.getBoundingClientRect(),w=R.width||480,h=R.height||330;svg.setAttribute('viewBox',`0 0 ${w} ${h}`);
  const L=r.L.filter(x=>x.v>.5),tot=r.total;const cols=[[...new Set(L.map(x=>x.st))].sort((a,b2)=>a-b2).map(s=>({k:'s'+s,n:STG[s].n,c:STG[s].c,v:sum(L.filter(x=>x.st===s).map(x=>x.v))})),
   Object.keys(CAT).filter(k=>L.some(x=>x.cat===k)).map(k=>({k:'c'+k,n:CAT[k],c:'#8A8984',v:sum(L.filter(x=>x.cat===k).map(x=>x.v))})),
   [{k:'ps',n:'فروشنده',c:'#5E9FE8',v:r.seller},{k:'pb',n:'خریدار',c:'#E0A84E',v:r.buyer}].filter(x=>x.v>0)];
  const pad=6,nw=12,gap=5,minH=13,X=[w-nw-150,(w-nw)/2+10,110];const pos={};
  cols.forEach((col,ci)=>{const avail=h-pad*2-gap*(col.length-1);let K=avail/tot;for(let it=0;it<8;it++){const big=col.filter(n=>n.v*K>minH);const small=col.length-big.length;K=Math.max(.0001,(avail-small*minH)/(sum(big.map(n=>n.v))||1))}
   let y=pad;col.forEach(n=>{const hh=Math.max(minH,n.v*K);pos[n.k]={x:X[ci],y,h:hh,o:0,i:0,n,ci};y+=hh+gap})});
  const links=[];const add=(a,z,v,c)=>{const A=pos[a],Z=pos[z];const sh=v/A.n.v*A.h,th=v/Z.n.v*Z.h;links.push({a:A,z:Z,v,c,sy:A.y+A.o,sh,ty:Z.y+Z.i,th});A.o+=sh;Z.i+=th};
  cols[0].forEach(s=>cols[1].forEach(c=>{const v=sum(L.filter(x=>'s'+x.st===s.k&&'c'+x.cat===c.k).map(x=>x.v));if(v>0)add(s.k,c.k,v,s.c)}));
  cols[1].forEach(c=>cols[2].forEach(p=>{const v=sum(L.filter(x=>'c'+x.cat===c.k&&'p'+x.who===p.k).map(x=>x.v));if(v>0)add(c.k,p.k,v,p.c)}));
  const path=l=>{const x0=l.a.x,x1=l.z.x+nw,mx=(x0+x1)/2;return `M${x0},${l.sy}C${mx},${l.sy} ${mx},${l.ty} ${x1},${l.ty}L${x1},${l.ty+l.th}C${mx},${l.ty+l.th} ${mx},${l.sy+l.sh} ${x0},${l.sy+l.sh}Z`};const cpath=l=>{const x0=l.a.x,x1=l.z.x+nw,mx=(x0+x1)/2,y0=l.sy+l.sh/2,y1=l.ty+l.th/2;return `M${x0},${y0}C${mx},${y0} ${mx},${y1} ${x1},${y1}`};
  svg.innerHTML=`<defs>${links.map((l,i)=>`<linearGradient id="skg${i}" x1="1" x2="0"><stop offset="0" stop-color="${l.c}" stop-opacity=".55"/><stop offset="1" stop-color="${l.z.n.c}" stop-opacity=".35"/></linearGradient>`).join('')}</defs>
  <g class="sk-l">${links.map((l,i)=>`<path d="${path(l)}" fill="url(#skg${i})" style="--d:${i*25}ms" data-i="${i}"/><path class="fl" d="${cpath(l)}" stroke-width="${Math.max(.6,Math.min(l.sh,l.th)*.3)}" style="animation-delay:-${(i*.37)%3}s"/>`).join('')}</g>
  <g class="sk-n">${Object.values(pos).map(p=>`<rect x="${p.x}" y="${p.y}" width="${nw}" height="${p.h}" rx="2" fill="${p.n.c}"/><text x="${p.ci===0?p.x+nw+6:p.x-6}" y="${p.y+p.h/2+3.5}" text-anchor="${p.ci===0?'start':'end'}">${esc(p.n.n)} · ${usd(p.n.v)}</text>`).join('')}</g>`;
  $$('.sk-l path[data-i]',svg).forEach(el=>{const l=links[+el.dataset.i];el.onmouseenter=e=>showTip(e,`${esc(l.a.n.n)} ← ${esc(l.z.n.n)}<br><b>${usd(l.v)}</b> · ${nf(l.v/tot*100,1)}٪`);el.onmousemove=e=>showTip(e,tip.innerHTML);el.onmouseleave=hideTip})}
 let CB=null;
 function combos(re){const cv=$('.co-cbw canvas',b);if(re||!CB){const pts=[];const months={1:'زمستان',4:'بهار',7:'تابستان',10:'پاییز'};
   S.forEach((s,si)=>Object.keys(PAY).forEach(p=>Object.keys(CHN).forEach(ch=>Object.keys(months).forEach(m=>['A','C'].forEach(ins=>{const r=landed(C,s,{...P(),pay:p,ch,month:+m,ins});pts.push({si,p,ch,q:+m,ins,c:r.total,d:r.days,cur:s.id===src.id&&p===COST.pay&&ch===COST.ch&&ins===COST.ins&&Math.floor((COST.month-1)/3)===Math.floor((+m-1)/3)})})))));CB={pts,t0:performance.now(),months}}
  const pts=CB.pts;const cs=pts.map(p=>p.c),ds=pts.map(p=>p.d);const c0=Math.min(...cs),c1=Math.max(...cs),d0=Math.min(...ds),d1=Math.max(...ds);
  const pal=['#5E9FE8','#E0A84E','#72BC8F','#A98BE0','#E07FA2','#4FB9C9','#E97366','#C9B26B','#8FB0D9','#D98F6B','#9AD08F','#B78FD9','#D9D26B','#6BD9C4'];
  const key=p=>cbMode==='route'?p.si:cbMode==='pay'?Object.keys(PAY).indexOf(p.p):cbMode==='ch'?Object.keys(CHN).indexOf(p.ch):[1,4,7,10].indexOf(p.q);
  const names=cbMode==='route'?S.map(s=>s.name):cbMode==='pay'?Object.values(PAY).map(x=>x.n):cbMode==='ch'?Object.values(CHN).map(x=>'مسیر '+x.n):Object.values(CB.months);
  const pcol=cbMode==='ch'?['#72BC8F','#E0A84E','#E97366']:pal;
  $('.co-cbs',b).textContent=`${fa(pts.length)} ترکیب = ${fa(S.length)} مسیر × ۳ روش پرداخت × ۳ مسیر گمرکی × ۴ فصل × ۲ پوشش بیمه · P10 ${kusd(qtl(cs,.1))} · P50 ${kusd(qtl(cs,.5))} · P90 ${kusd(qtl(cs,.9))}`;
  $('.co-cbl',b).innerHTML=names.map((n,i)=>`<span><i style="background:${pcol[i%pcol.length]}"></i>${esc(String(n).slice(0,38))}</span>`).join('');
  const hov={i:-1};cancelAnimationFrame(raf[0]);
  const draw=()=>{const {g,w,h}=canvasFit(cv);const m={l:58,r:12,t:10,b:58},hb=40;g.clearRect(0,0,w,h);const X=v=>m.l+(v-d0)/((d1-d0)||1)*(w-m.l-m.r),Y=v=>h-m.b-(v-c0)/((c1-c0)||1)*(h-m.t-m.b-hb);
   const cs2=getComputedStyle(document.body),line=cs2.getPropertyValue('--line'),faint=cs2.getPropertyValue('--faint'),txt=cs2.getPropertyValue('--text');
   g.strokeStyle=line;g.fillStyle=faint;g.font='10px Vazirmatn';g.lineWidth=1;for(let i=0;i<=5;i++){const v=d0+(d1-d0)*i/5,x=X(v);g.beginPath();g.moveTo(x,m.t+hb);g.lineTo(x,h-m.b);g.stroke();g.textAlign='center';g.fillText(nf(v,1),x,h-m.b+14)}
   for(let i=0;i<=4;i++){const v=c0+(c1-c0)*i/4,y=Y(v);g.beginPath();g.moveTo(m.l,y);g.lineTo(w-m.r,y);g.stroke();g.textAlign='right';g.fillText(kusd(v),m.l-6,y+3)}
   g.textAlign='left';g.fillText('روز',w-m.r-20,h-m.b+28);
   const t=clamp((performance.now()-CB.t0)/1200,0,1);
   // histogram (top strip) of cost? -> day histogram along x
   const nb=40,bins=Array(nb).fill(0);pts.forEach(p=>bins[Math.min(nb-1,Math.floor((p.d-d0)/((d1-d0)||1)*nb))]++);const bm=Math.max(...bins);
   bins.forEach((v,i)=>{const x=m.l+i*(w-m.l-m.r)/nb;g.fillStyle='rgba(138,137,132,.35)';const hh=v/bm*(hb-8)*ease(t);g.fillRect(x+1,m.t+hb-hh-4,(w-m.l-m.r)/nb-2,hh)});
   // cost histogram on bottom
   const nc=40,cb=Array(nc).fill(0);pts.forEach(p=>cb[Math.min(nc-1,Math.floor((p.c-c0)/((c1-c0)||1)*nc))]++);
   pts.forEach((p,i)=>{const k=i/pts.length;const tt=clamp((t-k*.6)/.4,0,1);if(tt<=0)return;const x=X(p.d),y=lerp(h-m.b,Y(p.c),ease(tt));g.globalAlpha=p.cur?1:.55*tt;g.fillStyle=pcol[key(p)%pcol.length];g.beginPath();g.arc(x,y,p.cur?5:i===hov.i?4.5:2.6,0,7);g.fill()});g.globalAlpha=1;
   const cur=pts.find(p=>p.cur);if(cur){const x=X(cur.d),y=Y(cur.c);const pul=(performance.now()/900)%1;g.strokeStyle=txt;g.lineWidth=1.5;g.beginPath();g.arc(x,y,6+pul*10,0,7);g.globalAlpha=1-pul;g.stroke();g.globalAlpha=1;
    g.setLineDash([3,3]);g.strokeStyle=faint;g.beginPath();g.moveTo(x,y);g.lineTo(x,h-m.b);g.moveTo(x,y);g.lineTo(m.l,y);g.stroke();g.setLineDash([])}
   [.1,.5,.9].forEach(q=>{const y=Y(qtl(cs,q));g.strokeStyle='rgba(224,168,78,.55)';g.setLineDash([2,4]);g.beginPath();g.moveTo(m.l,y);g.lineTo(w-m.r,y);g.stroke();g.setLineDash([]);g.fillStyle='rgba(224,168,78,.9)';g.textAlign='left';g.fillText('P'+fa(q*100),w-m.r-26,y-3)});
   raf[0]=requestAnimationFrame(draw)};draw();
  cv.onmousemove=e=>{const r=cv.getBoundingClientRect(),mx=e.clientX-r.left,my=e.clientY-r.top;const w=r.width,h=r.height,m={l:58,r:12,t:10,b:58},hb=40;const X=v=>m.l+(v-d0)/((d1-d0)||1)*(w-m.l-m.r),Y=v=>h-m.b-(v-c0)/((c1-c0)||1)*(h-m.t-m.b-hb);
   let bi=-1,bd=9;pts.forEach((p,i)=>{const d=Math.hypot(X(p.d)-mx,Y(p.c)-my);if(d<bd){bd=d;bi=i}});hov.i=bi;if(bi<0)return hideTip();const p=pts[bi];
   showTip(e,`<b>${esc(S[p.si].name)}</b><br>${PAY[p.p].n} · گمرک ${CHN[p.ch].n} · ${CB.months[p.q]} · بیمه ${p.ins}<br><b>${usd(p.c)}</b> · ${nf(p.d,1)} روز<br><small>کلیک: اعمال این ترکیب</small>`)};
  cv.onmouseleave=()=>{hov.i=-1;hideTip()};
  cv.onclick=()=>{if(hov.i<0)return;const p=pts[hov.i];COST.pay=p.p;COST.ch=p.ch;COST.ins=p.ins;COST.month=p.q+1;COST.sel=S[p.si].id;hideTip();rCost(b,C)}}
 function cmp(){const rs=S.map(s=>({s,r:landed(C,s,P())})).sort((a,b2)=>a.r.total-b2.r.total);const mx=Math.max(...rs.map(x=>x.r.total));const cats=Object.keys(CAT);const cc={transport:'#A98BE0',terminal:'#5E9FE8',customs:'#E0A84E',tax:'#C9765B',finance:'#B49A6B',admin:'#4FB9C9',risk:'#E97366'};
  $('.co-cmpb',b).innerHTML=`<div class="cmp-leg">${cats.map(k=>`<span><i style="background:${cc[k]}"></i>${CAT[k]}</span>`).join('')}</div>`+rs.map(({s,r},i)=>`<div class="cmp-r${s.id===src.id?' on':''}" data-id="${s.id}" style="--d:${i*50}ms"><span class="cmp-n">${esc(s.name)}<small>${nf(r.days,1)} روز</small></span><span class="cmp-b" style="width:${r.total/mx*100}%">${cats.map(k=>{const v=sum(r.L.filter(x=>x.cat===k).map(x=>x.v));return v>0?`<i style="flex:${v};background:${cc[k]}" title="${CAT[k]}: ${usd(v)}"></i>`:''}).join('')}</span><b>${UF(r.total,r)}</b></div>`).join('');
  $$('.cmp-r',b).forEach(el=>el.onclick=()=>{COST.sel=el.dataset.id;rCost(b,C)})}
 function tor(){const base=res.total,p0=P();const F=[['کرایهٔ حمل',r=>({...src,x:{...src.x,cost:{...src.x.cost,freight:src.x.cost.freight*r}}})],['ارزش کالا',null,'val'],['نرخ حقوق ورودی',null,'duty'],['اسپرد ارز',null,'fx'],['زمان ترانزیت',r=>({...src,days:(src.days||src.x.avgDays)*r})],['عوارض مرزی',r=>({...src,x:{...src.x,cost:{...src.x.cost,border:src.x.cost.border*r}}})],['هزینهٔ سرمایه',null,'inv'],['حمل داخلی',r=>({...src,x:{...src.x,cost:{...src.x.cost,lastMile:src.x.cost.lastMile*r}}})]];
  const res2=F.map(([n,fs,pk])=>{const run=r=>{if(fs)return landed(C,fs(r),p0).total;if(pk==='val'){const v0=C.cargo.value;C.cargo.value=v0*r;const t=landed(C,src,p0).total;C.cargo.value=v0;return t}return landed(C,src,{...p0,[pk]:p0[pk]*r}).total};return {n,lo:run(.8)-base,hi:run(1.2)-base}}).sort((a,b2)=>Math.max(Math.abs(b2.lo),Math.abs(b2.hi))-Math.max(Math.abs(a.lo),Math.abs(a.hi)));
  const mx=Math.max(...res2.map(x=>Math.max(Math.abs(x.lo),Math.abs(x.hi))))||1;
  $('.co-torb',b).innerHTML=res2.map((x,i)=>`<div class="tor-r" style="--d:${i*40}ms"><span>${x.n}</span><div class="tor-t"><i class="lo" style="width:${Math.abs(x.lo)/mx*50}%"></i><i class="hi" style="width:${Math.abs(x.hi)/mx*50}%"></i><em></em></div><b>${x.hi>=0?'+':'−'}${kusd(Math.abs(x.hi))}</b></div>`).join('')+'<div class="tor-ax"><span>+۲۰٪ ←</span><span>پایه '+kusd(base)+'</span><span>→ −۲۰٪</span></div>'}
 function bm(){const f=src.fam,rows=DS.d2d.filter(d=>d.cor===f.d2d);const box=$('.co-bmb',b);
  if(!rows.length){$('.co-bms',b).textContent='';box.innerHTML=`<div class="sx-empty">برای کریدور «${esc(f.n)}» دادهٔ درب‌به‌درب در فایل اطلس وجود ندارد. محک‌ها برای کریدورهای چین ← ایران (مرکزی، جنوبی، شمالی، ترانس‌خزر، دریایی–ریلی، TIR، هوایی) موجود است.</div>`;return}
  const pref=C.cargo.shipmentType==='LCL'?/LCL/:/Block|FCL|FTL|Standard/;const d=rows.find(x=>pref.test(x.mode))||rows[0];$('.co-bms',b).textContent=`${d.cor} · ${d.mode} · ${d.per||''}`;
  const L=res.L,g=k=>sum(L.filter(x=>k.includes(x.k)).map(x=>x.v));const u=res.units;
  const M=[['جمع‌آوری مبدأ',0,g(['origin'])/u],['هندلینگ مبدأ',1,null],['گمرک چین',2,g(['exp'])/u],['کرایهٔ پایه',3,g(['freight'])/u],['سوخت',4,g(['fuel'])/u],['عوارض مرزی/ترانزیت',[5,6,7,8,9,10,11],g(['border'])/u],['هندلینگ مقصد',13,g(['thc'])/u],['مایل آخر',14,g(['last'])/u],['بیمه',15,g(['ins'])/u],['اسناد',16,g(['docs'])/u],['هزینهٔ بانکی/ارزی',17,g(['bank','fx'])/u],['جمع بدون عوارض',18,(res.logistic-g(['inv','dem']))/u]];
  const items=M.map(([n,ix,v])=>{const rr=Array.isArray(ix)?ix.map(i=>d.c[i]).filter(Boolean).reduce((a,x)=>[a[0]+x[0],a[1]+x[1]],[0,0]):d.c[ix];return {n,r:rr&&rr[1]?rr:null,v}}).filter(x=>x.r);
  const mx=Math.max(...items.map(x=>Math.max(x.r[1],x.v||0)))*1.08;
  box.innerHTML=items.map((x,i)=>`<div class="bm-r${i===items.length-1?' tot':''}" style="--d:${i*40}ms"><span>${x.n}</span><div class="bm-t"><i style="right:${x.r[0]/mx*100}%;width:${Math.max(.6,(x.r[1]-x.r[0])/mx*100)}%"></i>${x.v!=null?`<em style="right:${x.v/mx*100}%" class="${x.v<x.r[0]?'lo':x.v>x.r[1]?'hi':'in'}"></em>`:''}</div><b>${x.v!=null?usd(x.v):'—'}</b><small dir="ltr">${usd(x.r[0])}–${usd(x.r[1])}</small></div>`).join('')+'<p class="sx-note">نوار: بازهٔ بازار (به‌ازای هر واحد/TEU) از برگهٔ Door-to-Door Costs · نشانگر: مقدار مدل همین مسیر. سبز = داخل بازه.</p>'}
 function trend(){const f=src.fam;const svg=$('.co-tr svg',b);const pref=C.cargo.shipmentType==='LCL'?'LCL Consolidated':src.x.legs.some(l=>l.mode==='road')&&!src.x.legs.some(l=>l.mode==='rail')?'Road Truck':'FCL Block Train';
  const rows=f.price?DS.price.filter(p=>p.cor===f.price&&p.cargo===pref&&p.total).sort((a,b2)=>{const k=s=>s.q.slice(3)+s.q.slice(1,2);return k(a).localeCompare(k(b2))}):[];
  const se=DS.seasonal.filter(s=>s.cor===f.seas);
  if(!rows.length&&!se.length){$('.co-trs',b).textContent='';svg.outerHTML=`<div class="sx-empty">دادهٔ روند برای این کریدور موجود نیست.</div>`;return}
  const R=svg.getBoundingClientRect(),w=R.width||480,h=R.height||220,m={l:50,r:40,t:12,b:26};svg.setAttribute('viewBox',`0 0 ${w} ${h}`);
  if(rows.length){$('.co-trs',b).textContent=`${f.price} · ${pref} · ${fa(rows.length)} فصل`;const lo=Math.min(...rows.map(r=>r.total[0]))*.92,hi=Math.max(...rows.map(r=>r.total[1]))*1.04;
   const X=i=>m.l+i/((rows.length-1)||1)*(w-m.l-m.r),Y=v=>h-m.b-(v-lo)/((hi-lo)||1)*(h-m.t-m.b);
   const band=rows.map((r,i)=>`${i?'L':'M'}${X(i)},${Y(r.total[1])}`).join('')+rows.map((r,i)=>`L${X(rows.length-1-i)},${Y(rows[rows.length-1-i].total[0])}`).join('')+'Z';
   const midp=rows.map((r,i)=>`${i?'L':'M'}${X(i)},${Y(mid(r.total))}`).join('');const pk=rows.map(r=>r.peak?mid(r.peak):0);const pm=Math.max(...pk.map(Math.abs))||1;
   svg.innerHTML=`<g class="ax">${[0,1,2,3].map(i=>{const v=lo+(hi-lo)*i/3;return `<line x1="${m.l}" x2="${w-m.r}" y1="${Y(v)}" y2="${Y(v)}"/><text x="${m.l-6}" y="${Y(v)+3}" text-anchor="end">${kusd(v)}</text>`}).join('')}${rows.map((r,i)=>`<text x="${X(i)}" y="${h-8}" text-anchor="middle">${esc(r.q)}</text>`).join('')}</g>
   ${rows.map((r,i)=>`<rect class="pk ${pk[i]<0?'neg':''}" x="${X(i)-7}" width="14" y="${h-m.b-Math.abs(pk[i])/pm*34}" height="${Math.abs(pk[i])/pm*34}"><title>ضریب اوج فصلی ${nf(pk[i],1)}٪</title></rect>`).join('')}
   <path class="band" d="${band}"/><path class="ln" d="${midp}"/>${rows.map((r,i)=>`<circle cx="${X(i)}" cy="${Y(mid(r.total))}" r="3.2"><title>${esc(r.q)}: ${usd(r.total[0])}–${usd(r.total[1])} · ${esc(String(r.drv).slice(0,90))}</title></circle>`).join('')}
   <text x="${w-m.r+4}" y="${h-m.b-4}" class="al">اوج٪</text>`;
   const ln=$('.ln',svg);const Lp=ln.getTotalLength();ln.style.strokeDasharray=Lp;ln.style.strokeDashoffset=Lp;requestAnimationFrame(()=>{ln.style.transition='stroke-dashoffset 1.4s ease';ln.style.strokeDashoffset=0})}
  else{$('.co-trs',b).textContent=`${f.seas} · بهره‌برداری ظرفیت`;const X=i=>m.l+i/((se.length-1)||1)*(w-m.l-m.r),Y=v=>h-m.b-v/100*(h-m.t-m.b);
   svg.innerHTML=`<g class="ax">${[0,50,100].map(v=>`<line x1="${m.l}" x2="${w-m.r}" y1="${Y(v)}" y2="${Y(v)}"/><text x="${m.l-6}" y="${Y(v)+3}" text-anchor="end">${fa(v)}٪</text>`).join('')}${se.map((r,i)=>`<text x="${X(i)}" y="${h-8}" text-anchor="middle">${esc(r.q)}</text>`).join('')}</g>${se.map((r,i)=>`<rect class="ut" x="${X(i)-9}" width="18" y="${Y(mid(r.util)||0)}" height="${h-m.b-Y(mid(r.util)||0)}" style="--d:${i*60}ms"><title>${esc(r.q)} · ${esc(r.peak)} · سورشارژ ${esc(r.surT)}</title></rect>`).join('')}`}}
 $('.co-csv',b).onclick=()=>dlFile('landed-cost.csv',['جزء,مرحله,دسته,پرداخت‌کننده,USD',...res.L.map(x=>[x.n,STG[x.st].n,CAT[x.cat],x.who==='s'?'فروشنده':'خریدار',x.v.toFixed(2)].map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')),'"جمع",,,,'+res.total.toFixed(2)].join('\n'));
 requestAnimationFrame(()=>upd(false))}

/* ===== Container load-planning studio: extreme-point 3D packing + animated canvas 3D ===== */
const EQ={'20GP':{n:'۲۰ فوت استاندارد',L:589,W:235,H:239,kg:28200,tare:2230,eng:'20DV',door:[234,228]},'40GP':{n:'۴۰ فوت استاندارد',L:1203,W:235,H:239,kg:26700,tare:3750,eng:'40DV',door:[234,228]},
 '40HC':{n:'۴۰ فوت های‌کیوب',L:1203,W:235,H:269,kg:26500,tare:3940,eng:'40HC',door:[234,258]},'45HC':{n:'۴۵ فوت های‌کیوب',L:1356,W:235,H:269,kg:27700,tare:4800,eng:'40HC',door:[234,258],mult:1.12},
 '20RF':{n:'۲۰ فوت یخچالی',L:544,W:229,H:227,kg:27400,tare:3080,eng:'20RF',door:[229,226]},'40RF':{n:'۴۰ فوت یخچالی (HC)',L:1158,W:229,H:255,kg:26800,tare:4800,eng:'40RF',door:[229,250]},
 'FTL':{n:'تریلی ۱۳٫۶ متری (FTL)',L:1360,W:245,H:270,kg:24000,tare:0,eng:'40HC',door:[245,270],road:1}};
const ENG2EQ={'20DV':'20GP','40DV':'40GP','40HC':'40HC','20RF':'20RF','40RF':'40RF','OT':'40GP','FR':'40GP'};
const PAL=['#5E9FE8','#E0A84E','#72BC8F','#A98BE0','#E07FA2','#4FB9C9','#E97366','#C9B26B','#8FB0D9','#D98F6B'];
const PRESETS=[{n:'پالت یورو',L:120,W:80,H:140,kg:450,q:33,stack:true,rot:true},{n:'پالت استاندارد',L:120,W:100,H:120,kg:600,q:20,stack:true,rot:true},{n:'کارتن صادراتی',L:60,W:40,H:40,kg:18,q:300,stack:true,rot:true,tilt:true},
 {n:'بشکهٔ ۲۰۰ لیتری (روی پالت)',L:120,W:120,H:95,kg:880,q:10,stack:false,rot:false},{n:'صندوق ماشین‌آلات',L:240,W:160,H:180,kg:2600,q:3,stack:false,rot:true},{n:'کیسهٔ جامبو',L:100,W:100,H:120,kg:1000,q:18,stack:true,rot:true}];
const LOAD={eq:null,items:null,ci:0,yaw:-.62,pitch:.48,zoom:1,prog:0,play:true,speed:1,color:'item',auto:false,sel:-1,res:null,key:''};
function defItems(C){const c=C.cargo;const q=Math.max(1,+c.packages||1);let L=+c.L,W=+c.W,H=+c.H;
 if(c.dimMode==='cbm'||!(L&&W&&H)){const v=(+c.cbm||10)/q*1e6;if(v<.25e6){const s=Math.round(Math.cbrt(v));L=Math.round(s*1.25);W=s;H=Math.round(v/(L*W))}else{L=120;W=v>1.6e6?115:100;H=Math.round(v/(L*W));if(H>250){W=115;L=Math.round(Math.min(230,v/(W*250)));H=Math.round(v/(L*W))}}}
 return [{n:c.commodity?String(c.commodity).slice(0,30):'بستهٔ اصلی',L,W,H,kg:Math.round((+c.weightKg||q*500)/q),q,stack:c.stackable!==false,rot:true,tilt:false}]}
function pack(items,eq,maxC=14){const E=EQ[eq];const units=[];items.forEach((it,ti)=>{for(let i=0;i<it.q&&units.length<900;i++)units.push({ti,...it,stack:it.frag?false:it.stack})});
 units.sort((a,b)=>(b.stop||1)-(a.stop||1)||(b.stack?0:1)-(a.stack?0:1)||b.L*b.W-a.L*a.W||b.H-a.H||b.kg-a.kg);
 // non-stackable last so they sit on top? -> keep non-stackable first on floor? choose: heavy non-stackables first on floor
 units.sort((a,b)=>(b.stop||1)-(a.stop||1)||(a.stack===b.stack?0:a.stack?1:-1)||b.kg/(b.L*b.W)-a.kg/(a.L*a.W)||b.L*b.W*b.H-a.L*a.W*a.H);
 const cons=[];let rest=units;
 while(rest.length&&cons.length<maxC){const P=[],left=[];let eps=[[0,0,0]],wt=0;
  for(const u of rest){if(wt+u.kg>E.kg){left.push(u);continue}
   const ors=[[u.L,u.W,u.H]];if(u.rot)ors.push([u.W,u.L,u.H]);if(u.tilt){ors.push([u.L,u.H,u.W],[u.H,u.L,u.W],[u.W,u.H,u.L],[u.H,u.W,u.L])}
   eps.sort((a,b)=>a[0]-b[0]||a[2]-b[2]||a[1]-b[1]);let done=null;
   for(const p of eps){for(const o of ors){const [x,y,z]=p,[l,w,h]=o;if(x+l>E.L+.01||y+w>E.W+.01||z+h>E.H+.01)continue;let ok=true;
     for(const q of P){if(x<q.x+q.l-.01&&x+l>q.x+.01&&y<q.y+q.w-.01&&y+w>q.y+.01&&z<q.z+q.h-.01&&z+h>q.z+.01){ok=false;break}}if(!ok)continue;
     if(z>.01){let sup=0;for(const q of P){if(Math.abs(q.z+q.h-z)<.6){if(q.top!=null&&q.top!==''){const ov2=Math.max(0,Math.min(x+l,q.x+q.l)-Math.max(x,q.x))*Math.max(0,Math.min(y+w,q.y+q.w)-Math.max(y,q.y));if(ov2>0&&u.kg*ov2/(l*w)>+q.top){ok=false;break}}if(!q.stack){const ov=Math.max(0,Math.min(x+l,q.x+q.l)-Math.max(x,q.x))*Math.max(0,Math.min(y+w,q.y+q.w)-Math.max(y,q.y));if(ov>0){ok=false;break}}
       sup+=Math.max(0,Math.min(x+l,q.x+q.l)-Math.max(x,q.x))*Math.max(0,Math.min(y+w,q.y+q.w)-Math.max(y,q.y))}}if(!ok||sup<l*w*.72)continue}
     done={x,y,z,l,w,h};break}if(done)break}
   if(!done){left.push(u);continue}
   const b={...done,ti:u.ti,kg:u.kg,stack:u.stack,n:u.n,stop:u.stop||1,top:u.top,dg:u.dg||'',frag:!!u.frag,i:P.length};P.push(b);wt+=u.kg;
   eps=eps.filter(p=>!(p[0]>=b.x-.01&&p[0]<b.x+b.l-.01&&p[1]>=b.y-.01&&p[1]<b.y+b.w-.01&&p[2]>=b.z-.01&&p[2]<b.z+b.h-.01));
   [[b.x+b.l,b.y,b.z],[b.x,b.y+b.w,b.z],[b.x,b.y,b.z+b.h]].forEach(p=>{if(p[0]<E.L&&p[1]<E.W&&p[2]<E.H&&!eps.some(e=>Math.abs(e[0]-p[0])<.5&&Math.abs(e[1]-p[1])<.5&&Math.abs(e[2]-p[2])<.5))eps.push(p)});
   // project new EPs down to supporting surface (gravity)
   }
  if(!P.length)break;cons.push(stats(P,E));rest=left}
 return {E,eq,cons,unplaced:rest.length,total:units.length}}
function blocked(S){let n=0;S.P.forEach(a=>{if(S.P.some(q=>(q.stop||1)>(a.stop||1)&&q.x>=a.x+a.l-1&&Math.min(q.y+q.w,a.y+a.w)-Math.max(q.y,a.y)>1&&Math.min(q.z+q.h,a.z+a.h)-Math.max(q.z,a.z)>1))n++});return n}
function stats(P,E){const M=sum(P.map(b=>b.kg)),V=sum(P.map(b=>b.l*b.w*b.h));const cg=[0,0,0];P.forEach(b=>{cg[0]+=(b.x+b.l/2)*b.kg;cg[1]+=(b.y+b.w/2)*b.kg;cg[2]+=(b.z+b.h/2)*b.kg});cg.forEach((v,i)=>cg[i]=M?v/M:0);
 const nb=Math.ceil(E.L/50),dist=Array(nb).fill(0);P.forEach(b=>{for(let s=0;s<nb;s++){const a=s*50,z=a+50;const ov=Math.max(0,Math.min(z,b.x+b.l)-Math.max(a,b.x));if(ov>0)dist[s]+=b.kg*ov/b.l}});
 let floor=0;P.filter(b=>b.z<.5).forEach(b=>{let w=b.kg;P.forEach(q=>{if(q!==b&&q.z>b.z){const cx=q.x+q.l/2,cy=q.y+q.w/2;if(cx>b.x&&cx<b.x+b.l&&cy>b.y&&cy<b.y+b.w)w+=q.kg}});floor=Math.max(floor,w/(b.l*b.w/1e4))});
 const a=.12*E.L,bx=.86*E.L;const Rr=M*(cg[0]-a)/(bx-a);const ldm=Math.max(0,...P.map(b=>b.x+b.l))/100*E.W/240;
 return {P,M,V,vol:V/(E.L*E.W*E.H),wt:M/E.kg,cg,off:(cg[0]-E.L/2)/E.L,offY:(cg[1]-E.W/2)/E.W,dist,floor,front:M-Rr,rear:Rr,ldm,maxX:Math.max(0,...P.map(b=>b.x+b.l))}}
/* ---------- 3D renderer ---------- */
function shade(hex,k){const n=parseInt(hex.slice(1),16);let r=n>>16,g=n>>8&255,b=n&255;const f=v=>Math.round(clamp(v*k,0,255));return `rgb(${f(r)},${f(g)},${f(b)})`}
function heat(t){return `hsl(${lerp(200,0,clamp(t,0,1))} 65% 58%)`}
function scene(g,w,h,S,o){const E=S.E,P=o.P||[];const cx=E.L/2,cy=E.W/2,cz=E.H/2;const yaw=o.yaw,pit=o.pitch;const cyw=Math.cos(yaw),syw=Math.sin(yaw),cp=Math.cos(pit),sp=Math.sin(pit);
 const R=Math.hypot(E.L,E.W,E.H);const D=R*1.9/o.zoom,F=Math.min(w*.8,h*1.3)*1.9;
 const T=(X,Y,Z)=>{const px=X-cx,py=Y-cy,pz=Z-cz;const x1=px*cyw-py*syw,y1=px*syw+py*cyw,z1=pz;const sx=x1,sy=y1*sp+z1*cp,sz=y1*cp-z1*sp+D;return [w/2+sx*F/sz,h/2+(o.mini?6:16)-sy*F/sz,sz,sx,sy]};
 g.clearRect(0,0,w,h);const css=getComputedStyle(document.body);const line=css.getPropertyValue('--line2').trim()||'#555',text=css.getPropertyValue('--text').trim()||'#eee';
 const V=[[0,0,0],[E.L,0,0],[E.L,E.W,0],[0,E.W,0],[0,0,E.H],[E.L,0,E.H],[E.L,E.W,E.H],[0,E.W,E.H]].map(p=>T(...p));
 const quad=(ids,fill,stroke,lw=1)=>{g.beginPath();ids.forEach((i,k)=>{const p=V[i];k?g.lineTo(p[0],p[1]):g.moveTo(p[0],p[1])});g.closePath();if(fill){g.fillStyle=fill;g.fill()}if(stroke){g.strokeStyle=stroke;g.lineWidth=lw;g.stroke()}};
 // walls: decide which are far (back-facing to camera) → draw filled behind cargo
 const walls=[{ids:[0,1,2,3],n:[0,0,-1],floor:1},{ids:[0,1,5,4],n:[0,-1,0]},{ids:[3,2,6,7],n:[0,1,0]},{ids:[0,3,7,4],n:[-1,0,0]},{ids:[1,2,6,5],n:[1,0,0],door:1},{ids:[4,5,6,7],n:[0,0,1]}];
 const cam=n=>{const x1=n[0]*cyw-n[1]*syw,y1=n[0]*syw+n[1]*cyw,z1=n[2];return [x1,y1*sp+z1*cp,y1*cp-z1*sp]};
 const camPos=(X,Y,Z)=>{const t=T(X,Y,Z);return [t[3],t[4],t[2]]};
 const facing=(n,c)=>{const nc=cam(n),pc=camPos(...c);return nc[0]*pc[0]+nc[1]*pc[1]+nc[2]*pc[2]<0};
 const wc=[[cx,cy,0],[cx,0,cz],[cx,E.W,cz],[0,cy,cz],[E.L,cy,cz],[cx,cy,E.H]];
 walls.forEach((wl,i)=>{const front=facing(wl.n,wc[i]);wl.front=front;if(!front){quad(wl.ids,wl.floor?'rgba(120,120,115,.16)':'rgba(120,120,115,.07)',line,1);
   if(!wl.floor&&!wl.door&&i<5&&!o.mini){g.strokeStyle='rgba(140,140,135,.14)';g.lineWidth=1;const isLong=i===1||i===2;const n=isLong?Math.floor(E.L/20):Math.floor(E.W/20);
    for(let k=1;k<n;k++){const t=k/n;let a,b;if(isLong){const y=i===1?0:E.W;a=T(E.L*t,y,0);b=T(E.L*t,y,E.H)}else{a=T(0,E.W*t,0);b=T(0,E.W*t,E.H)}g.beginPath();g.moveTo(a[0],a[1]);g.lineTo(b[0],b[1]);g.stroke()}}
   if(wl.floor&&!o.mini){g.strokeStyle='rgba(140,140,135,.12)';for(let x=100;x<E.L;x+=100){const a=T(x,0,0),b=T(x,E.W,0);g.beginPath();g.moveTo(a[0],a[1]);g.lineTo(b[0],b[1]);g.stroke()}}}});
 // CoG floor zone
 if(o.cg&&!o.mini){const zl=E.L*.1,zw=E.W*.1;const pts=[[cx-zl,cy-zw],[cx+zl,cy-zw],[cx+zl,cy+zw],[cx-zl,cy+zw]].map(p=>T(p[0],p[1],0));g.beginPath();pts.forEach((p,k)=>k?g.lineTo(p[0],p[1]):g.moveTo(p[0],p[1]));g.closePath();g.fillStyle='rgba(114,188,143,.13)';g.fill();g.setLineDash([4,4]);g.strokeStyle='rgba(114,188,143,.6)';g.stroke();g.setLineDash([])}
 // boxes → faces
 const faces=[];const L0=[.35,-.55,.76];const nL=Math.hypot(...L0);const n=P.length;const prog=o.prog??n;
 for(let i=0;i<n;i++){const b=P[i];if(i>=Math.ceil(prog))break;let dx=0,dz=0,al=1;if(i===Math.floor(prog)&&prog<n){const f=prog-i;const e=ease(f);dx=(1-e)*(E.L-b.x+60);dz=(1-e)*30*Math.sin(f*Math.PI);al=clamp(f*3,0,1)}
  if(o.ex){dx+=b.x/E.L*o.ex*80;dz+=b.z/E.H*o.ex*60}
  const x=b.x+dx,y=b.y,z=b.z+dz,l=b.l,ww=b.w,hh=b.h;const ins=.6;
  const F6=[{c:[[x,y,z+hh],[x+l,y,z+hh],[x+l,y+ww,z+hh],[x,y+ww,z+hh]],n:[0,0,1]},{c:[[x,y,z],[x+l,y,z],[x+l,y,z+hh],[x,y,z+hh]],n:[0,-1,0]},{c:[[x,y+ww,z],[x+l,y+ww,z],[x+l,y+ww,z+hh],[x,y+ww,z+hh]],n:[0,1,0]},
   {c:[[x,y,z],[x,y+ww,z],[x,y+ww,z+hh],[x,y,z+hh]],n:[-1,0,0]},{c:[[x+l,y,z],[x+l,y+ww,z],[x+l,y+ww,z+hh],[x+l,y,z+hh]],n:[1,0,0]},{c:[[x,y,z],[x+l,y,z],[x+l,y+ww,z],[x,y+ww,z]],n:[0,0,-1]}];
  const base=o.colorFn(b,i);
  for(const f of F6){const ctr=[avg(f.c.map(p=>p[0])),avg(f.c.map(p=>p[1])),avg(f.c.map(p=>p[2]))];if(!facing(f.n,ctr))continue;const pr=f.c.map(p=>T(...p));
   const lit=.62+.5*Math.max(0,(f.n[0]*L0[0]+f.n[1]*L0[1]+f.n[2]*L0[2])/nL);faces.push({pr,d:avg(pr.map(p=>p[2])),fill:shade(base,lit),i,al,top:f.n[2]===1})}}
 faces.sort((a,b)=>b.d-a.d);const hit=[];
 for(const f of faces){g.globalAlpha=f.al*(o.dim&&o.dim(f.i)?.22:1);g.beginPath();f.pr.forEach((p,k)=>k?g.lineTo(p[0],p[1]):g.moveTo(p[0],p[1]));g.closePath();g.fillStyle=f.fill;g.fill();g.strokeStyle=o.hover===f.i?'#fff':'rgba(0,0,0,.28)';g.lineWidth=o.hover===f.i?1.6:.7;g.stroke();
  if(f.top&&!o.mini&&o.labels){}hit.push(f)}g.globalAlpha=1;
 // near walls wireframe
 walls.forEach(wl=>{if(wl.front)quad(wl.ids,null,o.mini?'rgba(160,160,155,.55)':line,1)});
 // door frame
 if(!o.mini){const dA=T(E.L,0,0),dB=T(E.L,E.W,E.H);g.fillStyle=text;g.globalAlpha=.55;g.font='10px Vazirmatn';g.textAlign='center';const dm=T(E.L,E.W/2,E.H+14);g.fillText('درب',dm[0],dm[1]);const fm=T(0,E.W/2,E.H+14);g.fillText('جلو',fm[0],fm[1]);g.globalAlpha=1}
 // CoG
 if(o.cg&&P.length&&!o.mini){const c=T(...o.cg),f=T(o.cg[0],o.cg[1],0);g.setLineDash([3,3]);g.strokeStyle='rgba(255,255,255,.7)';g.beginPath();g.moveTo(c[0],c[1]);g.lineTo(f[0],f[1]);g.stroke();g.setLineDash([]);
  const pul=(performance.now()/1000)%1;g.fillStyle='#fff';g.beginPath();g.arc(c[0],c[1],4,0,7);g.fill();g.strokeStyle='rgba(255,255,255,'+(1-pul)+')';g.beginPath();g.arc(c[0],c[1],4+pul*9,0,7);g.stroke();
  g.fillStyle='rgba(0,0,0,.6)';g.beginPath();g.ellipse(f[0],f[1],6,3,0,0,7);g.fill();g.fillStyle=text;g.font='600 10px Vazirmatn';g.textAlign='center';g.fillText('مرکز ثقل',c[0],c[1]-10)}
 return hit}
function pip(p,poly){let c=false;for(let i=0,j=poly.length-1;i<poly.length;j=i++){const a=poly[i],b=poly[j];if((a[1]>p[1])!==(b[1]>p[1])&&p[0]<(b[0]-a[0])*(p[1]-a[1])/(b[1]-a[1])+a[0])c=!c}return c}
function rLoad(b,C){const k0=JSON.stringify([C.cargo.L,C.cargo.W,C.cargo.H,C.cargo.packages,C.cargo.weightKg,C.cargo.cbm,C.cargo.containerType]);
 if(!LOAD.items||LOAD.key!==k0){LOAD.key=k0;LOAD.items=defItems(C);LOAD.eq=ENG2EQ[C.cargo.containerType]||'40HC';if(C.cargo.reefer)LOAD.eq=LOAD.eq.startsWith('20')?'20RF':'40RF';LOAD.prog=0;LOAD.play=true}
 if(!EQ[LOAD.eq])LOAD.eq=ENG2EQ[C.cargo.containerType]||'40HC';
 b.innerHTML=`<div class="ld"><aside class="ld-side">
  <div class="sx-card"><header><b>تجهیزات</b><small>ابعاد داخلی</small></header><div class="ld-eqs"></div></div>
  <div class="sx-card"><header><b>اقلام بار</b><span class="sx-sp"></span><button class="sx-btn sm ld-reset" title="بازگشت به بار جستجوی فعلی">${svgI(IC.reset)}بار فعلی</button><label class="sx-btn sm ld-imp" title="ورود فهرست بسته‌بندی از Excel یا CSV">${svgI(IC.dl)}Packing List<input type="file" accept=".csv,.xlsx,.txt,.tsv" hidden></label></header><div class="ld-items"></div>
   <div class="ld-pre"><span>افزودن:</span>${PRESETS.map((p,i)=>`<button data-p="${i}">${svgI(IC.plus)}${p.n}</button>`).join('')}</div></div>
 </aside><section class="ld-main">
  <div class="ld-kpis"></div>
  <div class="sx-card ld-stage"><header><div class="sx-seg ld-ctab"></div><span class="sx-sp"></span><div class="sx-seg ld-views"><button data-v="3d" class="on">سه‌بعدی</button><button data-v="top">بالا</button><button data-v="side">کنار</button><button data-v="door">درب</button></div>
   <div class="sx-seg ld-col"><button data-v="item" class="on">رنگ: قلم</button><button data-v="weight">وزن</button><button data-v="order">ترتیب</button><button data-v="stop">مقصد</button></div><button class="sx-btn sm ld-ex" title="نمای انفجاری">⇱ باز</button><button class="sx-btn sm ld-pdf" title="برنامهٔ بارگیری قابل چاپ">${svgI(IC.pdf)}برنامهٔ بارگیری</button><button class="sx-btn sm ld-csv" title="جدول موقعیت بسته‌ها">${svgI(IC.dl)}CSV</button></header>
   <div class="ld-cv"><canvas></canvas><div class="ld-hint">کشیدن: چرخش · اسکرول: زوم · دوبار کلیک: بازنشانی</div></div>
   <div class="ld-play"><button class="sx-btn sm ld-pp">${svgI(IC.pause)}</button><input type="range" min="0" max="1000" value="0" class="ld-scr"><span class="ld-cnt"></span><div class="sx-seg ld-sp"><button data-v="0.5">½×</button><button data-v="1" class="on">۱×</button><button data-v="3">۳×</button></div></div></div>
  <div class="ld-g"><div class="sx-card"><header><b>توزیع وزن در طول</b><small>هر ۵۰ سانتی‌متر</small></header><div class="ld-dist"></div></div><div class="sx-card"><header><b>بار محور و ایمنی</b></header><div class="ld-axle"></div></div></div>
  <div class="sx-card"><header><b>مقایسهٔ تجهیزات برای همین بار</b><small>چیدمان واقعی هر گزینه + برآورد کرایه روی مسیر انتخابی</small></header><div class="ld-cmp"></div></div>
  <div class="ld-g"><div class="sx-card"><header><b>برنامهٔ مهار بار (CTU Code)</b><small>شتاب‌های طراحی بر اساس شیوه‌های حمل مسیر</small></header><div class="ld-lash"></div></div><div class="sx-card"><header><b>قیود ویژه و پالت‌سازی</b><small>شکستنی · حداکثر بار روی بسته · کالای خطرناک (DG)</small></header><div class="ld-spc"></div></div></div>
 </section></div>`;
 const imp=$('.ld-imp input',b);imp.onchange=async()=>{const f=imp.files[0];if(!f)return;try{const r=await plImport(f);LOAD.items=r.items;repack();toast(fa(r.items.length)+' قلم از «'+f.name+'» وارد شد · واحد: '+r.unit);emit('packinglist.imported',{file:f.name,items:r.items.length,map:r.map})}catch(e){toast('خطا در ورود: '+e.message)}imp.value=''};
 $('.ld-pdf',b).onclick=()=>loadPlanDoc(LOAD.res,C);$('.ld-csv',b).onclick=()=>LOAD.res&&loadPlanCSV(LOAD.res);const cv=$('.ld-cv canvas',b);let raf=0,hits=[],hover=-1,drag=null,lastT=performance.now(),ex=0,exT=0,vT=null;
 const colorFn=(bx,i)=>{const S=LOAD.res.cons[LOAD.ci];if(LOAD.color==='weight'){const mx=Math.max(...S.P.map(q=>q.kg/(q.l*q.w*q.h)));return toHex(heat((bx.kg/(bx.l*bx.w*bx.h))/mx))}if(LOAD.color==='stop'){const SC=['#72BC8F','#5E9FE8','#E0A84E','#E07FA2','#A98BE0','#4FB9C9','#E97366','#C9B26B','#8FB0D9'];return SC[((bx.stop||1)-1)%SC.length]}if(LOAD.color==='order')return toHex(`hsl(${lerp(210,30,i/Math.max(1,S.P.length-1))} 55% 60%)`);return PAL[bx.ti%PAL.length]};
 const hexC={};function toHex(c){if(hexC[c])return hexC[c];const d=document.createElement('canvas').getContext('2d');d.fillStyle=c;return hexC[c]=d.fillStyle}
 function repack(){LOAD.res=pack(LOAD.items,LOAD.eq);LOAD.ci=Math.min(LOAD.ci,Math.max(0,LOAD.res.cons.length-1));LOAD.prog=0;LOAD.play=true;side();kp();tabs();charts();cmpEq();extra()}
 function side(){$('.ld-eqs',b).innerHTML=Object.entries(EQ).map(([k,e])=>`<button class="ld-eq${k===LOAD.eq?' on':''}" data-k="${k}"><b>${k}</b><small>${e.n}</small><em>${fa((e.L/100).toFixed(2))}×${fa((e.W/100).toFixed(2))}×${fa((e.H/100).toFixed(2))} m · ${nf(e.kg/1000,1)} t</em></button>`).join('');
  $$('.ld-eq',b).forEach(x=>x.onclick=()=>{LOAD.eq=x.dataset.k;repack()});
  $('.ld-items',b).innerHTML=`<div class="ld-ih"><span></span><span>نام</span><span>طول</span><span>عرض</span><span>ارتفاع</span><span>kg</span><span>تعداد</span><span title="ترتیب تخلیه / مقصد">توقف</span><span title="قابل چیدن روی هم">⇡</span><span title="چرخش">⟲</span><span></span></div>`+LOAD.items.map((it,i)=>`<div class="ld-it" data-i="${i}"><i style="background:${PAL[i%PAL.length]}"></i><input data-f="n" value="${esc(it.n)}"><input data-f="L" type="number" value="${it.L}"><input data-f="W" type="number" value="${it.W}"><input data-f="H" type="number" value="${it.H}"><input data-f="kg" type="number" value="${it.kg}"><input data-f="q" type="number" value="${it.q}"><input data-f="stop" type="number" min="1" max="9" value="${it.stop||1}" title="ترتیب تخلیه (۱ = اولین مقصد، نزدیک درب)"><input data-f="stack" type="checkbox"${it.stack?' checked':''}><input data-f="rot" type="checkbox"${it.rot?' checked':''}><button data-del="${i}" title="حذف">${svgI(IC.trash)}</button></div>`).join('');
  $$('.ld-it input',b).forEach(inp=>inp.onchange=()=>{const it=LOAD.items[+inp.closest('.ld-it').dataset.i];const f=inp.dataset.f;it[f]=inp.type==='checkbox'?inp.checked:f==='n'?inp.value:Math.max(1,+inp.value||1);repack()});
  $$('[data-del]',b).forEach(x=>x.onclick=()=>{LOAD.items.splice(+x.dataset.del,1);if(!LOAD.items.length)LOAD.items=defItems(C);repack()})}
 $$('.ld-pre button',b).forEach(x=>x.onclick=()=>{LOAD.items.push({...PRESETS[+x.dataset.p]});repack()});
 $('.ld-reset',b).onclick=()=>{LOAD.items=defItems(C);repack()};
 function tabs(){const R=LOAD.res;$('.ld-ctab',b).innerHTML=R.cons.map((c,i)=>`<button data-i="${i}"${i===LOAD.ci?' class="on"':''}>${LOAD.eq} #${fa(i+1)} <small>${nf(c.vol*100)}٪</small></button>`).join('')+(R.unplaced?`<span class="ld-warn">${fa(R.unplaced)} بسته جا نشد</span>`:'');
  $$('.ld-ctab button',b).forEach(x=>x.onclick=()=>{LOAD.ci=+x.dataset.i;LOAD.prog=0;LOAD.play=true;tabs();kp();charts();extra()})}
 function kp(){const R=LOAD.res,S=R.cons[LOAD.ci];if(!S){$('.ld-kpis',b).innerHTML='<div class="sx-empty">هیچ بسته‌ای در این تجهیز جا نمی‌شود (ابعاد را بررسی کنید).</div>';return}const placed=sum(R.cons.map(c=>c.P.length));
  $('.ld-kpis',b).innerHTML=kpi('تعداد '+(R.E.road?'تریلی':'کانتینر'),R.cons.length,{sub:fa(placed)+' از '+fa(R.total)+' بسته'+(C.R&&C.R.d?' · برآورد حجمی موتور: '+fa(C.R.d.units)+'×':''),cls:C.R&&C.R.d&&R.cons.length>C.R.d.units?'bad':''})+kpi('پرشدگی حجمی',S.vol*100,{d:1,suf:'٪',sub:nf(S.V/1e6,1)+' از '+nf(R.E.L*R.E.W*R.E.H/1e6,1)+' m³',cls:S.vol>.8?'good':''})+kpi('بهره‌وری وزنی',S.wt*100,{d:1,suf:'٪',sub:nf(S.M)+' از '+nf(R.E.kg)+' kg',cls:S.wt>.98?'bad':''})
   +kpi('انحراف طولی مرکز ثقل',S.off*100,{d:1,suf:'٪',sub:Math.abs(S.off)<=.1?'داخل محدودهٔ ایمن ±۱۰٪':'خارج از محدوده — بار را جابه‌جا کنید',cls:Math.abs(S.off)<=.1?'good':'bad'})+(new Set(S.P.map(x=>x.stop||1)).size>1?(()=>{const bl=blocked(S);return kpi('دسترسی تخلیه (چندمقصدی)',bl,{suf:' مانع',sub:bl?'بسته‌های مقصد بعدی جلوی مقصد زودتر':'ترتیب تخلیه درست است · '+fa(new Set(S.P.map(x=>x.stop||1)).size)+' مقصد',cls:bl?'bad':'good'})})():kpi('متر بارگیری (LDM)',S.ldm,{d:2,sub:'طول اشغال‌شده '+nf(S.maxX/100,2)+' m'}))+kpi('بیشینهٔ بار کف',S.floor,{suf:' kg/m²',sub:'سقف معمول کف ~۴٬۵۰۰',cls:S.floor>4500?'bad':''});countUp($('.ld-kpis',b))}
 function charts(){const S=LOAD.res.cons[LOAD.ci];if(!S)return;const mx=Math.max(...S.dist,1);
  $('.ld-dist',b).innerHTML=`<div class="ld-db">${S.dist.map((v,i)=>`<i style="height:${v/mx*100}%;--d:${i*12}ms" title="${fa(i*50)}–${fa(i*50+50)} cm: ${nf(v)} kg"></i>`).join('')}<em style="right:${(1-S.cg[0]/LOAD.res.E.L)*100}%"></em></div><div class="ld-dax"><span>جلو</span><span>مرکز ثقل ${nf(S.cg[0]/100,2)} m</span><span>درب</span></div>`;
  const E=LOAD.res.E,gross=S.M+E.tare;const tr=E.road?{tare:15000,lim:40000}:{tare:15500,lim:40000};const tot=gross+tr.tare;
  const fr=S.front/(S.M||1),ok=fr>.25&&fr<.75;
  $('.ld-axle',b).innerHTML=`<div class="ld-ax"><span>محور جلو / کینگ‌پین</span><div><i style="width:${fr*100}%"></i></div><b>${nf(S.front)} kg</b></div><div class="ld-ax"><span>محورهای عقب</span><div><i style="width:${(1-fr)*100}%"></i></div><b>${nf(S.rear)} kg</b></div>
  <div class="ld-ax ${tot>tr.lim?'bad':''}"><span>وزن ناخالص جاده‌ای</span><div><i style="width:${clamp(tot/tr.lim,0,1)*100}%"></i></div><b>${nf(tot/1000,1)} / ${fa(40)} t</b></div>
  <ul class="ld-chk"><li class="${ok?'ok':'bad'}">${ok?'✓':'⚠'} تقسیم بار بین محورها ${ok?'متعادل است':'نامتعادل است'}</li><li class="${Math.abs(S.offY)<.05?'ok':'bad'}">${Math.abs(S.offY)<.05?'✓':'⚠'} انحراف عرضی ${nf(S.offY*100,1)}٪</li><li class="${S.wt<=1?'ok':'bad'}">${S.wt<=1?'✓':'⚠'} وزن در محدودهٔ ظرفیت ${LOAD.eq}</li><li class="${tot<=tr.lim?'ok':'bad'}">${tot<=tr.lim?'✓':'⚠'} وزن ناخالص با کشنده ${nf(tot/1000,1)} تن ${tot<=tr.lim?'(مجاز در ایران/TIR)':'— بیش از سقف ۴۰ تن'}</li><li class="${S.cg[2]<E.H*.5?'ok':'bad'}">${S.cg[2]<E.H*.5?'✓':'⚠'} ارتفاع مرکز ثقل ${nf(S.cg[2]/100,2)} m</li></ul>`}
 function extra(){const S=LOAD.res.cons[LOAD.ci];try{lashCard($('.ld-lash',b),S,LOAD.res.E,ctx())}catch(e){console.error(e)}try{spcCard($('.ld-spc',b),repack)}catch(e){console.error(e)}}
 function cmpEq(){const C2=ctx();const R=C2.R;const rows=Object.keys(EQ).map(k=>{const r=pack(LOAD.items,k,30);let cost=null;if(R){const e=EQ[k];const cg={...C2.cargo,containerType:e.eng};const x=yr(R.legs.map(l=>({edge:l.edge,from:l.from,to:l.to})),cg);if(x&&x.d&&x.d.units){cost=x.total/x.d.units*r.cons.length*(e.mult||1)}}
   return {k,r,cost,vol:avg(r.cons.map(c=>c.vol)),wt:avg(r.cons.map(c=>c.wt))}}).filter(x=>x.r.cons.length);
  const ok=rows.filter(x=>!x.r.unplaced&&x.cost);const best=ok.length?ok.reduce((a,c)=>c.cost<a.cost?c:a):null;
  $('.ld-cmp',b).innerHTML=`<table class="sx-t"><thead><tr><th>تجهیز</th><th>تعداد</th><th>پرشدگی حجمی</th><th>بهره‌وری وزنی</th><th>جا نشده</th><th>برآورد هزینهٔ مسیر</th><th></th></tr></thead><tbody>${rows.map((x,i)=>`<tr class="${x.k===LOAD.eq?'on':''}" style="--d:${i*40}ms"><td><b>${x.k}</b> <small>${EQ[x.k].n}</small></td><td>${fa(x.r.cons.length)}</td><td><span class="sx-mb"><i style="width:${x.vol*100}%"></i></span>${nf(x.vol*100)}٪</td><td><span class="sx-mb w"><i style="width:${Math.min(100,x.wt*100)}%"></i></span>${nf(x.wt*100)}٪</td><td>${x.r.unplaced?'<b class="bad">'+fa(x.r.unplaced)+'</b>':'—'}</td><td>${x.cost?usd(x.cost):'—'}${best&&best.k===x.k?' <u class="best">بهینه</u>':''}</td><td><button class="sx-btn sm" data-k="${x.k}">انتخاب</button></td></tr>`).join('')}</tbody></table><p class="sx-note">برآورد هزینه با موتور اطلس برای مسیر انتخاب‌شده (${esc(R?R.name:'—')}) و تعداد واحدهای حاصل از همین چیدمان محاسبه شده است؛ ۴۵ فوت با ضریب ۱٫۱۲ نسبت به ۴۰HC.</p>`;
  $$('.ld-cmp [data-k]',b).forEach(x=>x.onclick=()=>{LOAD.eq=x.dataset.k;repack()})}
 /* camera & interaction */
 const views={'3d':[-.62,.48],top:[0,1.5],side:[0,.05],door:[-Math.PI/2+.0001,.12]};
 $$('.ld-views button',b).forEach(x=>x.onclick=()=>{$$('.ld-views button',b).forEach(y=>y.classList.toggle('on',y===x));vT={from:[LOAD.yaw,LOAD.pitch],to:views[x.dataset.v],t0:performance.now()}});
 $$('.ld-col button',b).forEach(x=>x.onclick=()=>{$$('.ld-col button',b).forEach(y=>y.classList.toggle('on',y===x));LOAD.color=x.dataset.v});
 $$('.ld-sp button',b).forEach(x=>x.onclick=()=>{$$('.ld-sp button',b).forEach(y=>y.classList.toggle('on',y===x));LOAD.speed=+x.dataset.v});
 $('.ld-ex',b).onclick=e=>{exT=exT?0:1;e.currentTarget.classList.toggle('on',!!exT)};
 const pp=$('.ld-pp',b),scr=$('.ld-scr',b);pp.onclick=()=>{const S=LOAD.res.cons[LOAD.ci];if(!S)return;if(LOAD.prog>=S.P.length)LOAD.prog=0;LOAD.play=!LOAD.play};
 scr.oninput=()=>{const S=LOAD.res.cons[LOAD.ci];LOAD.play=false;LOAD.prog=scr.value/1000*S.P.length};
 cv.onpointerdown=e=>{drag={x:e.clientX,y:e.clientY,yaw:LOAD.yaw,p:LOAD.pitch};cv.setPointerCapture(e.pointerId);vT=null};
 cv.onpointermove=e=>{if(drag){LOAD.yaw=drag.yaw+(e.clientX-drag.x)*.008;LOAD.pitch=clamp(drag.p+(e.clientY-drag.y)*.006,-.1,1.52);return}
  const r=cv.getBoundingClientRect(),p=[e.clientX-r.left,e.clientY-r.top];let hv=-1;for(let i=hits.length-1;i>=0;i--){if(pip(p,hits[i].pr)){hv=hits[i].i;break}}hover=hv;
  if(hv>=0){const S=LOAD.res.cons[LOAD.ci],q=S.P[hv];showTip(e,`<b>${esc(q.n)}</b> · بستهٔ ${fa(hv+1)}<br>${fa(q.l)}×${fa(q.w)}×${fa(q.h)} cm · ${nf(q.kg)} kg<br><small>موقعیت x ${fa(Math.round(q.x))} · y ${fa(Math.round(q.y))} · z ${fa(Math.round(q.z))} · ${q.stack?'قابل چیدن':'غیرقابل چیدن'}</small>`)}else hideTip()};
 cv.onpointerup=()=>{drag=null};cv.onpointerleave=()=>{hover=-1;hideTip()};
 cv.onwheel=e=>{e.preventDefault();LOAD.zoom=clamp(LOAD.zoom*(e.deltaY<0?1.1:.9),.5,3.2)};cv.ondblclick=()=>{LOAD.zoom=1;vT={from:[LOAD.yaw,LOAD.pitch],to:views['3d'],t0:performance.now()}};
 const loop=now=>{const dt=Math.min(.05,(now-lastT)/1000);lastT=now;const R=LOAD.res,S=R&&R.cons[LOAD.ci];
  if(vT){const t=clamp((now-vT.t0)/650,0,1),e=easeIO(t);LOAD.yaw=lerp(vT.from[0],vT.to[0],e);LOAD.pitch=lerp(vT.from[1],vT.to[1],e);if(t>=1)vT=null}
  ex=lerp(ex,exT,.12);
  if(S){if(LOAD.play){LOAD.prog=Math.min(S.P.length,LOAD.prog+dt*LOAD.speed*Math.max(4,S.P.length/5));if(LOAD.prog>=S.P.length)LOAD.play=false}
   scr.value=LOAD.prog/S.P.length*1000;$('.ld-cnt',b).textContent=fa(Math.floor(LOAD.prog))+' / '+fa(S.P.length)+' بسته';pp.innerHTML=svgI(LOAD.play?IC.pause:IC.play);
   const {g,w,h}=canvasFit(cv);hits=scene(g,w,h,R,{P:S.P,yaw:LOAD.yaw,pitch:LOAD.pitch,zoom:LOAD.zoom,prog:LOAD.prog,colorFn,hover,cg:LOAD.prog>=S.P.length?S.cg:null,ex})}
  raf=requestAnimationFrame(loop)};
 onClose(()=>{cancelAnimationFrame(raf);hideTip()});
 repack();raf=requestAnimationFrame(loop)}
/* ---------- mini preview inside the cargo panel ---------- */
(function mini(){let el=null,cv=null,res=null,key='',yaw=-.62,t0=performance.now();
 function ensure(){if(el)return;el=document.createElement('button');el.className='sx-mini';el.title='استودیوی چیدمان کانتینر · L';el.innerHTML='<canvas></canvas><span>چیدمان سه‌بعدی ↗</span>';document.body.appendChild(el);cv=$('canvas',el);el.onclick=()=>open('load')}
 function tick(){requestAnimationFrame(tick);const svg=$('.live svg[aria-label]');const C=ctx();if(!svg||!C||document.hidden){if(el)el.style.display='none';return}
  const r=svg.getBoundingClientRect();const pn=svg.closest('.panel')||document.body;const pr=pn.getBoundingClientRect();
  if(r.width<20||r.top<pr.top+4||r.bottom>pr.bottom-4||wrap||getComputedStyle(pn).visibility==='hidden'||document.body.classList.contains('fx-focus')||document.body.classList.contains('fx-noright')){if(el)el.style.display='none';return}
  ensure();el.style.display='block';el.style.transform=`translate(${r.left}px,${r.top}px)`;el.style.width=r.width+'px';el.style.height=r.height+'px';svg.style.opacity='0';
  const k=JSON.stringify([C.cargo.L,C.cargo.W,C.cargo.H,C.cargo.packages,C.cargo.weightKg,C.cargo.cbm,C.cargo.containerType,C.cargo.dimMode]);
  if(k!==key){key=k;const eq=ENG2EQ[C.cargo.containerType]||'40HC';res=pack(defItems(C),eq,1);t0=performance.now()}
  const S=res.cons[0];const {g,w,h}=canvasFit(cv);const t=(performance.now()-t0)/1000;yaw=-.62+Math.sin(t*.35)*.35;
  scene(g,w,h,res,{P:S?S.P:[],yaw,pitch:.5,zoom:1.05,prog:S?Math.min(S.P.length,t*Math.max(6,S.P.length/2)):0,colorFn:(bx)=>PAL[0],mini:1})}
 requestAnimationFrame(tick)})();

/* ===== Intel / data-lake studio ===== */
const INT={tab:'over',wb:'atlas',sh:null,q:'',sort:null,dir:1,cty:null,xq:'',xsel:null,cq:'',lim:200};
const enFa=c=>{const k=Object.keys(ISO).find(k=>ISO[k][0].toLowerCase()===String(c).toLowerCase());return k?ISO[k][1]:c};
function rIntel(b,C){const T=[['over','نمای کلی'],['cty','کشورها'],['net','ارتقای شبکهٔ مسیر'],['xing','گذرگاه‌های مرزی'],['cor','کریدورها و فصل'],['co','شرکت‌ها'],['raw','مرورگر داده']];
 b.innerHTML=`<div class="in"><nav class="in-tabs">${T.map(([k,n])=>`<button data-t="${k}"${k===INT.tab?' class="on"':''}>${n}</button>`).join('')}<span class="sx-sp"></span><label class="in-gs">${svgI(IC.search)}<input placeholder="جستجو در همهٔ ${fa(DS.meta.reduce((a,w)=>a+w.sheets,0))} برگه…" value="${esc(INT.gq||'')}"></label></nav><div class="in-body"></div></div>`;
 $$('.in-tabs [data-t]',b).forEach(x=>x.onclick=()=>{INT.tab=x.dataset.t;rIntel(b,C)});
 const gs=$('.in-gs input',b);let gt=0;gs.oninput=()=>{clearTimeout(gt);gt=setTimeout(()=>{INT.gq=gs.value;if(gs.value.trim().length>1){INT.tab='gsearch';$$('.in-tabs [data-t]',b).forEach(x=>x.classList.remove('on'))}gsearch()},250)};
 const B=$('.in-body',b);
 const route=new Set(C.R?C.R.countries:[]);
 function over(){const M=DS.meta;const R=C.R;const fam=R?family(R):null;const se=R?season(fam,new Date().getMonth()+1):null;
  const rx=R?R.nodeSeq.map(id=>C.G.nodeById[id]).filter(n=>n&&n.type==='border'):[];
  B.innerHTML=`<div class="in-cov">${M.map((w,i)=>`<div class="sx-card in-wb" style="--d:${i*50}ms"><small>${esc(w.file)}</small><b>${esc(w.name)}</b><div><span><em data-cu="${w.sheets}">${fa(w.sheets)}</em> برگه</span><span><em data-cu="${w.rows}">${nf(w.rows)}</em> ردیف</span></div></div>`).join('')}</div>
  <div class="in-g2"><div class="sx-card"><header><b>اثر داده‌ها روی مسیر فعلی</b><small>${esc(R?R.name:'')}</small></header>${R?`<ul class="op-adj"><li><span>کریدور داده‌ای</span><b>${esc(fam.n)}</b></li><li><span>بهره‌برداری فصلی ظرفیت</span><b>${se?nf(se.u*100)+'٪ · '+esc(se.q):'—'}</b></li><li><span>سورشارژ فصلی</span><b>${se?esc(se.surT):'—'}</b></li><li><span>زمان رزرو پیشنهادی</span><b>${se?esc(se.lead):'—'}</b></li><li><span>شاخص ریسک کریدور</span><b>${nf(famRiskIdx(fam)*100)}</b></li><li><span>ریسک میانگین کشورها</span><b>${nf(avg(R.countries.filter(c=>c!=='IR').map(cRisk))*100)}</b></li>${rx.map(n=>{const x=crossFor(n);return `<li><span>${esc(n.nameFa)}</span><b>${x?`ترخیص ${x.clr!=null?nf(x.clr)+' ساعت':'—'} · ${esc(String(x.hs||'').slice(0,20))}`:'بدون تطبیق'}</b></li>`}).join('')}</ul>${se&&se.mit?`<p class="sx-note">راهکار فصلی: ${esc(se.mit)}</p>`:''}`:'<div class="sx-empty">مسیری انتخاب نشده</div>'}</div>
  <div class="sx-card"><header><b>کشورهای مسیر · امتیاز راهبردی</b></header><div class="in-rc">${(R?R.countries:[]).map(c=>{const s=strat(c);return `<button data-c="${c}"><b>${esc(cfa(c))}</b>${s?radar(s,64):'<small>—</small>'}<small>${s?'رتبهٔ '+fa(s.rank)+' · تجارت $'+nf(s.trade||0,1)+'B':'بدون امتیاز'}</small></button>`}).join('')}</div></div></div>
  <div class="sx-card"><header><b>جریان تجاری کشورها به ایران</b><small>جریان_تجاری_به_ایران</small></header>${tbl(DS.flow.cols,DS.flow.rows,30)}</div>`;countUp(B);
  $$('.in-rc [data-c]',B).forEach(x=>x.onclick=()=>{INT.tab='cty';INT.cty=(ISO[x.dataset.c]||[x.dataset.c])[0];rIntel(b,C)})}
 function radar(s,S=150){const ax=[['sanc','تحریم'],['transit','ترانزیت'],['pay','پرداخت'],['comp','مکمل'],['stab','ثبات'],['fta','FTA']];const c=S/2,r=S/2-(S>100?22:6);
  const P=(i,v)=>{const a=-Math.PI/2+i/ax.length*Math.PI*2;return [c+Math.cos(a)*r*v,c+Math.sin(a)*r*v]};
  return `<svg class="in-rad" viewBox="0 0 ${S} ${S}" width="${S}" height="${S}">${[.33,.66,1].map(k=>`<polygon points="${ax.map((_,i)=>P(i,k).join(',')).join(' ')}"/>`).join('')}${ax.map((a,i)=>`<line x1="${c}" y1="${c}" x2="${P(i,1)[0]}" y2="${P(i,1)[1]}"/>${S>100?`<text x="${P(i,1.18)[0]}" y="${P(i,1.18)[1]+3}" text-anchor="middle">${a[1]}</text>`:''}`).join('')}<polygon class="v" points="${ax.map((a,i)=>P(i,(s[a[0]]||0)/10).join(',')).join(' ')}"/></svg>`}
 function tbl(cols,rows,lim=200,hl){return `<div class="sx-tw"><table class="sx-t"><thead><tr>${cols.map((c,i)=>`<th data-i="${i}">${esc(c)}</th>`).join('')}</tr></thead><tbody>${rows.slice(0,lim).map(r=>`<tr>${cols.map((_,i)=>{const v=r[i]??'';const s=String(v);return `<td>${/^https?:\/\//.test(s)?`<a href="${esc(s)}" target="_blank" rel="noopener">${esc(s.replace(/^https?:\/\/(www\.)?/,'').slice(0,28))}</a>`:hl?mark(s,hl):esc(s.length>160?s.slice(0,160)+'…':s)}</td>`}).join('')}</tr>`).join('')}</tbody></table></div>${rows.length>lim?`<p class="sx-note">${fa(lim)} ردیف از ${nf(rows.length)} نمایش داده شد.</p>`:''}`}
 const mark=(s,q)=>{s=s.length>200?s.slice(0,200)+'…':s;const i=s.toLowerCase().indexOf(q.toLowerCase());return i<0?esc(s):esc(s.slice(0,i))+'<mark>'+esc(s.slice(i,i+q.length))+'</mark>'+esc(s.slice(i+q.length))};
 function cty(){if(INT.cty){const k=Object.keys(ISO).find(k=>ISO[k][0].toLowerCase()===String(INT.cty).toLowerCase());if(k)CTYS.sel=k;INT.cty=null}rCty(B,C)}
 function xing(){const X=DS.crossings;const q=INT.xq.toLowerCase();const F=X.filter(x=>!q||[x.n,x.l,x.a,x.b,x.road,x.sheet].join(' ').toLowerCase().includes(q));
  const onR=new Set();if(C.R)C.R.nodeSeq.forEach(id=>{const n=C.G.nodeById[id];if(n&&n.type==='border'){const x=crossFor(n);if(x)onR.add(x)}});
  B.innerHTML=`<div class="in-x"><div class="sx-card in-xm"><header><b>${fa(X.length)} گذرگاه در ${fa(new Set(X.map(x=>x.sheet)).size)} کشور</b><small>رنگ = میانگین زمان ترخیص · حلقهٔ سفید = روی مسیر فعلی</small><span class="sx-sp"></span><label class="in-gs sm">${svgI(IC.search)}<input class="in-xq" placeholder="نام، کشور، جاده…" value="${esc(INT.xq)}"></label></header><canvas></canvas><div class="in-xl"><span><i style="background:hsl(140 55% 55%)"></i>کمتر از ۴ ساعت</span><span><i style="background:hsl(60 60% 55%)"></i>۱۲ ساعت</span><span><i style="background:hsl(0 60% 58%)"></i>۴۸+ ساعت</span><span><i style="background:#777"></i>بدون داده</span></div></div>
   <div class="sx-card in-xd"></div></div><div class="sx-card"><header><b>فهرست گذرگاه‌ها</b><small>${fa(F.length)} مورد</small></header><div class="in-xt"></div></div>`;
  const qi=$('.in-xq',B);qi.oninput=()=>{INT.xq=qi.value;const p=qi.selectionStart;xing();const n=$('.in-xq',B);n.focus();n.setSelectionRange(p,p)};
  const col=x=>x.clr==null?'#777':`hsl(${lerp(140,0,clamp(Math.log(1+x.clr)/Math.log(49),0,1))} 58% 56%)`;
  const cv=$('.in-xm canvas',B);let raf=0;const t0=performance.now();let hv=null;
  const P=(F.length?F:X).filter(x=>x.lat!=null);const a=Math.min(...P.map(x=>x.lon))-2,z=Math.max(...P.map(x=>x.lon))+2,lo=Math.min(...P.map(x=>x.lat))-2,hi=Math.max(...P.map(x=>x.lat))+2,k=Math.cos((lo+hi)/2*Math.PI/180);
  const pj=(w,h)=>{const W=(z-a)*k,H=hi-lo,s=Math.min(w/W,h/H);const ox=(w-W*s)/2,oy=(h-H*s)/2;return (lat,lon)=>[ox+(lon-a)*k*s,oy+(hi-lat)*s]};
  const draw=()=>{const {g,w,h}=canvasFit(cv);const X2=pj(w,h);g.clearRect(0,0,w,h);const t=(performance.now()-t0)/1000;
   g.strokeStyle='rgba(255,255,255,.05)';C.G.edges.forEach(e=>{if(e.mode==='sea'||e.mode==='air')return;g.beginPath();e.pts.forEach((p,i)=>{const [x,y]=X2(p[0],p[1]);i?g.lineTo(x,y):g.moveTo(x,y)});g.stroke()});
   F.forEach((x,i)=>{if(x.lat==null)return;const tt=clamp(t*2.2-i/F.length,0,1);if(tt<=0)return;const [px,py]=X2(x.lat,x.lon);const r=(2+Math.sqrt(x.truck||40)/6)*ease(tt);g.fillStyle=col(x);g.globalAlpha=.8;g.beginPath();g.arc(px,py,Math.min(r,9),0,7);g.fill();g.globalAlpha=1;
    if(onR.has(x)||x===INT.xsel||x===hv){g.strokeStyle='#fff';g.lineWidth=1.5;g.beginPath();g.arc(px,py,Math.min(r,9)+3+(x===INT.xsel?Math.sin(t*4)*1.5:0),0,7);g.stroke()}});raf=requestAnimationFrame(draw)};draw();onClose(()=>cancelAnimationFrame(raf));
  cv.onmousemove=e=>{const r=cv.getBoundingClientRect();const X2=pj(r.width,r.height);let best=null,bd=10;F.forEach(x=>{if(x.lat==null)return;const [px,py]=X2(x.lat,x.lon);const d=Math.hypot(px-(e.clientX-r.left),py-(e.clientY-r.top));if(d<bd){bd=d;best=x}});hv=best;
   best?showTip(e,`<b>${esc(best.n)}</b><br>${esc(best.a)} ↔ ${esc(best.b)} · ${esc(best.t)}<br><small>ترخیص ${best.clr!=null?nf(best.clr)+' ساعت':'—'} · کامیون/روز ${best.truck?nf(best.truck):'—'}</small>`):hideTip()};
  cv.onmouseleave=()=>{hv=null;hideTip()};cv.onclick=()=>{if(hv){INT.xsel=hv;det()}};
  function det(){const x=INT.xsel||[...onR][0]||F[0];if(!x){$('.in-xd',B).innerHTML='';return}const fw=fwdFor([String(x.n).split(/[\s/-]/)[0]]).slice(0,5);
   const row=(k,v)=>v!==''&&v!=null&&!/^n\/?a$/i.test(String(v))?`<dt>${k}</dt><dd>${esc(String(v).slice(0,220))}</dd>`:'';
   $('.in-xd',B).innerHTML=`<header><b>${esc(x.n)}</b><small>${esc(x.l||'')}</small></header><div class="in-xk">${kpi('ترخیص',x.clr||0,{suf:' ساعت'})}${kpi('کامیون/روز',x.truck||0)}${kpi('واگن/روز',x.rail||0)}</div><dl class="in-dl">${row('کشورها',x.a+' ↔ '+x.b)}${row('نوع',x.t)}${row('وضعیت',x.st)}${row('ساعات کار (تابستان)',x.hs)}${row('ساعات کار (زمستان)',x.hw)}${row('سقف بار محور (t)',x.axle)}${row('سقف GVW (t)',x.gvw)}${row('ارتفاع/عرض/طول مجاز (m)',[x.mh,x.mw,x.ml].filter(v=>v!=null).join(' / '))}${row('انبار',x.wh)}${row('سردخانه',x.cold)}${row('کالاهای مجاز',x.perm)}${row('ممنوع/محدود',x.restr)}${row('خدمات گمرکی',x.svc)}${row('جادهٔ / ریل متصل',x.road)}${row('حجم سالانه',x.vol)}${row('ارزش سالانه',x.val)}${row('مرجع',x.auth)}${row('سال افتتاح/ارتقا',x.yr)}</dl>
   <a class="sx-btn sm" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=${x.lat},${x.lon}">${svgI(IC.map)}نقشه</a>${fw.length?`<h5>فورواردرهای فعال</h5><div class="op-fw">${fw.map(f=>`<a href="${/^http/.test(f.web)?esc(f.web):'https://'+esc(f.web)}" target="_blank" rel="noopener"><b>${esc(f.fa||f.en)}</b><small>${esc(f.city)}</small></a>`).join('')}</div>`:''}`}
