const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const NF={};const nf=(n,d=0)=>{const k=d;return (NF[k]||(NF[k]=new Intl.NumberFormat('fa-IR',{maximumFractionDigits:d,minimumFractionDigits:0}))).format(n)};
const fa=n=>String(n).replace(/\d/g,d=>'۰۱۲۳۴۵۶۷۸۹'[d]);
const usd=(n,d=0)=>'$'+nf(Math.round(n*10**d)/10**d,d);
const kusd=n=>Math.abs(n)>=1e6?'$'+nf(n/1e6,2)+'M':Math.abs(n)>=1e4?'$'+nf(n/1e3,1)+'K':usd(n);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));const lerp=(a,b,t)=>a+(b-a)*t;
const ease=t=>1-Math.pow(1-t,3);const easeIO=t=>t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;
const sum=a=>a.reduce((s,x)=>s+x,0);const avg=a=>a.length?sum(a)/a.length:0;
const qtl=(a,q)=>{if(!a.length)return 0;const s=[...a].sort((x,y)=>x-y);const p=(s.length-1)*q,i=Math.floor(p);return s[i]+(s[Math.min(i+1,s.length-1)]-s[i])*(p-i)};
const mid=r=>r?(r[0]+r[1])/2:null;
const svgI=p=>`<svg class="sx-i" viewBox="0 0 24 24">${p}</svg>`;
