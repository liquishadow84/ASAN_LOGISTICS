  B.innerHTML=`<div class="in-coh"><label class="in-gs">${svgI(IC.search)}<input class="in-cq" placeholder="نام، شهر، مرز، مسیر، خدمت…" value="${esc(INT.cq)}"></label><small>${fa(F.length)} فورواردر ایرانی · ${fa(Z.length)} شرکت چینی</small></div>
  <h4 class="in-h">فورواردرهای ایرانی</h4><div class="in-cards">${F.map((f,i)=>`<div class="sx-card in-fc" style="--d:${Math.min(i,24)*25}ms"><b>${esc(f.fa||f.en)}</b><small>${esc(f.en)} · ${esc(f.city)}</small><p>${esc(String(f.svc).slice(0,90))}</p><dl><dt>مسیرها</dt><dd>${esc(String(f.routes).slice(0,90))}</dd><dt>مرزها</dt><dd>${esc(String(f.borders).slice(0,70))}</dd><dt>حجم</dt><dd>${esc(f.vol||'—')}</dd><dt>گواهی</dt><dd>${esc(f.cert||'—')}</dd></dl><div class="in-lk">${link(f.web)}${f.tel?`<a href="tel:${esc(String(f.tel).replace(/[^\d+]/g,''))}" dir="ltr">${esc(f.tel)}</a>`:''}${f.mail&&/@/.test(f.mail)?`<a href="mailto:${esc(f.mail)}">${esc(f.mail)}</a>`:''}</div></div>`).join('')}</div>
  <h4 class="in-h">شرکت‌های لجستیک چینی <small>وضعیت تحریمی طبق فایل — پیش از همکاری غربالگری کنید</small></h4><div class="in-cards">${Z.map((f,i)=>`<div class="sx-card in-fc" style="--d:${Math.min(i,24)*25}ms"><b>${esc(f.en)}</b><small>${esc(f.cn)} · ${esc(f.hq)}</small><p>${esc(f.type)}</p><dl><dt>سرویس ایران</dt><dd>${esc(String(f.mode).slice(0,90))}</dd><dt>مجوزها</dt><dd>${esc(String(f.lic).slice(0,80))}</dd></dl><span class="in-sanc ${sc(f.sanc)}">${esc(String(f.sanc).slice(0,60))}</span><div class="in-lk">${link(f.web)}${f.tel?`<span dir="ltr">${esc(f.tel)}</span>`:''}${f.mail&&/@/.test(f.mail)?`<a href="mailto:${esc(f.mail)}">${esc(f.mail)}</a>`:''}</div></div>`).join('')}</div>`;
  const qi=$('.in-cq',B);qi.oninput=()=>{INT.cq=qi.value;const p=qi.selectionStart;co();const n=$('.in-cq',B);n.focus();n.setSelectionRange(p,p)}}
 function raw(){B.innerHTML=`<div class="in-raw"><aside class="sx-card in-tree"><div class="sx-empty">در حال باز کردن ${fa(DS.meta.length)} فایل…</div></aside><section class="sx-card in-view"></section></div>`;
  lake().then(LK=>{if(!B.isConnected)return;const tree=$('.in-tree',B);
   tree.innerHTML=LK.map(w=>`<details${w.id===INT.wb?' open':''}><summary><b>${esc(w.name)}</b><small>${esc(w.file)} · ${fa(w.sheets.length)}</small></summary>${w.sheets.map(s=>`<button data-w="${w.id}" data-s="${esc(s.name)}" class="${w.id===INT.wb&&s.name===INT.sh?'on':''}">${esc(s.name)}<small>${nf(s.rows.length)}</small></button>`).join('')}</details>`).join('');
   $$('[data-s]',tree).forEach(x=>x.onclick=()=>{INT.wb=x.dataset.w;INT.sh=x.dataset.s;INT.q='';INT.sort=null;$$('[data-s]',tree).forEach(y=>y.classList.toggle('on',y===x));view2()});
   const W=LK.find(w=>w.id===INT.wb)||LK[0];if(!INT.sh||!W.sheets.find(s=>s.name===INT.sh))INT.sh=W.sheets[0].name;view2();
   function view2(){const W=LK.find(w=>w.id===INT.wb),S=W.sheets.find(s=>s.name===INT.sh);const v=$('.in-view',B);const q=INT.q.toLowerCase();
    let rows=S.rows.filter(r=>!q||r.some(c=>String(c).toLowerCase().includes(q)));if(INT.sort!=null){const i=INT.sort;rows=[...rows].sort((a,b2)=>{const x=a[i],y=b2[i];const nx=parseFloat(String(x).replace(/[,$]/g,'')),ny=parseFloat(String(y).replace(/[,$]/g,''));return (isFinite(nx)&&isFinite(ny)?nx-ny:String(x).localeCompare(String(y),'fa'))*INT.dir})}
    v.innerHTML=`<header><div><b>${esc(S.name)}</b><small>${esc(W.name)}${S.title?' · '+esc(S.title.slice(0,120)):''}</small></div><span class="sx-sp"></span><label class="in-gs sm">${svgI(IC.search)}<input class="in-q" placeholder="فیلتر در این برگه" value="${esc(INT.q)}"></label><small>${nf(rows.length)} ردیف · ${fa(S.cols.length)} ستون</small><button class="sx-btn sm in-csv">${svgI(IC.dl)}CSV</button></header>${tbl(S.cols,rows,INT.lim,q||null)}`;
    $$('th',v).forEach(th=>{const i=+th.dataset.i;if(INT.sort===i)th.classList.add(INT.dir>0?'asc':'desc');th.onclick=()=>{INT.dir=INT.sort===i?-INT.dir:1;INT.sort=i;view2()}});
    const qi=$('.in-q',v);qi.oninput=()=>{INT.q=qi.value;const p=qi.selectionStart;view2();const n=$('.in-q',B);n.focus();n.setSelectionRange(p,p)};
    $('.in-csv',v).onclick=()=>dlFile(S.name+'.csv',[S.cols,...rows].map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(',')).join('\n'))}})}
 function gsearch(){const q=(INT.gq||'').trim().toLowerCase();if(q.length<2){if(INT.tab==='gsearch'){INT.tab='over';rIntel(b,C)}return}
  B.innerHTML='<div class="sx-empty">در حال جستجو…</div>';lake().then(LK=>{const out=[];let n=0;
   LK.forEach(w=>w.sheets.forEach(s=>{const hits=s.rows.filter(r=>r.some(c=>String(c).toLowerCase().includes(q)));if(hits.length){n+=hits.length;out.push({w,s,hits})}}));
   B.innerHTML=`<p class="sx-note">${nf(n)} ردیف در ${fa(out.length)} برگه برای «${esc(INT.gq)}»</p>`+out.sort((a,b2)=>b2.hits.length-a.hits.length).slice(0,25).map(o=>`<details class="in-sec"${out.length<4?' open':''}><summary>${esc(o.s.name)} <small>${esc(o.w.name)} · ${fa(o.hits.length)}</small><button class="sx-btn sm" data-w="${o.w.id}" data-s="${esc(o.s.name)}">باز کردن برگه</button></summary>${tbl(o.s.cols,o.hits,20,INT.gq.trim())}</details>`).join('');
   $$('summary [data-s]',B).forEach(x=>x.onclick=e=>{e.preventDefault();INT.wb=x.dataset.w;INT.sh=x.dataset.s;INT.q=INT.gq.trim();INT.tab='raw';INT.gq='';rIntel(b,C)})})}
 ({over,cty,xing,cor,co,raw,gsearch,net:()=>netUpg(B,C)})[INT.tab]()}

