  $('.in-xt',B).innerHTML=tbl(cols,F.map(x=>[x.n,x.a+' ↔ '+x.b,x.t,x.clr??'',x.truck??'',x.rail??'',x.hs,x.gvw??'',x.st]),250);
  $$('.in-xt tbody tr',B).forEach((tr,i)=>tr.onclick=()=>{INT.xsel=F[i];det();$('.in-xd',B).scrollIntoView({block:'nearest',behavior:'smooth'})})}
 function cor(){const S=DS.seasonal;const cors=[...new Set(S.map(s=>s.cor))];const qs=['Q1','Q2','Q3','Q4'];const fam=C.R?family(C.R):null;
  const cell=(c,q)=>{const r=S.filter(s=>s.cor===c&&s.q.startsWith(q)).sort((a,b2)=>b2.q.localeCompare(a.q))[0];if(r)return r;const h=+q[1]<=2?'H1':'H2';return S.filter(s=>s.cor===c&&s.q.startsWith(h)).sort((a,b2)=>b2.q.localeCompare(a.q))[0]};
  const CR=DS.corridors;const km=Math.max(...CR.map(c=>c.km?c.km[1]:0)),dy=Math.max(...CR.map(c=>c.days?c.days[1]:0));
  B.innerHTML=`<div class="in-g2"><div class="sx-card"><header><b>نقشهٔ حرارتی بهره‌برداری ظرفیت</b><small>Seasonal Capacity · رنگ = بهره‌برداری٪ · عدد = سورشارژ</small></header>
   <div class="in-hm" style="--n:${qs.length}"><span></span>${qs.map(q=>`<b>${q}</b>`).join('')}${cors.map((c,i)=>`<span class="${fam&&fam.seas===c?'rt':''}">${esc(c)}<small>${esc((S.find(s=>s.cor===c)||{}).mode||'')}</small></span>${qs.map((q,j)=>{const r=cell(c,q);const u=r&&r.util?mid(r.util):null;return `<i style="--d:${(i*4+j)*18}ms;background:${u==null?'var(--hover)':`hsl(${lerp(140,0,clamp((u-55)/45,0,1))} 55% ${lerp(30,46,clamp((u-55)/45,0,1))}%)`}" data-c="${esc(c)}" data-q="${q}">${u==null?'—':fa(Math.round(u))+'٪'}<small>${r&&r.sur?(r.sur>0?'+':'')+nf(r.sur,1)+'٪':''}</small></i>`}).join('')}`).join('')}</div><div class="in-hd sx-note">روی یک خانه بروید تا جزئیات (گلوگاه، زمان رزرو، راهکار) نمایش داده شود.</div></div>
   <div class="sx-card"><header><b>کریدورهای چین ← ایران</b><small>${fa(CR.length)} کریدور · مسافت و زمان</small></header><div class="in-cors">${CR.map((c,i)=>`<div class="in-co" style="--d:${i*30}ms"><b>${esc(String(c.n).replace(/\s*\(.*$/,''))}</b><small>${esc(c.hub)} → ${esc(c.exit)} → ${esc(c.transit)} → ${esc(c.entry)} · ${esc(c.mode)}</small><div class="rb"><span>km</span><i><u style="right:${c.km?c.km[0]/km*100:0}%;width:${c.km?Math.max(1,(c.km[1]-c.km[0])/km*100):0}%"></u></i><em dir="ltr">${c.km?nf(c.km[0])+'–'+nf(c.km[1]):'—'}</em></div><div class="rb d"><span>روز</span><i><u style="right:${c.days?c.days[0]/dy*100:0}%;width:${c.days?Math.max(1,(c.days[1]-c.days[0])/dy*100):0}%"></u></i><em dir="ltr">${c.days?nf(c.days[0])+'–'+nf(c.days[1]):'—'}</em></div></div>`).join('')}</div></div></div>
   <div class="sx-card"><header><b>ساختار هزینه و زمان کریدورها</b><small>Cost & Time Breakdown</small></header>${tbl(['کریدور','نوع بار','کرایهٔ پایه','گمرک چین','عوارض ترانزیت','THC','بیمه و پنهان','جمع'],DS.cbreak.map(r=>[r.cor,r.type,...r.raw]),40)}</div>`;
  $$('.in-hm i',B).forEach(el=>el.onmouseenter=()=>{const r=cell(el.dataset.c,el.dataset.q);$('.in-hd',B).innerHTML=r?`<b>${esc(r.cor)} · ${esc(r.q)}</b> — ظرفیت: ${esc(r.cap)} · اوج: ${esc(r.peak)} · کانتینر خالی: ${r.empty?fa(mid(r.empty))+'٪':'—'} · رزرو: ${esc(r.lead)} · گلوگاه: ${esc(r.bott)} · راهکار: ${esc(r.mit)}`:'—'})}
 function co(){const q=INT.cq.toLowerCase();const F=DS.fwd.filter(f=>!q||Object.values(f).join(' ').toLowerCase().includes(q)),Z=DS.cncos.filter(f=>!q||Object.values(f).join(' ').toLowerCase().includes(q));
