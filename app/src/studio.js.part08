';
let CNDD=null,CNDP=null;
const CDS={sub:'ov'};
const CDF={q:'',L:'',v:'',evb:'',irt:'',cor:'',prov:'',city:'',ctry:'',mb:'',st:'',cn:'',xr:'',sf:'',sort:'score',pg:0};
const CDT={city:'',roles:null,corr:true,xs:true,minv:'P',n:5,used:false};
const CDL={V:'راستی‌آزمایی‌شده',P:'نیمه‌راستی‌آزمایی',U:'نامطمئن',X:'طبقه‌بندی‌نشده'};
const CDE={S:'قوی',M:'متوسط',W:'ضعیف',U:'نامشخص'};
const CDI={S:'قوی / تأییدشده',M:'متوسط',W:'ضعیف',I:'استنباطی',O:'توصیفی',N:'یافت نشد',U:'نامشخص'};
const CDST={F:'ثبت NVOCC انجام‌شده (已备案)',A:'فعال',P:'درخواست ثبت داده، ثبت‌نشده',N:'بدون درخواست ثبت (未申请备案)',R:'لغو / ابطال',O:'سایر',U:'نامشخص'};
const CDM={sea:'دریایی',road:'جاده‌ای',rail:'ریلی',air:'هوایی',wh:'انبار/CFS',port:'بندر/پایانه',river:'رودخانه‌ای/فیدر',exp:'اکسپرس',multi:'چندوجهی'};
const CDCF={Shanghai:'شانگهای',Shenzhen:'شنژن',Beijing:'پکن',Qingdao:'چینگدائو',Guangzhou:'گوانگژو',Tianjin:'تیانجین',Ningbo:'نینگبو',Xiamen:'شیامن','Hong Kong':'هنگ‌کنگ',Dalian:'دالیان',Hangzhou:'هانگژو',Tehran:'تهران',Nanjing:'نانجینگ',Chongqing:'چونگ‌چینگ',Chengdu:'چنگدو',Foshan:'فوشان',"Xi'an":'شی‌آن',Fuzhou:'فوژو',Wuhan:'ووهان',Zhengzhou:'ژنگژو',Urumqi:'ارومچی',Yiwu:'ییوو',Dongguan:'دونگ‌گوان',Zhongshan:'ژونگشان',Changsha:'چانگشا',Shantou:'شانتو',Lianyungang:'لیان‌یون‌گانگ',Suzhou:'سوژو',Zhuhai:'ژوهای',Kunming:'کونمینگ',Quanzhou:'چوانژو',Yantai:'یانتای',Nanning:'نانینگ',Horgos:'خورگوس',Hefei:'هفی',Jinan:'جینان',Weihai:'وی‌های',Putian:'پوتیان',Shijiazhuang:'شیجیاژوانگ',Haikou:'هایکو',Lanzhou:'لانژو',Guiyang:'گوئیانگ',Wuxi:'ووشی',Taicang:'تایتسانگ',Wuhu:'ووهو',Nanchang:'نانچانگ',Harbin:'هاربین',Alashankou:'آلاشانکو',Wenzhou:'ونژو',Nantong:'نانتونگ',Yingkou:'یینگکو',Zhanjiang:'ژانجیانگ',Kashgar:'کاشغر',Manzhouli:'مانژولی',Shenyang:'شنیانگ',Bandar:'بندر',Zhoushan:'ژوشان',Tangshan:'تانگشان',Rizhao:'ریژائو',Erenhot:'ارن‌هوت',Hohhot:'هوهوت',Taiyuan:'تایوان (山西)',Dandong:'داندونگ',Yichang:'ییچانگ',Changzhou:'چانگژو',Yangzhou:'یانگژو'};
const CDROLE=[['FF','فورواردر / هماهنگ‌کنندهٔ حمل'],['RT','حمل جاده‌ای و TIR'],['RR','اپراتور ریلی / قطار بلوک'],['OC','خط کشتیرانی / NVOCC دریایی'],['PT','بندر و پایانه'],['WH','انبار، CFS و بندر خشک'],['CB','کارگزار گمرکی و اظهار'],['IN','بیمه و تأمین مالی تجاری'],['AC','بار هوایی'],['EX','اکسپرس و آخرین‌مایل'],['PL','پلتفرم دیجیتال و رهگیری'],['RG','نهاد ناظر / استاندارد']];
const CDLC={FF:'#5E9FE8',OC:'#4FB9C9',RR:'#A98BE0',RT:'#E0A84E',AC:'#E07FA2',PT:'#72BC8F',WH:'#C9B26B',CB:'#8FB0D9',IN:'#D98F6B',PL:'#9FC5A8',EX:'#E97366',RG:'#B7B4AC'};
const cdSL=()=>LSG('ifa-cnd-sl',[]),cdSLs=v=>{LSS('ifa-cnd-sl',v);emit('china.shortlist',{n:v.length})};
function cndLoad(){if(CNDD)return Promise.resolve(CNDD);if(CNDP)return CNDP;CNDP=(async()=>{const bin=Uint8Array.from(atob(CND_B64),c=>c.charCodeAt(0));const t=await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'))).text();const J=JSON.parse(t);
 const K=J.cols;const E=J.rows.map(r=>{const o={};K.forEach((k,i)=>o[k]=r[i]);return o});const byId={};E.forEach(e=>byId[e.id]=e);
 const PF={};J.prov.forEach(p=>PF[p[0]]=p[1]);const CF={};J.ctry.forEach(p=>CF[p[0]]=p[1]);const LN={};J.lay.forEach(l=>LN[l[0]]={fa:l[1],en:l[2]});
 const back={};E.forEach(e=>e.xid.forEach(x=>{if(byId[x]){(back[x]=back[x]||[]).push(e.id)}}));
 E.forEach(e=>{e.lk=[...new Set([...e.xid.filter(x=>byId[x]),...(back[e.id]||[])])];e.sc=cdScore(e);e.k=(e.id+' '+e.n+' '+e.cn+' '+e.cnraw+' '+e.type+' '+e.role+' '+e.hq+' '+e.city+' '+e.prov+' '+(PF[e.prov]||'')+' '+(CDCF[e.city]||'')+' '+e.own+' '+e.svc).toLowerCase()});
 CNDD={...J,E,byId,PF,CF,LN};return CNDD})();return CNDP}
function cdScore(e){const p={v:{V:35,P:20,U:5}[e.v]||0,ev:{S:20,M:12,W:4,U:0}[e.evb],cn:e.cn?6:0,src:Math.min(3,e.urls.length)*3,st:{F:12,A:10,O:4,U:3,P:2,N:0,R:-30}[e.st]||0,x:(e.xr||e.lk&&e.lk.length)?4:0,det:(e.svc?3:0)+(e.hq?3:0)+(e.own?2:0)};const s=Object.values(p).reduce((a,b)=>a+b,0);e.sp=p;return clamp(Math.round(s/94*100),0,100)}
const cdLay=(L,sm)=>`<span class="cd-lay" style="--c:${CDLC[L]||'#999'}">${L}${sm?'':' · '+esc((CNDD.LN[L]||{}).fa||'')}</span>`;
const cdVB=v=>`<span class="cd-b cd-v${v}" title="وضعیت راستی‌آزمایی (بازطبقه‌بندی فاز ۲.۱)">${CDL[v]}</span>`;
const cdIB=e=>e.irt==='U'?'<span class="cd-mut">—</span>':`<span class="cd-b cd-i${e.irt}" title="ارتباط با ایران (Iran_Relevance): ${esc(e.ir)}">${CDI[e.irt]}</span>`;
const cdLoc=e=>{const c=e.city?(CDCF[e.city]||e.city):'',p=e.prov?(CNDD.PF[e.prov]||e.prov):'';if(e.ctry&&e.ctry!=='CN')return (c?c+'، ':'')+(CNDD.CF[e.ctry]||e.ctry);return c&&p&&c!==p?c+'، '+p:(c||p||'—')};
const cdMods=m=>CNDD.mb.filter((k,i)=>m&(1<<i));
const cdBar=(rows,o={})=>{const mx=Math.max(1,...rows.map(r=>r[1]));return `<div class="cd-bars">${rows.map(r=>`<button class="cd-br ${o.on===r[2]?'on':''}" ${r[2]!=null?`data-f="${esc(o.f||'')}" data-x="${esc(r[2])}"`:'disabled'}><span class="cd-bl">${esc(r[0])}</span><i style="width:${(r[1]/mx*100).toFixed(1)}%;${r[3]?'background:'+r[3]:''}"></i><b>${nf(r[1])}</b></button>`).join('')}</div>`};
const cdWarn=()=>`<div class="cd-warn">${svgI(IC.risk)}<div><b>حساس به زمان — نیازمند راستی‌آزمایی روز.</b> وضعیت تحریم، مرز و گمرک، نرخ، اعتبار مجوز، فعال‌بودن سرویس و ظرفیت، به‌ویژه در محور چین–ایران، واقعیت قطعی نیست و پیش از هر تصمیم عملیاتی باید با منابع روز بررسی شود. «ارتباط با ایران» و «قوت شواهد» دو ستون جدا هستند و نباید با هم یکی گرفته شوند.</div></div>`;
function rCnd(b,C){const dw=$('.cd-dlg');if(dw)dw.remove();if(!CNDD){b.innerHTML=`<div class="sx-empty"><span class="sx-spin"></span><p>بارگذاری پایگاه اکوسیستم لجستیک چین (۶٬۹۸۱ موجودیت در ۱۲ لایه)…</p></div>`;cndLoad().then(()=>{if(b.isConnected&&view==='cnd')rCnd(b,C)}).catch(e=>{b.innerHTML='<div class="sx-empty">خطا در بارگذاری داده: '+esc(e.message)+'</div>'});return}
 subTabs(b,CDS,'sub',[['ov','نمای کلی'],['dir','فهرست و جستجو'],['fit','یابندهٔ شریک برای مسیر'],['cor','کریدور ایران و انطباق'],['net','روابط میان‌لایه‌ای'],['sl','فهرست کوتاه من ('+fa(cdSL().length)+')'],['q','کیفیت داده و روش‌شناسی']],(v,B)=>({ov:cdOv,dir:cdDir,fit:cdFit,cor:cdCor,net:cdNet,sl:cdShort,q:cdQual})[v](B,C))}
function cdGo(f){const w=$('.cd-dlg');if(w)w.remove();Object.assign(CDF,{q:'',L:'',v:'',evb:'',irt:'',cor:'',prov:'',city:'',ctry:'',mb:'',st:'',cn:'',xr:'',sf:'',pg:0,sort:'score'},f||{});CDS.sub='dir';open('cnd')}
function cdCount(arr,fn){const m={};arr.forEach(e=>{const k=fn(e);if(k==null||k==='')return;[].concat(k).forEach(x=>m[x]=(m[x]||0)+1)});return Object.entries(m).sort((a,b)=>b[1]-a[1])}
/* ---- overview ---- */
function cdOv(B){const D=CNDD,E=D.E;const n=E.length,ver=E.filter(e=>e.v==='V').length,cor=E.filter(e=>e.cor).length,cn=E.filter(e=>e.cn).length,xr=E.filter(e=>e.xr).length,sf=E.filter(e=>e.sf).length,ir=E.filter(e=>!'UN'.includes(e.irt)).length;
 const LC=D.lay.map(([k,f,en])=>{const X=E.filter(e=>e.L===k);const vv=X.filter(e=>e.v==='V').length;const mc=cdCount(X,e=>cdMods(e.mb)).slice(0,3).map(x=>CDM[x[0]]).join('، ');const top=X.slice().sort((a,b)=>b.sc-a.sc)[0];return `<button class="cd-lc" data-l="${k}" style="--c:${CDLC[k]}"><header><b>${esc(f)}</b><span>${k}</span></header><strong>${nf(X.length)}</strong><small>${en}</small><div class="cd-lm"><span>راستی‌آزمایی‌شده ${nf(Math.round(vv/X.length*100))}٪</span><span>کریدور ${nf(X.filter(e=>e.cor).length)}</span></div><em>${esc(mc||'—')}</em>${top?`<i title="بالاترین امتیاز اعتبار داده">برتر: ${esc(top.n.slice(0,42))}</i>`:''}</button>`}).join('');
 const PV=cdCount(E.filter(e=>e.prov),e=>e.prov).slice(0,14).map(([k,v])=>[D.PF[k]||k,v,k]);
 const CT=cdCount(E.filter(e=>e.city),e=>e.city).slice(0,14).map(([k,v])=>[CDCF[k]||k,v,k]);
 const ST=Object.keys(CDST).map(k=>[CDST[k],E.filter(e=>e.st===k).length,k,{F:'#72BC8F',A:'#5E9FE8',P:'#E0A84E',N:'#B7B4AC',R:'#E97366',O:'#8FB0D9',U:'#6f6e6a'}[k]]).filter(r=>r[1]);
 const MB=Object.keys(CDM).map(k=>[CDM[k],E.filter(e=>e.mb&(1<<D.mb.indexOf(k))).length,k]).sort((a,b)=>b[1]-a[1]);
 const IT=['S','M','W','I','O','N','U'].map(k=>[CDI[k],E.filter(e=>e.irt===k).length,k,{S:'#E97366',M:'#E0A84E',W:'#C9B26B',I:'#8FB0D9',O:'#A98BE0',N:'#72BC8F',U:'#6f6e6a'}[k]]);
 const FC=cdCount(E.filter(e=>e.ctry&&e.ctry!=='CN'),e=>e.ctry).slice(0,10).map(([k,v])=>[D.CF[k]||k,v,k]);
 B.innerHTML=`${cdWarn()}<div class="ex-kpis">${kpi('موجودیت در پایگاه',n,{sub:'۱۲ لایهٔ زنجیرهٔ لجستیک چین'})}${kpi('راستی‌آزمایی‌شده',ver,{sub:nf(Math.round(ver/n*100))+'٪ · پس از بازطبقه‌بندی'})}${kpi('مجموعهٔ کریدور ایران',cor,{sub:'بازبینی '+fa('۱۴۰۵/۰۶/۳۱')})}${kpi('دارای نام حقوقی چینی',cn,{sub:nf(Math.round(cn/n*100))+'٪ · قابل استعلام در 企查查'})}${kpi('ثبت NVOCC انجام‌شده',E.filter(e=>e.st==='F').length,{sub:'已备案 · وزارت حمل‌ونقل چین'})}${kpi('ارجاع میان‌لایه‌ای',xr,{sub:'شرکت‌های حاضر در چند لایه'})}${kpi('اشاره به تحریم در شواهد',sf,{sub:'نیازمند غربالگری',cls:'warn'})}</div>
 <div class="cd-lcs">${LC}</div>
 <div class="cd-g3"><div class="sx-card"><header><b>استان‌های مقر</b><small>برای فیلتر کلیک کنید</small></header>${cdBar(PV,{f:'prov'})}</div><div class="sx-card"><header><b>شهرهای مقر</b><small>هاب‌های اصلی</small></header>${cdBar(CT,{f:'city'})}</div><div class="sx-card"><header><b>شیوه‌های حمل</b><small>استخراج از توضیح هر موجودیت</small></header>${cdBar(MB,{f:'mb'})}</div>
 <div class="sx-card"><header><b>وضعیت فعالیت / ثبت</b><small>ثبت NVOCC وزارت حمل‌ونقل برای فورواردرها</small></header>${cdBar(ST,{f:'st'})}</div><div class="sx-card"><header><b>ارتباط با ایران (Iran_Relevance)</b><small>جدا از قوت شواهد</small></header>${cdBar(IT,{f:'irt'})}</div><div class="sx-card"><header><b>موجودیت‌های غیرچینی</b><small>شعب و شرکای خارجی در پایگاه</small></header>${cdBar(FC,{f:'ctry'})}</div></div>
 <p class="sx-muted v14-sm">منبع: ${esc(D.meta.src)} · تولید ${esc(D.meta.gen)} · آخرین بازبینی کریدور ${esc(D.meta.corv)}. همهٔ ارقام مستقیماً از فایل شمرده شده‌اند؛ شهر، استان، شیوهٔ حمل و وضعیت از ستون توضیح فارسی استخراج و یکسان‌سازی شده‌اند.</p>`;
 countUp(B);$$('.cd-lc',B).forEach(x=>x.onclick=()=>cdGo({L:x.dataset.l}));$$('.cd-br[data-f]',B).forEach(x=>x.onclick=()=>cdGo({[x.dataset.f]:x.dataset.x}))}
/* ---- directory ---- */
function cdFilter(F){const q=nkey(F.q||'').split(/\s+/).filter(Boolean);const mbi=F.mb?1<<CNDD.mb.indexOf(F.mb):0;
 return CNDD.E.filter(e=>(!F.L||e.L===F.L)&&(!F.v||e.v===F.v)&&(!F.evb||e.evb===F.evb)&&(!F.irt||(F.irt==='any'?!'UN'.includes(e.irt):e.irt===F.irt))&&(!F.cor||e.cor)&&(!F.prov||e.prov===F.prov)&&(!F.city||e.city===F.city)&&(!F.ctry||(F.ctry==='CN'?e.ctry==='CN':F.ctry==='X'?e.ctry&&e.ctry!=='CN':e.ctry===F.ctry))&&(!mbi||e.mb&mbi)&&(!F.st||e.st===F.st)&&(!F.cn||(F.cn==='1'?e.cn:!e.cn))&&(!F.xr||e.xr)&&(!F.sf||(F.sf==='1'?e.sf:!e.sf))&&q.every(w=>e.k.includes(w)))}
const cdSort=(R,s)=>R.sort(s==='name'?(a,b)=>a.n.localeCompare(b.n):s==='id'?(a,b)=>a.id.localeCompare(b.id):s==='ir'?(a,b)=>'SMWIONU'.indexOf(a.irt)-'SMWIONU'.indexOf(b.irt)||b.sc-a.sc:(a,b)=>b.sc-a.sc||a.id.localeCompare(b.id));
function cdDir(B){const D=CNDD;const F=CDF;const opt=(k,L,ph)=>`<select data-f="${k}"><option value="">${ph}</option>${L.map(([a,n])=>`<option value="${esc(a)}" ${String(F[k])===String(a)?'selected':''}>${esc(n)}</option>`).join('')}</select>`;
 const provs=cdCount(D.E.filter(e=>e.prov),e=>e.prov).map(([k,v])=>[k,(D.PF[k]||k)+' ('+fa(v)+')']);const cities=cdCount(D.E.filter(e=>e.city&&(!F.prov||e.prov===F.prov)),e=>e.city).slice(0,120).map(([k,v])=>[k,(CDCF[k]||k)+' ('+fa(v)+')']);
 B.innerHTML=`<div class="sx-card cd-fl"><div class="cd-fr"><label class="cd-q">${svgI(IC.srch)}<input data-f="q" value="${esc(F.q)}" placeholder="نام انگلیسی، چینی یا فارسی، شناسه (FF-0001)، نقش، شهر…"></label>${opt('L',D.lay.map(l=>[l[0],l[0]+' · '+l[1]]),'همهٔ لایه‌ها')}${opt('v',Object.entries(CDL).slice(0,3),'هر وضعیت راستی‌آزمایی')}${opt('evb',Object.entries(CDE),'هر قوت شواهد')}${opt('irt',[['any','هر سیگنال معنادار'],...Object.entries(CDI)],'ارتباط با ایران: همه')}</div>
 <div class="cd-fr">${opt('prov',provs,'همهٔ استان‌ها')}${opt('city',cities,'همهٔ شهرها')}${opt('ctry',[['CN','فقط چین'],['X','فقط خارج از چین'],...D.ctry.map(c=>[c[0],c[1]])],'همهٔ کشورها')}${opt('mb',Object.entries(CDM),'هر شیوهٔ حمل')}${opt('st',Object.entries(CDST),'هر وضعیت فعالیت')}${opt('cn',[['1','دارای نام چینی'],['0','بدون نام چینی']],'نام چینی: مهم نیست')}${opt('sf',[['0','بدون اشارهٔ تحریمی'],['1','دارای اشارهٔ تحریمی']],'تحریم: همه')}<label class="cd-ck"><input type="checkbox" data-f="cor" ${F.cor?'checked':''}>فقط مجموعهٔ کریدور</label><label class="cd-ck"><input type="checkbox" data-f="xr" ${F.xr?'checked':''}>دارای ارجاع میان‌لایه‌ای</label><button class="sx-btn sm cd-rs">پاک‌کردن فیلترها</button></div></div><div class="cd-res"></div>`;
 const res=()=>{const R=cdSort(cdFilter(F),F.sort);const PG=50,pgs=Math.max(1,Math.ceil(R.length/PG));F.pg=Math.min(F.pg,pgs-1);const P=R.slice(F.pg*PG,F.pg*PG+PG);const SL=new Set(cdSL().map(s=>s.id));
  $('.cd-res',B).innerHTML=`<div class="sx-card"><header><b>${nf(R.length)} موجودیت</b><small>${R.length?nf(R.filter(e=>e.v==='V').length)+' راستی‌آزمایی‌شده · '+nf(R.filter(e=>e.cor).length)+' کریدور · '+nf(R.filter(e=>e.sf).length)+' اشارهٔ تحریمی':''}</small><span class="sx-sp"></span><label class="cd-srt">مرتب‌سازی <select class="cd-so">${[['score','امتیاز اعتبار داده'],['ir','ارتباط با ایران'],['name','نام'],['id','شناسه']].map(([a,n])=>`<option value="${a}" ${F.sort===a?'selected':''}>${n}</option>`).join('')}</select></label><button class="sx-btn sm cd-top" ${R.length?'':'disabled'}>افزودن ۱۰ مورد برتر به فهرست کوتاه</button><button class="sx-btn sm cd-csv" ${R.length?'':'disabled'}>${svgI(IC.dl)}خروجی CSV</button></header>
  ${R.length?`<div class="cd-tw"><table class="sx-tbl cd-t"><thead><tr><th>شناسه</th><th>نام</th><th>لایه</th><th>نقش اصلی</th><th>مقر</th><th>شیوه</th><th>راستی‌آزمایی</th><th>شواهد</th><th>ایران</th><th title="امتیاز اعتبار و کامل‌بودن داده (فرض طراحی)">امتیاز</th><th></th></tr></thead><tbody>${P.map(e=>`<tr data-id="${e.id}" class="${e.sf?'cd-sfr':''}"><td class="cd-id">${e.id}</td><td><b>${esc(e.n)}</b>${e.cn?`<small class="cd-cn">${esc(e.cn)}</small>`:''}${e.cor?'<span class="cd-cor" title="عضو مجموعهٔ کریدور چین–ایران">کریدور</span>':''}${e.sf?'<span class="cd-sf" title="در شواهد یا یادداشت‌ها به تحریم/OFAC اشاره شده است">⚠ تحریم</span>':''}</td><td>${cdLay(e.L,1)}</td><td class="cd-rl">${esc(e.role.slice(0,60))}</td><td>${esc(cdLoc(e))}</td><td class="cd-md">${cdMods(e.mb).map(m=>CDM[m]).join('، ')||'—'}</td><td>${cdVB(e.v)}</td><td><span class="cd-e cd-e${e.evb}" title="${esc(e.ev)}">${CDE[e.evb]}</span></td><td>${cdIB(e)}</td><td><span class="cd-sc" style="--p:${e.sc}">${fa(e.sc)}</span></td><td><button class="cd-star ${SL.has(e.id)?'on':''}" data-s="${e.id}" title="فهرست کوتاه">★</button></td></tr>`).join('')}</tbody></table></div>
  ${pgs>1?`<div class="cd-pg"><button class="sx-btn sm" data-p="${F.pg-1}" ${F.pg?'':'disabled'}>قبلی</button><span>صفحهٔ ${fa(F.pg+1)} از ${fa(pgs)}</span><button class="sx-btn sm" data-p="${F.pg+1}" ${F.pg<pgs-1?'':'disabled'}>بعدی</button></div>`:''}`:'<div class="sx-empty">موردی با این فیلترها پیدا نشد.</div>'}</div>`;
  const RB=$('.cd-res',B);$$('tr[data-id]',RB).forEach(t=>t.onclick=ev=>{if(ev.target.closest('.cd-star'))return;cdDlg(t.dataset.id)});$$('.cd-star',RB).forEach(x=>x.onclick=()=>{cdToggle(x.dataset.s);x.classList.toggle('on')});
  $$('[data-p]',RB).forEach(x=>x.onclick=()=>{F.pg=+x.dataset.p;res();RB.scrollIntoView({block:'start'})});$('.cd-so',RB).onchange=ev=>{F.sort=ev.target.value;F.pg=0;res()};
  const tp=$('.cd-top',RB);if(tp)tp.onclick=()=>{const n=cdAddMany(R.slice(0,10));toast(fa(n)+' مورد به فهرست کوتاه افزوده شد');res()};const cv=$('.cd-csv',RB);if(cv)cv.onclick=()=>cdCsv(R,'china-logistics-directory.csv')};
 let tm=0;$$('[data-f]',B).forEach(x=>{const k=x.dataset.f;const h=()=>{F[k]=x.type==='checkbox'?(x.checked?'1':''):x.value;F.pg=0;if(k==='prov'){F.city='';cdDir(B);return}res()};x.addEventListener(x.tagName==='INPUT'&&x.type!=='checkbox'?'input':'change',()=>{clearTimeout(tm);tm=setTimeout(h,x.type==='text'||!x.type?160:0)})});
 $('.cd-rs',B).onclick=()=>{Object.assign(F,{q:'',L:'',v:'',evb:'',irt:'',cor:'',prov:'',city:'',ctry:'',mb:'',st:'',cn:'',xr:'',sf:'',pg:0});cdDir(B)};res()}
function cdCsv(R,name){const H=['Entity_ID','Layer','Canonical_Name','Chinese_Name','Entity_Type','Primary_Role','HQ','City','Province','Country','Modes','Status','Verification_Reclassified','Verification_Original','Evidence_Strength','Iran_Relevance','Iran_Evidence','Corridor_Flag','Sanctions_Mention','Data_Score','Cross_Layer_Ref','Source_URLs','Notes'];
 const q=v=>'"'+String(v??'').replace(/"/g,'""').replace(/\r?\n/g,' ')+'"';dlFile(name,H.join(',')+'\n'+R.map(e=>[e.id,e.L,e.n,e.cn||e.cnraw,e.type,e.role,e.hq,e.city,e.prov,e.ctry,cdMods(e.mb).join('|'),e.str,e.v,e.v0,e.ev,e.ir,e.ie,e.cor?'Corridor':'',e.sf?'yes':'',e.sc,e.xr,e.urls.join(' '),e.notes].map(q).join(',')).join('\n'))}
/* ---- shortlist ---- */
function cdToggle(id){const L=cdSL();const i=L.findIndex(s=>s.id===id);if(i>=0){L.splice(i,1);toast('از فهرست کوتاه حذف شد')}else{L.push({id,st:'cand',t:Date.now()});toast('به فهرست کوتاه افزوده شد')}cdSLs(L);cdTabCnt()}
function cdAddMany(R){const L=cdSL();const S=new Set(L.map(s=>s.id));let n=0;R.forEach(e=>{if(!S.has(e.id)){L.push({id:e.id,st:'cand',t:Date.now()});n++}});cdSLs(L);cdTabCnt();return n}
function cdTabCnt(){const b=$$('.v14-st button').find(x=>x.dataset.v==='sl');if(b)b.textContent='فهرست کوتاه من ('+fa(cdSL().length)+')'}
/* ---- entity dialog ---- */
function cdDlg(id){const D=CNDD;const e=D&&D.byId[id];if(!e)return;let w=$('.cd-dlg');if(w)w.remove();w=document.createElement('div');w.className='cd-dlg';const SL=new Set(cdSL().map(s=>s.id));
 const F=(l,v)=>v?`<div><small>${l}</small><span>${esc(v)}</span></div>`:'';const ln=e.lk.map(x=>D.byId[x]).filter(Boolean);
 const other=[];try{(DS.cncos||[]).forEach(c=>{const a=nkey(c.en||'').split(/[\s,.()]+/).slice(0,2).join(' ');if(a.length>5&&nkey(e.n).startsWith(a))other.push('شرکت‌های چینی پایگاه اصلی: '+c.en)});(((X11||{}).cn||{}).fleet||{rows:[]}).rows.forEach(r=>{const a=nkey(String(r[0]).split(/[\s/(]+/)[0]);if(a.length>3&&nkey(e.n).startsWith(a))other.push('ناوگان کریدور چین–ایران: '+r[0]+' · '+r[1]+' · ترانزیت ایران '+r[8])})}catch(x){}
 w.innerHTML=`<div class="cd-dp" role="dialog" aria-label="${esc(e.n)}"><header><div><div class="cd-dh">${cdLay(e.L)}<span class="cd-id">${e.id}</span>${e.cor?'<span class="cd-cor">کریدور چین–ایران</span>':''}${e.ts?'<span class="cd-ts">حساس به زمان</span>':''}${e.sf?'<span class="cd-sf">⚠ اشاره به تحریم</span>':''}</div><h3>${esc(e.n)}</h3>${e.cn?`<p class="cd-cn2">${esc(e.cn)}</p>`:e.cnraw?`<p class="cd-mut">نام چینی: ${esc(e.cnraw)}</p>`:''}</div><button class="cd-x" aria-label="بستن">✕</button></header>
 <div class="cd-db"><div class="cd-bd"><div><small>راستی‌آزمایی (بازطبقه‌بندی)</small>${cdVB(e.v)}<em>اصلی: ${CDL[e.v0]}</em></div><div><small>قوت شواهد</small><span class="cd-e cd-e${e.evb}">${CDE[e.evb]}</span><em>${esc(e.ev.slice(0,70))}</em></div><div><small>ارتباط با ایران</small>${cdIB(e)}<em>${esc(e.ir||'—')}</em></div><div><small>امتیاز اعتبار داده</small><span class="cd-sc" style="--p:${e.sc}">${fa(e.sc)}</span><em>${Object.entries({v:'راستی‌آزمایی',ev:'شواهد',cn:'نام چینی',src:'منابع',st:'وضعیت',x:'میان‌لایه',det:'جزئیات'}).map(([k,l])=>l+' '+fa(e.sp[k])).join(' · ')}</em></div></div>
 <section><h4>شرح</h4><p class="cd-fa">${esc(e.fa)}</p></section>
 <section><h4>مشخصات</h4><div class="cd-kv">${F('نوع موجودیت',e.type)}${F('نقش اصلی',e.role)}${F('نقش‌های فرعی',e.sec)}${F('حوزهٔ خدمات',e.svc)}${F('شیوه‌های حمل',cdMods(e.mb).map(m=>CDM[m]).join('، '))}${F('مقر',e.hq)}${F('مکان یکسان‌شده',cdLoc(e)==='—'?'':cdLoc(e))}${F('وضعیت کنونی',e.str)}${F('مالکیت / شرکت مادر',e.own)}${F('روابط مالکیتی',e.rel)}${F('وضعیت بورسی',e.lst)}${F('مقیاس تقریبی',e.scale)}${F('سال تأسیس',e.yr)}${F('وضعیت تفکیک موجودیت',e.res)}</div></section>
 ${e.ie?`<section><h4>شواهد ایران</h4><p>${esc(e.ie)}</p></section>`:''}${e.notes?`<section><h4>یادداشت‌های منبع</h4><p>${esc(e.notes)}</p></section>`:''}
 ${e.xr||ln.length?`<section><h4>ارجاع میان‌لایه‌ای</h4>${e.xr?`<p>${esc(e.xr)}</p>`:''}${ln.length?`<div class="cd-chips">${ln.map(x=>`<button data-go="${x.id}">${cdLay(x.L,1)} ${esc(x.n.slice(0,50))}</button>`).join('')}</div>`:''}</section>`:''}
 ${e.cor?`<section><h4>تازه‌سازی کریدور (${esc(D.meta.corv)})</h4><p>${esc(D.crn[e.crn])}</p></section>`:''}
 <section><h4>مبنای بازطبقه‌بندی</h4><p class="cd-mut">${esc(D.rb[e.rb])}</p></section>
 <section><h4>منابع (${fa(e.urls.length)})</h4><ol class="cd-src">${e.urls.map(u=>`<li><a href="${esc(u)}" target="_blank" rel="noopener noreferrer">${esc(u.replace(/^https?:\/\//,'').slice(0,90))}</a></li>`).join('')}</ol></section>
 ${other.length?`<section><h4>در سایر بخش‌های داشبورد</h4><ul>${other.slice(0,5).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></section>`:''}
 <section><h4>غربالگری زنده با فهرست‌های تحریم</h4><div class="cd-sn"><button class="sx-btn sm cd-snr">${svgI(IC.shield)}بررسی با OFAC / UN / EU</button></div></section></div>
 <footer><button class="sx-btn sm pri cd-sl">${SL.has(e.id)?'حذف از فهرست کوتاه':'★ افزودن به فهرست کوتاه'}</button><button class="sx-btn sm cd-rfq">افزودن به طرف‌های استعلام قیمت</button><button class="sx-btn sm cd-sx">باز کردن در غربالگری تحریم</button><button class="sx-btn sm cd-cp">کپی خلاصه</button>${e.cn?`<a class="sx-btn sm" target="_blank" rel="noopener noreferrer" href="https://www.qcc.com/web/search?key=${encodeURIComponent(e.cn)}">استعلام در 企查查</a>`:''}</footer></div>`;
 document.body.appendChild(w);const cl=()=>w.remove();w.onclick=ev=>{if(ev.target===w)cl()};$('.cd-x',w).onclick=cl;
 $$('[data-go]',w).forEach(x=>x.onclick=()=>cdDlg(x.dataset.go));
 $('.cd-sl',w).onclick=()=>{cdToggle(e.id);cdDlg(e.id)};$('.cd-rfq',w).onclick=()=>{cdRfq([e]);};
 $('.cd-sx',w).onclick=()=>{cl();SNC.q=e.n;SNC.tab='q';open('sanc')};
 $('.cd-cp',w).onclick=()=>{const t=`${e.n}${e.cn?' ('+e.cn+')':''} · ${e.id} · ${(D.LN[e.L]||{}).fa}\n${e.role}\nمقر: ${e.hq||'—'} · راستی‌آزمایی: ${CDL[e.v]} · شواهد: ${CDE[e.evb]} · ارتباط با ایران: ${e.ir||'—'}\nمنبع: ${e.urls[0]||''}`;navigator.clipboard&&navigator.clipboard.writeText(t).then(()=>toast('کپی شد'),()=>toast('کپی ممکن نشد'))};
 $('.cd-snr',w).onclick=()=>{const S=$('.cd-sn',w);S.innerHTML='<span class="sx-spin"></span> در حال بارگذاری فهرست‌ها…';cdScreen([e]).then(r=>{S.innerHTML=cdSnHtml(r[0])}).catch(x=>S.textContent='خطا: '+x.message)}}
window.addEventListener('keydown',e=>{const d=$('.cd-dlg');if(d&&e.key==='Escape'){e.preventDefault();e.stopImmediatePropagation();d.remove()}},true);
async function cdScreen(R){await sxLoad();return R.map(e=>{const h=screen(e.n,{th:.88,lim:3});return {e,h,t:Date.now()}})}
const cdSnHtml=r=>r.h.length?`<div class="cd-snh bad"><b>${fa(r.h.length)} تطبیق احتمالی</b>${r.h.map(h=>`<div>${esc(h.name)} · ${esc(LISTN[h.list]||h.list)} · شباهت ${fa(Math.round(h.score*100))}٪ ${h.programs?'· '+esc(String(h.programs).slice(0,60)):''}</div>`).join('')}<small>تطبیق نام به معنای یکی‌بودن نهاد نیست؛ با شناسه‌ها و نشانی‌ها بررسی و تصمیم را در «غربالگری تحریم» ثبت کنید.</small></div>`:`<div class="cd-snh ok"><b>تطبیقی بالای ۸۸٪ یافت نشد</b><small>بررسی ${new Date(r.t).toLocaleString('fa-IR')} · فهرست‌های داخل برنامه ممکن است به‌روز نباشند.</small></div>`;
function cdRfq(R){const X=LSG('ifa-rfqx',[]);const have=new Set(X.map(p=>nkey(p.en||p.n)));const SL=cdSL();let n=0;R.forEach(e=>{if(have.has(nkey(e.n)))return;const s=SL.find(x=>x.id===e.id)||{};X.push({n:e.n,en:e.n,mail:s.mail||'',x:(CNDD.LN[e.L]||{}).fa+' · '+cdLoc(e),tag:[e.city,e.prov,...cdMods(e.mb)].join(' '),cnd:e.id});n++});LSS('ifa-rfqx',X);
 const P=LSG('ifa-sparties',[]);R.forEach(e=>{if(!P.includes(e.n))P.push(e.n)});LSS('ifa-sparties',P);toast(n?fa(n)+' طرف به استعلام قیمت و غربالگری دسته‌ای افزوده شد':'این طرف‌ها قبلاً افزوده شده‌اند');emit('china.rfq',{n})}
/* ---- partner finder for current route ---- */
function cdRoute(C){try{const S=sources(C);const src=S[C.E.selected]||S[0];if(!src)return null;const R=src.x;const G=C.G;const nm=R.nodeSeq.map(id=>(G.nodeById[id]||{}).nameEn||'');const modes=[...new Set(R.legs.map(l=>l.mode))];
 const cities=[...new Set(CNDD.E.map(e=>e.city).filter(Boolean))];let city='';for(const n of nm){const k=nkey(n);const c=cities.find(c=>c.length>3&&k.includes(nkey(c)));if(c){city=c;break}}return {name:src.name,city,modes,nm}}catch(x){return null}}
function cdFitRun(o){const D=CNDD;const pv=(D.E.find(e=>e.city===o.city)||{}).prov||'';const out={};
 o.roles.forEach(L=>{let X=D.E.filter(e=>e.L===L&&(o.minv==='V'?e.v==='V':o.minv==='P'?e.v!=='U':true)&&e.st!=='R'&&(!o.xs||!e.sf));
  X=X.map(e=>{const why=[];let p=0;if(o.city&&e.city===o.city){p=30;why.push('هم‌شهر مبدأ')}else if(pv&&e.prov===pv){p=18;why.push('هم‌استان')}else if((L==='RT'||L==='RR'||L==='WH')&&e.prov==='Xinjiang'){p=14;why.push('دروازهٔ سین‌کیانگ')}
   let cb=0;if(o.corr){if(e.cor){cb+=6;why.push('کریدور')}if('SM'.includes(e.irt)){cb+=8;why.push('سابقهٔ ایران')}else if('WI'.includes(e.irt)){cb+=5}}
   if(e.st==='F')why.push('ثبت NVOCC');if(e.v==='V')why.push('راستی‌آزمایی‌شده');if(/\btir\b/i.test(e.role+e.type))why.push('مجوز TIR');
   const f=clamp(Math.round(.6*e.sc+p+cb-(e.sf?25:0)),0,100);return {e,f,why}}).sort((a,b)=>b.f-a.f);out[L]={n:X.length,top:X.slice(0,o.n)}});return out}
function cdFit(B,C){const D=CNDD;const rt=cdRoute(C);if(!CDT.used){CDT.used=true;CDT.city=rt&&rt.city||'Shanghai';const m=rt?rt.modes:[];const r=new Set(['FF','CB','IN']);if(!rt||m.includes('sea'))['OC','PT'].forEach(x=>r.add(x));if(!rt||m.includes('rail'))['RR','WH'].forEach(x=>r.add(x));if(!rt||m.includes('road'))r.add('RT');if(m.includes('air'))r.add('AC');CDT.roles=[...r]}
 const cities=cdCount(D.E.filter(e=>e.city&&e.ctry==='CN'),e=>e.city).map(([k,v])=>[k,(CDCF[k]||k)+' ('+fa(v)+')']);
 B.innerHTML=`<div class="sx-card cd-ff"><header><b>نیاز زنجیرهٔ تأمین در چین</b><small>${rt?'مسیر فعلی: '+esc(rt.name)+(rt.city?' · مبدأ چینی: '+esc(CDCF[rt.city]||rt.city):' · مبدأ چینی در این مسیر شناسایی نشد'):'مسیری انتخاب نشده؛ پیش‌فرض شانگهای'}</small></header>
 <div class="cd-fr"><label class="sx-f fw-f"><span>شهر مبدأ / بارگیری</span><select data-t="city">${cities.map(([a,n])=>`<option value="${esc(a)}" ${a===CDT.city?'selected':''}>${esc(n)}</option>`).join('')}</select></label>${fwI('حداقل راستی‌آزمایی','minv',CDT.minv,{opts:[['V','فقط راستی‌آزمایی‌شده'],['P','راستی‌آزمایی‌شده یا نیمه'],['','همه']]})}${fwI('تعداد پیشنهاد در هر نقش','n',CDT.n,{opts:[[3,'۳'],[5,'۵'],[8,'۸'],[12,'۱۲']]})}<label class="cd-ck"><input type="checkbox" data-t="corr" ${CDT.corr?'checked':''}>اولویت با سابقهٔ کریدور ایران</label><label class="cd-ck"><input type="checkbox" data-t="xs" ${CDT.xs?'checked':''}>حذف موارد دارای اشارهٔ تحریمی</label></div>
 <div class="cd-roles">${CDROLE.map(([k,n])=>`<label class="cd-rk ${CDT.roles.includes(k)?'on':''}" style="--c:${CDLC[k]}"><input type="checkbox" data-r="${k}" ${CDT.roles.includes(k)?'checked':''}>${esc(n)}</label>`).join('')}</div></div><div class="cd-fo"></div>`;
 const run=()=>{const R=cdFitRun(CDT);const SL=new Set(cdSL().map(s=>s.id));const all=[];
  $('.cd-fo',B).innerHTML=`<div class="cd-fh"><span>${fa(CDT.roles.length)} نقش · امتیاز تناسب = ۶۰٪ امتیاز اعتبار داده + نزدیکی جغرافیایی (هم‌شهر ۳۰، هم‌استان ۱۸، دروازهٔ سین‌کیانگ ۱۴) + سابقهٔ کریدور (تا ۱۴) − اشارهٔ تحریمی ۲۵ <i>[فرض طراحی]</i></span><span class="sx-sp"></span><button class="sx-btn sm cd-fa">★ افزودن همهٔ پیشنهادها به فهرست کوتاه</button><button class="sx-btn sm cd-fq">ارسال به استعلام قیمت</button></div><div class="cd-fg">${CDROLE.map(x=>x[0]).filter(k=>CDT.roles.includes(k)).map(L=>{const r=R[L];all.push(...r.top.map(x=>x.e));return `<div class="sx-card cd-fc" style="--c:${CDLC[L]}"><header><b>${esc((CDROLE.find(x=>x[0]===L)||[])[1])}</b><small>${nf(r.n)} گزینهٔ واجد شرایط</small></header>${r.top.length?r.top.map((x,i)=>`<div class="cd-fi" data-id="${x.e.id}"><span class="cd-rk2">${fa(i+1)}</span><div><b>${esc(x.e.n)}</b>${x.e.cn?`<small class="cd-cn">${esc(x.e.cn)}</small>`:''}<em>${esc(cdLoc(x.e))} · ${esc(x.e.role.slice(0,48))}</em><div class="cd-why">${x.why.map(w=>`<span>${w}</span>`).join('')}</div></div><span class="cd-sc" style="--p:${clamp(x.f,0,100)}" title="امتیاز تناسب">${fa(x.f)}</span><button class="cd-star ${SL.has(x.e.id)?'on':''}" data-s="${x.e.id}">★</button></div>`).join(''):'<div class="sx-muted v14-sm">گزینه‌ای با این شرایط نیست؛ حداقل راستی‌آزمایی را کاهش دهید.</div>'}<button class="cd-more" data-l="${L}">مشاهدهٔ همه در فهرست</button></div>`}).join('')}</div><p class="sx-muted v14-sm">این فهرست برای شروع شناسایی و تماس است، نه تأیید صلاحیت. ظرفیت، نرخ، مجوز روز و وضعیت تحریم هر طرف را پیش از قرارداد مستقیماً بررسی کنید.</p>`;
  const O=$('.cd-fo',B);$$('.cd-fi',O).forEach(x=>x.onclick=ev=>{if(ev.target.closest('.cd-star'))return;cdDlg(x.dataset.id)});$$('.cd-star',O).forEach(x=>x.onclick=()=>{cdToggle(x.dataset.s);x.classList.toggle('on')});
  $$('.cd-more',O).forEach(x=>x.onclick=()=>cdGo({L:x.dataset.l,city:CDT.city}));$('.cd-fa',O).onclick=()=>toast(fa(cdAddMany(all))+' مورد افزوده شد');$('.cd-fq',O).onclick=()=>cdRfq(all)};
 $$('[data-t]',B).forEach(x=>x.onchange=()=>{CDT[x.dataset.t]=x.type==='checkbox'?x.checked:x.value;run()});$$('.fw-f [data-k]',B).forEach(x=>x.onchange=()=>{CDT[x.dataset.k]=x.dataset.k==='n'?+x.value:x.value;run()});
 $$('[data-r]',B).forEach(x=>x.onchange=()=>{const k=x.dataset.r;CDT.roles=x.checked?[...CDT.roles,k]:CDT.roles.filter(r=>r!==k);x.parentNode.classList.toggle('on',x.checked);run()});run()}
/* ---- corridor & compliance ---- */
function cdClaims(){const R=(CNDD.aux['تازه‌سازی کریدور (B5)']||[]);return R.filter(r=>/^[A-Z]+-[A-Z]+-\d\d$/.test(r[1]||'')).map(r=>({id:r[1],topic:r[2],fa:r[3],conf:r[4],tag:r[5],src:String(r[6]||'').split('\n').map(l=>l.replace(/^-\s*/,'').split(' | ')).filter(x=>x[0]).map(x=>({t:x[0],u:(x.find(y=>/^https?:/.test(y))||''),d:x.slice(2).join(' · ')}))}))}
function cdCor(B){const D=CNDD;const X=D.E.filter(e=>e.cor);const S=D.E.filter(e=>e.sf);const CL=cdClaims();const CF={high:['زیاد','ok'],medium:['متوسط','warn'],low:['کم','bad']};
 const LB=D.lay.map(l=>[l[0]+' · '+l[1],X.filter(e=>e.L===l[0]).length,l[0],CDLC[l[0]]]).filter(r=>r[1]).sort((a,b)=>b[1]-a[1]);const IR=cdCount(X,e=>e.ir||'—').slice(0,10).map(([k,v])=>[k,v]);
 const top=X.filter(e=>'SMW'.includes(e.irt)).sort((a,b)=>'SMW'.indexOf(a.irt)-'SMW'.indexOf(b.irt)||b.sc-a.sc);
 B.innerHTML=`${cdWarn()}<div class="ex-kpis">${kpi('مجموعهٔ کریدور',X.length,{sub:'Corridor_Flag · بازبینی '+D.meta.corv})}${kpi('ارتباط قوی/متوسط',X.filter(e=>'SM'.includes(e.irt)).length,{sub:'طبق ستون Iran_Relevance'})}${kpi('ادعای مستند کریدور',CL.length,{sub:'تحریم، تجارت، ریل، هرمز، بانک'})}${kpi('اشارهٔ تحریمی در کل پایگاه',S.length,{sub:'OFAC، SDN، CISADA و …',cls:'warn'})}</div>
 <div class="sx-card"><header><b>یافته‌های تازه‌سازی کریدور چین–ایران</b><small>هر ادعا با سطح اطمینان، برچسب معرفتی و منابع تاریخ‌دار</small></header><div class="cd-cls">${CL.map(c=>`<article class="cd-cl"><header><span class="cd-cid">${esc(c.id)}</span><span class="cd-cf ${(CF[c.conf]||[])[1]||''}">اطمینان ${(CF[c.conf]||[c.conf])[0]}</span></header><h5>${esc(c.topic)}</h5><p>${esc(c.fa)}</p><small class="cd-tg">${esc(c.tag)}</small><details><summary>منابع (${fa(c.src.length)})</summary><ol>${c.src.map(s=>`<li>${s.u?`<a href="${esc(s.u)}" target="_blank" rel="noopener noreferrer">${esc(s.t)}</a>`:esc(s.t)}${s.d?`<em>${esc(s.d)}</em>`:''}</li>`).join('')}</ol></details>${/IN-0104|Kunlun/.test(c.topic)?'<button class="sx-btn sm" data-go="IN-0104">پروندهٔ Bank of Kunlun</button>':''}</article>`).join('')}</div></div>
 <div class="v16-g2"><div class="sx-card"><header><b>کریدور به تفکیک لایه</b><small>کلیک برای فهرست</small></header>${cdBar(LB,{f:'L'})}</div><div class="sx-card"><header><b>رتبهٔ ارتباط ثبت‌شده در منبع</b><small>مقدار خام Iran_Relevance در مجموعهٔ کریدور</small></header>${cdBar(IR)}</div></div>
 <div class="sx-card"><header><b>بازیگران دارای سابقهٔ مستند ایران</b><small>${fa(top.length)} موجودیت با رتبهٔ قوی، متوسط یا ضعیف</small><span class="sx-sp"></span><button class="sx-btn sm" data-gf="cor">همهٔ مجموعهٔ کریدور در فهرست</button></header><div class="cd-tw"><table class="sx-tbl cd-t"><thead><tr><th>شناسه</th><th>نام</th><th>لایه</th><th>ارتباط با ایران</th><th>شواهد ایران</th></tr></thead><tbody>${top.map(e=>`<tr data-id="${e.id}" class="${e.sf?'cd-sfr':''}"><td class="cd-id">${e.id}</td><td><b>${esc(e.n)}</b>${e.sf?'<span class="cd-sf">⚠ تحریم</span>':''}</td><td>${cdLay(e.L,1)}</td><td>${cdIB(e)}</td><td class="cd-ie">${esc((e.ie||'—').slice(0,220))}</td></tr>`).join('')}</tbody></table></div></div>
 <div class="sx-card"><header><b>پرچم‌های انطباق: اشاره به تحریم در شواهد</b><small>این فهرست از متن منبع استخراج شده و به‌خودی‌خود حکم تحریم نیست</small><span class="sx-sp"></span><button class="sx-btn sm pri cd-bs">${svgI(IC.shield)}غربالگری زنده‌ی ${fa(S.length+X.length)} طرف</button><button class="sx-btn sm" data-gf="sf">مشاهده در فهرست</button></header><div class="cd-bsr"></div><div class="cd-tw cd-tw2"><table class="sx-tbl cd-t"><thead><tr><th>شناسه</th><th>نام</th><th>لایه</th><th>متن مرتبط</th></tr></thead><tbody>${S.map(e=>`<tr data-id="${e.id}"><td class="cd-id">${e.id}</td><td><b>${esc(e.n)}</b></td><td>${cdLay(e.L,1)}</td><td class="cd-ie">${esc(((e.ie+' '+e.notes).match(/[^.;|]*(OFAC|SDN|sanction|تحریم|CISADA|Entity List|designat)[^.;|]*/i)||[''])[0].slice(0,220))}</td></tr>`).join('')}</tbody></table></div></div>`;
 countUp(B);$$('tr[data-id]',B).forEach(t=>t.onclick=()=>cdDlg(t.dataset.id));$$('[data-go]',B).forEach(x=>x.onclick=()=>cdDlg(x.dataset.go));$$('.cd-br[data-f]',B).forEach(x=>x.onclick=()=>cdGo({cor:'1',[x.dataset.f]:x.dataset.x}));
 $$('[data-gf]',B).forEach(x=>x.onclick=()=>cdGo(x.dataset.gf==='cor'?{cor:'1',sort:'ir'}:{sf:'1'}));
 $('.cd-bs',B).onclick=()=>{const O=$('.cd-bsr',B);O.innerHTML='<div class="sx-muted"><span class="sx-spin"></span> بارگذاری فهرست‌ها و غربالگری…</div>';const U=[...new Map([...S,...X].map(e=>[e.id,e])).values()];const t0=performance.now();
  cdScreen(U).then(R=>{const H=R.filter(r=>r.h.length);O.innerHTML=`<div class="cd-snh ${H.length?'bad':'ok'}"><b>${fa(U.length)} طرف در ${fa(Math.round(performance.now()-t0))} میلی‌ثانیه بررسی شد · ${fa(H.length)} تطبیق احتمالی</b>${H.slice(0,40).map(r=>`<div><button class="cd-lnk" data-go="${r.e.id}">${esc(r.e.n)}</button> ↔ ${esc(r.h[0].name)} · ${esc(LISTN[r.h[0].list]||'')} · ${fa(Math.round(r.h[0].score*100))}٪</div>`).join('')}<small>نتیجه‌ها را در بخش «غربالگری تحریم» با تصمیم مستند ثبت کنید.</small></div>`;$$('[data-go]',O).forEach(x=>x.onclick=()=>cdDlg(x.dataset.go));emit('china.screened',{n:U.length,hits:H.length})}).catch(x=>O.textContent='خطا: '+x.message)}}
/* ---- cross-layer network & groups ---- */
function cdNet(B){const D=CNDD;const seen=new Set();const comps=[];D.E.forEach(e=>{if(!e.lk.length||seen.has(e.id))return;const st=[e.id],c=[];seen.add(e.id);while(st.length){const x=st.pop();c.push(x);D.byId[x].lk.forEach(y=>{if(!seen.has(y)&&D.byId[y]){seen.add(y);st.push(y)}})}comps.push(c.map(i=>D.byId[i]))});comps.sort((a,b)=>b.length-a.length);
 const own={};D.E.forEach(e=>{const o=String(e.own||'').split(/ — | - |;|؛/)[0].trim();if(o.length<6||/خصوصی|private|دولتی|نامشخص|independent|unknown|^—|قابل اعمال|state|government|n\/a|بنگاه|عمومی|سمت ایران|متقابل|انجمن|نهاد/i.test(o))return;(own[o]=own[o]||[]).push(e)});const GR=Object.entries(own).filter(([k,v])=>v.length>=2).sort((a,b)=>b[1].length-a[1].length).slice(0,40);
 const XR=D.E.filter(e=>e.xr);
 B.innerHTML=`<div class="ex-kpis">${kpi('ارجاع میان‌لایه‌ای متنی',XR.length,{sub:'Cross_Layer_Ref غیرخالی'})}${kpi('پیوند صریح شناسه‌به‌شناسه',D.E.filter(e=>e.lk.length).length,{sub:fa(comps.length)+' خوشهٔ متصل'})}${kpi('گروه مالکیتی مشترک',GR.length,{sub:'شرکت مادر با ۲ عضو یا بیشتر'})}</div>
 <div class="v16-g2"><div class="sx-card"><header><b>خوشه‌های چندلایه (یک شرکت در چند نقش)</b><small>برای قراردادهای یکپارچه: یک طرف، چند خدمت</small></header><div class="cd-cmp">${comps.slice(0,40).map(c=>`<div class="cd-cm"><div class="cd-cml">${[...new Set(c.map(e=>e.L))].map(l=>cdLay(l,1)).join('')}</div><div class="cd-chips">${c.map(e=>`<button data-go="${e.id}" title="${esc(e.role)}">${e.id} · ${esc(e.n.slice(0,44))}</button>`).join('')}</div></div>`).join('')}</div></div>
 <div class="sx-card"><header><b>گروه‌های مالکیتی</b><small>بر پایهٔ فیلد مالکیت/شرکت مادر</small></header><div class="cd-cmp">${GR.map(([k,v])=>`<details class="cd-gr"><summary><b>${esc(k)}</b><span>${fa(v.length)} عضو · ${[...new Set(v.map(e=>e.L))].map(l=>cdLay(l,1)).join('')}</span></summary><div class="cd-chips">${v.map(e=>`<button data-go="${e.id}">${e.id} · ${esc(e.n.slice(0,44))}</button>`).join('')}</div></details>`).join('')}</div></div></div>
 <div class="sx-card"><header><b>همهٔ ارجاعات میان‌لایه‌ای</b><small>${fa(XR.length)} ردیف</small><span class="sx-sp"></span><label class="cd-q sm">${svgI(IC.srch)}<input class="cd-xq" placeholder="جستجو در ارجاعات…"></label></header><div class="cd-tw cd-tw2"><table class="sx-tbl cd-t"><thead><tr><th>شناسه</th><th>نام</th><th>لایه</th><th>ارجاع</th></tr></thead><tbody class="cd-xb"></tbody></table></div></div>`;
 const xb=q=>{q=nkey(q);$('.cd-xb',B).innerHTML=XR.filter(e=>!q||nkey(e.id+' '+e.n+' '+e.xr).includes(q)).map(e=>`<tr data-id="${e.id}"><td class="cd-id">${e.id}</td><td><b>${esc(e.n)}</b></td><td>${cdLay(e.L,1)}</td><td class="cd-ie">${esc(e.xr.slice(0,260))}</td></tr>`).join('');$$('.cd-xb tr',B).forEach(t=>t.onclick=()=>cdDlg(t.dataset.id))};xb('');$('.cd-xq',B).oninput=ev=>xb(ev.target.value);
 countUp(B);$$('[data-go]',B).forEach(x=>x.onclick=()=>cdDlg(x.dataset.go))}
/* ---- shortlist view ---- */
const CDSS={cand:'نامزد',cont:'تماس گرفته شد',quote:'پیشنهاد قیمت دریافت شد',appr:'تأیید و فعال',rej:'رد شد'};
function cdShort(B){const D=CNDD;const L=cdSL();const R=L.map(s=>({s,e:D.byId[s.id]})).filter(x=>x.e);
 if(!R.length){B.innerHTML=`<div class="sx-empty">فهرست کوتاه خالی است. از «فهرست و جستجو» یا «یابندهٔ شریک برای مسیر» با ★ طرف اضافه کنید.</div>`;return}
 const cnt=k=>R.filter(x=>x.s.st===k).length;
 B.innerHTML=`<div class="ex-kpis">${kpi('در فهرست کوتاه',R.length)}${Object.keys(CDSS).map(k=>kpi(CDSS[k],cnt(k),{cls:k==='rej'&&cnt(k)?'warn':''})).join('')}${kpi('تطبیق تحریمی',R.filter(x=>x.s.sn&&x.s.sn.h).length,{sub:R.filter(x=>x.s.sn).length?'از '+fa(R.filter(x=>x.s.sn).length)+' بررسی‌شده':'هنوز بررسی نشده',cls:'warn'})}</div>
 <div class="sx-card"><header><b>طرف‌های منتخب</b><small>اطلاعات تماس و وضعیت در همین مرورگر (و سرور تیمی در صورت اتصال) ذخیره می‌شود</small><span class="sx-sp"></span><button class="sx-btn sm pri cd-ss">${svgI(IC.shield)}غربالگری همه</button><button class="sx-btn sm cd-sq">ارسال به استعلام قیمت</button><button class="sx-btn sm cd-sc2">${svgI(IC.dl)}CSV</button></header>
 <div class="cd-tw"><table class="sx-tbl cd-t cd-slt"><thead><tr><th>نام</th><th>لایه</th><th>مقر</th><th>امتیاز</th><th>وضعیت</th><th>امتیاز شما</th><th>شخص رابط</th><th>ایمیل</th><th>تلفن / وی‌چت</th><th>یادداشت</th><th>تحریم</th><th></th></tr></thead><tbody>${R.map(({s,e})=>`<tr data-id="${e.id}"><td><button class="cd-lnk" data-go="${e.id}"><b>${esc(e.n)}</b></button>${e.cn?`<small class="cd-cn">${esc(e.cn)}</small>`:''}</td><td>${cdLay(e.L,1)}</td><td>${esc(cdLoc(e))}</td><td><span class="cd-sc" style="--p:${e.sc}">${fa(e.sc)}</span></td><td><select data-k="st">${Object.entries(CDSS).map(([a,n])=>`<option value="${a}" ${s.st===a?'selected':''}>${n}</option>`).join('')}</select></td><td><select data-k="r"><option value="">—</option>${[1,2,3,4,5].map(i=>`<option value="${i}" ${+s.r===i?'selected':''}>${'★'.repeat(i)}</option>`).join('')}</select></td><td><input data-k="ct" value="${esc(s.ct||'')}"></td><td><input data-k="mail" type="email" value="${esc(s.mail||'')}" class="${s.mail&&badMail(s.mail)?'bad':''}"></td><td><input data-k="tel" value="${esc(s.tel||'')}"></td><td><input data-k="note" value="${esc(s.note||'')}"></td><td>${s.sn?(s.sn.h?`<span class="cd-sf" title="${esc(s.sn.h)}">⚠ ${fa(Math.round(s.sn.s*100))}٪</span>`:'<span class="cd-okb">پاک</span>'):'<span class="cd-mut">—</span>'}</td><td><button class="cd-del" title="حذف">✕</button></td></tr>`).join('')}</tbody></table></div></div>`;
 countUp(B);const save=(id,k,v)=>{const L2=cdSL();const s=L2.find(x=>x.id===id);if(s){s[k]=v;s.u=Date.now();cdSLs(L2)}};
 $$('.cd-slt tr[data-id]',B).forEach(t=>{const id=t.dataset.id;$$('[data-k]',t).forEach(x=>x.onchange=()=>{save(id,x.dataset.k,x.value);if(x.dataset.k==='st')cdShort(B)});$('.cd-del',t).onclick=()=>{cdToggle(id);cdShort(B)}});
 $$('[data-go]',B).forEach(x=>x.onclick=()=>cdDlg(x.dataset.go));
 $('.cd-ss',B).onclick=()=>{toast('در حال غربالگری…');cdScreen(R.map(x=>x.e)).then(S=>{const L2=cdSL();S.forEach(r=>{const s=L2.find(x=>x.id===r.e.id);if(s)s.sn=r.h.length?{h:r.h[0].name+' · '+(LISTN[r.h[0].list]||''),s:r.h[0].score,t:r.t}:{h:'',s:0,t:r.t}});cdSLs(L2);cdShort(B);toast(fa(S.filter(r=>r.h.length).length)+' تطبیق احتمالی')})};
 $('.cd-sq',B).onclick=()=>cdRfq(R.filter(x=>x.s.st!=='rej').map(x=>x.e));
 $('.cd-sc2',B).onclick=()=>{const q=v=>'"'+String(v??'').replace(/"/g,'""')+'"';dlFile('china-shortlist.csv','Entity_ID,Name,Chinese_Name,Layer,Location,Score,Status,Rating,Contact,Email,Phone,Note,Sanctions_Check,Source\n'+R.map(({s,e})=>[e.id,e.n,e.cn,e.L,cdLoc(e),e.sc,CDSS[s.st],s.r||'',s.ct||'',s.mail||'',s.tel||'',s.note||'',s.sn?(s.sn.h||'clear'):'',e.urls[0]||''].map(q).join(',')).join('\n'))}}
/* ---- data quality & methodology ---- */
function cdQual(B){const D=CNDD,A=D.aux;const tb=(rows,o={})=>{rows=rows.map(r=>r.filter((x,i)=>i>0||x)).filter(r=>r.some(x=>x));return `<div class="cd-tw cd-tw2"><table class="sx-tbl cd-qt">${rows.map((r,i)=>`<tr>${r.map(x=>i===0&&o.h?`<th>${esc(x)}</th>`:`<td>${esc(x)}</td>`).join('')}</tr>`).join('')}</table></div>`};
 const strip=rows=>rows.map(r=>r.slice(r[0]===''?1:0));
 const lay=D.lay.map(([k,f])=>{const X=D.E.filter(e=>e.L===k);const c=v=>X.filter(e=>e.v===v).length;return [k,f,X.length,c('V'),c('P'),c('U'),X.filter(e=>e.cn).length,X.filter(e=>e.hq).length]});
 const gap=strip(A['تحلیل شکاف فیلدها (B3)']||[]).filter(r=>r[2]&&/^\d+$/.test(r[2])).map(r=>[r[0],+r[2],+r[3]]);
 const doc=rows=>rows.map(r=>r.filter(Boolean)).filter(r=>r.length).map(r=>r.length===1?(/^[۰-۹\d]+[.\-)]|^جدول|^پیوست|^[۰-۹]+\.[۰-۹]/.test(r[0])&&r[0].length<120?`<h5>${esc(r[0])}</h5>`:`<p>${esc(r[0])}</p>`):`<div class="cd-dr">${r.map(x=>`<span>${esc(x)}</span>`).join('')}</div>`).join('');
