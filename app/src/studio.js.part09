let MKD=null,MKV=0;
const mkToday=()=>new Date().toISOString().slice(0,10);
const mkAge=d=>Math.max(0,Math.round((Date.parse(mkToday())-Date.parse(d))/864e5));
const mkD=d=>{try{return new Date(d+'T12:00:00Z').toLocaleDateString('fa-IR',{year:'numeric',month:'short',day:'numeric'})}catch(e){return d}};
const mkDT=t=>t?new Date(t).toLocaleString('fa-IR',{dateStyle:'medium',timeStyle:'short'}):'—';
function mkPrec(v,u){const a=Math.abs(v);return u==='σ'?2:a>=1e4?0:a>=100?1:a>=10?2:a>=1?3:4}
const mkV=(v,s)=>v==null||!isFinite(v)?'—':nf(v,mkPrec(v,s&&s.unit));
/* ---------- data merge: seed → server/browser cache → manual ---------- */
function mkBuild(){const S={};const add=(x,origin)=>{const id=x.id;const cur=S[id]||(S[id]={id,name:x.name||id,unit:x.unit||'',kind:x.kind||'freight',freq:x.freq||'d',src:x.src||'',unofficial:!!(x.unofficial||x.flag==='unofficial'),P:{},F:{},O:{}});
  for(const k of ['name','unit','kind','freq','src'])if(x[k])cur[k]=x[k];if(x.unofficial||x.flag==='unofficial')cur.unofficial=true;for(const [d,v] of x.pts||[]){if(origin==='man'&&cur.P[d]!=null&&cur.O[d]!=='man')continue;cur.P[d]=+v;cur.O[d]=origin}Object.assign(cur.F,x.flags||{})};
 (MK_SEED.series||[]).forEach(x=>add(x,'seed'));const C=LSG('ifa-mkt-cache',null);if(C&&C.series)C.series.forEach(x=>add(x,C.origin||'server'));
 const M={};mkMan().forEach(p=>{if(!p||!p.id||!/^\d{4}-\d{2}-\d{2}$/.test(p.date)||!isFinite(+p.value))return;const m=M[p.id]||(M[p.id]={id:p.id,name:p.name,unit:p.unit,kind:p.kind,freq:p.freq||'d',src:S[p.id]?'':'man',pts:[]});m.pts.push([p.date,+p.value]);if(p.name)m.name=p.name});Object.values(M).forEach(x=>add(x,'man'));
 for(const s of Object.values(S)){s.pts=Object.keys(s.P).sort().map(d=>[d,s.P[d]]);delete s.P}
 const src={};for(const [k,v] of Object.entries(MKSRC0))src[k]={id:k,...v};(MK_SEED.sources||[]).forEach(x=>src[x.id]=Object.assign(src[x.id]||{},{seedOk:x.lastOk||x.lastRun}));if(C&&C.sources)C.sources.forEach(x=>src[x.id]=Object.assign(src[x.id]||{},{status:x}));
 return {S,src,cache:C,seedTs:MK_SEED.ts,v:MKV}}
const mkGet=()=>{if(!MKD||MKD.v!==MKV)MKD=mkBuild();return MKD};
const mkBump=()=>{MKV++;MKD=null};
function mkStat(s){if(!s||!s.pts.length)return null;const n=s.pts.length,[d,v]=s.pts[n-1];const pv=n>1?s.pts[n-2]:null;const age=mkAge(d);const fw=MKFQ[s.freq]||5;const fresh=age<=fw?'ok':age<=fw*3?'stale':'old';
 const orig=s.O[d];const tier=orig==='man'?MKTIER.man:(MKTIER[s.src]||.7);const sus=String(s.F[d]||'').includes('jump')||(pv&&s.kind!=='macro'&&Math.abs(v/pv[1]-1)>({freight:.35,bunker:.2,oil:.2,fx:.15,commodity:.4}[s.kind]||.5));
 const conf=+(tier*(fresh==='ok'?1:fresh==='stale'?.75:.45)*(sus?.7:1)).toFixed(2);const chg=pv?(s.kind==='macro'?v-pv[1]:(v/pv[1]-1)*100):null;
 const back=(days)=>{const t=Date.parse(d)-days*864e5;let r=null;for(const p of s.pts){if(Date.parse(p[0])<=t)r=p;else break}return r};const w4=back(28);
 return {d,v,pv:pv&&pv[1],pd:pv&&pv[0],chg,age,fresh,conf,sus,orig,ch4:w4?(s.kind==='macro'?v-w4[1]:(v/w4[1]-1)*100):null}}
function mkAt(id,date){const s=mkGet().S[id];if(!s||!s.pts.length)return null;let r=null;for(const p of s.pts){if(p[0]<=date)r=p;else break}return r||s.pts[0]}
const mkLast=id=>{const s=mkGet().S[id];const t=mkStat(s);return t?t.v:null};
const MKFL={ok:['تازه','ok'],stale:['کهنه','chk'],old:['قدیمی','bad']};
const mkFB=t=>t?`<span class="il-vs il-${MKFL[t.fresh][1]}" title="${nf(t.age)} روز از آخرین داده">${MKFL[t.fresh][0]}</span>`:'';
const mkCB=t=>t?`<span class="mk-cf" style="--p:${Math.round(t.conf*100)}" title="اطمینان: منبع × تازگی × آزمون پرش">${nf(Math.round(t.conf*100))}٪</span>`:'';
const mkUB=s=>s&&s.unofficial?`<span class="mk-uo" title="نرخ بازار آزاد از منبع غیررسمی؛ فقط برای مرجع داخلی">غیررسمی</span>`:'';
const mkOB=o=>({seed:'نسخهٔ همراه',server:'سرور تیمی',browser:'دریافت مستقیم',man:'ورود دستی'}[o]||o||'');
const mkChg=(t,s)=>t&&t.chg!=null?`<em class="mk-ch ${t.chg>0?'up':t.chg<0?'dn':''}">${t.chg>0?'▲':t.chg<0?'▼':'•'} ${s&&s.kind==='macro'?nf(Math.abs(t.chg),2):nf(Math.abs(t.chg),1)+'٪'}</em>`:'';
function mkSpark(pts,w=120,h=30,c){if(!pts||pts.length<2)return `<svg class="mk-sp" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}"><line x1="0" y1="${h/2}" x2="${w}" y2="${h/2}" stroke="var(--line)" stroke-dasharray="3 3"/></svg>`;const P=pts.slice(-60);const v=P.map(p=>p[1]);const lo=Math.min(...v),hi=Math.max(...v),r=hi-lo||1;
 const xy=P.map((p,i)=>[(i/(P.length-1))*(w-4)+2,h-3-((p[1]-lo)/r)*(h-6)]);return `<svg class="mk-sp" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" aria-hidden="true"><polyline fill="none" stroke="${c||'var(--accent,#5E9FE8)'}" stroke-width="1.6" points="${xy.map(p=>p.map(x=>x.toFixed(1)).join(',')).join(' ')}"/><circle cx="${xy[xy.length-1][0].toFixed(1)}" cy="${xy[xy.length-1][1].toFixed(1)}" r="2.4" fill="${c||'var(--accent,#5E9FE8)'}"/></svg>`}
function mkChart(L,{w=680,h=240,norm=false}={}){L=L.filter(x=>x.pts&&x.pts.length);if(!L.length)return '<div class="sx-empty">دادهٔ کافی برای نمودار نیست.</div>';const pad={l:52,r:12,t:12,b:26};const ser=L.map(x=>{let p=x.pts;if(norm&&p.length){const b=p[0][1]||1;p=p.map(q=>[q[0],q[1]/b*100])}return {...x,p}});
 const T=ser.flatMap(x=>x.p.map(q=>Date.parse(q[0])));const V=ser.flatMap(x=>x.p.map(q=>q[1]));const t0=Math.min(...T),t1=Math.max(...T)||t0+1,lo=Math.min(...V),hi=Math.max(...V),r=(hi-lo)||Math.abs(hi)||1;const X=t=>pad.l+((t-t0)/((t1-t0)||1))*(w-pad.l-pad.r),Y=v=>h-pad.b-((v-lo)/r)*(h-pad.t-pad.b);
 const ty=[0,.25,.5,.75,1].map(f=>lo+r*f);const tx=[0,.33,.66,1].map(f=>t0+(t1-t0)*f);
 return `<svg class="mk-ch2" viewBox="0 0 ${w} ${h}" role="img">${ty.map(v=>`<line x1="${pad.l}" x2="${w-pad.r}" y1="${Y(v).toFixed(1)}" y2="${Y(v).toFixed(1)}" stroke="var(--line)" stroke-width=".6"/><text x="${pad.l-6}" y="${(Y(v)+3).toFixed(1)}" text-anchor="end" font-size="10" fill="var(--faint)">${mkV(v)}</text>`).join('')}${tx.map(t=>`<text x="${X(t).toFixed(1)}" y="${h-8}" text-anchor="middle" font-size="10" fill="var(--faint)">${mkD(new Date(t).toISOString().slice(0,10))}</text>`).join('')}
 ${ser.map(x=>`<polyline fill="none" stroke="${x.c}" stroke-width="1.8" points="${x.p.map(q=>X(Date.parse(q[0])).toFixed(1)+','+Y(q[1]).toFixed(1)).join(' ')}"/>${x.p.length<40?x.p.map(q=>`<circle cx="${X(Date.parse(q[0])).toFixed(1)}" cy="${Y(q[1]).toFixed(1)}" r="2.2" fill="${x.c}"><title>${esc(x.n)} · ${mkD(q[0])}: ${mkV(q[1])}</title></circle>`).join(''):''}`).join('')}</svg>
 ${L.length>1?`<div class="mk-lg">${ser.map(x=>`<span><i style="background:${x.c}"></i>${esc(x.n)}</span>`).join('')}</div>`:''}`}
/* ---------- sync: team server / direct browser fetch ---------- */
async function mkSync(force){if(!svOn())throw new Error('به سرور تیمی وصل نیستید');if(force){if(!svCan('market.refresh'))throw new Error('نقش شما اجازهٔ به‌روزرسانی دادهٔ بازار را ندارد');await svApi('/api/market/refresh',{method:'POST',body:{}})}
 const j=await svApi('/api/market?n=120');LSS('ifa-mkt-cache',{origin:'server',ts:Date.now(),sources:j.sources,series:j.series,enabled:j.enabled});mkBump();mkAlertEval(true);return j}
async function mkBrowser(){const out=[],src=[],err=[];const P=(id,name,unit,kind,freq,pts,s)=>out.push({id,name,unit,kind,freq,src:s,pts});
 const job=async(k,f)=>{try{await f();src.push({id:k,ok:true,lastRun:Date.now(),lastOk:Date.now()})}catch(e){err.push(MKSRC0[k].name+': '+e.message);src.push({id:k,ok:false,lastRun:Date.now(),err:e.message})}};
 await Promise.all([job('erapi',async()=>{const j=await (await fetch('https://open.er-api.com/v6/latest/USD')).json();const d=new Date(j.time_last_update_unix*1000).toISOString().slice(0,10);for(const c of ['EUR','CNY','AED','TRY','RUB','INR','IRR'])if(j.rates[c])P('fx.er.USD'+c,'دلار به '+c+(c==='IRR'?' (نرخ مرجع بین‌المللی — نه بازار آزاد)':''),c,'fx','d',[[d,j.rates[c]]],'erapi')}),
  job('eia',async()=>{const j=await (await fetch('https://api.eia.gov/v2/petroleum/pri/spt/data/?api_key='+encodeURIComponent(mkCfg().eiaKey||'DEMO_KEY')+'&frequency=daily&data[0]=value&facets[series][]=RBRTE&facets[series][]=RWTC&sort[0][column]=period&sort[0][direction]=desc&length=120')).json();const L=(j.response&&j.response.data)||[];if(!L.length)throw new Error('بدون داده');
   for(const [s,id,n] of [['RBRTE','oil.brent','نفت برنت (اسپات FOB)'],['RWTC','oil.wti','نفت WTI (اسپات کاشینگ)']])P(id,n,'USD/bbl','oil','d',L.filter(x=>x.series===s).map(x=>[x.period,+x.value]).reverse(),'eia')}),
  job('fbx',async()=>{const s=await (await fetch(MKSRC0.fbx.url)).text();const H=[...s.matchAll(/"ticker":"(FBX\d*)","indexDate":"(\d{4}-\d{2}-\d{2})","value":([\d.]+)/g)];if(!H.length)throw new Error('ساختار صفحه تغییر کرده است');const last=H.map(h=>h[2]).sort().pop();
   P('fbx.FBX','شاخص جهانی کانتینر (FBX)','USD/FEU','freight','w',H.filter(h=>h[1]==='FBX').map(h=>[h[2],+h[3]]),'fbx');const m=s.match(/frProductIntroTickerData\[[^\]]*\]\s*=\s*(\[[\s\S]*?\]);/);if(m)JSON.parse(m[1]).forEach(x=>{const v=parseFloat(String(x.value).replace(/[$,]/g,''));const o=mkGet().S['fbx.'+x.label];if(x.label!=='FBX'&&isFinite(v))P('fbx.'+x.label,o?o.name:x.label,'USD/FEU','freight','w',[[last,v]],'fbx')})})]);
 if(!out.length)throw new Error(err.join(' · ')||'هیچ منبعی پاسخ نداد');const C=LSG('ifa-mkt-cache',null);const keep=C&&C.origin==='server'?C.series.filter(x=>!out.some(o=>o.id===x.id)):(C&&C.series||[]).filter(x=>!out.some(o=>o.id===x.id));
 const prevS=new Map(((C&&C.series)||[]).map(x=>[x.id,x]));for(const o of out){const p=prevS.get(o.id);if(p){const m=new Map(p.pts);o.pts.forEach(([d,v])=>m.set(d,v));o.pts=[...m.entries()].sort((a,b)=>a[0]<b[0]?-1:1).slice(-400)}}
 LSS('ifa-mkt-cache',{origin:'browser',ts:Date.now(),sources:[...((C&&C.sources)||[]).filter(x=>!src.some(s=>s.id===x.id)),...src],series:[...keep,...out]});mkBump();mkAlertEval(true);return {n:out.length,err}}
function mkAuto(){const C=LSG('ifa-mkt-cache',null);if(svOn()&&(!C||C.origin!=='server'||Date.now()-C.ts>30*60e3)&&!MKS.syncing){MKS.syncing=true;mkSync(false).then(()=>{MKS.syncing=false;if(view==='mkt')open('mkt')}).catch(()=>{MKS.syncing=false})}}
async function mkRefresh(btn){if(btn){btn.disabled=true;btn.innerHTML='<span class="sx-spin"></span> در حال دریافت…'}try{if(svOn()){await mkSync(svCan('market.refresh'));toast('دادهٔ بازار از سرور تیمی به‌روز شد')}else{const r=await mkBrowser();toast(nf(r.n)+' سری مستقیم از مرورگر دریافت شد'+(r.err.length?' · '+nf(r.err.length)+' منبع ناموفق':''))}}catch(e){toast('به‌روزرسانی ناموفق: '+e.message)}open('mkt')}
/* ---------- estimator ---------- */
function mkQuotes(){const R=[];(typeof rbAll==='function'?rbAll():[]).filter(r=>r.mode==='sea'&&+r.amt>0).forEach(r=>R.push({id:'rb:'+r.id,src:'بانک نرخ',vendor:r.vendor,pol:r.pol,pod:r.pod,eq:r.eq,amt:+r.amt,cur:r.cur||'USD',date:r.from||mkToday()}));mkQ().forEach(q=>R.push({...q,id:'mq:'+q.id,src:'پیشنهاد ثبت‌شده'}));
 return R.map(q=>({...q,usd:typeof pU==='function'?pU(q.amt,q.cur):q.amt,eqk:mkEqK(q.eq),podk:mkPodK(q.pod),polk:mkPolK(q.pol)}))}
const mkEqK=e=>{e=String(e||'').toUpperCase().replace(/\s/g,'');return /RF|REEF|RH/.test(e)?'40RF':/HC|HQ/.test(e)?'40HC':/^20|20'|20GP|20DV|TEU/.test(e)?'20':/40/.test(e)?'40':'40HC'};
function mkPodK(p){const s=nkey(p);if(/bnd|abbas|عباس|رجایی|rajaee|rajai/.test(s))return 'BND';if(/buz|bushehr|بوشهر/.test(s))return 'BUZ';if(/bkm|imam|خمینی|امام/.test(s))return 'BKM';if(/zbr|chabahar|چابهار/.test(s))return 'ZBR';
 if(/hamburg|rotterdam|antwerp|felixstowe|bremerhaven|le havre|gdansk|هامبورگ|روتردام/.test(s))return 'FBX11';if(/genoa|piraeus|valencia|barcelona|istanbul|mersin|ambarli|izmir|koper|trieste|جنوا|استانبول|مرسین/.test(s))return 'FBX13';if(/los angeles|long beach|oakland|seattle|tacoma|vancouver/.test(s))return 'FBX01';if(/new york|savannah|norfolk|charleston|houston/.test(s))return 'FBX03';return ''}
function mkPolK(p){const s=nkey(p);for(const [k,v] of Object.entries(MKPOL))if(s.includes(k.toLowerCase())||s.includes(nkey(v[0]).split('/')[0]))return k;if(/yantian|shekou|شنژن/.test(s))return 'Shenzhen';if(/nansha|huangpu/.test(s))return 'Guangzhou';if(/china|cn|چین/.test(s))return 'Shanghai';return ''}
function mkCal(){const Q=mkQuotes().filter(q=>MKPOD[q.podk]&&q.usd>0);const cf=mkCfg();const R=Q.map(q=>{const s=mkAt('scfi.T',q.date)||mkAt('fbx.FBX',q.date);if(!s)return null;const via=mkAt('scfi.T',q.date)?'scfi':'fbx';const idx=via==='scfi'?s[1]:s[1]*(mkLast('scfi.T')||1)/(mkLast('fbx.FBX')||1);
  const E=MKEQ[q.eqk],teu=E[2],ocean=q.usd-(cf.route==='tr'?(teu>1?cf.feeder40:cf.feeder20)*MKPOD[q.podk][1]:0)-cf.war*teu;const base=ocean/(1+cf.prem/100)/E[1]/((MKPOL[q.polk]||[0,1])[1]);return base>0?{q,k:base/idx}:null}).filter(Boolean);
 const ks=R.map(x=>x.k).sort((a,b)=>a-b);const med=ks.length?ks[Math.floor(ks.length/2)]:null;return {n:ks.length,k:med,R}}
function mkEst(o={},at){const cf=Object.assign(mkCfg(),o);const cal=mkCal();const k=cf.autoCal&&cal.n>=2?cal.k:cf.k;const date=at||mkToday();const sc=mkAt('scfi.T',date);const fb=mkAt('fbx.FBX',date);
 let idx=sc?sc[1]:null,via='SCFI';if(!idx&&fb){idx=fb[1]*(mkLast('scfi.T')||1)/(mkLast('fbx.FBX')||1);via='FBX'}if(!idx)return null;const E=MKEQ[cf.eq]||MKEQ['40HC'],teu=E[2],pol=MKPOL[cf.pol]||MKPOL.Shanghai,pod=MKPOD[cf.pod]||MKPOD.BND;
 const L=[];const ocean=k*idx*E[1]*pol[1];L.push(['حمل اصلی دریایی (پیوند به '+via+')',ocean,via+' '+mkV(idx)+' × ضریب '+nf(k,3)+' × '+E[0]+' × مبدأ '+pol[0]]);
 if(cf.route==='tr')L.push(['فیدر جبل‌علی ← '+pod[0],(teu>1?cf.feeder40:cf.feeder20)*pod[1],'تخمین قابل‌ویرایش؛ ضریب مقصد '+nf(pod[1],2)]);else L.push(['حق سرویس مستقیم به ایران',ocean*cf.dirPrem/100,nf(cf.dirPrem)+'٪ حمل اصلی']);
 L.push(['صرف ریسک تحریم / محدودیت خطوط',ocean*cf.prem/100,nf(cf.prem)+'٪ حمل اصلی']);L.push(['بیمهٔ ریسک جنگ (هرمز)',cf.war*teu,nf(cf.war)+' دلار به‌ازای هر TEU']);
 if(cf.baf){const b=mkLast(cf.bunkerId);if(b)L.push(['تعدیل سوخت (BAF) نسبت به مبنا',(b-cf.bunkerRef)*cf.fuelT*teu,'('+mkV(b)+' − '+nf(cf.bunkerRef)+') × '+nf(cf.fuelT,2)+' تن/TEU'])}
 L.push(['THC مبدأ (چین)',teu>1?cf.thcO40:cf.thcO20,'تخمین؛ معمولاً در پیش‌پرداخت']);const fx=mkLast(cf.fx)||(typeof fwFx==='function'?fwFx().free:0);const thd=teu>1?cf.thcD40:cf.thcD20;L.push(['THC و هزینهٔ محلی مقصد (ریالی)',fx?thd/fx:0,nf(thd)+' ریال ÷ '+(fx?nf(fx):'—')]);
 const tot=L.reduce((a,x)=>a+x[1],0);const age=sc?mkAge(sc[0]):99;const w=(cf.autoCal&&cal.n>=3?.12:cal.n>=1?.18:.25)+(age>14?.08:0);return {L,tot,lo:tot*(1-w),hi:tot*(1+w),w,k,cal,idx,via,date:sc?sc[0]:fb&&fb[0],cf,fx,ocean}}
function mkBench(q){if(MKPOD[q.podk]){const e=mkEst({pol:q.polk||'Shanghai',pod:q.podk,eq:q.eqk},q.date);return e?{m:e.tot,lo:e.lo,hi:e.hi,how:'برآورد ایران · '+e.via}:null}
 if(/^FBX/.test(q.podk)){const t=mkAt('fbx.'+q.podk,q.date);if(!t)return null;const f=q.eqk==='20'?.56:q.eqk==='40RF'?1.8:1;return {m:t[1]*f,lo:t[1]*f*.85,hi:t[1]*f*1.15,how:q.podk+(q.eqk==='20'?' × ۰٫۵۶ (۲۰ فوت)':'')}}return null}
const mkVerd=d=>d==null?['—','']:d<-15?['زیر بازار — شمول هزینه‌ها را بررسی کنید','chk']:d<=10?['در محدودهٔ بازار','ok']:d<=25?['بالاتر از بازار','chk']:['گران — جای مذاکره','bad'];
/* ---------- alerts ---------- */
function mkAlertEval(notify){const A=mkAlr();const seen=LSG('ifa-mkt-alr-seen',{});const out=[];const today=mkToday();for(const a of A){const s=mkGet().S[a.sid];const t=mkStat(s);if(!t||a.off){out.push({a,t,hit:false});continue}
 const hit=a.op==='gt'?t.v>a.v:a.op==='lt'?t.v<a.v:a.op==='chg'?Math.abs(t.chg||0)>=a.v:false;out.push({a,t,hit,s});if(hit&&notify&&seen[a.id]!==today){seen[a.id]=today;toast('هشدار بازار: '+s.name+' = '+mkV(t.v,s));emit('market.alert',{ref:a.sid,series:s.name,value:t.v,change:t.chg!=null?t.chg.toFixed(1)+'%':'',rule:mkOp(a)})}}
 if(notify)LSS('ifa-mkt-alr-seen',seen);return out}
const mkOp=a=>(a.op==='gt'?'بیشتر از ':a.op==='lt'?'کمتر از ':'تغییر بیش از ')+nf(a.v)+(a.op==='chg'?'٪':'');
/* ---------- render ---------- */
function rMkt(b,C){mkAuto();subTabs(b,MKS,'sub',[['ov','نمای کلی بازار'],['idx','شاخص‌ها و سری‌ها'],['est','برآورد نرخ ایران و BAF'],['cmp','مقایسهٔ پیشنهاد با بازار'],['int','شاخص داخلی'],['imp','ورود داده و CSV'],['alr','هشدارها'],['src','منابع، مجوز و وضعیت']],(v,B)=>({ov:mkOv,idx:mkIdx,est:mkEstV,cmp:mkCmp,int:mkInt,imp:mkImp,alr:mkAlrV,src:mkSrc})[v](B,C))}
const mkWarn=()=>`<div class="cd-warn">${svgI(IC.shield||IC.risk||'')}<div><b>شفافیت داده:</b> نرخ‌ها از منابع عمومی (FBX، SCFI، Ship & Bunker، EIA، ECB، بانک جهانی، NY Fed) جمع‌آوری و با تاریخ، منبع، تازگی و درصد اطمینان نمایش داده می‌شوند. نرخ ارز <b>TGJU و Bonbast غیررسمی</b> است. شاخص‌ها میانگین بازارند، نه پیشنهاد قطعی؛ مسیرهای SCFI به خلیج فارس نیازمند عضویت است و «برآورد نرخ ایران» یک مدل شفاف و قابل‌کالیبره است. استفادهٔ تجاری یا بازنشر بیرونی برخی منابع نیازمند مجوز ناشر است.</div></div>`;
function mkBar(){const D=mkGet();const C=D.cache;const o=C?C.origin:'seed';const ts=C?C.ts:D.seedTs;const on=svOn();
 return `<div class="sx-card mk-bar"><header><b>وضعیت داده</b><small>${mkOB(o)} · ${mkDT(ts)}${o!=='server'?' · نسخهٔ همراه: '+mkDT(D.seedTs):''}</small><div class="il-acts"><span class="mk-dot ${on?'on':''}">${on?'سرور تیمی متصل — جمع‌آوری خودکار هر ۶ تا ۲۴ ساعت':'حالت مستقل — دریافت مستقیم FBX، EIA و نرخ ارز از مرورگر'}</span><button class="sx-btn sm mk-rf">${svgI(IC.sync||IC.fc||'')} به‌روزرسانی</button><button class="sx-btn sm" data-go="imp">ورود دستی</button></div></header></div>`}
function mkBind(B){const r=$('.mk-rf',B);if(r)r.onclick=()=>mkRefresh(r);$$('[data-go]',B).forEach(x=>x.onclick=()=>{MKS.sub=x.dataset.go;if(x.dataset.k!=null)MKS.k=x.dataset.k;open('mkt')});$$('[data-sid]',B).forEach(x=>x.onclick=e=>{if(e.target.closest('button,a,input,select')&&e.target.closest('button,a,input,select')!==x)return;mkDlg(x.dataset.sid)})}
function mkCard(id){const s=mkGet().S[id];const t=mkStat(s);if(!s||!t)return '';return `<button class="mk-k" data-sid="${esc(id)}" style="--c:${MKKC[s.kind]}"><header><span>${esc(s.name)}</span>${mkUB(s)}</header><div class="mk-kv"><b>${mkV(t.v,s)}</b><small>${esc(s.unit)}</small>${mkChg(t,s)}</div>${mkSpark(s.pts,140,30,MKKC[s.kind])}<footer><span>${mkD(t.d)}</span>${mkFB(t)}${mkCB(t)}<span class="mk-src">${esc((MKSRC0[s.src]||{}).name||s.src)}</span></footer></button>`}
function mkOv(B){const D=mkGet();const e20=mkEst({eq:'20'}),e40=mkEst({eq:'40HC'});const lanes=Object.values(D.S).filter(s=>/^fbx\.FBX\d/.test(s.id)).map(s=>[s,mkStat(s)]).filter(x=>x[1]);const mx=Math.max(1,...lanes.map(x=>x[1].v));
 const wb=Object.values(D.S).filter(s=>s.kind==='commodity').map(s=>[s,mkStat(s)]).filter(x=>x[1]);const A=mkAlertEval(false).filter(x=>x.hit);const fxF=mkLast('fx.tgju.USDIRR')||mkLast('fx.bb.USDIRR');const fxS=typeof fwFx==='function'?fwFx().free:0;
 B.innerHTML=mkWarn()+mkBar()+`<div class="mk-ks">${MKKEY.map(mkCard).join('')}</div>
 <div class="cd-g2 mk-g2"><div class="sx-card"><header><b>برآورد امروز: ${esc(MKPOL[mkCfg().pol][0])} ← ${esc(MKPOD[mkCfg().pod][0])}</b><small>مدل شفاف پیوند به SCFI · ${e40&&e40.cal.n>=2&&e40.cf.autoCal?'کالیبره با '+nf(e40.cal.n)+' نرخ داخلی':'ضریب پیش‌فرض — با نرخ‌های واقعی کالیبره کنید'}</small><div class="il-acts"><button class="sx-btn sm" data-go="est">جزئیات و تنظیم</button></div></header>
  ${e20&&e40?`<div class="ex-kpis">${kpT('۲۰ فوت',nf(Math.round(e20.tot))+' $',nf(Math.round(e20.lo))+' تا '+nf(Math.round(e20.hi)))}${kpT('۴۰ فوت HC',nf(Math.round(e40.tot))+' $',nf(Math.round(e40.lo))+' تا '+nf(Math.round(e40.hi)))}${kpT('معادل ریالی ۴۰ فوت',e40.fx?nf(Math.round(e40.tot*e40.fx/1e6))+' م ریال':'—',e40.fx?'با نرخ آزاد '+nf(e40.fx):'')}</div>`:'<div class="sx-empty">دادهٔ SCFI/FBX موجود نیست.</div>'}</div>
  <div class="sx-card"><header><b>نرخ ارز: بازار در برابر تنظیمات شما</b><small>برای محاسبات هزینه و مالی</small><div class="il-acts"><button class="sx-btn sm mk-afx"${fxF?'':' disabled'}>اعمال نرخ بازار</button></div></header>
  <table class="sx-tbl mk-t"><tbody><tr><td>دلار آزاد (غیررسمی)</td><td class="num">${fxF?nf(fxF):'—'}</td></tr><tr><td>دلار آزاد در تنظیمات مالی</td><td class="num">${fxS?nf(fxS):'—'}</td></tr><tr><td>اختلاف</td><td class="num">${fxF&&fxS?nf((fxS/fxF-1)*100,1)+'٪':'—'}</td></tr><tr><td>یورو/دلار (ECB)</td><td class="num">${mkV(mkLast('fx.ecb.EURUSD'))}</td></tr><tr><td>دلار/یوان</td><td class="num">${mkV(mkLast('fx.ecb.USDCNY')||mkLast('fx.er.USDCNY'))}</td></tr></tbody></table></div></div>
 ${A.length?`<div class="sx-card"><header><b>هشدارهای فعال (${nf(A.length)})</b><div class="il-acts"><button class="sx-btn sm" data-go="alr">مدیریت هشدارها</button></div></header><ul class="il-ul">${A.map(x=>`<li><b>${esc(x.s.name)}</b>: ${mkV(x.t.v,x.s)} — ${mkOp(x.a)}</li>`).join('')}</ul></div>`:''}
 <div class="cd-g2 mk-g2"><div class="sx-card"><header><b>مسیرهای FBX (دلار/FEU)</b><small>${lanes.length?mkD(lanes[0][1].d):''}</small></header><div class="mk-bars">${lanes.sort((a,b)=>b[1].v-a[1].v).map(([s,t])=>`<div class="mk-br" data-sid="${s.id}"><span>${esc(s.id.slice(4))} · ${esc(s.name)}</span><i style="--w:${(t.v/mx*100).toFixed(1)}%"></i><b>${nf(t.v)}</b>${mkChg(t,s)}</div>`).join('')||'<div class="sx-empty">داده‌ای نیست.</div>'}</div></div>
 <div class="sx-card"><header><b>کالاهای پایه (بانک جهانی، ماهانه)</b><small>${wb.length?mkD(wb[0][1].d):''}</small></header><table class="sx-tbl mk-t"><thead><tr><th>کالا</th><th>آخرین</th><th>واحد</th><th>ماه قبل</th></tr></thead><tbody>${wb.map(([s,t])=>`<tr data-sid="${s.id}" class="mk-rw"><td>${esc(s.name)}</td><td class="num">${mkV(t.v,s)}</td><td>${esc(s.unit)}</td><td>${mkChg(t,s)}</td></tr>`).join('')}</tbody></table></div></div>`;
 mkBind(B);const af=$('.mk-afx',B);if(af)af.onclick=()=>{if(!confirm('نرخ دلار آزاد ('+nf(fxF)+' ریال) در تنظیمات مالی و نرخ‌های تبدیل بانک نرخ (یورو، یوان، درهم، لیر، روبل) از دادهٔ بازار جایگزین شود؟'))return;try{if(typeof FIN!=='undefined'){FIN.rx.free=Math.round(fxF);if(typeof finSave==='function')finSave()}
  const P=LSG('ifa-pfx',{});const eu=mkLast('fx.ecb.EURUSD');if(eu)P.EUR=+eu.toFixed(4);for(const [c,id] of [['CNY','fx.er.USDCNY'],['AED','fx.er.USDAED'],['TRY','fx.er.USDTRY'],['RUB','fx.er.USDRUB']]){const v=mkLast(id);if(v)P[c]=+(1/v).toFixed(5)}LSS('ifa-pfx',P);toast('نرخ‌های ارز بازار اعمال شد');emit('market.fx.applied',{free:fxF})}catch(e){toast('خطا: '+e.message)}open('mkt')}}
function mkIdx(B){const D=mkGet();const L=Object.values(D.S).filter(s=>(!MKS.k||s.kind===MKS.k)&&(!MKS.q||nkey(s.name+' '+s.id).includes(nkey(MKS.q)))).map(s=>[s,mkStat(s)]).filter(x=>x[1]).sort((a,b)=>Object.keys(MKK).indexOf(a[0].kind)-Object.keys(MKK).indexOf(b[0].kind)||a[0].id.localeCompare(b[0].id));
 const cnt=k=>Object.values(D.S).filter(s=>s.kind===k).length;
 B.innerHTML=mkBar()+`<div class="sx-card"><header><b>همهٔ سری‌ها (${nf(L.length)})</b><div class="il-acts"><input class="sx-in mk-q" placeholder="جستجوی سری…" value="${esc(MKS.q)}"><button class="sx-btn sm mk-csv">خروجی CSV</button></div></header>
 <div class="sx-seg il-seg mk-kseg"><button data-k="" class="${MKS.k?'':'on'}">همه</button>${Object.entries(MKK).map(([k,n])=>`<button data-k="${k}" class="${MKS.k===k?'on':''}">${n} <small>${nf(cnt(k))}</small></button>`).join('')}</div>
 <div class="il-sc"><table class="sx-tbl mk-t mk-it"><thead><tr><th>سری</th><th>آخرین</th><th>تغییر</th><th>۴ هفته</th><th>تاریخ</th><th>تازگی</th><th>اطمینان</th><th>منبع</th><th>روند</th></tr></thead><tbody>${L.map(([s,t])=>`<tr class="mk-rw" data-sid="${esc(s.id)}"><td><b>${esc(s.name)}</b>${mkUB(s)}<small class="mk-id">${esc(s.id)} · ${esc(s.unit)}</small></td><td class="num">${mkV(t.v,s)}</td><td>${mkChg(t,s)}${t.sus?'<span class="il-vs il-bad" title="پرش غیرعادی نسبت به نقطهٔ قبل">مشکوک</span>':''}</td><td class="num">${t.ch4!=null?(s.kind==='macro'?nf(t.ch4,2):nf(t.ch4,1)+'٪'):'—'}</td><td>${mkD(t.d)}</td><td>${mkFB(t)}</td><td>${mkCB(t)}</td><td><small>${esc((MKSRC0[s.src]||{}).name||s.src)}<br>${mkOB(t.orig)}</small></td><td>${mkSpark(s.pts,90,24,MKKC[s.kind])}</td></tr>`).join('')}</tbody></table></div></div>`;
 mkBind(B);$$('.mk-kseg button',B).forEach(x=>x.onclick=()=>{MKS.k=x.dataset.k;mkIdx(B)});const q=$('.mk-q',B);q.oninput=()=>{MKS.q=q.value;clearTimeout(q._t);q._t=setTimeout(()=>{mkIdx(B);const n=$('.mk-q',B);n.focus();n.setSelectionRange(n.value.length,n.value.length)},250)};
 $('.mk-csv',B).onclick=()=>dlFile('market-series-'+mkToday()+'.csv',toCSV(['series_id','name','unit','kind','source','date','value','origin','flag'],L.flatMap(([s])=>s.pts.map(([d,v])=>[s.id,s.name,s.unit,s.kind,s.src,d,v,s.O[d]||'',s.F[d]||(s.unofficial?'unofficial':'')]))))}
function mkDlg(id){const s=mkGet().S[id];if(!s)return;const t=mkStat(s);let w=$('.cd-dlg');if(w)w.remove();w=document.createElement('div');w.className='cd-dlg';const v=s.pts.map(p=>p[1]);const src=MKSRC0[s.src]||{};
 w.innerHTML=`<div class="cd-dp" role="dialog" aria-label="${esc(s.name)}"><header><div><div class="cd-dh"><span class="il-cat" style="--c:${MKKC[s.kind]}">${MKK[s.kind]}</span><span class="cd-id">${esc(s.id)}</span>${mkUB(s)}${mkFB(t)}${mkCB(t)}</div><h3>${esc(s.name)}</h3><p class="cd-mut">${esc(src.name||s.src)} · ${esc(s.unit)} · ${s.freq==='d'?'روزانه':s.freq==='w'?'هفتگی':'ماهانه'}</p></div><button class="cd-x" aria-label="بستن">✕</button></header><div class="cd-db">
 <div class="ex-kpis">${kpT('آخرین',mkV(t.v,s),mkD(t.d))}${kpT('تغییر نسبت به قبل',t.chg!=null?(s.kind==='macro'?nf(t.chg,2):nf(t.chg,1)+'٪'):'—',t.pd?mkD(t.pd):'')}${kpT('کمینه / بیشینهٔ دوره',mkV(Math.min(...v),s)+' / '+mkV(Math.max(...v),s),nf(v.length)+' نقطه')}${kpT('میانگین دوره',mkV(v.reduce((a,x)=>a+x,0)/v.length,s),'')}</div>
 <section>${mkChart([{n:s.name,c:MKKC[s.kind],pts:s.pts}],{w:660,h:230})}</section>
 <section><h4>منبع و مجوز</h4><p>${esc(src.what||'')} — ${esc(src.licence||'')}${src.url?` · <a href="${esc(src.url)}" target="_blank" rel="noopener">صفحهٔ منبع</a>`:''}</p>${s.unofficial?'<p class="cd-fa"><b>توجه:</b> این نرخ غیررسمی است و نباید مبنای اسناد رسمی، اظهار گمرکی یا قرارداد قرار گیرد.</p>':''}${t.sus?'<p class="cd-fa"><b>هشدار کیفیت:</b> آخرین مقدار پرش غیرعادی دارد؛ پیش از استفاده با منبع تطبیق دهید.</p>':''}</section>
 <section><h4>داده‌ها (${nf(s.pts.length)})</h4><div class="il-sc mk-dl"><table class="sx-tbl mk-t"><thead><tr><th>تاریخ</th><th>مقدار</th><th>مبدأ داده</th></tr></thead><tbody>${s.pts.slice().reverse().slice(0,120).map(([d,x])=>`<tr><td>${mkD(d)} <small dir="ltr">${d}</small></td><td class="num">${mkV(x,s)}</td><td><small>${mkOB(s.O[d])}${s.F[d]&&s.F[d]!=='unofficial'?' · '+esc(s.F[d]):''}</small></td></tr>`).join('')}</tbody></table></div></section></div>
 <footer class="mk-df"><button class="sx-btn sm mk-dc">خروجی CSV</button><button class="sx-btn sm mk-da">افزودن هشدار</button><button class="sx-btn sm mk-dm">افزودن نقطهٔ دستی</button></footer></div>`;
 document.body.appendChild(w);const X=()=>w.remove();$('.cd-x',w).onclick=X;w.onclick=e=>{if(e.target===w)X()};$('.mk-dc',w).onclick=()=>dlFile(s.id+'.csv',toCSV(['date','value','origin'],s.pts.map(([d,x])=>[d,x,s.O[d]||''])));
 $('.mk-da',w).onclick=()=>{X();MKS.sub='alr';MKS.asid=s.id;open('mkt')};$('.mk-dm',w).onclick=()=>{X();MKS.sub='imp';MKS.msid=s.id;open('mkt')}}
function mkEstV(B){const cf=mkCfg();const e=mkEst();const cal=mkCal();const bn=Object.values(mkGet().S).filter(s=>s.kind==='bunker');const bv=mkLast(cf.bunkerId);
 const F=(k,l,t='number',st='1')=>`<label class="sx-f"><span>${l}</span><input type="${t}" step="${st}" data-cf="${k}" value="${esc(cf[k])}"></label>`;const Sel=(k,l,O)=>`<label class="sx-f"><span>${l}</span><select data-cf="${k}">${Object.entries(O).map(([v,n])=>`<option value="${v}"${String(cf[k])===v?' selected':''}>${esc(Array.isArray(n)?n[0]:n)}</option>`).join('')}</select></label>`;
 const thc=(MKEQ[cf.eq]||MKEQ['40HC'])[2]>1;const bafT=bv?(bv-cf.bunkerRef)*cf.fuelT:null;
 B.innerHTML=`<div class="cd-warn">${svgI(IC.info||IC.shield||'')}<div><b>روش:</b> نرخ حمل اصلی = <b>شاخص کل SCFI × ضریب کالیبراسیون</b> (دلار/TEU تا جبل‌علی) × ضریب کانتینر × ضریب مبدأ؛ سپس فیدر یا حق سرویس مستقیم، صرف ریسک تحریم، بیمهٔ جنگ، THC مبدأ و هزینهٔ ریالی مقصد افزوده می‌شود. ضریب پیش‌فرض (${nf(MKCFG0.k,2)}) تقریبی است؛ با «کالیبراسیون خودکار» از نرخ‌های واقعی بانک نرخ و پیشنهادهای ثبت‌شدهٔ مسیر چین ← ایران محاسبه می‌شود. SCFI خود سوخت را دربر دارد؛ تعدیل BAF جداگانه فقط برای نرخ‌های ثابت قراردادی است.</div></div>
 <div class="cd-g2 mk-g2"><div class="sx-card"><header><b>ورودی‌ها</b><div class="il-acts"><button class="sx-btn sm mk-rs">بازنشانی پیش‌فرض</button></div></header><div class="mk-fm">
 ${Sel('pol','بندر مبدأ',MKPOL)}${Sel('pod','بندر مقصد',MKPOD)}${Sel('eq','کانتینر',MKEQ)}${Sel('route','نوع سرویس',{tr:'ترانشیپ جبل‌علی + فیدر',dir:'سرویس مستقیم'})}
 ${F('k','ضریب SCFI (دلار/TEU به‌ازای هر واحد)','number','0.01')}<label class="sx-f mk-ck"><input type="checkbox" data-cf="autoCal"${cf.autoCal?' checked':''}><span>کالیبراسیون خودکار با نرخ‌های داخلی (${nf(cal.n)} نرخ${cal.k?' · ضریب '+nf(cal.k,3):''})</span></label>
 ${F('feeder20','فیدر ۲۰ فوت ($)')}${F('feeder40','فیدر ۴۰ فوت ($)')}${F('dirPrem','حق سرویس مستقیم (٪)')}${F('prem','صرف ریسک تحریم (٪)')}${F('war','ریسک جنگ ($/TEU)')}${F('thcO20','THC مبدأ ۲۰ ($)')}${F('thcO40','THC مبدأ ۴۰ ($)')}${F('thcD20','هزینهٔ محلی مقصد ۲۰ (ریال)','number','100000')}${F('thcD40','هزینهٔ محلی مقصد ۴۰ (ریال)','number','100000')}
 ${Sel('fx','نرخ تبدیل ریال',{'fx.tgju.USDIRR':'دلار آزاد TGJU (غیررسمی)','fx.bb.USDIRR':'دلار آزاد Bonbast (غیررسمی)','fx.er.USDIRR':'نرخ مرجع بین‌المللی'})}<label class="sx-f mk-ck"><input type="checkbox" data-cf="baf"${cf.baf?' checked':''}><span>تعدیل جداگانهٔ سوخت (BAF)</span></label></div></div>
 <div class="sx-card"><header><b>نتیجهٔ برآورد</b><small>${e?'شاخص '+e.via+' '+mkV(e.idx)+' · '+mkD(e.date):''}</small><div class="il-acts"><button class="sx-btn sm mk-cp"${e?'':' disabled'}>کپی خلاصه</button><button class="sx-btn sm" data-go="cmp">مقایسه با پیشنهادها</button></div></header>
 ${e?`<div class="ex-kpis">${kpT('برآورد کل',nf(Math.round(e.tot))+' $',(MKEQ[cf.eq]||[''])[0])}${kpT('بازهٔ محتمل',nf(Math.round(e.lo))+' – '+nf(Math.round(e.hi)),'±'+nf(Math.round(e.w*100))+'٪')}${kpT('معادل ریالی',e.fx?nf(Math.round(e.tot*e.fx/1e6))+' م ریال':'—',e.fx?'نرخ '+nf(e.fx):'نرخ ارز موجود نیست')}${kpT('کالیبراسیون',e.cf.autoCal&&e.cal.n>=2?'خودکار ('+nf(e.cal.n)+')':'پیش‌فرض',nf(e.k,3))}</div>
 <table class="sx-tbl mk-t"><thead><tr><th>جزء</th><th>دلار</th><th>مبنا</th></tr></thead><tbody>${e.L.map(x=>`<tr><td>${esc(x[0])}</td><td class="num">${nf(Math.round(x[1]))}</td><td><small>${esc(x[2])}</small></td></tr>`).join('')}<tr class="mk-tot"><td><b>جمع</b></td><td class="num"><b>${nf(Math.round(e.tot))}</b></td><td></td></tr></tbody></table>
 <p class="mk-note">حساسیت: هر ۱۰٪ تغییر SCFI ≈ ${nf(Math.round(e.ocean*.1*(1+cf.prem/100+(cf.route==='dir'?cf.dirPrem/100:0))))} دلار؛ هر ۵ واحد صرف ریسک ≈ ${nf(Math.round(e.ocean*.05))} دلار.</p>`:'<div class="sx-empty">برای برآورد، دادهٔ SCFI یا FBX لازم است.</div>'}</div></div>
 <div class="cd-g2 mk-g2"><div class="sx-card"><header><b>ماشین‌حساب BAF (تعدیل سوخت)</b><small>برای قراردادهای نرخ ثابت</small></header><div class="mk-fm">
 <label class="sx-f"><span>قیمت مرجع سوخت</span><select data-cf="bunkerId">${bn.map(s=>`<option value="${s.id}"${s.id===cf.bunkerId?' selected':''}>${esc(s.name)} · ${mkV(mkLast(s.id))}</option>`).join('')}</select></label>${F('bunkerRef','قیمت مبنای قرارداد ($/تن)')}${F('fuelT','مصرف سوخت (تن به‌ازای TEU)','number','0.01')}</div>
 <table class="sx-tbl mk-t"><tbody><tr><td>قیمت فعلی</td><td class="num">${bv?mkV(bv)+' $/تن':'—'}</td></tr><tr><td>BAF به‌ازای TEU</td><td class="num">${bafT!=null?nf(Math.round(bafT))+' $':'—'}</td></tr><tr><td>BAF به‌ازای ۴۰ فوت</td><td class="num">${bafT!=null?nf(Math.round(bafT*2))+' $':'—'}</td></tr><tr><td>کل هزینهٔ سوخت در هر TEU</td><td class="num">${bv?nf(Math.round(bv*cf.fuelT))+' $':'—'}</td></tr></tbody></table>
 <p class="mk-note">مصرف پیش‌فرض ${nf(MKCFG0.fuelT,2)} تن/TEU برای مسیر حدود ۵٬۸۰۰ مایل دریایی شانگهای ← خلیج فارس تخمین زده شده؛ با فرمول BAF قرارداد خط کشتیرانی جایگزین کنید.</p></div>
 <div class="sx-card"><header><b>نرخ‌های داخلی استفاده‌شده برای کالیبراسیون</b><small>چین ← بنادر ایران</small></header>${cal.R.length?`<div class="il-sc"><table class="sx-tbl mk-t"><thead><tr><th>منبع</th><th>مسیر</th><th>کانتینر</th><th>تاریخ</th><th>دلار</th><th>ضریب ضمنی</th></tr></thead><tbody>${cal.R.map(x=>`<tr><td><small>${esc(x.q.src)}${x.q.vendor?' · '+esc(x.q.vendor):''}</small></td><td>${esc(x.q.pol)} ← ${esc(x.q.pod)}</td><td>${esc(x.q.eq)}</td><td>${mkD(x.q.date)}</td><td class="num">${nf(Math.round(x.q.usd))}</td><td class="num">${nf(x.k,3)}</td></tr>`).join('')}</tbody></table></div>`:'<div class="sx-empty">هنوز نرخ دریایی چین ← ایران در «بانک نرخ» یا «مقایسهٔ پیشنهاد» ثبت نشده است. با ثبت دست‌کم ۲ نرخ واقعی، ضریب خودکار کالیبره می‌شود.</div>'}</div></div>`;
 mkBind(B);$$('[data-cf]',B).forEach(x=>x.onchange=()=>{const c=mkCfg();const k=x.dataset.cf;c[k]=x.type==='checkbox'?x.checked:x.type==='number'?(+x.value||0):x.value;mkCfgS(c);mkEstV(B)});$('.mk-rs',B).onclick=()=>{mkCfgS({});mkEstV(B)};
 const cp=$('.mk-cp',B);if(cp&&e)cp.onclick=()=>{const t='برآورد نرخ '+MKPOL[cf.pol][0]+' ← '+MKPOD[cf.pod][0]+' ('+MKEQ[cf.eq][0]+') — '+mkD(mkToday())+'\n'+e.L.map(x=>'• '+x[0]+': '+Math.round(x[1])+' $').join('\n')+'\nجمع: '+Math.round(e.tot)+' $ (بازه '+Math.round(e.lo)+'–'+Math.round(e.hi)+')\nمبنا: '+e.via+' '+mkV(e.idx)+' · منبع: سامانه لجستیک آسانا';navigator.clipboard&&navigator.clipboard.writeText(t).then(()=>toast('خلاصه کپی شد'),()=>toast('کپی ناموفق'))}}
function mkCmp(B){const Q=mkQuotes().map(q=>{const m=mkBench(q);return {q,m,d:m?(q.usd/m.m-1)*100:null}});const ok=Q.filter(x=>x.m);const avg=ok.length?ok.reduce((a,x)=>a+x.d,0)/ok.length:null;
 B.innerHTML=`<div class="ex-kpis">${kpT('پیشنهاد و نرخ دریایی',nf(Q.length),nf(ok.length)+' قابل مقایسه با بازار')}${kpT('میانگین انحراف از بازار',avg!=null?nf(avg,1)+'٪':'—',avg!=null?mkVerd(avg)[0]:'')}${kpT('بالاتر از بازار (>۱۰٪)',nf(ok.filter(x=>x.d>10).length),'')}${kpT('زیر بازار (<−۱۵٪)',nf(ok.filter(x=>x.d<-15).length),'شمول هزینه‌ها را بررسی کنید')}</div>
 <div class="sx-card"><header><b>ثبت پیشنهاد برای مقایسه</b><small>مسیرهای چین ← ایران با برآورد ایران؛ اروپا، مدیترانه و آمریکا با مسیرهای FBX</small></header><div class="mk-fm mk-fq"><label class="sx-f"><span>شرکت</span><input class="mq-v" placeholder="نام خط/فورواردر"></label><label class="sx-f"><span>مبدأ</span><input class="mq-pol" value="Shanghai"></label><label class="sx-f"><span>مقصد</span><input class="mq-pod" value="Bandar Abbas"></label><label class="sx-f"><span>کانتینر</span><select class="mq-eq">${Object.keys(MKEQ).map(k=>`<option${k==='40HC'?' selected':''}>${k}</option>`).join('')}</select></label><label class="sx-f"><span>مبلغ</span><input class="mq-a" type="number" min="0"></label><label class="sx-f"><span>ارز</span><select class="mq-c">${['USD','EUR','CNY','AED'].map(c=>`<option>${c}</option>`).join('')}</select></label><label class="sx-f"><span>تاریخ</span><input class="mq-d" type="date" value="${mkToday()}"></label><button class="sx-btn mq-add">افزودن و مقایسه</button></div></div>
 <div class="sx-card"><header><b>مقایسهٔ پیشنهادها با معیار بازار</b><div class="il-acts"><button class="sx-btn sm mq-csv"${Q.length?'':' disabled'}>خروجی CSV</button></div></header>${Q.length?`<div class="il-sc"><table class="sx-tbl mk-t"><thead><tr><th>منبع</th><th>مسیر</th><th>کانتینر</th><th>تاریخ</th><th>پیشنهاد ($)</th><th>معیار بازار ($)</th><th>انحراف</th><th>ارزیابی</th><th></th></tr></thead><tbody>${Q.map(x=>{const v=mkVerd(x.d);return `<tr><td><small>${esc(x.q.src)}</small><br>${esc(x.q.vendor||'—')}</td><td>${esc(x.q.pol)} ← ${esc(x.q.pod)}</td><td>${esc(x.q.eq)}</td><td>${mkD(x.q.date)}</td><td class="num">${nf(Math.round(x.q.usd))}</td><td class="num">${x.m?nf(Math.round(x.m.m))+'<small>'+nf(Math.round(x.m.lo))+'–'+nf(Math.round(x.m.hi))+' · '+esc(x.m.how)+'</small>':'<small>معیار ندارد</small>'}</td><td class="num">${x.d!=null?nf(x.d,1)+'٪':'—'}</td><td>${x.m?`<span class="il-vs il-${v[1]}">${v[0]}</span>`:''}</td><td>${/^mq:/.test(x.q.id)?`<button class="sx-btn sm" data-dq="${esc(x.q.id.slice(3))}" aria-label="حذف">✕</button>`:''}</td></tr>`}).join('')}</tbody></table></div>`:'<div class="sx-empty">هنوز پیشنهادی ثبت نشده است. نرخ‌های دریایی «بانک نرخ» هم خودکار اینجا مقایسه می‌شوند.</div>'}</div>`;
 $('.mq-add',B).onclick=()=>{const a=+$('.mq-a',B).value;if(!a)return toast('مبلغ را وارد کنید');const L=mkQ();L.push({id:uid(),vendor:$('.mq-v',B).value.trim(),pol:$('.mq-pol',B).value.trim(),pod:$('.mq-pod',B).value.trim(),eq:$('.mq-eq',B).value,amt:a,cur:$('.mq-c',B).value,date:$('.mq-d',B).value||mkToday()});LSS('ifa-mkt-q',L);const q=mkQuotes().pop();const m=mkBench(q);emit('quote.benchmarked',{vendor:q.vendor,lane:q.pol+' → '+q.pod,usd:q.usd,market:m&&Math.round(m.m),deviation:m?+((q.usd/m.m-1)*100).toFixed(1):null});mkCmp(B)};
 $$('[data-dq]',B).forEach(x=>x.onclick=()=>{LSS('ifa-mkt-q',mkQ().filter(q=>q.id!==x.dataset.dq));mkCmp(B)});const c=$('.mq-csv',B);if(c)c.onclick=()=>dlFile('quote-vs-market-'+mkToday()+'.csv',toCSV(['source','vendor','pol','pod','eq','date','quote_usd','market_usd','low','high','benchmark','deviation_pct','verdict'],Q.map(x=>[x.q.src,x.q.vendor,x.q.pol,x.q.pod,x.q.eq,x.q.date,Math.round(x.q.usd),x.m?Math.round(x.m.m):'',x.m?Math.round(x.m.lo):'',x.m?Math.round(x.m.hi):'',x.m?x.m.how:'',x.d!=null?x.d.toFixed(1):'',x.m?mkVerd(x.d)[0]:''])))}
function mkIntIdx(){const Q=mkQuotes().filter(q=>q.usd>0);const fe=q=>q.usd/((MKEQ[q.eqk]||MKEQ['40HC'])[1]/1.8);const M={};Q.forEach(q=>{const m=String(q.date).slice(0,7);(M[m]=M[m]||[]).push(fe(q))});const med=a=>{a=a.slice().sort((x,y)=>x-y);return a[Math.floor(a.length/2)]};
 const months=Object.keys(M).sort();const rows=months.map(m=>({m,n:M[m].length,med:med(M[m])}));const b=rows.length?rows[0].med:1;rows.forEach(r=>r.idx=r.med/b*100);
 const lanes={};Q.forEach(q=>{const k=(q.polk||q.pol)+' → '+(MKPOD[q.podk]?MKPOD[q.podk][0]:q.pod);(lanes[k]=lanes[k]||[]).push({...q,fe:fe(q)})});return {rows,lanes,Q}}
function mkInt(B){const I=mkIntIdx();const sc=mkGet().S['scfi.T'];const fb=mkGet().S['fbx.FBX'];const mo=s=>{if(!s)return [];const M={};s.pts.forEach(([d,v])=>{(M[d.slice(0,7)]=M[d.slice(0,7)]||[]).push(v)});return Object.keys(M).sort().map(m=>[m+'-15',M[m].reduce((a,x)=>a+x,0)/M[m].length])};
 B.innerHTML=`<div class="cd-warn">${svgI(IC.info||IC.shield||'')}<div><b>شاخص داخلی آسانا</b> از نرخ‌های واقعی سازمان شما ساخته می‌شود: نرخ‌های دریایی «بانک نرخ» + پیشنهادهای ثبت‌شده در «مقایسه» + فایل‌های CSV واردشده. همهٔ نرخ‌ها به معادل ۴۰ فوت (FEU) تبدیل و میانهٔ ماهانه محاسبه می‌شود (پایه = ۱۰۰ در نخستین ماه). در کنار FBX و SCFI، تفاوت بازار شما با بازار جهانی را نشان می‌دهد.</div></div>
 <div class="ex-kpis">${kpT('نرخ‌های داخلی',nf(I.Q.length),nf(Object.keys(I.lanes).length)+' مسیر')}${kpT('ماه‌های پوشش',nf(I.rows.length),I.rows.length?mkD(I.rows[0].m+'-01')+' تا '+mkD(I.rows[I.rows.length-1].m+'-01'):'')}${kpT('آخرین شاخص',I.rows.length?nf(I.rows[I.rows.length-1].idx,1):'—',I.rows.length?'میانه '+nf(Math.round(I.rows[I.rows.length-1].med))+' $/FEU':'')}</div>
 <div class="sx-card"><header><b>شاخص داخلی در برابر FBX و SCFI (پایه ۱۰۰)</b></header>${I.rows.length>=1?mkChart([{n:'شاخص داخلی',c:'#E97366',pts:I.rows.map(r=>[r.m+'-15',r.med])},{n:'FBX جهانی',c:'#5E9FE8',pts:mo(fb).filter(p=>!I.rows.length||p[0]>=I.rows[0].m)},{n:'SCFI',c:'#72BC8F',pts:mo(sc).filter(p=>!I.rows.length||p[0]>=I.rows[0].m)}],{norm:true,w:1000,h:260}):'<div class="sx-empty">برای ساخت شاخص داخلی دست‌کم یک نرخ دریایی در «بانک نرخ» یا «مقایسهٔ پیشنهاد» ثبت کنید.</div>'}</div>
 <div class="cd-g2 mk-g2"><div class="sx-card"><header><b>میانهٔ ماهانه</b></header><table class="sx-tbl mk-t"><thead><tr><th>ماه</th><th>تعداد</th><th>میانه $/FEU</th><th>شاخص</th></tr></thead><tbody>${I.rows.map(r=>`<tr><td>${mkD(r.m+'-01')}</td><td class="num">${nf(r.n)}</td><td class="num">${nf(Math.round(r.med))}</td><td class="num">${nf(r.idx,1)}</td></tr>`).join('')||'<tr><td colspan="4">—</td></tr>'}</tbody></table></div>
 <div class="sx-card"><header><b>مسیرها</b></header><div class="il-sc"><table class="sx-tbl mk-t"><thead><tr><th>مسیر</th><th>تعداد</th><th>کمینه</th><th>میانه</th><th>بیشینه $/FEU</th></tr></thead><tbody>${Object.entries(I.lanes).sort((a,b)=>b[1].length-a[1].length).map(([k,L])=>{const v=L.map(x=>x.fe).sort((a,b)=>a-b);return `<tr><td>${esc(k)}</td><td class="num">${nf(L.length)}</td><td class="num">${nf(Math.round(v[0]))}</td><td class="num">${nf(Math.round(v[Math.floor(v.length/2)]))}</td><td class="num">${nf(Math.round(v[v.length-1]))}</td></tr>`}).join('')||'<tr><td colspan="5">—</td></tr>'}</tbody></table></div></div></div>`}
function mkImp(B){const D=mkGet();const M=mkMan();const ids=Object.values(D.S).sort((a,b)=>a.name.localeCompare(b.name,'fa'));const sel=MKS.msid||'';MKS.msid='';
 B.innerHTML=`<div class="cd-g2 mk-g2"><div class="sx-card"><header><b>ثبت دستی نقطهٔ داده</b><small>مثلاً نرخ SCFI خلیج فارس از گزارش اشتراکی یا نرخ محلی</small></header><div class="mk-fm"><label class="sx-f mk-w2"><span>سری</span><select class="mm-s"><option value="">— سری جدید —</option>${ids.map(s=>`<option value="${esc(s.id)}"${s.id===sel?' selected':''}>${esc(s.name)} (${esc(s.id)})</option>`).join('')}</select></label>
 <label class="sx-f mm-n"><span>شناسهٔ سری جدید</span><input class="mm-id" placeholder="man.scfi.pg" dir="ltr"></label><label class="sx-f mm-n"><span>نام</span><input class="mm-nm" placeholder="SCFI خلیج فارس/دبی"></label><label class="sx-f mm-n"><span>واحد</span><input class="mm-u" placeholder="USD/TEU" dir="ltr"></label><label class="sx-f mm-n"><span>نوع</span><select class="mm-k">${Object.entries(MKK).map(([k,n])=>`<option value="${k}">${n}</option>`).join('')}</select></label>
 <label class="sx-f"><span>تاریخ</span><input class="mm-d" type="date" value="${mkToday()}"></label><label class="sx-f"><span>مقدار</span><input class="mm-v" type="number" step="any"></label><label class="sx-f mk-w2"><span>یادداشت / منبع</span><input class="mm-no" placeholder="مثلاً گزارش هفتگی SSE"></label><button class="sx-btn mm-add">ثبت</button></div></div>
 <div class="sx-card"><header><b>ورود CSV یا Excel</b><small>ستون‌ها: series_id, date, value و اختیاری name, unit, kind</small><div class="il-acts"><button class="sx-btn sm mm-tpl">دریافت الگو</button></div></header><div class="mk-drop"><input type="file" class="mm-f" accept=".csv,.txt,.xlsx"><p>تاریخ به‌صورت YYYY-MM-DD میلادی. برای پیشنهادهای حمل از الگوی دوم استفاده کنید (pol, pod, eq, amount, currency, date, vendor) — به «مقایسه» و «شاخص داخلی» اضافه می‌شود.</p><button class="sx-btn sm mm-tq">الگوی پیشنهادهای حمل</button></div><div class="mm-r"></div></div></div>
 <div class="sx-card"><header><b>نقاط ثبت‌شدهٔ دستی (${nf(M.length)})</b><small>${svOn()?'با سرور تیمی همگام می‌شود':'ذخیرهٔ محلی مرورگر'}</small><div class="il-acts"><button class="sx-btn sm mm-clr"${M.length?'':' disabled'}>پاک‌کردن همه</button></div></header>${M.length?`<div class="il-sc"><table class="sx-tbl mk-t"><thead><tr><th>سری</th><th>تاریخ</th><th>مقدار</th><th>یادداشت</th><th>ثبت</th><th></th></tr></thead><tbody>${M.slice().reverse().slice(0,300).map(p=>`<tr><td>${esc((D.S[p.id]||{}).name||p.id)}<small class="mk-id">${esc(p.id)}</small></td><td>${mkD(p.date)}</td><td class="num">${mkV(+p.value)}</td><td><small>${esc(p.note||'')}</small></td><td><small>${esc(p.by||'')} ${p.t?mkDT(p.t):''}</small></td><td><button class="sx-btn sm" data-dm="${esc(p.k)}" aria-label="حذف">✕</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="sx-empty">هنوز نقطه‌ای ثبت نشده است.</div>'}</div>`;
 const s=$('.mm-s',B);const tg=()=>$$('.mm-n',B).forEach(x=>x.style.display=s.value?'none':'');s.onchange=tg;tg();
 const addPts=(rows)=>{const L=mkMan();const by=(SV.st.user&&(SV.st.user.name||SV.st.user.username))||'';let n=0;rows.forEach(r=>{if(!r.id||!/^\d{4}-\d{2}-\d{2}$/.test(r.date)||!isFinite(+r.value))return;L.push({k:uid(),id:String(r.id).slice(0,60),date:r.date,value:+r.value,name:r.name||'',unit:r.unit||'',kind:MKK[r.kind]?r.kind:(D.S[r.id]||{}).kind||'freight',note:r.note||'',by,t:Date.now()});n++});LSS('ifa-mkt-man',L.slice(-5000));mkBump();return n};
 $('.mm-add',B).onclick=()=>{const id=s.value||$('.mm-id',B).value.trim();const v=$('.mm-v',B).value;if(!id||v==='')return toast('سری و مقدار لازم است');if(!s.value&&!/^[a-z0-9._-]{2,60}$/i.test(id))return toast('شناسهٔ سری: حروف لاتین، عدد، نقطه و خط تیره');
  addPts([{id:s.value?id:(id.startsWith('man.')?id:'man.'+id),date:$('.mm-d',B).value,value:v,name:s.value?'':$('.mm-nm',B).value.trim()||id,unit:s.value?'':$('.mm-u',B).value.trim(),kind:s.value?'':$('.mm-k',B).value,note:$('.mm-no',B).value.trim()}]);toast('نقطهٔ داده ثبت شد');mkImp(B)};
 $('.mm-tpl',B).onclick=()=>dlFile('market-points-template.csv',toCSV(['series_id','date','value','name','unit','kind'],[['scfi.T','2026-09-26','3686.6','','',''],['man.scfi.pg','2026-09-26','1450','SCFI Persian Gulf/Dubai','USD/TEU','freight']]));
 $('.mm-tq',B).onclick=()=>dlFile('freight-quotes-template.csv',toCSV(['pol','pod','eq','amount','currency','date','vendor'],[['Shanghai','Bandar Abbas','40HC','2950','USD','2026-09-20','Sample Line']]));
 $('.mm-f',B).onchange=async e=>{const f=e.target.files[0];if(!f)return;const R=$('.mm-r',B);try{const buf=await f.arrayBuffer();const rows=/\.xlsx$/i.test(f.name)?await readXlsx(buf):readCsv(new TextDecoder().decode(buf));if(!rows.length)throw new Error('فایل خالی است');const H=rows[0].map(h=>nkey(h).replace(/\s+/g,'_'));const ix=k=>H.findIndex(h=>h===k||h.includes(k));const dt=v=>{v=String(v||'').trim();if(/^\d{5}(\.\d+)?$/.test(v))return new Date((+v-25569)*864e5).toISOString().slice(0,10);const m=v.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/);return m?m[1]+'-'+m[2].padStart(2,'0')+'-'+m[3].padStart(2,'0'):''};
  if(ix('pol')>=0&&ix('pod')>=0){const L=mkQ();let n=0;rows.slice(1).forEach(r=>{const a=+String(r[ix('amount')]||r[ix('amt')]||'').replace(/,/g,'');if(!a)return;L.push({id:uid(),pol:String(r[ix('pol')]||''),pod:String(r[ix('pod')]||''),eq:String(r[ix('eq')]||'40HC'),amt:a,cur:String(r[ix('currency')]||r[ix('cur')]||'USD').toUpperCase(),date:dt(r[ix('date')])||mkToday(),vendor:String(r[ix('vendor')]||'')});n++});LSS('ifa-mkt-q',L);R.innerHTML=`<p class="mk-ok">${nf(n)} پیشنهاد حمل وارد شد.</p>`;toast(nf(n)+' پیشنهاد وارد شد');return}
  const si=ix('series'),di=ix('date'),vi=ix('value');if(si<0||di<0||vi<0)throw new Error('ستون‌های series_id، date و value یافت نشد');const P=rows.slice(1).map(r=>({id:String(r[si]||'').trim(),date:dt(r[di]),value:String(r[vi]).replace(/,/g,''),name:ix('name')>=0?r[ix('name')]:'',unit:ix('unit')>=0?r[ix('unit')]:'',kind:ix('kind')>=0?r[ix('kind')]:''}));const n=addPts(P);toast(nf(n)+' نقطه وارد شد');mkImp(B);const R2=$('.mm-r',B);if(R2)R2.innerHTML=`<p class="mk-ok">${nf(n)} از ${nf(P.length)} ردیف وارد شد${P.length-n?' · '+nf(P.length-n)+' ردیف نامعتبر رد شد':''}.</p>`}catch(err){R.innerHTML=`<p class="mk-er">خطا: ${esc(err.message)}</p>`}};
 $$('[data-dm]',B).forEach(x=>x.onclick=()=>{LSS('ifa-mkt-man',mkMan().filter(p=>p.k!==x.dataset.dm));mkBump();mkImp(B)});$('.mm-clr',B).onclick=()=>{if(!confirm('همهٔ نقاط دستی حذف شوند؟'))return;LSS('ifa-mkt-man',[]);mkBump();mkImp(B)}}
function mkAlrV(B){const D=mkGet();const ids=Object.values(D.S).sort((a,b)=>a.name.localeCompare(b.name,'fa'));const E=mkAlertEval(false);const pre=MKS.asid||'fbx.FBX';MKS.asid='';
 B.innerHTML=`<div class="sx-card"><header><b>افزودن هشدار</b><small>هنگام به‌روزرسانی داده بررسی می‌شود؛ با سرور تیمی از طریق قوانین اعلان (بله، تلگرام، پیامک) هم ارسال می‌شود.</small></header><div class="mk-fm mk-fq"><label class="sx-f mk-w2"><span>سری</span><select class="ma-s">${ids.map(s=>`<option value="${esc(s.id)}"${s.id===pre?' selected':''}>${esc(s.name)}</option>`).join('')}</select></label><label class="sx-f"><span>شرط</span><select class="ma-o"><option value="gt">بیشتر از</option><option value="lt">کمتر از</option><option value="chg">تغییر دوره‌ای بیش از (٪)</option></select></label><label class="sx-f"><span>مقدار</span><input class="ma-v" type="number" step="any"></label><button class="sx-btn ma-add">افزودن</button></div></div>
 <div class="sx-card"><header><b>هشدارها (${nf(E.length)})</b></header>${E.length?`<table class="sx-tbl mk-t"><thead><tr><th>سری</th><th>شرط</th><th>مقدار فعلی</th><th>وضعیت</th><th></th></tr></thead><tbody>${E.map(x=>{const s=D.S[x.a.sid];return `<tr><td>${esc(s?s.name:x.a.sid)}</td><td>${mkOp(x.a)}</td><td class="num">${x.t?mkV(x.t.v,s)+(x.t.chg!=null?' <small>('+nf(x.t.chg,1)+'٪)</small>':''):'—'}</td><td>${x.a.off?'<span class="il-vs il-chk">غیرفعال</span>':x.hit?'<span class="il-vs il-bad">فعال‌شده</span>':'<span class="il-vs il-ok">عادی</span>'}</td><td class="mk-ac"><button class="sx-btn sm" data-ta="${esc(x.a.id)}">${x.a.off?'فعال':'توقف'}</button><button class="sx-btn sm" data-da="${esc(x.a.id)}" aria-label="حذف">✕</button></td></tr>`}).join('')}</tbody></table>`:'<div class="sx-empty">هشداری تعریف نشده است. مثال: «VLSFO فجیره بیشتر از ۱۰۰۰» یا «FBX تغییر بیش از ۱۰٪».</div>'}</div>`;
 $('.ma-add',B).onclick=()=>{const v=+$('.ma-v',B).value;if(!$('.ma-v',B).value)return toast('مقدار لازم است');const L=mkAlr();L.push({id:uid(),sid:$('.ma-s',B).value,op:$('.ma-o',B).value,v});LSS('ifa-mkt-alr',L);mkAlertEval(true);mkAlrV(B)};
 $$('[data-da]',B).forEach(x=>x.onclick=()=>{LSS('ifa-mkt-alr',mkAlr().filter(a=>a.id!==x.dataset.da));mkAlrV(B)});$$('[data-ta]',B).forEach(x=>x.onclick=()=>{LSS('ifa-mkt-alr',mkAlr().map(a=>a.id===x.dataset.ta?{...a,off:!a.off}:a));mkAlrV(B)})}
function mkSrc(B){const D=mkGet();const cnt=k=>Object.values(D.S).filter(s=>s.src===k).length;
 B.innerHTML=mkBar()+`<div class="sx-card"><header><b>منابع داده و وضعیت جمع‌آوری</b><small>جمع‌آوری اصلی روی سرور تیمی انجام می‌شود (محدودیت CORS مرورگر)؛ هر دریافت با هش SHA-256 و نسخهٔ خام بایگانی می‌شود.</small></header><div class="il-sc"><table class="sx-tbl mk-t"><thead><tr><th>منبع</th><th>داده</th><th>مجوز / شرایط</th><th>سری</th><th>آخرین دریافت موفق</th><th>وضعیت</th><th>مرورگر</th></tr></thead><tbody>${Object.values(D.src).filter(x=>x.id!=='man'||cnt('man')).map(x=>{const st=x.status;return `<tr><td><b>${esc(x.name)}</b>${x.unofficial?' <span class="mk-uo">غیررسمی</span>':''}${x.url?`<br><a href="${esc(x.url)}" target="_blank" rel="noopener" dir="ltr" class="mk-ln">${esc(x.url.replace(/^https?:\/\//,'').slice(0,46))}</a>`:''}</td><td><small>${esc(x.what||'')}</small></td><td><small>${esc(x.licence||'')}</small></td><td class="num">${nf(cnt(x.id))}</td><td><small>${st&&st.lastOk?mkDT(st.lastOk):x.seedOk?mkDT(x.seedOk)+' (نسخهٔ همراه)':'—'}</small></td><td>${st?(st.ok?'<span class="il-vs il-ok">موفق</span>':st.ok===false?`<span class="il-vs il-bad" title="${esc(st.err||'')}">ناموفق</span><small>${esc(String(st.err||'').slice(0,80))}</small>`:'—'):'<span class="il-vs il-chk">نسخهٔ همراه</span>'}</td><td>${x.br?'✓':'—'}</td></tr>`}).join('')}</tbody></table></div></div>
 <div class="sx-card"><header><b>اصول حاکمیت داده</b></header><ul class="il-ul"><li><b>شفافیت منبع:</b> هر عدد با منبع، تاریخ داده، زمان دریافت و مبدأ (سرور، مرورگر، دستی، نسخهٔ همراه) نگهداری می‌شود.</li><li><b>اعتبارسنجی:</b> مقادیر خارج از بازهٔ منطقی رد و پرش‌های غیرعادی «مشکوک» علامت می‌خورند؛ درصد اطمینان = اعتبار منبع × تازگی × آزمون پرش.</li><li><b>نرخ غیررسمی:</b> TGJU و Bonbast فقط برای مرجع داخلی و برآورد هزینه‌اند و در اسناد رسمی استفاده نشوند.</li><li><b>مجوز:</b> FBX، SCFI و Ship & Bunker دادهٔ عمومی محدود می‌دهند؛ برای استفادهٔ تجاری، بازنشر به مشتری یا دادهٔ تفصیلی مسیرها اشتراک رسمی تهیه کنید. داده‌های ECB، EIA، بانک جهانی (CC BY 4.0) و NY Fed با ذکر منبع قابل استفاده‌اند.</li><li><b>بایگانی:</b> سرور پاسخ خام هر دریافت را ${nf(60)} روز نگه می‌دارد (قابل تنظیم در config.json → market.rawDays) تا هر عدد قابل ردیابی باشد.</li><li><b>منابع رسمی ایران:</b> سامانه‌های بانک مرکزی، مرکز مبادله و سازمان بنادر از محیط توسعه در دسترس نبودند؛ نرخ‌های رسمی را از «ورود دستی» ثبت کنید.</li></ul></div>`;mkBind(B)}
/* ---------- integrations: rate bank, RFQ, cost, live-rates hubs ---------- */
function mkHub(title,sub,body,btn,go){const d=document.createElement('div');d.className='sx-card il-hub mk-hub';d.innerHTML=`<header><b>${title}</b><small>${sub}</small><div class="il-acts"><button class="sx-btn sm">${btn}</button></div></header>${body||''}`;$('button',d).onclick=()=>{MKS.sub=go;open('mkt')};return d}
const mkMini=ids=>`<div class="mk-mini">${ids.map(id=>{const s=mkGet().S[id],t=mkStat(s);return t?`<span><small>${esc(s.name)}</small><b>${mkV(t.v,s)}</b>${mkChg(t,s)}</span>`:''}).join('')}</div>`;
{const _r=rRate;rRate=function(b,C){_r(b,C);try{const Q=mkQuotes().filter(q=>q.id.startsWith('rb:'));const X=Q.map(q=>{const m=mkBench(q);return m?(q.usd/m.m-1)*100:null}).filter(x=>x!=null);b.appendChild(mkHub('مقایسهٔ نرخ‌ها با بازار',X.length?nf(X.length)+' نرخ دریایی با معیار بازار مقایسه شد · میانگین انحراف '+nf(X.reduce((a,x)=>a+x,0)/X.length,1)+'٪ · '+nf(X.filter(x=>x>10).length)+' بالاتر از بازار':'نرخ‌های دریایی چین ← ایران، اروپا و آمریکا با FBX/SCFI و برآورد ایران مقایسه می‌شوند',mkMini(['fbx.FBX','scfi.T','bnk.VLSFO.fujairah']),'مقایسه با بازار','cmp'))}catch(e){console.error(e)}}}
{const _r=rRfq;rRfq=function(b,C){_r(b,C);try{const e=mkEst({eq:'40HC'});b.appendChild(mkHub('معیار بازار برای این استعلام',e?'برآورد دریایی شانگهای ← بندرعباس ۴۰ فوت: '+nf(Math.round(e.tot))+' $ (بازه '+nf(Math.round(e.lo))+'–'+nf(Math.round(e.hi))+')':'دادهٔ بازار موجود نیست',mkMini(['fbx.FBX','scfi.T','fbx.FBX11']),'برآورد و مقایسه','est'))}catch(e){console.error(e)}}}
{const _r=rCost;rCost=function(b,C){_r(b,C);try{b.appendChild(mkHub('نشانگرهای بازار مؤثر بر هزینه','سوخت، نفت و نرخ ارز آزاد — با تاریخ و منبع',mkMini(['bnk.VLSFO.fujairah','oil.brent','fx.tgju.USDIRR','fx.ecb.EURUSD']),'قیمت‌های بازار','ov'))}catch(e){console.error(e)}}}
{const _r=rFc;rFc=function(b,C){_r(b,C);try{b.insertBefore(mkHub('شاخص‌های واقعی بازار حمل','FBX، SCFI، سوخت و ارز از منابع عمومی؛ پیش‌بینی این زبانه مدل شبیه‌سازی است',mkMini(['fbx.FBX','scfi.T','bnk.VLSFO.singapore','macro.gscpi']),'مشاهدهٔ داده‌های واقعی','idx'),b.firstChild)}catch(e){console.error(e)}}}
window.__MKT_PAL=X=>{[['ov','نمای کلی قیمت‌های بازار حمل (FBX، SCFI، سوخت، ارز)'],['idx','همهٔ شاخص‌ها و سری‌های بازار'],['est','برآورد نرخ حمل چین ← ایران و ماشین‌حساب BAF'],['cmp','مقایسهٔ پیشنهاد حمل با بازار'],['int','شاخص داخلی نرخ حمل'],['imp','ورود دستی و CSV دادهٔ بازار'],['alr','هشدارهای قیمت بازار'],['src','منابع و مجوز دادهٔ بازار']].forEach(([k,t])=>X.push({g:'قیمت‌های بازار حمل',t,run:()=>{MKS.sub=k;open('mkt')}}));
 MKKEY.forEach(id=>{const s=mkGet().S[id];if(s)X.push({g:'قیمت‌های بازار حمل',t:s.name+' — '+mkV(mkLast(id),s)+' '+s.unit,run:()=>{MKS.sub='ov';open('mkt');setTimeout(()=>mkDlg(id),60)}})})};
function mkApi(){const pub=s=>{const t=mkStat(s);return s&&{id:s.id,name:s.name,unit:s.unit,kind:s.kind,source:s.src,unofficial:s.unofficial,last:t&&{date:t.d,value:t.v,change:t.chg,fresh:t.fresh,confidence:t.conf,suspect:t.sus,origin:t.orig}}};
 return {series:(kind)=>Object.values(mkGet().S).filter(s=>!kind||s.kind===kind).map(pub),get:id=>{const s=mkGet().S[id];return s?{...pub(s),points:s.pts.slice()}:null},last:mkLast,at:(id,date)=>mkAt(id,date),
  estimate:(o={})=>{const e=mkEst({pol:o.pol||o.origin||'Shanghai',pod:o.pod||o.destination||'BND',eq:o.eq||o.container||'40HC',...(o.params||{})},o.date);return e&&{total:Math.round(e.tot),low:Math.round(e.lo),high:Math.round(e.hi),index:e.via,indexValue:e.idx,indexDate:e.date,calibration:{k:e.k,quotes:e.cal.n,auto:!!e.cf.autoCal},breakdown:e.L.map(x=>({item:x[0],usd:Math.round(x[1]),basis:x[2]})),fxRate:e.fx}},
  benchmark:q=>{const x={...q,usd:typeof pU==='function'?pU(q.amt||q.amount,q.cur||q.currency||'USD'):+(q.amt||q.amount),eqk:mkEqK(q.eq),podk:mkPodK(q.pod),polk:mkPolK(q.pol),date:q.date||mkToday()};const m=mkBench(x);return m?{market:Math.round(m.m),low:Math.round(m.lo),high:Math.round(m.hi),basis:m.how,deviationPct:+((x.usd/m.m-1)*100).toFixed(1),verdict:mkVerd((x.usd/m.m-1)*100)[0]}:null},
  internalIndex:()=>{const I=mkIntIdx();return I.rows.map(r=>({month:r.m,count:r.n,medianUsdFeu:Math.round(r.med),index:+r.idx.toFixed(1)}))},sources:()=>Object.values(mkGet().src).map(x=>({id:x.id,name:x.name,url:x.url,licence:x.licence,unofficial:!!x.unofficial,status:x.status||null})),
  addPoints:rows=>{const L=mkMan();let n=0;(rows||[]).forEach(r=>{if(r&&r.id&&/^\d{4}-\d{2}-\d{2}$/.test(r.date)&&isFinite(+r.value)){L.push({k:uid(),id:String(r.id),date:r.date,value:+r.value,name:r.name||'',unit:r.unit||'',kind:r.kind||'',note:r.note||'api',t:Date.now()});n++}});LSS('ifa-mkt-man',L);mkBump();return n},
  refresh:()=>svOn()?mkSync(svCan('market.refresh')).then(()=>true):mkBrowser().then(r=>r.n),alerts:()=>mkAlertEval(false).map(x=>({series:x.a.sid,rule:mkOp(x.a),hit:x.hit,value:x.t&&x.t.v})),open:sub=>{MKS.sub=sub||'ov';open('mkt')}}}

/* ===== v20: UI normalizer — typography floor, scrollable overflowing tables, equal-height card rows ===== */
(()=>{let T=0,LR=0;const run=()=>{T=0;LR=Date.now();const B=document.querySelector('.sx-body');if(!B||!B.isConnected)return;try{
 const S=[...B.querySelectorAll('small,i,u,em,sub,sup,.sx-muted')].filter(e=>!e.style.fontSize&&!e.closest('svg'));const fz=S.map(e=>parseFloat(getComputedStyle(e).fontSize));
 const Tb=[...B.querySelectorAll('table')].filter(t=>!t.classList.contains('u-tsc'));const tw=Tb.map(t=>{const p=t.parentElement;if(!p)return false;const ps=getComputedStyle(p),r=t.getBoundingClientRect();if(r.width<1)return false;const cw=p.clientWidth-parseFloat(ps.paddingLeft)-parseFloat(ps.paddingRight);return r.width>cw+2&&!/auto|scroll/.test(ps.overflowX)});
 const P=new Set();B.querySelectorAll('.sx-card,.sx-kpi').forEach(c=>{const p=c.parentElement;if(p&&!p.classList.contains('u-eq')&&!p.dataset.eq)P.add(p)});const eq=[];
 P.forEach(p=>{const s=getComputedStyle(p);if(!/flex|grid/.test(s.display)||s.alignItems==='stretch'||s.alignItems==='normal'||(s.display.includes('flex')&&s.flexDirection.startsWith('column')))return;const rows={};[...p.children].filter(x=>(x.classList.contains('sx-card')||x.classList.contains('sx-kpi'))&&x.offsetParent).forEach(x=>{const r=x.getBoundingClientRect();(rows[Math.round(r.top/6)]=rows[Math.round(r.top/6)]||[]).push(r.height)});
  let ok=false,bad=false;Object.values(rows).forEach(h=>{if(h.length<2)return;const mx=Math.max(...h),mn=Math.min(...h);if(mx-mn>10){if(mx/mn<=1.8)ok=true;else bad=true}});eq.push([p,ok&&!bad?1:bad?2:0])});
 S.forEach((e,i)=>{if(fz[i]<10&&e.textContent.trim()){e.style.fontSize='10px';e.style.lineHeight='1.45'}});Tb.forEach((t,i)=>{if(tw[i])t.classList.add('u-tsc')});eq.forEach(([p,v])=>{if(v===1)p.classList.add('u-eq');else if(v===2)p.dataset.eq='x'})}catch(e){console.error('uiNorm',e)}};
 const sch=(slow)=>{if(T)return;const d=slow?Math.max(60,1000-(Date.now()-LR)):60;T=setTimeout(()=>requestAnimationFrame(run),d)};window.__uiNorm=run;
 const mo=new MutationObserver(m=>{for(const x of m){if(x.type==='attributes'&&/\bu-(eq|tsc)\b/.test(x.target.className||''))continue;if(x.target.closest&&x.target.closest('.sx-body')){sch(x.type==='attributes');return}}});
 const start=()=>{mo.observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['class','open']});document.addEventListener('click',e=>{if(e.target.closest&&e.target.closest('.sx-body'))setTimeout(sch,250)},true);addEventListener('resize',()=>{const B=document.querySelector('.sx-body');if(B){B.querySelectorAll('[data-eq]').forEach(e=>delete e.dataset.eq);B.querySelectorAll('.u-eq').forEach(e=>e.classList.remove('u-eq'))}sch()})};
 if(document.body)start();else addEventListener('DOMContentLoaded',start)})();

/* ===== Live rates, calendar / schedule engine, forecasting ===== */
const HOLX='IR,TR,PK,AF,AZ,TM,UZ,KZ,KG,TJ,IQ,AE,OM';
const HOL=[['CN','2025-01-28','2025-02-04','عید بهار چین'],['CN','2026-02-15','2026-02-23','عید بهار چین'],['CN','2027-02-05','2027-02-11','عید بهار چین'],
 ['IR','*-03-20','*-03-24','نوروز'],['IR','*-04-01','*-04-02','نوروز (۱۲–۱۳ فروردین)'],
 [HOLX,'2025-03-30','2025-04-01','عید فطر'],[HOLX,'2026-03-20','2026-03-22','عید فطر'],[HOLX,'2027-03-10','2027-03-12','عید فطر'],
 [HOLX,'2025-06-06','2025-06-08','عید قربان'],[HOLX,'2026-05-27','2026-05-29','عید قربان'],[HOLX,'2027-05-16','2027-05-18','عید قربان'],
 ['IR,IQ,PK','2025-07-05','2025-07-06','تاسوعا و عاشورا'],['IR,IQ,PK','2026-06-24','2026-06-25','تاسوعا و عاشورا'],['IR,IQ,PK','2027-06-14','2027-06-15','تاسوعا و عاشورا'],['CN','2028-01-25','2028-02-01','عید بهار چین'],[HOLX,'2028-02-26','2028-02-28','عید فطر'],[HOLX,'2028-05-04','2028-05-06','عید قربان'],['IR,IQ,PK','2028-06-02','2028-06-03','تاسوعا و عاشورا'],
 ['CN','*-10-01','*-10-07','هفتهٔ طلایی چین'],['KZ,UZ,TM,KG,TJ,AZ,AF','*-03-21','*-03-23','نوروز آسیای مرکزی'],['RU,KZ,KG','*-01-01','*-01-08','تعطیلات سال نو'],['TR','*-04-23','*-04-23','تعطیل رسمی ترکیه']];
let HOLC=null;
function holidays(){if(HOLC)return HOLC;HOLC=[];const y0=new Date().getFullYear();HOL.forEach(([cs,a,b,n])=>{const ys=a[0]==='*'?[y0-1,y0,y0+1,y0+2]:[0];
 ys.forEach(y=>{const A=a.replace('*',y),B=b.replace('*',y);HOLC.push({cs:cs.split(','),s:Date.parse(A+'T00:00:00Z'),e:Date.parse(B+'T00:00:00Z')+DAY,n})})});
 LSG('ifa-hol',[]).forEach(h=>HOLC.push({cs:h.cs,s:Date.parse(h.a+'T00:00:00Z'),e:Date.parse(h.b+'T00:00:00Z')+DAY,n:h.n}));return HOLC}
const holidayAt=(cc,t)=>holidays().find(h=>h.cs.includes(cc)&&t>=h.s&&t<h.e)||null;
const hsh=s=>{let h=2166136261;for(const c of String(s))h=Math.imul(h^c.charCodeAt(0),16777619);return h>>>0};
const FREQ={daily:'روزانه','3perweek':'۳ بار در هفته',weekly:'هفتگی',biweekly:'دوهفته‌یک‌بار'};
const WD=['یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنجشنبه','جمعه','شنبه'];
function depDays(e){const f=e.frequency||'daily',h=hsh(e.id||'x');if(f==='daily')return [0,1,2,3,4,5,6];if(f==='3perweek'){const a=h%7;return [a,(a+2)%7,(a+4)%7].sort()}return [h%7]}
function nextDep(e,t,l){const S=LSG('ifa-sched',{});const key=l.from+'>'+l.to;if(S[key]&&S[key].length){const n=S[key].map(d=>Date.parse(d)).filter(x=>x>=t).sort((a,b)=>a-b)[0];if(n)return {t:n,src:'برنامهٔ واردشده'}}
 if(l.mode==='road'||l.mode==='air'&&!e.frequency)return {t,src:null};const f=e.frequency||'daily';const days=depDays(e);const hh=8+(hsh(e.id)%10);
 for(let k=0;k<40;k++){const d=new Date(t+k*DAY);d.setUTCHours(hh,0,0,0);const c=d.getTime();if(c<t)continue;if(!days.includes(d.getUTCDay()))continue;
  if(f==='biweekly'&&Math.floor(c/(7*DAY))%2!==(hsh(e.id)>>3)%2)continue;return {t:c,src:FREQ[f]||f}}return {t,src:null}}
/* dated plan for a route from ready time */
function plan(R,t0,o={}){const G=ctx().G;const ev=[];let t=t0,wait=0,hold=0;const T=R.timeline&&R.timeline.length?R.timeline:R.legs.map((l,i)=>({kind:'leg',legIndex:i,start:0,end:l.hours||l.distanceKm/50}));
 const holdAt=(cc,label,nid)=>{let h;let g=0;while((h=holidayAt(cc,t))&&g++<20){const e2=h.e+8*HR;ev.push({k:'hold',n:h.n+' · '+label,s:t,e:e2,cc,nid});hold+=e2-t;t=e2}};
 T.forEach((s,si)=>{const d=Math.max(0,(s.end-s.start))*HR*(o.mult||1);
  if(s.kind==='leg'){const l=R.legs[s.legIndex];if(!l)return;const e=l.edge||{};const nf0=G.nodeById[l.from];
   if(si===0||s.legIndex===0){nf0&&holdAt(nf0.country,'مبدأ',l.from)}
   const pl=R.legs[s.legIndex-1];const through=pl&&pl.mode===l.mode&&l.mode!=='sea';const nd=through?{t,src:null}:nextDep(e,t,l);if(nd.t>t){ev.push({k:'wait',n:'انتظار حرکت · '+nd.src,s:t,e:nd.t,nid:l.from});wait+=nd.t-t;t=nd.t}
   ev.push({k:'leg',n:nname(l.from)+' → '+nname(l.to),mode:l.mode,s:t,e:t+d,li:s.legIndex,from:l.from,to:l.to,freq:e.frequency,src:nd.src});t+=d}
  else{const n=G.nodeById[s.nodeId];if(n&&(n.type==='border'||n.crossBorder||/customs|port/i.test(n.type||'')||s.kind==='dwell'))holdAt(n.country,n.nameFa,n.id);
   if(d>0)ev.push({k:'node',n:(n?n.nameFa:s.nodeId)+(s.label?' · '+s.label:''),s:t,e:t+d,nid:s.nodeId});t+=d}});
 const last=G.nodeById[R.nodeSeq[R.nodeSeq.length-1]];if(last){holdAt(last.country,'ترخیص مقصد',last.id)}
 return {ev,t0,eta:t,days:(t-t0)/DAY,wait:wait/HR,hold:hold/HR}}
/* ----- live FX ----- */
const FXC=['USD','EUR','CNY','AED','TRY','RUB','INR','KZT','UZS','TMT','AZN','PKR','IRR'];const FXN={USD:'دلار آمریکا',EUR:'یورو',CNY:'یوان چین',AED:'درهم امارات',TRY:'لیر ترکیه',RUB:'روبل روسیه',INR:'روپیهٔ هند',KZT:'تنگهٔ قزاقستان',UZS:'سوم ازبکستان',TMT:'منات ترکمنستان',AZN:'منات آذربایجان',PKR:'روپیهٔ پاکستان',IRR:'ریال (رسمی)'};
const FX={d:LSG('ifa-fx',null),busy:false,err:''};
async function fxLoad(force){if(!force&&FX.d&&Date.now()-FX.d.t<6*HR)return FX.d;FX.busy=true;FX.err='';
 const url=LSG('ifa-fxurl','')||'https://open.er-api.com/v6/latest/USD';
 try{const r=await fetch(url,{cache:'no-store'});const j=await r.json();const rates=j.rates||j.conversion_rates||j.data||j;if(!rates||!rates.EUR)throw new Error('ساختار پاسخ نامعتبر');
  FX.d={t:Date.now(),src:url,upd:j.time_last_update_utc||j.date||'',rates};LSS('ifa-fx',FX.d);emit('fx.updated',{src:url,EUR:rates.EUR,CNY:rates.CNY})}catch(e){FX.err=e.message||'خطای شبکه'}finally{FX.busy=false}return FX.d}
const irrMkt=()=>{const C=ctx();return +LSG('ifa-irr',0)||(C&&C.rates.fx&&C.rates.fx.IRR)||1050000};
function fxRate(cur){if(cur==='IRRm')return irrMkt();const R=FX.d&&FX.d.rates;if(R&&R[cur])return R[cur];const C=ctx();const f=C&&C.rates.fx||{};return cur==='USD'?1:cur==='EUR'&&f.EUR?1/f.EUR*(f.USD||1):null}
/* ----- forecasting ----- */
const QI=q=>{const m=/Q(\d)\s+(\d{4})/.exec(q);return m?(+m[2]-2023)*4+(+m[1]-1):null};const QN=i=>'Q'+(i%4+1)+' '+(2023+Math.floor(i/4));
function seasIdx(){const g={};DS.price.forEach(p=>{const k=p.cor+'|'+p.cargo;(g[k]=g[k]||[]).push(p)});const acc=[[],[],[],[]];
 Object.values(g).forEach(rs=>{const m=avg(rs.map(r=>mid(r.total)));rs.forEach(r=>{const i=QI(r.q);if(i!=null&&m)acc[i%4].push(mid(r.total)/m)})});const S=acc.map(a=>a.length?avg(a):1);const k=avg(S);return S.map(v=>v/k)}
function forecast(cor,cargo,H0=6){const rs=DS.price.filter(p=>p.cor===cor&&(!cargo||p.cargo===cargo)).map(p=>({i:QI(p.q),v:mid(p.total),r:p})).filter(p=>p.i!=null).sort((a,b)=>a.i-b.i);if(rs.length<2)return null;
 const S=seasIdx();const X=rs.map(p=>p.i),Y=rs.map(p=>p.v/S[p.i%4]);const mx=avg(X),my=avg(Y);const b=sum(X.map((x,i)=>(x-mx)*(Y[i]-my)))/(sum(X.map(x=>(x-mx)**2))||1);const a=my-b*mx;
 const H=Math.max(H0,qNow()-X[X.length-1]+4);const res=rs.map((p,i)=>p.v-(a+b*p.i)*S[p.i%4]);const sd=Math.sqrt(sum(res.map(r=>r*r))/Math.max(1,rs.length-2))||my*.06;const last=X[X.length-1];
 const F=[];for(let h=1;h<=H;h++){const i=last+h;const v=clamp((a+b*i),my*.6,my*1.8)*S[i%4];F.push({i,q:QN(i),v,lo:v-1.28*sd*Math.sqrt(1+h/rs.length),hi:v+1.28*sd*Math.sqrt(1+h/rs.length)})}
 return {rs,F,S,a,b,sd,trend:b/my*4,last}}
function qNow(){const d=new Date();return (d.getFullYear()-2023)*4+Math.floor(d.getMonth()/3)}
function bias(fk){const H=LSG('ifa-ship',[]).filter(s=>s.fam===fk&&s.done&&s.planDays);if(!H.length)return {k:1,n:0};return {k:clamp(avg(H.map(s=>s.actDays/s.planDays)),.6,2),n:H.length}}
function monthScan(C,src){const R=src.x;const fam=src.fam;const y=new Date();const out=[];const fc=fam.price?forecast(fam.price):null;const B=bias(fam.k);const val=+C.cargo.value||0;
 const sprd=R.maxDays&&R.avgDays?R.maxDays/R.avgDays:1.25;
 for(let k=0;k<12;k++){const d=new Date(Date.UTC(y.getUTCFullYear(),y.getUTCMonth()+k,15,8));const m=d.getUTCMonth()+1;const p=plan(R,d.getTime());const se=season(fam,m);
  const q=se?clamp(6*se.u/(1-se.u),0,96)/24:0;const p50=(p.days+q)*B.k;const p90=p50*(.6+.4*sprd)+(se?se.u*2:0);
  let idx=1;if(fc){const qi=(d.getUTCFullYear()-2023)*4+Math.floor((m-1)/3);const ref=fc.F.find(f=>f.i===qNow())||fc.F[0];const at=fc.F.find(f=>f.i===qi);idx=at&&ref?at.v/ref.v:fc.S[qi%4]/fc.S[qNow()%4]}
  const fr=(R.cost&&R.cost.freight||R.total*.7)*idx*(1+(se&&se.s||0)/100);const other=R.total-(R.cost&&R.cost.freight||R.total*.7);const carry=val*.18/365*p50;
  out.push({t:d.getTime(),m,p50,p90,cost:fr+other,carry,score:fr+other+carry,hol:p.hold/24,wait:p.wait/24,se,idx})}
 const best=out.reduce((a,b)=>b.score<a.score?b:a,out[0]);return {out,best,B,fc}}
/* ----- ICS ----- */
function ics(p,title){const f=t=>new Date(t).toISOString().replace(/[-:]/g,'').replace(/\.\d+/,'');const L=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Asana//Logistics//FA','CALSCALE:GREGORIAN'];
 p.ev.filter(e=>e.k!=='node'||e.e-e.s>6*HR).forEach((e,i)=>L.push('BEGIN:VEVENT','UID:'+uid()+i+'@ifa','DTSTAMP:'+f(Date.now()),'DTSTART:'+f(e.s),'DTEND:'+f(Math.max(e.e,e.s+HR)),'SUMMARY:'+(e.k==='leg'?'🚚 ':e.k==='hold'?'⛔ ':e.k==='wait'?'⏳ ':'📍 ')+e.n.replace(/[,;]/g,' '),'DESCRIPTION:'+title.replace(/[,;]/g,' '),'END:VEVENT'));
 L.push('BEGIN:VEVENT','UID:'+uid()+'eta@ifa','DTSTAMP:'+f(Date.now()),'DTSTART:'+f(p.eta),'DTEND:'+f(p.eta+HR),'SUMMARY:✅ ETA · '+title.replace(/[,;]/g,' '),'END:VEVENT','END:VCALENDAR');return L.join('\r\n')}
/* ----- UI ----- */
const FC={tab:'cal',src:null,ready:null,cargo:null,cor:null,conv:'EUR'};
function gantt(p,w=980){const rows=p.ev.filter(e=>e.k!=='node'||e.e-e.s>=3*HR);const t0=p.t0,t1=p.eta,sp=t1-t0||1;const H=22,top=26,lw=250,W=w-lw-10;const X=t=>lw+(t-t0)/sp*W;
 const ticks=[];const step=sp>40*DAY?7*DAY:sp>14*DAY?3*DAY:DAY;for(let t=Math.ceil(t0/step)*step;t<=t1;t+=step)ticks.push(t);
 const col=e=>e.k==='leg'?MODE[e.mode]?.c||'#888':e.k==='hold'?'#E97366':e.k==='wait'?'#E0A84E':'#8A8984';
 return `<svg class="fc-gantt" viewBox="0 0 ${w} ${top+rows.length*H+10}" style="direction:ltr">${ticks.map(t=>`<line x1="${X(t)}" x2="${X(t)}" y1="${top-6}" y2="${top+rows.length*H}" class="gl"/><text x="${X(t)}" y="14" class="tk">${fdS(t)}</text>`).join('')}
 ${rows.map((e,i)=>`<g class="r ${e.k}"><text x="${lw-8}" y="${top+i*H+15}" class="lb" text-anchor="start" style="direction:rtl">${esc(e.n.slice(0,40))}</text><rect x="${X(e.s)}" y="${top+i*H+4}" width="${Math.max(2,X(e.e)-X(e.s))}" height="${H-8}" rx="4" fill="${col(e)}" style="--d:${i*30}ms"><title>${esc(e.n)} · ${fdT(e.s)} → ${fdT(e.e)} · ${nf((e.e-e.s)/DAY,1)} روز</title></rect></g>`).join('')}
 ${Date.now()>t0&&Date.now()<t1?`<line x1="${X(Date.now())}" x2="${X(Date.now())}" y1="${top-6}" y2="${top+rows.length*H}" class="now"/>`:''}</svg>`}
function rFc(b,C){const S=sources(C);let src=S.find(s=>s.id===FC.src)||S[C.E.selected]||S[0];if(!src){b.innerHTML='<div class="sx-empty">ابتدا یک جستجوی مسیر اجرا کنید.</div>';return}FC.src=src.id;
 if(!FC.ready){const d=new Date(Date.now()+2*DAY);d.setHours(9,0,0,0);FC.ready=d.getTime()}
 const tabs={cal:'تقویم و ETA',live:'نرخ ارز زنده',fc:'پیش‌بینی نرخ و زمان'};
 b.innerHTML=`<div class="fc"><div class="sx-card fc-bar"><div class="sx-seg fc-tabs">${Object.entries(tabs).map(([k,n])=>`<button data-v="${k}"${FC.tab===k?' class="on"':''}>${n}</button>`).join('')}</div>
  <label class="sx-f"><span>مسیر</span><select class="fc-src">${S.map(s=>`<option value="${s.id}"${s.id===src.id?' selected':''}>${esc(s.name)}</option>`).join('')}</select></label>
  <label class="sx-f"><span>آماده‌بودن بار</span><input type="date" class="fc-ready" value="${iso(FC.ready)}"></label><span class="sx-sp"></span><small class="sx-muted fc-st"></small></div><div class="fc-body"></div></div>`;
 $$('.fc-tabs button',b).forEach(x=>x.onclick=()=>{FC.tab=x.dataset.v;rFc(b,C)});$('.fc-src',b).onchange=e=>{FC.src=e.target.value;rFc(b,C)};
 $('.fc-ready',b).onchange=e=>{const t=Date.parse(e.target.value+'T09:00:00');if(t)FC.ready=t;rFc(b,C)};
 const fb=$('.fc-body',b);({cal:fcCal,live:fcLive,fc:fcFc})[FC.tab](fb,C,src);countUp(b)}
function fcCal(fb,C,src){const R=src.x;const p=plan(R,FC.ready);const nom=R.avgDays;const hs=holidays().filter(h=>h.e>FC.ready&&h.s<p.eta+10*DAY&&h.cs.some(c=>(R.countries||[]).includes(c)));
 const legs=p.ev.filter(e=>e.k==='leg');
 fb.innerHTML=`<div class="fc-kpis">${kpi('تاریخ تحویل برآوردی (ETA)',0,{})}${kpi('زمان کل با تقویم',p.days,{d:1,suf:' روز',sub:'مدل بدون تقویم: '+nf(nom,1)+' روز'})}${kpi('انتظار برای حرکت',p.wait/24,{d:1,suf:' روز',sub:'بر اساس فرکانس سرویس هر بخش'})}${kpi('توقف به‌دلیل تعطیلات',p.hold/24,{d:1,suf:' روز',sub:hs.length?hs.map(h=>h.n).filter((v,i,a)=>a.indexOf(v)===i).join('، '):'بدون تداخل'})}</div>
 <div class="sx-card"><header><b>گانت زمان‌بندی‌شده</b><small>${fdate(FC.ready)} ← ${fdate(p.eta)}</small><span class="sx-sp"></span><button class="sx-btn sm fc-ics">${svgI(IC.cal)}خروجی تقویم (ICS)</button><button class="sx-btn sm fc-csv">${svgI(IC.dl)}CSV برنامه</button><button class="sx-btn sm fc-trk">${svgI(IC.track)}ایجاد محموله برای رهگیری</button></header><div class="fc-gw">${gantt(p)}</div>
  <div class="sx-legend"><span><i style="background:#E0A84E"></i>انتظار حرکت</span><span><i style="background:#E97366"></i>تعطیلات / توقف</span><span><i style="background:#8A8984"></i>توقف گره / ترخیص</span>${Object.entries(MODE).map(([k,m])=>`<span><i style="background:${m.c}"></i>${m.n}</span>`).join('')}</div></div>
 <div class="fc-g2"><div class="sx-card"><header><b>برنامهٔ حرکت بخش‌ها</b><small>فرکانس از گراف شبکه · روزهای حرکت مدل‌سازی‌شده</small></header><table class="sx-tbl"><thead><tr><th>بخش</th><th>شیوه</th><th>سرویس</th><th>حرکت</th><th>رسیدن</th></tr></thead><tbody>${legs.map(e=>`<tr><td>${esc(e.n)}</td><td>${MODE[e.mode]?.n||e.mode}</td><td>${e.freq?esc(FREQ[e.freq]||e.freq)+(e.freq!=='daily'?' · '+depDays(C.R&&R.legs[e.li].edge||{}).map(d=>WD[d]).join('، '):''):'پیوسته'}</td><td>${fdT(e.s)}</td><td>${fdT(e.e)}</td></tr>`).join('')}</tbody></table>
  <details class="fc-imp"><summary>واردکردن برنامهٔ حرکت واقعی (CSV)</summary><p class="sx-note">هر سطر: <code dir="ltr">fromNodeId,toNodeId,2025-11-03;2025-11-10</code> — شناسهٔ گره‌ها: ${legs.slice(0,2).map(e=>`<code dir="ltr">${esc(e.from)},${esc(e.to)}</code>`).join(' ')}</p><textarea class="fc-ta" dir="ltr" rows="3" placeholder="IR_BND,IR_THR,2025-11-03;2025-11-10"></textarea><button class="sx-btn sm fc-imb">ذخیرهٔ برنامه</button> <button class="sx-btn sm fc-clr">حذف برنامه‌های واردشده</button></details></div>
 <div class="sx-card"><header><b>تعطیلات و بسته‌شدن‌های پیش‌رو در کشورهای مسیر</b></header><ul class="fc-hol">${holidays().filter(h=>h.e>Date.now()&&h.s<Date.now()+200*DAY&&h.cs.some(c=>(R.countries||[]).includes(c))).sort((a,b)=>a.s-b.s).slice(0,12).map(h=>`<li class="${h.s<p.eta&&h.e>FC.ready?'hit':''}"><b>${esc(h.n)}</b><span>${fdS(h.s)} – ${fdS(h.e-DAY)}</span><small>${h.cs.filter(c=>(R.countries||[]).includes(c)).map(cfa).join('، ')}</small></li>`).join('')||'<li class="sx-muted">موردی نیست</li>'}</ul>
  <details class="fc-imp"><summary>افزودن تعطیلی سفارشی</summary><div class="fc-hadd"><input class="fc-hn" placeholder="عنوان"><input class="fc-hc" dir="ltr" placeholder="IR,TR"><input type="date" class="fc-ha"><input type="date" class="fc-hb"><button class="sx-btn sm fc-hok">افزودن</button></div></details></div></div>`;
 const k0=$('.fc-kpis .sx-kpi b',fb);k0.removeAttribute('data-cu');k0.textContent=fdate(p.eta);
 $('.fc-ics',fb).onclick=()=>dlFile('ifa-schedule.ics',ics(p,src.name),'text/calendar');
 $('.fc-csv',fb).onclick=()=>dlFile('ifa-schedule.csv','type,step,start,end,days\n'+p.ev.map(e=>[e.k,'"'+e.n+'"',new Date(e.s).toISOString(),new Date(e.e).toISOString(),((e.e-e.s)/DAY).toFixed(2)].join(',')).join('\n'));
 $('.fc-trk',fb).onclick=()=>{newShipment(C,src,FC.ready);view='track';render()};
 $('.fc-imb',fb).onclick=()=>{const S=LSG('ifa-sched',{});let n=0;$('.fc-ta',fb).value.split(/\n/).forEach(l=>{const [a,b2,d]=l.split(',').map(s=>s&&s.trim());if(a&&b2&&d){S[a+'>'+b2]=d.split(/[;\s]+/).filter(x=>/^\d{4}-\d\d-\d\d/.test(x)).map(x=>x.length<=10?x+'T09:00:00Z':x);n++}});LSS('ifa-sched',S);toast(fa(n)+' برنامه ذخیره شد');fcCal(fb,C,src)};
 $('.fc-clr',fb).onclick=()=>{LSS('ifa-sched',{});fcCal(fb,C,src)};
 $('.fc-hok',fb).onclick=()=>{const a=$('.fc-ha',fb).value,b2=$('.fc-hb',fb).value||a;if(!a)return;const L=LSG('ifa-hol',[]);L.push({n:$('.fc-hn',fb).value||'تعطیلی',cs:($('.fc-hc',fb).value||'IR').toUpperCase().split(/[,\s]+/),a,b:b2});LSS('ifa-hol',L);HOLC=null;fcCal(fb,C,src)};countUp(fb)}
function fcLive(fb,C,src){const draw=()=>{const d=FX.d;const res=landed(C,src,{inc:COST.inc||C.cargo.incoterm||'CFR',pay:COST.pay,duty:COST.duty,vat:COST.vat,fx:COST.fx,inv:COST.inv,broker:COST.broker,psi:COST.psi,ins:COST.ins,ch:COST.ch,month:COST.month,season:COST.season,dem:COST.dem});
  const tot=res.total+res.val;const cur=FC.conv;const r=fxRate(cur);
  fb.innerHTML=`<div class="fc-kpis">${kpi('هزینهٔ کل زنجیره',res.total,{pre:'$'})}${kpi('بهای تمام‌شده (کالا + زنجیره)',tot,{pre:'$'})}${kpi('به ریال (نرخ بازار)',tot*irrMkt()/1e7,{d:1,suf:' میلیارد ریال',sub:'نرخ: '+nf(irrMkt())+' ریال/دلار'})}${kpi('به '+(FXN[cur]||cur),r?tot*r:0,{sub:r?'۱ دلار = '+nf(r,r<10?4:1)+' '+cur:'نرخ در دسترس نیست'})}</div>
  <div class="fc-g2"><div class="sx-card"><header><b>نرخ‌های زنده (پایهٔ دلار)</b><small>${d?'منبع: '+esc(d.src.replace(/^https?:\/\//,'').split('/')[0])+' · به‌روزرسانی '+fdT(d.t):'هنوز دریافت نشده'}</small><span class="sx-sp"></span><button class="sx-btn sm fc-ref">${svgI(IC.reset)}${FX.busy?'در حال دریافت…':'دریافت مجدد'}</button></header>
   ${FX.err?`<div class="sx-note warn">خطا: ${esc(FX.err)} — از نرخ‌های ذخیره‌شده/پیش‌فرض استفاده می‌شود.</div>`:''}
   <table class="sx-tbl fc-fx"><thead><tr><th>ارز</th><th>۱ دلار =</th><th>معادل بهای تمام‌شده</th><th></th></tr></thead><tbody>${FXC.map(c=>{const v=d&&d.rates[c];return `<tr class="${FC.conv===c?'on':''}" data-c="${c}"><td><b dir="ltr">${c}</b> ${FXN[c]}</td><td>${v?nf(v,v<10?4:2):'—'}</td><td>${v?nf(tot*v):'—'}</td><td><button class="sx-btn xs" data-c="${c}">نمایش</button></td></tr>`}).join('')}</tbody></table></div>
   <div class="sx-card"><header><b>تنظیم نرخ‌ها</b></header>
   <label class="sx-f"><span>نرخ بازار آزاد ریال (هر دلار)</span><input type="number" class="fc-irr" value="${irrMkt()}" step="1000"></label>
   <label class="sx-f"><span>آدرس API نرخ سفارشی (JSON با کلید rates)</span><input class="fc-url" dir="ltr" value="${esc(LSG('ifa-fxurl',''))}" placeholder="https://open.er-api.com/v6/latest/USD"></label>
   <div class="sx-row"><button class="sx-btn sm fc-sv">ذخیره</button><button class="sx-btn sm pri fc-ap">اعمال یورو و ریال زنده روی موتور</button></div>
   <p class="sx-note">نرخ‌ها از سرویس عمومی open.er-api.com (نرخ‌های بین‌بانکی روزانه) دریافت و ۶ ساعت ذخیره می‌شوند. نرخ ریال در بازار آزاد با نرخ رسمی تفاوت زیادی دارد؛ عدد بازار را دستی وارد کنید. «اعمال روی موتور» نرخ‌های EUR و IRR را در محاسبه‌های بعدی اطلس جایگزین می‌کند.</p>
   <h5>مبدل سریع</h5><div class="fc-cv"><input type="number" class="fc-a" value="1000"><select class="fc-f">${FXC.map(c=>`<option${c==='USD'?' selected':''}>${c}</option>`).join('')}<option value="IRRm">IRR (بازار)</option></select><span>→</span><select class="fc-t">${FXC.map(c=>`<option${c==='EUR'?' selected':''}>${c}</option>`).join('')}<option value="IRRm">IRR (بازار)</option></select><b class="fc-o"></b></div></div></div>`;
  countUp(fb);const cv=()=>{const a=+$('.fc-a',fb).value||0,f=fxRate($('.fc-f',fb).value),t=fxRate($('.fc-t',fb).value);$('.fc-o',fb).textContent=f&&t?nf(a/f*t,2):'—'};['.fc-a','.fc-f','.fc-t'].forEach(s=>$(s,fb).oninput=cv);cv();
  $('.fc-ref',fb).onclick=async()=>{FX.busy=true;draw();await fxLoad(true);draw()};$$('.fc-fx [data-c]',fb).forEach(x=>x.onclick=()=>{FC.conv=x.dataset.c;draw()});
  $('.fc-sv',fb).onclick=()=>{LSS('ifa-irr',+$('.fc-irr',fb).value||0);LSS('ifa-fxurl',$('.fc-url',fb).value.trim());toast('ذخیره شد');draw()};
  $('.fc-ap',fb).onclick=()=>{const f=C.rates.fx||(C.rates.fx={});const d=FX.d;if(d&&d.rates.EUR)f.EUR=+(1/d.rates.EUR).toFixed(4)*(f.USD||1);f.IRR=irrMkt();toast('نرخ‌ها روی موتور اعمال شد · یورو '+nf(f.EUR,3)+' دلار');emit('fx.applied',{EUR:f.EUR,IRR:f.IRR})}};
 draw();if(!FX.d||Date.now()-FX.d.t>6*HR)fxLoad().then(()=>{if(FC.tab==='live'&&fb.isConnected)draw()})}
function fcFc(fb,C,src){const fam=src.fam;const cors=[...new Set(DS.price.map(p=>p.cor))];if(!FC.cor||!cors.includes(FC.cor))FC.cor=fam.price&&cors.includes(fam.price)?fam.price:cors[0];
 const cargos=[...new Set(DS.price.filter(p=>p.cor===FC.cor).map(p=>p.cargo))];if(!cargos.includes(FC.cargo))FC.cargo=cargos[0];const F=forecast(FC.cor,FC.cargo,8);const M=monthScan(C,src);
 const chart=()=>{if(!F)return '<div class="sx-muted">داده کافی نیست</div>';const pts=[...F.rs.map(p=>({i:p.i,v:p.v,lo:p.r.total[0],hi:p.r.total[1],h:1})),...F.F];const i0=Math.min(...pts.map(p=>p.i)),i1=Math.max(...pts.map(p=>p.i));
  const vmax=Math.max(...pts.map(p=>p.hi||p.v))*1.08,vmin=Math.min(...pts.map(p=>p.lo||p.v))*.9;const W=640,H=230,l=50,bt=26;const X=i=>l+(i-i0)/((i1-i0)||1)*(W-l-14),Y=v=>H-bt-(v-vmin)/(vmax-vmin)*(H-bt-12);
  const band=F.F.map(p=>`${X(p.i)},${Y(p.hi)}`).concat(F.F.slice().reverse().map(p=>`${X(p.i)},${Y(p.lo)}`));const lastH=F.rs[F.rs.length-1];
  return `<svg viewBox="0 0 ${W} ${H}" class="fc-ch" style="direction:ltr">${[0,.25,.5,.75,1].map(f=>{const v=vmin+f*(vmax-vmin);return `<line x1="${l}" x2="${W-10}" y1="${Y(v)}" y2="${Y(v)}" class="gl"/><text x="${l-6}" y="${Y(v)+4}" text-anchor="end" class="tk">${kusd(v)}</text>`}).join('')}
  ${F.rs.map(p=>`<line x1="${X(p.i)}" x2="${X(p.i)}" y1="${Y(p.r.total[0])}" y2="${Y(p.r.total[1])}" class="rg"/>`).join('')}
  <polygon points="${[`${X(lastH.i)},${Y(lastH.v)}`,...band.slice(0,F.F.length),...band.slice(F.F.length),`${X(lastH.i)},${Y(lastH.v)}`].join(' ')}" class="bd"/>
  <polyline points="${F.rs.map(p=>`${X(p.i)},${Y(p.v)}`).join(' ')}" class="hs"/><polyline points="${[lastH,...F.F].map(p=>`${X(p.i)},${Y(p.v)}`).join(' ')}" class="fl"/>
  ${pts.map(p=>`<circle cx="${X(p.i)}" cy="${Y(p.v)}" r="3.4" class="${p.h?'h':'f'}"><title>${p.q||QN(p.i)} · ${usd(p.v)}${p.h?'':' (پیش‌بینی '+usd(p.lo)+'–'+usd(p.hi)+')'}</title></circle>`).join('')}
  ${pts.filter((_,i)=>i%1===0).map(p=>`<text x="${X(p.i)}" y="${H-8}" text-anchor="middle" class="tk">${QN(p.i).replace(' 20',"'")}</text>`).join('')}<line x1="${X(qNow())}" x2="${X(qNow())}" y1="8" y2="${H-bt}" class="now"/></svg>`};
 const mx0=Math.max(...M.out.map(o=>o.p90)),mn0=Math.min(...M.out.map(o=>o.p50))*.85;const hp=v=>8+(v-mn0)/((mx0-mn0)||1)*92;const cmin=Math.min(...M.out.map(o=>o.score)),cmax=Math.max(...M.out.map(o=>o.score));
 fb.innerHTML=`<div class="fc-kpis">${kpi('روند سالانهٔ نرخ کریدور',F?F.trend*100:0,{d:1,suf:'٪',sub:F?'رگرسیون خطی روی ۸ فصل + شاخص فصلی':'—'})}${(()=>{const n=F&&(F.F.find(f=>f.i===qNow()+1)||F.F[F.F.length-1]);return kpi('پیش‌بینی فصل بعد',n?n.v:0,{pre:'$',sub:n?n.q+' · بازه ۸۰٪: '+kusd(n.lo)+'–'+kusd(n.hi):''})})()}${kpi('بهترین ماه حرکت',0,{sub:'میانهٔ '+nf(M.best.p50,1)+' روز · هزینهٔ کل '+usd(M.best.cost)})}${kpi('ضریب یادگیری از محموله‌ها',M.B.k,{d:2,suf:'×',sub:M.B.n?'از '+fa(M.B.n)+' محمولهٔ تحویل‌شده':'هنوز محموله‌ای تحویل نشده'})}</div>
 <div class="fc-g2"><div class="sx-card"><header><b>پیش‌بینی نرخ کریدور</b><span class="sx-sp"></span><select class="fc-cor">${cors.map(c=>`<option${c===FC.cor?' selected':''}>${esc(c)}</option>`).join('')}</select><select class="fc-cg">${cargos.map(c=>`<option${c===FC.cargo?' selected':''}>${esc(c)}</option>`).join('')}</select></header>${chart()}
  <div class="sx-legend"><span><i style="background:var(--ink2)"></i>تاریخی (میانه و بازه)</span><span><i style="background:#5E9FE8"></i>پیش‌بینی + بازهٔ ۸۰٪</span><span><i style="background:#E97366"></i>امروز</span></div>
  <div class="fc-si">${['Q1','Q2','Q3','Q4'].map((q,i)=>`<span>${q}<b>${nf((F?F.S[i]:1)*100-100,1)}٪</b></span>`).join('')}<small>شاخص فصلی تجمیعی همهٔ کریدورها</small></div></div>
 <div class="sx-card"><header><b>زمان و هزینه بر اساس ماه حرکت</b><small>تقویم + فصل + یادگیری</small></header><div class="fc-ms">${M.out.map(o=>`<div class="${o===M.best?'best':''}" title="${esc(fdate(o.t))} · P50 ${nf(o.p50,1)} روز · P90 ${nf(o.p90,1)} · هزینه ${usd(o.cost)} · تعطیلات ${nf(o.hol,1)} روز">
   <i class="p90" style="height:calc((100% - 40px)*${(hp(o.p90)/100).toFixed(3)})"></i><i class="p50" style="height:calc((100% - 40px)*${(hp(o.p50)/100).toFixed(3)})"></i><em style="--c:${(o.score-cmin)/((cmax-cmin)||1)}"></em><small>${fdS(o.t).split(' ').slice(-1)[0]}</small></div>`).join('')}</div>
  <div class="sx-legend"><span><i style="background:#A98BE0"></i>P50 روز</span><span><i style="background:rgba(169,139,224,.3)"></i>P90</span><span><i style="background:linear-gradient(90deg,#72BC8F,#E97366)"></i>هزینهٔ کل + هزینهٔ سرمایه</span></div>
  <p class="sx-note">پیشنهاد: حرکت در <b>${fdate(M.best.t)}</b> — ${M.best.se?'بهره‌برداری کریدور '+nf(M.best.se.u*100)+'٪، ':''}${M.best.hol>0?'تعطیلات '+nf(M.best.hol,1)+' روز':'بدون تداخل تعطیلات'}، شاخص نرخ ${nf(M.best.idx*100)}٪ امروز.</p></div></div>
 <div class="sx-card"><header><b>عوامل محرک نرخ در داده‌های تاریخی</b></header><ul class="fc-drv">${F?F.rs.slice(-6).reverse().map(p=>`<li><b>${p.r.q}</b><span>${usd(p.v)}</span><small>${esc(p.r.drv||'')}</small></li>`).join(''):''}</ul></div>`;
 const k2=$$('.fc-kpis .sx-kpi b',fb)[2];k2.removeAttribute('data-cu');k2.textContent=fdS(M.best.t);
 $('.fc-cor',fb).onchange=e=>{FC.cor=e.target.value;FC.cargo=null;fcFc(fb,C,src)};$('.fc-cg',fb).onchange=e=>{FC.cargo=e.target.value;fcFc(fb,C,src)};countUp(fb)}

/* ===== Shipment tracking: planned milestones, actuals, delay propagation, ISO 6346 ===== */
const TRK={sel:null};
const shipsG=()=>LSG('ifa-ship',[]),shipsS=a=>{LSS('ifa-ship',a)};
function iso6346(s){s=String(s||'').toUpperCase().replace(/[^A-Z0-9]/g,'');if(!/^[A-Z]{3}[UJZR]\d{7}$/.test(s))return {ok:false,s,msg:'قالب: ۴ حرف + ۷ رقم (مثل MSCU1234565)'};
 const v=c=>{if(/\d/.test(c))return +c;let n=10+c.charCodeAt(0)-65;n+=Math.floor((n-1)/10);return n};const V=c=>{const a=c.charCodeAt(0)-65;let x=10;for(let i=0;i<a;i++){x++;if(x%11===0)x++}return x};
 let t=0;for(let i=0;i<10;i++){const c=s[i];t+=(/\d/.test(c)?+c:V(c))*2**i}const cd=t%11%10;return {ok:cd===+s[10],s,cd,msg:cd===+s[10]?'رقم کنترل معتبر':'رقم کنترل باید '+cd+' باشد'}}
const CARR=[[/^(MSC|MED)/,'MSC','https://www.msc.com/en/track-a-shipment?agencyPath=msc&trackingNumber='],[/^(MAE|MSK|MRK|SUD)/,'Maersk','https://www.maersk.com/tracking/'],[/^(CMA|CGM|APL|APH)/,'CMA CGM','https://www.cma-cgm.com/ebusiness/tracking/search?SearchBy=Container&Reference='],
 [/^(HLX|HLC|UAC)/,'Hapag-Lloyd','https://www.hapag-lloyd.com/en/online-business/track/track-by-container-solution.html?container='],[/^(COS|CSN|CBH|CCL|OOL)/,'COSCO / OOCL','https://elines.coscoshipping.com/ebusiness/cargoTracking?trackingType=CONTAINER&number='],
 [/^ONE/,'ONE','https://ecomm.one-line.com/one-ecom/manage-shipment/cargo-tracking?ctrack-field='],[/^(EGL|EIS|EMC)/,'Evergreen','https://ct.shipmentlink.com/servlet/TDB1_CargoTracking.do?SEL=s_cntr&NO='],[/^(IRS|IRI|HDM|KTZ)/,'IRISL / KTZ','https://www.searates.com/container/tracking/?number=']];
const trackLinks=n=>{n=String(n||'').toUpperCase().replace(/[^A-Z0-9]/g,'');if(n.length<4)return [];const L=CARR.filter(c=>c[0].test(n)).map(c=>({n:c[1],u:c[2]+n}));L.push({n:'SeaRates',u:'https://www.searates.com/container/tracking/?number='+n},{n:'track-trace',u:'https://www.track-trace.com/container?number='+n});return L};
function decim(p,n=24){if(!p||p.length<=n)return p||[];const s=(p.length-1)/(n-1);return Array.from({length:n},(_,i)=>p[Math.round(i*s)])}
function newShipment(C,src,ready){const R=src.x;const p=plan(R,ready||Date.now());const A=shipsG();
 const ms=[];p.ev.forEach(e=>{if(e.k==='leg'){ms.push({id:uid(),k:'dep',n:'حرکت از '+nname(e.from),nid:e.from,pl:e.s,mode:e.mode,act:null});ms.push({id:uid(),k:'arr',n:'رسیدن به '+nname(e.to),nid:e.to,pl:e.e,mode:e.mode,act:null})}});
 ms.push({id:uid(),k:'del',n:'ترخیص و تحویل نهایی',nid:R.nodeSeq[R.nodeSeq.length-1],pl:p.eta,act:null});
 const s={id:uid(),name:(C.cargo.commodity||'محموله')+' · '+nname(R.nodeSeq[0])+' → '+nname(R.nodeSeq[R.nodeSeq.length-1]),ref:'IFA-'+Date.now().toString(36).slice(-5).toUpperCase(),ctr:'',route:src.name,fam:src.fam.k,created:Date.now(),ready:p.t0,planEta:p.eta,planDays:p.days,
  legs:R.legs.map(l=>({from:l.from,to:l.to,mode:l.mode,eid:l.edge&&l.edge.id,pts:decim(l.edge&&l.edge.pts)})),ms,log:[{t:Date.now(),m:'محموله ایجاد شد'}],cargo:{c:C.cargo.commodity,kg:C.cargo.weightKg,v:C.cargo.value,hs:C.cargo.hs},cost:R.total,maxDays:C.prefs.maxDays||null};
 A.unshift(s);shipsS(A);TRK.sel=s.id;emit('shipment.created',{id:s.id,ref:s.ref,name:s.name,eta:new Date(s.planEta).toISOString()});toast('محموله «'+s.ref+'» ساخته شد');return s}
function shipState(s){let delay=0;const now=Date.now();const ms=s.ms.map(m=>{if(m.act!=null){delay=m.act-m.pl;return {...m,fc:m.act,d:delay}}const fc=m.pl+Math.max(0,delay);return {...m,fc:Math.max(fc,m.k!=='dep'||fc>now?fc:fc),d:delay}});
 const last=ms[ms.length-1];const done=last.act!=null;const nx=ms.find(m=>m.act==null);let late=nx&&nx.fc<now?now-nx.fc:0;const eta=done?last.act:last.fc+late;
 const t0=s.ready,prog=done?1:clamp((now-t0)/((eta-t0)||1),0,.99);const actN=ms.filter(m=>m.act!=null).length;
 const st=done?'تحویل شد':!actN&&now<t0?'برنامه‌ریزی':late>12*HR||delay>24*HR?'تأخیر':'در مسیر';const al=[];
 if(delay>24*HR)al.push('تأخیر ثبت‌شده '+nf(delay/HR)+' ساعت نسبت به برنامه');if(late>12*HR&&!done)al.push('رویداد «'+nx.n+'» '+nf(late/HR)+' ساعت از زمان پیش‌بینی گذشته و ثبت نشده');
 if(s.maxDays&&(eta-t0)/DAY>s.maxDays)al.push('ETA فراتر از سقف '+fa(s.maxDays)+' روز');const h=holidays().find(h=>h.s>now&&h.s<eta&&h.cs.includes('IR'));if(h&&!done)al.push('تعطیلات پیش‌رو: '+h.n+' ('+fdS(h.s)+')');
 return {ms,eta,delay:(eta-s.planEta),prog,st,done,nx,al,actDays:(eta-t0)/DAY}}
function shipPos(s,prog){const pts=[].concat(...s.legs.map(l=>l.pts||[]));if(!pts.length)return null;const i=Math.min(pts.length-1,Math.floor(prog*(pts.length-1)));return {pts,i}}
function miniMap(s,S){const P=shipPos(s,S.prog);if(!P)return '<div class="sx-muted">بدون هندسهٔ مسیر</div>';const la=P.pts.map(p=>p[0]),lo=P.pts.map(p=>p[1]);const a0=Math.min(...la),a1=Math.max(...la),o0=Math.min(...lo),o1=Math.max(...lo);
 const W=300,H=170,pd=14,sc=Math.min((W-2*pd)/((o1-o0)||1),(H-2*pd)/((a1-a0)||1));const X=o=>pd+(o-o0)*sc+((W-2*pd)-(o1-o0)*sc)/2,Y=a=>H-pd-(a-a0)*sc-((H-2*pd)-(a1-a0)*sc)/2;
 const path=P.pts.map(p=>`${X(p[1]).toFixed(1)},${Y(p[0]).toFixed(1)}`);const cur=P.pts[P.i];
 return `<svg viewBox="0 0 ${W} ${H}" class="tr-map" style="direction:ltr"><polyline points="${path.join(' ')}" class="all"/><polyline points="${path.slice(0,P.i+1).join(' ')}" class="dn"/><circle cx="${path[0].split(',')[0]}" cy="${path[0].split(',')[1]}" r="4" class="o"/><circle cx="${path[path.length-1].split(',')[0]}" cy="${path[path.length-1].split(',')[1]}" r="4" class="d"/><circle cx="${X(cur[1])}" cy="${Y(cur[0])}" r="6" class="me"/><circle cx="${X(cur[1])}" cy="${Y(cur[0])}" r="6" class="pl"/></svg>`}
const dtl=t=>{if(t==null)return '';const d=new Date(t);d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16)};
function rTrack(b,C){const A=shipsG();if(!TRK.sel||!A.find(s=>s.id===TRK.sel))TRK.sel=A[0]&&A[0].id;const S0=sources(C);
 b.innerHTML=`<div class="tr"><aside class="tr-side"><div class="sx-card"><header><b>محموله‌ها</b><small>${fa(A.length)}</small><span class="sx-sp"></span><button class="sx-btn sm pri tr-new">${svgI(IC.plus)}از مسیر فعلی</button></header>
  <div class="tr-list">${A.map(s=>{const S=shipState(s);return `<button class="tr-it${s.id===TRK.sel?' on':''}" data-id="${s.id}"><b>${esc(s.ref)}</b><span class="tr-st st-${S.done?'ok':S.st==='تأخیر'?'late':S.st==='برنامه‌ریزی'?'pl':'go'}">${S.st}</span><small>${esc(s.name)}</small><i style="--p:${S.prog}"></i><em>ETA ${fdS(S.eta)}${S.delay>HR?' · +'+nf(S.delay/DAY,1)+' روز':''}</em></button>`}).join('')||'<div class="sx-muted" style="padding:14px">هنوز محموله‌ای ثبت نشده. از تب «تقویم و ETA» یا دکمهٔ بالا یک محموله بسازید.</div>'}</div>
  <div class="sx-row"><button class="sx-btn sm tr-ex">${svgI(IC.dl)}JSON</button><button class="sx-btn sm tr-csv">${svgI(IC.dl)}CSV</button><label class="sx-btn sm">${svgI(IC.plus)}ورود JSON<input type="file" accept=".json" class="tr-im" hidden></label></div></div>
  <div class="sx-card"><header><b>بررسی شمارهٔ کانتینر</b><small>ISO 6346</small></header><input class="tr-chk" dir="ltr" placeholder="MSCU1234565"><div class="tr-chr"></div></div></aside>
 <section class="tr-main"></section></div>`;
 $('.tr-new',b).onclick=()=>{const src=S0[C.E.selected]||S0[0];if(!src)return toast('ابتدا مسیر را جستجو کنید');newShipment(C,src,Date.now()+DAY);rTrack(b,C)};
 $$('.tr-it',b).forEach(x=>x.onclick=()=>{TRK.sel=x.dataset.id;rTrack(b,C)});
 $('.tr-ex',b).onclick=()=>dlFile('ifa-shipments.json',JSON.stringify(shipsG(),null,1),'application/json');
 $('.tr-csv',b).onclick=()=>dlFile('ifa-shipments.csv','ref,name,container,milestone,planned,forecast,actual\n'+shipsG().map(s=>{const S=shipState(s);return S.ms.map(m=>[s.ref,'"'+s.name+'"',s.ctr,'"'+m.n+'"',new Date(m.pl).toISOString(),new Date(m.fc).toISOString(),m.act?new Date(m.act).toISOString():''].join(',')).join('\n')}).join('\n'));
 $('.tr-im',b).onchange=e=>{const f=e.target.files[0];if(!f)return;f.text().then(t=>{try{const J=JSON.parse(t);const L=Array.isArray(J)?J:[J];const A2=shipsG();L.forEach(s=>{if(s&&s.ms&&!A2.find(x=>x.id===s.id))A2.push(s)});shipsS(A2);toast(fa(L.length)+' محموله وارد شد');rTrack(b,C)}catch(err){toast('فایل نامعتبر')}})};
 const ck=$('.tr-chk',b);ck.oninput=()=>{const r=iso6346(ck.value);$('.tr-chr',b).innerHTML=ck.value?`<span class="${r.ok?'ok':'bad'}">${r.ok?'✓':'✗'} ${r.msg}</span>${r.ok?`<div class="tr-lk">${trackLinks(r.s).map(l=>`<a href="${l.u}" target="_blank" rel="noopener">${esc(l.n)} ↗</a>`).join('')}</div>`:''}`:''};
 const s=A.find(x=>x.id===TRK.sel);const M=$('.tr-main',b);if(!s){M.innerHTML='<div class="sx-empty">'+svgI(IC.track)+'<p>محموله‌ای انتخاب نشده</p></div>';return}
 const S=shipState(s);const ci=iso6346(s.ctr);
 M.innerHTML=`<div class="sx-card tr-hd"><div class="tr-hl"><input class="tr-nm" value="${esc(s.name)}"><small>${esc(s.route)} · ساخته‌شده ${fdate(s.created)}</small></div>
  <label class="sx-f"><span>شمارهٔ کانتینر / بارنامه</span><input class="tr-ctr" dir="ltr" value="${esc(s.ctr)}" placeholder="MSCU1234565"></label><span class="tr-cv ${s.ctr?ci.ok?'ok':'bad':''}">${s.ctr?(ci.ok?'✓ ISO 6346':'✗ '+ci.msg):''}</span>
  <span class="sx-sp"></span><button class="sx-btn sm tr-now">${svgI(IC.check)}ثبت رویداد بعدی: اکنون</button><button class="sx-btn sm tr-map2">${svgI(IC.map)}نقشه</button><button class="sx-btn sm tr-del">${svgI(IC.x)}حذف</button></div>
 <div class="fc-kpis">${kpi('وضعیت',0,{sub:esc(S.nx?'بعدی: '+S.nx.n:'تکمیل‌شده')})}${kpi('ETA پیش‌بینی',0,{sub:'برنامه: '+fdate(s.planEta)})}${kpi('تأخیر نسبت به برنامه',S.delay/DAY,{d:1,suf:' روز',cls:S.delay>DAY?'bad':S.delay<-HR*6?'good':''})}${kpi('پیشرفت',S.prog*100,{suf:'٪',sub:fa(S.ms.filter(m=>m.act!=null).length)+' از '+fa(S.ms.length)+' رویداد ثبت شده'})}</div>
 ${S.al.length?`<div class="op-flags">${S.al.map(a=>`<span>⚠ ${esc(a)}</span>`).join('')}</div>`:''}
 <div class="tr-g"><div class="sx-card"><header><b>رویدادهای کلیدی (Milestones)</b><small>ثبت زمان واقعی، تأخیر را به رویدادهای بعدی منتقل می‌کند</small></header>
  <table class="sx-tbl tr-ms"><thead><tr><th></th><th>رویداد</th><th>برنامه</th><th>پیش‌بینی</th><th>واقعی</th><th>انحراف</th></tr></thead><tbody>${S.ms.map((m,i)=>`<tr class="${m.act!=null?'dn':m===S.nx?'nx':''}"><td><i class="tr-dot" style="--c:${m.mode?MODE[m.mode].c:'#72BC8F'}"></i></td><td>${esc(m.n)}</td><td>${fdT(m.pl)}</td><td>${fdT(m.fc)}</td><td><input type="datetime-local" data-i="${i}" value="${dtl(m.act)}"></td><td class="${m.d>6*HR?'late':m.d<-6*HR?'early':''}">${m.act!=null?((m.d>=0?'+':'−')+nf(Math.abs(m.d)/HR)+' س'):m.d>HR?'<small>پیش‌بینی +'+nf(m.d/HR)+' س</small>':'—'}</td></tr>`).join('')}</tbody></table></div>
  <div><div class="sx-card"><header><b>موقعیت تخمینی</b><small>بر اساس پیشرفت زمانی</small></header>${miniMap(s,S)}</div>
  ${s.ctr&&ci.ok?`<div class="sx-card"><header><b>رهگیری در سامانهٔ خط کشتیرانی</b></header><div class="tr-lk">${trackLinks(s.ctr).map(l=>`<a href="${l.u}" target="_blank" rel="noopener">${esc(l.n)} ↗</a>`).join('')}</div></div>`:''}
  <div class="sx-card"><header><b>گزارش رویداد</b></header><ul class="tr-log">${s.log.slice().reverse().slice(0,12).map(l=>`<li><small>${fdT(l.t)}</small>${esc(l.m)}</li>`).join('')}</ul><div class="sx-row"><input class="tr-note" placeholder="یادداشت…"><button class="sx-btn sm tr-add">افزودن</button></div></div></div></div>`;
 const vals=$$('.fc-kpis .sx-kpi b',M);vals[0].removeAttribute('data-cu');vals[0].textContent=S.st;vals[1].removeAttribute('data-cu');vals[1].textContent=fdate(S.eta);countUp(M);
 const save=(msg)=>{const A2=shipsG();const i=A2.findIndex(x=>x.id===s.id);if(msg)s.log.push({t:Date.now(),m:msg});A2[i]=s;shipsS(A2)};
 $('.tr-nm',M).onchange=e=>{s.name=e.target.value;save();};$('.tr-ctr',M).onchange=e=>{s.ctr=e.target.value.toUpperCase().trim();save('شمارهٔ کانتینر: '+s.ctr);rTrack(b,C)};
 $$('.tr-ms input',M).forEach(inp=>inp.onchange=()=>{const m=s.ms[+inp.dataset.i];m.act=inp.value?new Date(inp.value).getTime():null;save(m.n+(m.act?' · ثبت '+fdT(m.act):' · حذف ثبت'));const S2=shipState(s);
  emit('milestone.updated',{id:s.id,ref:s.ref,milestone:m.n,actual:m.act&&new Date(m.act).toISOString(),eta:new Date(S2.eta).toISOString(),delayHours:Math.round(S2.delay/HR)});if(S2.done){s.done=true;s.actDays=S2.actDays;save('تحویل شد');emit('shipment.delivered',{id:s.id,ref:s.ref,days:S2.actDays})}
  if(S2.delay>DAY)emit('shipment.delayed',{id:s.id,ref:s.ref,delayHours:Math.round(S2.delay/HR)});rTrack(b,C)});
 $('.tr-now',M).onclick=()=>{const m=s.ms.find(m=>m.act==null);if(!m)return;m.act=Date.now();const inp=$$('.tr-ms input',M)[s.ms.indexOf(m)];inp.value=dtl(m.act);inp.onchange()};
 $('.tr-del',M).onclick=()=>{if(!confirm('حذف محمولهٔ '+s.ref+'؟'))return;shipsS(shipsG().filter(x=>x.id!==s.id));TRK.sel=null;rTrack(b,C)};
 $('.tr-add',M).onclick=()=>{const v=$('.tr-note',M).value.trim();if(v){save(v);rTrack(b,C)}};
 $('.tr-map2',M).onclick=()=>{const E=C.E;const legs=s.legs.map(l=>({edge:E.G.edgeById[l.eid],from:l.from,to:l.to})).filter(l=>l.edge);if(legs.length!==s.legs.length)return toast('مسیر این محموله در گراف فعلی یافت نشد');const x=yr(legs);if(!x)return;
  try{E.setRoutes([{...x,id:'trk',name:s.ref,via:'',badges:[],rank:1}],0);E.fitRoute(E.routes[0],{top:90,right:440,bottom:260,left:200});E.setPlayback&&E.setPlayback({T:S.prog*(x.timeline.length?x.timeline[x.timeline.length-1].end:1),playing:false})}catch(e){console.error(e)}close();toast('مسیر محموله روی نقشه')}}

/* ===== Sanctions screening: OFAC SDN + non-SDN, UN, EU consolidated (offline snapshot) ===== */
const SANC_B64='