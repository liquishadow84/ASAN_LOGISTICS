function cndEco(B,C){if(!CNDD){B.innerHTML='<div class="sx-empty"><span class="sx-spin"></span></div>';cndLoad().then(()=>B.isConnected&&cndEco(B,C));return}const D=CNDD;
 const hubs=X11.cn.hubs.rows.map(h=>{const c=String(h[0]).split(' (')[0];const X=D.E.filter(e=>e.city===c);return {h,c,X}});
 B.innerHTML=`<div class="sx-card"><header><b>بازیگران اکوسیستم لجستیک چین در هاب‌های کریدور</b><small>از پایگاه ۶٬۹۸۱ موجودیتی · کلیک برای فهرست هر هاب</small><span class="sx-sp"></span><button class="sx-btn sm pri" data-o="ov">باز کردن فهرست اکوسیستم چین</button><button class="sx-btn sm" data-o="fit">یابندهٔ شریک برای مسیر</button></header><div class="cd-hg">${hubs.map(({h,c,X})=>`<button class="cd-hb" data-c="${esc(c)}" ${X.length?'':'disabled'}><b>${esc(h[0])}</b><small>${esc(h[2])}</small><strong>${nf(X.length)}</strong><span>${D.lay.map(l=>[l[0],X.filter(e=>e.L===l[0]).length]).filter(x=>x[1]).slice(0,5).map(x=>`<i style="--c:${CDLC[x[0]]}">${x[0]} ${fa(x[1])}</i>`).join('')}</span></button>`).join('')}</div></div>`;
 $$('.cd-hb',B).forEach(x=>x.onclick=()=>cdGo({city:x.dataset.c}));$$('[data-o]',B).forEach(x=>x.onclick=()=>{CDS.sub=x.dataset.o;open('cnd')})}
function cndHubCard(B){const s=$('.cn-hub section',B);if(!s)return;const ttl=$('.cn-hub section .sx-card header b',B);const c=ttl?ttl.textContent.split(' (')[0]:'';const box=document.createElement('div');box.className='sx-card cd-hubc';box.innerHTML='<div class="sx-muted"><span class="sx-spin"></span></div>';s.appendChild(box);
 cndLoad().then(D=>{const X=D.E.filter(e=>e.city===c).sort((a,b)=>b.sc-a.sc);if(!X.length){box.innerHTML=`<header><b>بازیگران ثبت‌شده در ${esc(c)}</b></header><div class="sx-muted v14-sm">در پایگاه اکوسیستم چین موجودیتی با مقر این شهر ثبت نشده است.</div>`;return}
  const by=D.lay.map(l=>[l,X.filter(e=>e.L===l[0])]).filter(x=>x[1].length);
  box.innerHTML=`<header><b>بازیگران ثبت‌شده در ${esc(c)}</b><small>${nf(X.length)} موجودیت · ${nf(X.filter(e=>e.v==='V').length)} راستی‌آزمایی‌شده</small><span class="sx-sp"></span><button class="sx-btn sm" data-c="${esc(c)}">همه در فهرست</button></header><div class="cd-hl2">${by.map(([l,Y])=>`<div><h6>${cdLay(l[0])} <span>${fa(Y.length)}</span></h6>${Y.slice(0,3).map(e=>`<button data-go="${e.id}">${esc(e.n.slice(0,46))}<em>${fa(e.sc)}</em></button>`).join('')}</div>`).join('')}</div>`;
  $$('[data-go]',box).forEach(x=>x.onclick=()=>cdDlg(x.dataset.go));$('[data-c]',box).onclick=()=>cdGo({city:c})})}
{const _h=cnHub;cnHub=function(B,C){_h(B,C);try{cndHubCard(B)}catch(e){console.error(e)}}}
window.__CND_PAL=X=>{[['ov','نمای کلی اکوسیستم لجستیک چین (۶٬۹۸۱ موجودیت)'],['dir','جستجوی شرکت‌های لجستیک چین'],['fit','یابندهٔ شریک چینی برای مسیر فعلی'],['cor','کریدور ایران و پرچم‌های تحریمی شرکت‌های چینی'],['net','روابط میان‌لایه‌ای و گروه‌های مالکیتی'],['sl','فهرست کوتاه شرکای چینی']].forEach(([k,t])=>X.push({g:'اکوسیستم لجستیک چین',t,run:()=>{CDS.sub=k;open('cnd')}}));
 if(!CNDD){cndLoad().catch(()=>{});return}CNDD.E.filter(e=>e.v==='V'||e.cor||e.sc>=80).slice(0,900).forEach(e=>X.push({g:'شرکت‌های لجستیک چین',t:e.n+(e.cn?' · '+e.cn:'')+' ('+e.id+')',sub:e.L,run:()=>{if(view!=='cnd'||!wrap){CDS.sub='dir';open('cnd')}setTimeout(()=>cdDlg(e.id),60)}}))};
function cdApi(){const need=()=>{if(!CNDD)throw new Error('ابتدا IFA.china.load() را فراخوانی کنید');return CNDD};const pub=e=>e&&({id:e.id,layer:e.L,name:e.n,chineseName:e.cn,type:e.type,role:e.role,hq:e.hq,city:e.city,province:e.prov,country:e.ctry,modes:cdMods(e.mb),status:e.str,verification:CDL[e.v],evidence:e.ev,iranRelevance:e.ir,iranEvidence:e.ie,corridor:!!e.cor,sanctionsMention:!!e.sf,score:e.sc,links:e.lk,sources:e.urls});
 return {load:async()=>{await cndLoad();return {entities:CNDD.E.length,layers:CNDD.lay.length}},stats:()=>{const D=need();return {entities:D.E.length,byLayer:Object.fromEntries(D.lay.map(l=>[l[0],D.E.filter(e=>e.L===l[0]).length])),verified:D.E.filter(e=>e.v==='V').length,corridor:D.E.filter(e=>e.cor).length,sanctionsMention:D.E.filter(e=>e.sf).length,generated:D.meta.gen}},
  search:(q,f={},limit=50)=>{need();return cdSort(cdFilter({...f,q:q||''}),f.sort||'score').slice(0,limit).map(pub)},get:id=>pub(need().byId[id]),
  fit:(o={})=>{need();const R=cdFitRun({city:o.city||'Shanghai',roles:o.roles||['FF','RT','RR','OC','CB'],corr:o.corridor!==false,xs:o.excludeSanctions!==false,minv:o.minVerification||'P',n:o.n||5});return Object.fromEntries(Object.entries(R).map(([k,v])=>[k,v.top.map(x=>({...pub(x.e),fit:x.f,why:x.why}))]))},
  shortlist:()=>cdSL().map(s=>({...s,entity:CNDD?pub(CNDD.byId[s.id]):null})),open:(id)=>{if(id){cndLoad().then(()=>{CDS.sub='dir';open('cnd');setTimeout(()=>cdDlg(id),80)})}else open('cnd')}}}

