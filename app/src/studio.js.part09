function ilApi(){const need=()=>{if(!IRLD)throw new Error('ابتدا IFA.iran.load() را فراخوانی کنید');return IRLD};const pub=c=>c&&({id:c.id,name:c.n,nameEn:c.en,type:c.c,typeFa:ILCAT[c.c],province:c.pv,city:c.ct,address:c.ad,phone:c.ph,website:c.w,email:c.em,license:c.lic||'',completeness:c.q,source:c.src,myStatus:(ilVer()[c.id]||{}).s||null,lat:c.la,lon:c.lo});const pe=e=>({id:e.id,type:e.k,typeFa:ILEPT[e.k],name:e.n,nameEn:e.en,province:e.pv,counterpart:e.cp,status:e.st,iata:e.iata,limits:e.sp?{axle:e.sp.axle,gvw:e.sp.gvw,height:e.sp.mh,width:e.sp.mw,length:e.sp.ml}:null,source:e.src});
 return {load:async()=>{await ilLoad();return {companies:IRLD.C.length,entryPoints:ilEPs().length}},stats:()=>{const J=need();return {companies:J.C.length,byType:Object.fromEntries(Object.keys(ILCAT).map(k=>[k,J.C.filter(c=>c.c===k).length])),entryPoints:Object.fromEntries(Object.keys(ILEPT).map(k=>[k,ilEPs().filter(e=>e.k===k).length])),freeZones:J.fz.length,laws:IRL_LAW.length}},
  companies:(q,f={},limit=50)=>{need();return ilSort(ilFilter({q:q||'',c:f.type||'',pv:f.province||'',src:f.source||'',ct:f.contact||'',vs:f.status||''}),'q').slice(0,limit).map(pub)},get:id=>pub(need().byId[id]),
  entryPoints:(f={})=>{need();return ilEPs().filter(e=>(!f.type||e.k===f.type)&&(!f.province||e.pv===f.province)).map(pe)},
  check:(o={})=>{need();const R=ilCheck({dir:o.procedure||'imp',cat:o.category||'gen',ep:o.entryPoint||'',pv:o.province||'تهران',gvw:o.gvw||0,h:o.height||0,reefer:!!o.reefer,tir:o.tir!==false,kg:o.weightKg||0});return {verdict:R.verdict,entryPoint:R.ep&&pe(R.ep),checks:R.checks,documents:R.docs,agencies:R.agencies.map(a=>({agency:a[0],requirement:a[1],stage:a[2]})),steps:R.steps,companies:Object.fromEntries(Object.entries(R.cos).map(([k,L])=>[k,L.map(x=>({...pub(x.c),fit:x.f,why:x.why}))]))}},
  permits:cat=>cat?IRL_PERM[cat]:IRL_PERM,procedures:()=>IRL_PROC,laws:()=>IRL_LAW.map(r=>({name:r[0],year:r[1],scope:r[2],operational:r[3],confidence:r[4]==='H'?'established':'verify'})),
  importRows:rows=>{need();return ilImport(ilMapRows(rows).items)},open:sub=>{ILS.sub=sub||'ov';open('irl')}}}

