ه‌جا شد (Roll)','bad'],['ship','بارگیری شد','ok'],['canc','لغو','off']];
const bkN=k=>BKS.find(x=>x[0]===k)||BKS[0];
const hleft=t=>t?(Date.parse(t)-Date.now())/36e5:null;
const hchip=t=>{const h=hleft(t);if(h==null||isNaN(h))return '—';return chip(h<0?'bad':h<48?'warn':'ok',h<0?'گذشته':h<48?fa(Math.round(h))+' ساعت':fa(Math.round(h/24))+' روز')};
function bkBk(B){rgUI(B,{key:'ifa-bkg',title:'رزروها و مهلت‌های خط کشتیرانی',sub:'Cut-off تحویل بار به ترمینال (CY)، ارسال اطلاعات بارنامه (SI)، اعلام VGM و اسناد',addL:'رزرو جدید',
 def:()=>{const e=fwAdd(fwToday(),10);return {no:'',carrier:'',vessel:'',voy:'',pol:'',pod:'BND',eq:'40HC',qty:1,etd:e,cy:fwAdd(e,-2)+'T12:00',si:fwAdd(e,-3)+'T12:00',vgm:fwAdd(e,-2)+'T10:00',doc:fwAdd(e,-3)+'T16:00',job:LSG('ifa-jobs',[])[0]?.ref||'',st:'req',note:''}},
 fields:[['no','شمارهٔ رزرو'],['carrier','خط کشتیرانی'],['vessel','کشتی'],['voy','سفر'],['pol','بندر بارگیری'],['pod','بندر تخلیه'],['eq','نوع کانتینر','',['20GP','40GP','40HC','20RF','40RH','20OT','40FR'].map(x=>[x,x])],['qty','تعداد','n'],['etd','ETD','d'],['cy','Cut-off CY','datetime-local'],['si','Cut-off SI','datetime-local'],['vgm','Cut-off VGM','datetime-local'],['doc','Cut-off اسناد','datetime-local'],['job','پرونده','',[['','—'],...LSG('ifa-jobs',[]).map(j=>[j.ref,j.ref])]],['st','وضعیت','',BKS.map(x=>[x[0],x[1]])],['note','یادداشت','l']],
 cols:[['رزرو',r=>`<b dir="ltr">${esc(r.no||'—')}</b><small class="v14-sm">${esc(r.carrier)}</small>`],['کشتی/سفر',r=>esc(r.vessel)+' '+esc(r.voy)],['مسیر',r=>esc(r.pol)+' → '+esc(r.pod)],['تجهیزات',r=>fa(r.qty)+'×'+esc(r.eq)],['ETD',r=>jdt(r.etd)],['SI',r=>r.st==='ship'||r.st==='canc'?'—':hchip(r.si)],['VGM',r=>r.st==='ship'||r.st==='canc'?'—':hchip(r.vgm)],['CY',r=>r.st==='ship'||r.st==='canc'?'—':hchip(r.cy)],['وضعیت',r=>chip(bkN(r.st)[2],bkN(r.st)[1])]],
 sort:(a,b)=>String(a.etd).localeCompare(b.etd),
 kpis:L=>{const A=L.filter(r=>!['ship','canc'].includes(r.st));const nx=A.flatMap(r=>[r.si,r.vgm,r.cy,r.doc]).map(hleft).filter(h=>h!=null&&!isNaN(h));return kpi('رزرو فعال',A.length)+kpi('مهلت ۴۸ ساعت آینده',nx.filter(h=>h>=0&&h<48).length)+kpi('مهلت از دست رفته',nx.filter(h=>h<0).length)+kpi('Roll شده',L.filter(r=>r.st==='roll').length)},
 name:r=>'رزرو '+esc(r.no||''),onField:(r,k)=>{if(k==='etd'&&r.etd){r.cy=fwAdd(r.etd,-2)+'T12:00';r.si=fwAdd(r.etd,-3)+'T12:00';r.vgm=fwAdd(r.etd,-2)+'T10:00';r.doc=fwAdd(r.etd,-3)+'T16:00'}}})}
const TARE={'20GP':[2200,30480],'40GP':[3750,30480],'40HC':[3900,30480],'20RF':[3050,30480],'40RH':[4480,34000],'20OT':[2350,30480],'40FR':[5000,45000]};
function bkVgm(B){const S=Object.assign({ctr:'',eq:'40HC',cargo:18000,pack:450,dun:120,tare:null,shp:'',auth:'',bk:'',meth:'2'},LSG('ifa-vgm',{}));const sv=()=>LSS('ifa-vgm',S);
 B.innerHTML=`<div class="fc-g2"><div class="sx-card fw-form"><header><b>محاسبه و اظهارنامهٔ VGM</b><small>کنوانسیون SOLAS فصل ۶ مقررهٔ ۲ · روش ۲: جمع اجزا + وزن خالی کانتینر</small></header><div class="fw-g">${fwI('شمارهٔ کانتینر','ctr',S.ctr,{t:'text'})}${fwI('نوع','eq',S.eq,{opts:Object.keys(TARE).map(x=>[x,x])})}${fwI('وزن خالص کالا (kg)','cargo',S.cargo)}${fwI('بسته‌بندی و پالت (kg)','pack',S.pack)}${fwI('مهاربندی و دانیج (kg)','dun',S.dun)}${fwI('وزن خالی کانتینر (Tare، خالی = پیش‌فرض)','tare',S.tare)}${fwI('روش','meth',S.meth,{opts:[['1','روش ۱ — توزین کل کانتینر'],['2','روش ۲ — جمع اجزا']]})}${fwI('فرستنده (Shipper)','shp',S.shp,{t:'text'})}${fwI('شخص مجاز امضاکننده','auth',S.auth,{t:'text'})}${fwI('شمارهٔ رزرو','bk',S.bk,{t:'text'})}</div></div><div class="v14-vo"></div></div>`;
 const out=()=>{const T=TARE[S.eq];const tare=S.tare||T[0];const v=(+S.cargo||0)+(+S.pack||0)+(+S.dun||0)+tare;const ok=v<=T[1];const ck=S.ctr?iso6346(S.ctr):null;
  $('.v14-vo',B).innerHTML=`<div class="sx-card"><header><b>نتیجه</b></header><div class="ex-kpis">${kpi('VGM',v,{suf:' kg'})}${kpi('حداکثر وزن ناخالص',T[1],{suf:' kg'})}${kpi('ظرفیت باقی‌مانده',T[1]-v,{suf:' kg'})}</div><div class="fw-al ${ok?'ok':'bad'}">${ok?'وزن در حد مجاز کانتینر است.':'VGM از حداکثر وزن ناخالص درج‌شده روی پلاک CSC بیشتر است — بار را کاهش دهید.'}</div>${ck?`<div class="fw-al ${ck.ok?'ok':'bad'}">کانتینر ${esc(ck.s)}: ${ck.msg}</div>`:''}<div class="fw-al">محدودیت جاده‌ای ایران معمولاً سخت‌گیرانه‌تر از ظرفیت کانتینر است؛ وزن کل کامیون را در «حمل‌کنندگان و تردد» بررسی کنید.</div><div class="fw-bt"><button class="sx-btn sm pri" data-pv>چاپ اظهارنامهٔ VGM</button></div></div>`;
  $('[data-pv]',B).onclick=()=>openDoc(`<div class="page"><h1 style="text-align:center">Verified Gross Mass Declaration · اظهارنامهٔ وزن ناخالص تأییدشده</h1><table><tr><td>Booking No. / شمارهٔ رزرو</td><td dir="ltr">${esc(S.bk)}</td></tr><tr><td>Container No. / کانتینر</td><td dir="ltr">${esc(S.ctr)} (${S.eq})</td></tr><tr><td>Shipper / فرستنده</td><td>${esc(S.shp)}</td></tr><tr><td>Method / روش</td><td>SOLAS VI/2 Method ${S.meth}</td></tr><tr><td>Cargo + packing + dunnage</td><td dir="ltr">${nf((+S.cargo||0)+(+S.pack||0)+(+S.dun||0))} kg</td></tr><tr><td>Tare / وزن خالی</td><td dir="ltr">${nf(tare)} kg</td></tr><tr><th>VGM</th><th dir="ltr">${nf(v)} kg</th></tr><tr><td>Authorized person / امضاکننده</td><td>${esc(S.auth)}</td></tr><tr><td>Date / تاریخ</td><td>${fwToday()} · ${jdt(fwToday())}</td></tr></table><p style="margin-top:40px">Signature / امضا: ____________________</p></div>`,'VGM '+S.ctr)};
 fwBind(B,S,()=>{sv();out()});out()}
const LCAP={'20GP':[28,26000],'40GP':[56,26500],'40HC':[66,26500]};
function bkLcl(B){const S=Object.assign({eq:'40HC',mbl:'',vessel:'',fr:2600,org:350,dst:900,rate:85,minc:1,items:[]},LSG('ifa-lcl',{}));const sv=()=>LSS('ifa-lcl',S);if(!S.items.length)S.items=[{id:rgId(),cust:'مشتری الف',cargo:'قطعات یدکی',pcs:20,kg:3200,cbm:12},{id:rgId(),cust:'مشتری ب',cargo:'لوازم خانگی',pcs:60,kg:5400,cbm:28}];
 const draw=()=>{const cap=LCAP[S.eq];const tc=S.items.reduce((a,x)=>a+(+x.cbm||0),0),tk=S.items.reduce((a,x)=>a+(+x.kg||0),0);const W=S.items.map(x=>Math.max(+x.cbm||0,(+x.kg||0)/1000,+S.minc||0));const tw=W.reduce((a,x)=>a+x,0)||1;const cost=(+S.fr||0)+(+S.org||0)+(+S.dst||0);
  const R=S.items.map((x,i)=>({x,w:W[i],cost:cost*W[i]/tw,rev:W[i]*(+S.rate||0),hbl:'HBL-'+(S.mbl||'MBL').replace(/\W/g,'').slice(-6)+'-'+String(i+1).padStart(2,'0')}));const rev=R.reduce((a,r)=>a+r.rev,0);
  B.innerHTML=`<div class="sx-card fw-form"><header><b>تجمیع بار خرده (LCL) و تقسیم هزینه</b><small>تقسیم بر اساس تن درآمدی W/M = بیشینهٔ (مترمکعب، تن) · بارنامهٔ اصلی و فرعی</small></header><div class="fw-g">${fwI('کانتینر','eq',S.eq,{opts:Object.keys(LCAP).map(k=>[k,k+' — '+LCAP[k][0]+' m³ مفید'])})}${fwI('بارنامهٔ اصلی (MBL)','mbl',S.mbl,{t:'text'})}${fwI('کشتی/سفر','vessel',S.vessel,{t:'text'})}${fwI('کرایهٔ حمل اصلی ($)','fr',S.fr)}${fwI('هزینهٔ مبدأ و تجمیع ($)','org',S.org)}${fwI('هزینهٔ مقصد و تفکیک ($)','dst',S.dst)}${fwI('نرخ فروش هر W/M ($)','rate',S.rate)}${fwI('حداقل W/M هر مشتری','minc',S.minc,{step:.5})}</div></div>
  <div class="ex-kpis">${kpi('پرشدگی حجمی',tc/cap[0]*100,{suf:'٪',sub:fa(nf(tc,1))+' از '+fa(cap[0])+' m³'})}${kpi('پرشدگی وزنی',tk/cap[1]*100,{suf:'٪',sub:fa(nf(tk))+' kg'})}${kpi('درآمد',rev,{pre:'$'})}${kpi('سود ناخالص',rev-cost,{pre:'$',sub:'هزینهٔ کل '+usd0(cost)})}${kpi('نقطهٔ سربه‌سر',cost/(+S.rate||1),{suf:' W/M',d:1})}</div>
  <div class="sx-card"><header><b>محموله‌های مشتریان</b><span class="sx-sp"></span><button class="sx-btn sm" data-ad>افزودن مشتری</button><button class="sx-btn sm" data-mf>چاپ مانیفست</button></header><div class="rg-w"><table class="sx-tbl v14-lt"><thead><tr><th>مشتری</th><th>کالا</th><th>تعداد بسته</th><th>وزن (kg)</th><th>حجم (m³)</th><th>W/M</th><th>سهم هزینه</th><th>درآمد</th><th>سود</th><th>بارنامهٔ فرعی</th><th></th></tr></thead><tbody>${R.map((r,i)=>`<tr data-i="${i}"><td><input data-c="cust" value="${esc(r.x.cust)}"></td><td><input data-c="cargo" value="${esc(r.x.cargo)}"></td><td><input data-c="pcs" type="number" value="${r.x.pcs}"></td><td><input data-c="kg" type="number" value="${r.x.kg}"></td><td><input data-c="cbm" type="number" step=".1" value="${r.x.cbm}"></td><td>${fa(nf(r.w,2))}</td><td>${usd0(r.cost)}</td><td>${usd0(r.rev)}</td><td class="${r.rev-r.cost<0?'v14-bad':''}">${usd0(r.rev-r.cost)}</td><td dir="ltr"><small>${r.hbl}</small></td><td><button class="sx-btn xs" data-x>×</button></td></tr>`).join('')}</tbody></table></div>${tc>cap[0]||tk>cap[1]?'<div class="fw-al bad">ظرفیت کانتینر کافی نیست؛ یک محموله را به کانتینر بعدی منتقل کنید.</div>':''}</div>`;
  fwBind($('.fw-form',B),S,(k)=>{sv();if(['eq'].includes(k))draw()});$$('.fw-form [data-k]',B).forEach(x=>x.addEventListener('change',draw));
  $$('.v14-lt input',B).forEach(x=>x.onchange=()=>{const it=S.items[+x.closest('tr').dataset.i];it[x.dataset.c]=x.type==='number'?+x.value:x.value;sv();draw()});$$('.v14-lt [data-x]',B).forEach(x=>x.onclick=()=>{S.items.splice(+x.closest('tr').dataset.i,1);sv();draw()});
  $('[data-ad]',B).onclick=()=>{S.items.push({id:rgId(),cust:'',cargo:'',pcs:1,kg:500,cbm:2});sv();draw()};
  $('[data-mf]',B).onclick=()=>openDoc(`<div class="page"><h1>Consolidation Manifest · مانیفست بار تجمیعی</h1><p>MBL: <b dir="ltr">${esc(S.mbl)}</b> · ${esc(S.vessel)} · ${S.eq}</p><table><tr><th>HBL</th><th>مشتری / Consignee</th><th>کالا</th><th>بسته</th><th>kg</th><th>m³</th></tr>${R.map(r=>`<tr><td dir="ltr">${r.hbl}</td><td>${esc(r.x.cust)}</td><td>${esc(r.x.cargo)}</td><td>${fa(r.x.pcs)}</td><td>${nf(r.x.kg)}</td><td>${nf(r.x.cbm,1)}</td></tr>`).join('')}<tr><th colspan="3">جمع</th><th>${fa(S.items.reduce((a,x)=>a+(+x.pcs||0),0))}</th><th>${nf(tk)}</th><th>${nf(tc,1)}</th></tr></table></div>`,'مانیفست '+S.mbl)};draw()}
function rBkg(b){subTabs(b,V14,'bkg',[['bk','رزرو و مهلت‌ها'],['vgm','VGM'],['lcl','تجمیع بار خرده (LCL)']],(v,B)=>({bk:bkBk,vgm:bkVgm,lcl:bkLcl})[v](B))}

/* ===== v14: customs/transit/TIR/free zones/FX commitment/regulations + ledger (aging, guarantees, commissions, accounting export, profitability) ===== */
const DECS=['ثبت اظهارنامه و دریافت کوتاژ','تخصیص مسیر (سبز/زرد/قرمز)','ارزیابی اسنادی','ارزیابی فیزیکی / کارشناسی','تعیین ارزش و تعرفه','اخذ مجوزهای ترخیص','پرداخت حقوق و عوارض','صدور پروانهٔ گمرکی','خروج از درب گمرک'];
const DCH=[['g','سبز','ok'],['y','زرد','warn'],['r','قرمز','bad'],['',' تعیین‌نشده','off']];
function cusDec(B){rgUI(B,{key:'ifa-dec',title:'اظهارنامه‌ها و پیگیری ترخیص',sub:'کوتاژ، مسیر ارزیابی و مراحل ترخیص هر اظهارنامه',addL:'اظهارنامهٔ جدید',
 def:()=>({kot:'',date:fwToday(),cus:'گمرک شهید رجایی',type:'واردات قطعی',job:LSG('ifa-jobs',[])[0]?.ref||'',hs:'',val:0,ch:'',agent:'',steps:[],note:''}),
 fields:[['kot','شمارهٔ کوتاژ'],['date','تاریخ اظهار','d'],['cus','گمرک اجرایی'],['type','نوع اظهار','',['واردات قطعی','صادرات قطعی','ترانزیت خارجی','ورود موقت','کالای همراه مسافر','مرجوعی'].map(x=>[x,x])],['job','پرونده','',[['','—'],...LSG('ifa-jobs',[]).map(j=>[j.ref,j.ref])]],['hs','کد تعرفه'],['val','ارزش گمرکی ($)','n'],['ch','مسیر ارزیابی','',DCH.map(x=>[x[0],x[1]])],['agent','کارگزار/ترخیص‌کار'],['note','یادداشت','l']],
 cols:[['کوتاژ',r=>`<b dir="ltr">${esc(r.kot||'—')}</b>`],['تاریخ',r=>jdt(r.date)],['گمرک',r=>esc(r.cus)],['نوع',r=>esc(r.type)],['پرونده',r=>esc(r.job)],['مسیر',r=>{const c=DCH.find(x=>x[0]===r.ch)||DCH[3];return chip(c[2],c[1])}],['پیشرفت',r=>{const n=(r.steps||[]).length;return `<span class="v14-bar"><i style="width:${n/DECS.length*100}%" class="${n===DECS.length?'':'warn'}"></i></span> ${fa(n)}/${fa(DECS.length)}`}],['روز در گمرک',r=>(r.steps||[]).length===DECS.length?'—':fa(Math.max(0,-dleft(r.date)))]],
 kpis:L=>{const o=L.filter(r=>(r.steps||[]).length<DECS.length);return kpi('در جریان ترخیص',o.length)+kpi('مسیر قرمز',o.filter(r=>r.ch==='r').length)+kpi('میانگین روز در گمرک',o.length?o.reduce((a,r)=>a+Math.max(0,-dleft(r.date)),0)/o.length:0,{d:1})+kpi('ترخیص‌شده',L.length-o.length)},
 name:r=>'اظهارنامه '+esc(r.kot||''),after:r=>`<h5>مراحل ترخیص</h5><div class="v14-steps">${DECS.map((s,i)=>`<label class="${(r.steps||[]).includes(i)?'on':''}"><input type="checkbox" data-st="${i}" ${(r.steps||[]).includes(i)?'checked':''}><span>${fa(i+1)}. ${s}</span></label>`).join('')}</div>${r.ch==='r'?'<div class="fw-al warn">مسیر قرمز: کارشناسی فیزیکی و احتمال ارجاع به کمیسیون؛ دموراژ و انبارداری را در محاسبه‌گر بررسی کنید.</div>':''}`,
 bindAfter:(E,r,sv)=>$$('[data-st]',E).forEach(x=>x.onchange=()=>{const s=new Set(r.steps||[]);x.checked?s.add(+x.dataset.st):s.delete(+x.dataset.st);r.steps=[...s].sort((a,b)=>a-b);sv();x.closest('label').classList.toggle('on',x.checked);const tr=document.querySelector(`.rg-t tr[data-id="${r.id}"]`);if(tr){const n=r.steps.length;tr.children[6].innerHTML=`<span class="v14-bar"><i style="width:${n/DECS.length*100}%" class="${n===DECS.length?'':'warn'}"></i></span> ${fa(n)}/${fa(DECS.length)}`}})})}
const TRK2=[['open','در جریان','warn'],['out','خروج ثبت شد','ok'],['clr','رفع تعهد/ابطال','ok'],['clm','مطالبهٔ تضمین','bad']];
function cusTrn(B){rgUI(B,{key:'ifa-trn',title:'ترانزیت خارجی، کارنهٔ تیر و ورود موقت',sub:'مهلت خروج، تضمین/ضمانت‌نامه و رفع تعهد',addL:'ثبت جدید',
 def:()=>({kind:'ترانزیت خارجی',no:'',inC:'گمرک بازرگان',outC:'گمرک شهید رجایی',inD:fwToday(),days:30,gAmt:0,gType:'ضمانت‌نامهٔ بانکی',gNo:'',truck:'',job:'',st:'open',outD:'',note:''}),
 fields:[['kind','نوع','',['ترانزیت خارجی','کارنهٔ تیر (TIR)','ورود موقت','کارنهٔ ATA','انتقالی داخلی'].map(x=>[x,x])],['no','شمارهٔ پروانه/کارنه'],['inC','گمرک ورودی'],['outC','گمرک خروجی'],['inD','تاریخ ورود','d'],['days','مهلت (روز)','n'],['gType','نوع تضمین','',['ضمانت‌نامهٔ بانکی','سپردهٔ نقدی','تضمین اتاق بازرگانی (TIR)','بیمه‌نامهٔ تضمین'].map(x=>[x,x])],['gAmt','مبلغ تضمین (ریال)','n'],['gNo','شمارهٔ تضمین'],['truck','کامیون/کانتینر'],['job','پرونده'],['st','وضعیت','',TRK2.map(x=>[x[0],x[1]])],['outD','تاریخ خروج','d'],['note','یادداشت','l']],
 cols:[['نوع',r=>esc(r.kind)],['شماره',r=>`<b dir="ltr">${esc(r.no||'—')}</b>`],['مسیر',r=>esc(r.inC)+' → '+esc(r.outC)],['ورود',r=>jdt(r.inD)],['مهلت خروج',r=>r.st==='open'?jdt(fwAdd(r.inD,+r.days||0))+' '+dchip(fwAdd(r.inD,+r.days||0),5):'—'],['تضمین',r=>fa(nf((+r.gAmt||0)/1e7,1))+' م.ت'],['وضعیت',r=>{const s=TRK2.find(x=>x[0]===r.st)||TRK2[0];return chip(s[2],s[1])}]],
 kpis:L=>{const o=L.filter(r=>r.st==='open');return kpi('تعهد باز',o.length)+kpi('سررسید ۵ روز آینده',o.filter(r=>{const d=dleft(fwAdd(r.inD,+r.days||0));return d>=0&&d<=5}).length)+kpi('مهلت گذشته',o.filter(r=>dleft(fwAdd(r.inD,+r.days||0))<0).length)+kpi('تضمین‌های درگیر (م.ت)',o.reduce((a,r)=>a+(+r.gAmt||0),0)/1e7,{d:1})},
 name:r=>esc(r.kind)+' '+esc(r.no||''),after:r=>r.kind.includes('TIR')?fwNote('کارنهٔ تیر: پس از خروج، برگ ۲ (Voucher 2) در گمرک خروجی ابطال و ته‌برگ به اتاق بازرگانی برگشت داده شود؛ تا دریافت تأیید ابطال، تضمین آزاد نمی‌شود.'):fwNote('پس از خروج کالا، رسید خروج را از گمرک خروجی بگیرید و برای آزادسازی تضمین به گمرک ورودی ارائه کنید.')})}
const FZ0=[['CHB','منطقهٔ آزاد چابهار',1.5,0.5,'CHB'],['KSH','منطقهٔ آزاد کیش',2,0.6,'BND'],['QSM','منطقهٔ آزاد قشم',1.5,0.5,'BND'],['ARS','منطقهٔ آزاد ارس',1.2,0.4,'JLF'],['ANZ','منطقهٔ آزاد انزلی',1.2,0.4,'ANZ'],['ARV','منطقهٔ آزاد اروند',1.2,0.4,'BIK'],['MAK','منطقهٔ آزاد ماکو',1.2,0.4,'BZG']];
function cusFz(B){const S=Object.assign({val:100000,duty:20,days:60,int:30,dest:'THR',zone:'CHB',main:'BND',hand:400,tr:0},LSG('ifa-fz',{}));const sv=()=>LSS('ifa-fz',S);
 const out=()=>{const z=FZ0.find(x=>x[0]===S.zone);const dz=dmKm(z[4],S.dest)||0,dm=dmKm(S.main,S.dest)||0;const fx=fwFx().free;const truck=km=>km*240000/fx;const duty=S.val*S.duty/100;const fin=duty*S.int/100*S.days/365;const stor=S.val*z[2]/100*S.days/30*0+z[3]/100*S.val;
  const A={n:'ورود مستقیم از '+dmN(S.main),duty,fin:0,stor:0,hand:0,tr:truck(dm)},Z={n:'ورود از '+z[1],duty,fin:-fin,stor,hand:+S.hand,tr:truck(dz)};const tot=x=>x.duty+x.fin+x.stor+x.hand+x.tr;
  $('.v14-fo',B).innerHTML=`<div class="sx-card"><header><b>مقایسه</b><small>ارزش کالا ${usd0(S.val)} · نگهداری ${fa(S.days)} روز</small></header><table class="sx-tbl"><thead><tr><th></th><th>${esc(A.n)}</th><th>${esc(Z.n)}</th></tr></thead><tbody>${[['حقوق ورودی (پرداخت هنگام ورود به سرزمین اصلی)','duty'],['صرفه‌جویی مالی از تعویق پرداخت حقوق','fin'],['انبارداری و عوارض منطقه','stor'],['تخلیه/بارگیری اضافه','hand'],['حمل داخلی تا مقصد','tr']].map(([n,k])=>`<tr><td>${n}</td><td>${usd0(A[k])}</td><td class="${Z[k]<0?'v14-good':''}">${usd0(Z[k])}</td></tr>`).join('')}<tr class="v14-tot"><td><b>جمع</b></td><td><b>${usd0(tot(A))}</b></td><td><b>${usd0(tot(Z))}</b></td></tr></tbody></table>
  <div class="fw-al ${tot(Z)<tot(A)?'ok':''}">${tot(Z)<tot(A)?`ورود از ${esc(z[1])} حدود ${usd0(tot(A)-tot(Z))} ارزان‌تر است؛ مزیت اصلی، تعویق پرداخت حقوق تا زمان ترخیص تدریجی است.`:`ورود مستقیم حدود ${usd0(tot(Z)-tot(A))} ارزان‌تر است؛ منطقه فقط وقتی به‌صرفه است که کالا مدت طولانی نگهداری یا به‌صورت تدریجی ترخیص شود.`}</div>${fwNote('نرخ‌های انبارداری و عوارض مناطق نمونه‌اند و با تعرفهٔ روز سازمان منطقه جایگزین شوند. مزایای دیگر مناطق (معافیت ارزش افزوده در منطقه، ثبت سفارش، ورود کالای همراه مسافر، کار روی کالا و ارزش افزودهٔ محلی) و محدودیت‌ها (سهمیه و مقررات ترخیص به سرزمین اصلی) را جداگانه بسنجید.')}</div>`};
 B.innerHTML=`<div class="fc-g2"><div class="sx-card fw-form"><header><b>منطقهٔ آزاد یا ورود مستقیم؟</b><small>مقایسهٔ هزینهٔ تمام‌شده</small></header><div class="fw-g">${fwI('ارزش کالا ($)','val',S.val)}${fwI('حقوق ورودی + سود بازرگانی ٪','duty',S.duty)}${fwI('مدت نگهداری پیش از فروش (روز)','days',S.days)}${fwI('هزینهٔ سرمایه/بهره سالانه ٪','int',S.int)}${fwI('منطقهٔ آزاد','zone',S.zone,{opts:FZ0.map(z=>[z[0],z[1]])})}${fwI('بندر ورود مستقیم','main',S.main,{opts:DMC.map(c=>[c[0],c[1]])})}${fwI('مقصد نهایی','dest',S.dest,{opts:DMC.map(c=>[c[0],c[1]])})}${fwI('تخلیه/بارگیری اضافه در منطقه ($)','hand',S.hand)}</div></div><div class="v14-fo"></div></div>`;fwBind(B,S,()=>{sv();out()});out()}
function cusFxc(B){rgUI(B,{key:'ifa-fxc',title:'رفع تعهد ارزی صادرات',sub:'مهلت بازگشت ارز هر پروانهٔ صادراتی و روش رفع تعهد',addL:'پروانهٔ صادراتی',
 def:()=>({kot:'',date:fwToday(),val:0,cur:'USD',months:4,back:0,meth:'سامانهٔ نیما / بازار مبادله',buyer:'',st:'open',note:''}),
 fields:[['kot','کوتاژ صادراتی'],['date','تاریخ صدور پروانه','d'],['val','ارزش (ارز)','n'],['cur','ارز','',['USD','EUR','AED','CNY','RUB','TRY','IQD'].map(x=>[x,x])],['months','مهلت (ماه)','n'],['back','ارز بازگشتی تاکنون','n'],['meth','روش رفع تعهد','',['سامانهٔ نیما / بازار مبادله','واردات در مقابل صادرات خود','واگذاری به واردکنندهٔ دیگر','فروش اسکناس به بانک/صرافی','پیمان‌سپاری با تهاتر'].map(x=>[x,x])],['buyer','خریدار خارجی'],['st','وضعیت','',[['open','در جریان'],['done','رفع تعهد شد'],['ext','تمدید مهلت']]],['note','یادداشت','l']],
 cols:[['کوتاژ',r=>`<b dir="ltr">${esc(r.kot||'—')}</b>`],['تاریخ',r=>jdt(r.date)],['ارزش',r=>fa(nf(r.val))+' '+esc(r.cur)],['بازگشته',r=>{const p=r.val?Math.min(100,r.back/r.val*100):0;return `<span class="v14-bar"><i style="width:${p}%" class="${p>=100?'':'warn'}"></i></span> ${fa(nf(p))}٪`}],['روش',r=>esc(r.meth)],['سررسید',r=>{const d=fwAdd(r.date,Math.round((+r.months||0)*30.4));return r.st==='done'?chip('ok','رفع تعهد'):jdt(d)+' '+dchip(d,20)}]],
 kpis:L=>{const o=L.filter(r=>r.st!=='done');return kpi('تعهد باز',o.length)+kpi('ارز بازنگشته (دلار معادل)',o.reduce((a,r)=>a+pU((+r.val||0)-(+r.back||0),r.cur),0),{pre:'$'})+kpi('سررسید ۲۰ روز آینده',o.filter(r=>{const d=dleft(fwAdd(r.date,Math.round((+r.months||0)*30.4)));return d>=0&&d<=20}).length)},name:r=>'تعهد ارزی '+esc(r.kot||'')})}
function cusReg(B){const hsAll=[...LSG('ifa-dec',[]).map(d=>d.hs),(ctx()&&ctx().cargo&&ctx().cargo.hs)||''].filter(Boolean).map(String);
 rgUI(B,{key:'ifa-reg',title:'تقویم تغییر مقررات و بخشنامه‌ها',sub:'هر بخشنامه را با پیشوند کد تعرفهٔ مشمول ثبت کنید تا اظهارنامه‌های متأثر علامت بخورند',addL:'بخشنامهٔ جدید',
 def:()=>({date:fwToday(),eff:fwToday(),src:'گمرک ج.ا.ا.',no:'',title:'',hs:'',kind:'تغییر نرخ/تعرفه',link:'',note:''}),
 fields:[['date','تاریخ ابلاغ','d'],['eff','تاریخ اجرا','d'],['src','مرجع','',['گمرک ج.ا.ا.','وزارت صمت','بانک مرکزی','سازمان توسعهٔ تجارت','سازمان امور مالیاتی','سازمان ملی استاندارد','سازمان غذا و دارو','سازمان حفظ نباتات/دامپزشکی','هیئت وزیران'].map(x=>[x,x])],['no','شمارهٔ بخشنامه'],['title','عنوان','','',0,'w2'],['hs','پیشوند کدهای تعرفهٔ مشمول (با کاما)'],['kind','نوع تغییر','',['تغییر نرخ/تعرفه','ممنوعیت/محدودیت','مجوز جدید','رویهٔ ارزی','رویهٔ گمرکی','استاندارد اجباری'].map(x=>[x,x])],['link','پیوند'],['note','خلاصه/اقدام لازم','l']],
 cols:[['اجرا از',r=>jdt(r.eff)+' '+(dleft(r.eff)>0?chip('warn','آینده'):'')],['مرجع',r=>esc(r.src)],['شماره',r=>esc(r.no)],['عنوان',r=>`<b>${esc(r.title)}</b>`],['نوع',r=>esc(r.kind)],['کدها',r=>`<small dir="ltr">${esc(r.hs)}</small>`],['متأثر',r=>{const P=String(r.hs||'').split(/[,،\s]+/).filter(Boolean);const n=hsAll.filter(h=>P.some(p=>h.replace(/\D/g,'').startsWith(p.replace(/\D/g,'')))).length;return n?chip('bad',fa(n)+' مورد'):'—'}]],
 sort:(a,b)=>String(b.eff).localeCompare(a.eff),name:r=>esc(r.title||'بخشنامه')})}
function rCus(b){subTabs(b,V14,'cus',[['dec','اظهار و ترخیص'],['trn','ترانزیت و تیر'],['fz','مناطق آزاد'],['fxc','رفع تعهد ارزی'],['reg','تقویم مقررات']],(v,B)=>({dec:cusDec,trn:cusTrn,fz:cusFz,fxc:cusFxc,reg:cusReg})[v](B))}

/* ---------- Ledger ---------- */
function ledAr(B){const A=arLines();const S=LED.ar||(LED.ar='ar');const L=A.filter(x=>x.t===S);const by={};L.forEach(x=>{const o=by[x.who]=by[x.who]||{b:[0,0,0,0,0],n:0,it:[]};o.b[agB(x.due)]+=x.amt;o.n++;o.it.push(x)});const tot=[0,1,2,3,4].map(i=>Object.values(by).reduce((a,o)=>a+o.b[i],0));const T=tot.reduce((a,x)=>a+x,0);
 B.innerHTML=`<div class="sx-row" style="margin-bottom:10px">${tmSeg([['ar','مطالبات (دریافتنی)'],['ap','بدهی‌ها (پرداختنی)']],S,'v14-ar')}</div><div class="ex-kpis">${kpi(S==='ar'?'جمع مطالبات':'جمع بدهی‌ها',T,{pre:'$'})}${AGB.slice(1).map((g,i)=>kpi(g[1]+' روز',tot[i+1],{pre:'$'})).join('')}${S==='ar'?kpi('صورتحساب‌نشده',A.filter(x=>x.t==='ub').reduce((a,x)=>a+x.amt,0),{pre:'$',sub:'هنوز صادر نشده؛ در سن‌بندی نیست'}):''}</div>
 <div class="sx-card"><header><b>سن ${S==='ar'?'مطالبات به تفکیک مشتری':'بدهی به تفکیک تأمین‌کننده/کارگزار'}</b><small>دلار معادل · از ردیف‌های پرونده‌ها (${S==='ar'?'صورتحساب‌شده و وصول‌نشده':'پرداخت‌نشده'})</small><span class="sx-sp"></span><button class="sx-btn sm" data-csv>CSV</button></header><div class="rg-w"><table class="sx-tbl"><thead><tr><th>${S==='ar'?'مشتری':'طرف حساب'}</th><th>ردیف</th>${AGB.map(g=>`<th>${g[1]}</th>`).join('')}<th>جمع</th></tr></thead><tbody>${Object.entries(by).sort((a,b)=>b[1].b.reduce((x,y)=>x+y)-a[1].b.reduce((x,y)=>x+y)).map(([w,o])=>`<tr><td><b>${esc(w)}</b><details><summary>${fa(o.n)} قلم</summary>${o.it.map(x=>`<div class="v14-sm">${esc(x.job)} · ${esc(x.n)} · ${usd0(x.amt)} · سررسید ${jdt(x.due)}</div>`).join('')}</details></td><td>${fa(o.n)}</td>${o.b.map((v,i)=>`<td class="${i>=3&&v?'v14-bad':''}">${v?usd0(v):'—'}</td>`).join('')}<td><b>${usd0(o.b.reduce((a,x)=>a+x,0))}</b></td></tr>`).join('')||'<tr><td colspan="8" class="sx-muted">موردی نیست.</td></tr>'}</tbody></table></div></div>
 <div class="sx-card"><header><b>تطبیق صورت‌حساب کارگزار</b><small>ستون‌های «مرجع پرونده، مبلغ دلاری» را از صورت‌حساب کارگزار بچسبانید (هر خط یک ردیف)</small></header><div class="fw-g"><label class="sx-f fw-f"><span>کارگزار/طرف حساب</span><select class="v14-ag">${[...new Set(A.filter(x=>x.t==='ap').map(x=>x.who))].map(w=>`<option>${esc(w)}</option>`).join('')}</select></label></div><textarea class="v14-ta" rows="4" dir="ltr" placeholder="JOB-0001, 1250&#10;JOB-0002, 830"></textarea><div class="fw-bt"><button class="sx-btn sm pri" data-rc>تطبیق</button></div><div class="v14-rc"></div></div>`;
 $$('.v14-ar button',B).forEach(x=>x.onclick=()=>{LED.ar=x.dataset.v;ledAr(B)});
 $('[data-csv]',B).onclick=()=>dlFile('aging-'+S+'.csv',toCSV(['party','job','item','amountUSD','due','bucket'],L.map(x=>[x.who,x.job,x.n,Math.round(x.amt),x.due,AGB[agB(x.due)][1]])));
 $('[data-rc]',B).onclick=()=>{const ag=$('.v14-ag',B).value;const mine={};A.filter(x=>x.t==='ap'&&x.who===ag).forEach(x=>mine[x.job]=(mine[x.job]||0)+x.amt);const th={};$('.v14-ta',B).value.split(/\n/).forEach(l=>{const m=l.split(/[,;\t]/);if(m.length>=2){const k=m[0].trim();th[k]=(th[k]||0)+(fwN(m[1])||0)}});
  const ks=[...new Set([...Object.keys(mine),...Object.keys(th)])];$('.v14-rc',B).innerHTML=`<table class="sx-tbl"><thead><tr><th>پرونده</th><th>دفاتر ما</th><th>صورت‌حساب کارگزار</th><th>اختلاف</th><th>نتیجه</th></tr></thead><tbody>${ks.map(k=>{const a=mine[k]||0,b=th[k]||0,d=b-a;return `<tr><td>${esc(k)}</td><td>${a?usd0(a):'—'}</td><td>${b?usd0(b):'—'}</td><td class="${Math.abs(d)>1?'v14-bad':''}">${usd0(d)}</td><td>${!a?chip('bad','در دفاتر ما نیست'):!b?chip('warn','در صورت‌حساب کارگزار نیست'):Math.abs(d)<=1?chip('ok','منطبق'):chip('bad','مغایرت مبلغ')}</td></tr>`}).join('')}</tbody></table>`}}
const LED={};
function ledGrt(B){rgUI(B,{key:'ifa-grt',title:'ضمانت‌نامه‌ها و سپرده‌ها',sub:'سپردهٔ کانتینر، ضمانت گمرکی، تضمین تیر و حسن انجام کار — با مهلت آزادسازی',addL:'ثبت ضمانت/سپرده',
 def:()=>({kind:'سپردهٔ کانتینر',party:'',no:'',amt:0,cur:'USD',issue:fwToday(),exp:fwAdd(fwToday(),90),job:'',bank:'',st:'act',note:''}),
 fields:[['kind','نوع','',['سپردهٔ کانتینر','ضمانت‌نامهٔ گمرکی','تضمین ترانزیت/تیر','ضمانت‌نامهٔ حسن انجام کار','ضمانت‌نامهٔ پیش‌پرداخت','چک تضمین'].map(x=>[x,x])],['party','ذی‌نفع'],['no','شماره'],['amt','مبلغ','n'],['cur','ارز','',['USD','EUR','AED','IRR'].map(x=>[x,x])],['issue','تاریخ صدور','d'],['exp','سررسید/مهلت آزادسازی','d'],['bank','بانک/محل نگهداری'],['job','پرونده'],['st','وضعیت','',[['act','فعال'],['rel','آزاد شد'],['clm','ضبط/مطالبه شد']]],['note','یادداشت','l']],
 cols:[['نوع',r=>esc(r.kind)],['ذی‌نفع',r=>`<b>${esc(r.party)}</b>`],['شماره',r=>`<span dir="ltr">${esc(r.no)}</span>`],['مبلغ',r=>fa(nf(r.amt))+' '+esc(r.cur)],['پرونده',r=>esc(r.job)],['سررسید',r=>r.st==='act'?jdt(r.exp)+' '+dchip(r.exp,10):'—'],['وضعیت',r=>chip(r.st==='act'?'warn':r.st==='rel'?'ok':'bad',{act:'فعال',rel:'آزاد شد',clm:'ضبط شد'}[r.st])]],
 kpis:L=>{const a=L.filter(r=>r.st==='act');return kpi('سرمایهٔ درگیر (دلار معادل)',a.reduce((s,r)=>s+pU(r.amt,r.cur),0),{pre:'$'})+kpi('فعال',a.length)+kpi('سررسید ۱۰ روز آینده',a.filter(r=>{const d=dleft(r.exp);return d>=0&&d<=10}).length)+kpi('ضبط‌شده',L.filter(r=>r.st==='clm').length)},name:r=>esc(r.kind)})}
function ledCom(B){const J=LSG('ifa-jobs',[]);rgUI(B,{key:'ifa-com',title:'کمیسیون کارگزاران و نمایندگان',sub:'مبنای کمیسیون: سود ناخالص یا فروش پرونده',addL:'کمیسیون جدید',
 def:()=>({agent:'',job:J[0]?.ref||'',base:'gp',pct:20,amt:0,st:'due',paid:'',note:''}),
 fields:[['agent','کارگزار/نماینده'],['job','پرونده','',J.map(j=>[j.ref,j.ref+' · '+(j.cust||'')])],['base','مبنا','',[['gp','سود ناخالص واقعی'],['rev','فروش']]],['pct','درصد','n'],['amt','مبلغ ($) — خالی = محاسبهٔ خودکار','n'],['st','وضعیت','',[['due','قابل پرداخت'],['paid','پرداخت شد']]],['paid','تاریخ پرداخت','d'],['note','یادداشت','l']],
 cols:[['کارگزار',r=>`<b>${esc(r.agent)}</b>`],['پرونده',r=>esc(r.job)],['مبنا',r=>r.base==='gp'?'سود ناخالص':'فروش'],['٪',r=>fa(r.pct)],['مبلغ',r=>usd0(comAmt(r,J))],['وضعیت',r=>chip(r.st==='paid'?'ok':'warn',r.st==='paid'?'پرداخت شد':'قابل پرداخت')]],
 kpis:L=>kpi('کمیسیون قابل پرداخت',L.filter(r=>r.st!=='paid').reduce((a,r)=>a+comAmt(r,J),0),{pre:'$'})+kpi('پرداخت‌شده',L.filter(r=>r.st==='paid').reduce((a,r)=>a+comAmt(r,J),0),{pre:'$'}),name:r=>'کمیسیون '+esc(r.agent),
 acts:r=>'<button class="sx-btn sm" data-pv>صورتحساب کمیسیون</button>',bindEd:(E,r)=>{$('[data-pv]',E).onclick=()=>openDoc(`<div class="page"><h1>صورتحساب کمیسیون · Commission Statement</h1><table><tr><td>نماینده / Agent</td><td>${esc(r.agent)}</td></tr><tr><td>پرونده / Job</td><td>${esc(r.job)}</td></tr><tr><td>مبنا / Basis</td><td>${r.base==='gp'?'Gross profit':'Revenue'} × ${r.pct}%</td></tr><tr><th>مبلغ / Amount</th><th dir="ltr">${usd0(comAmt(r,J))}</th></tr><tr><td>تاریخ</td><td>${jdt(fwToday())}</td></tr></table></div>`,'کمیسیون '+r.agent)}})}
function comAmt(r,J){if(+r.amt)return +r.amt;const j=J.find(x=>x.ref===r.job);if(!j)return 0;const s=jobSum(j);return (r.base==='gp'?s.gpa:s.sa)*(+r.pct||0)/100}
const ACC0={rev:'6101',cost:'7101',ar:'1301',ap:'3101',pass:'1309',vat:'2201',fmt:'gen'};
function ledAcc(B){const S=Object.assign({},ACC0,LSG('ifa-acc',{}),{from:LED.from||fwAdd(fwToday(),-90),to:LED.to||fwToday()});const J=LSG('ifa-jobs',[]);const fx=fwFx().free;
 const ent=()=>{const E=[];J.filter(j=>j.date>=S.from&&j.date<=S.to).forEach(j=>(j.lines||[]).forEach(l=>{const rs=Math.round(pU(l.sa??l.se,l.cur)*fx),rc=Math.round(pU(l.ba??l.be,l.cur)*fx);const d=j.date,ds=j.ref+' · '+l.n;
  if(l.kind==='dis'){if(rc){E.push([d,S.pass,'پیش‌پرداخت از طرف مشتری',rc,0,ds]);E.push([d,S.ap,l.v||'بستانکار',0,rc,ds])}}else{if(rs){E.push([d,S.ar,j.cust||'مشتری',rs,0,ds]);E.push([d,S.rev,'درآمد خدمات حمل',0,rs,ds])}if(rc){E.push([d,S.cost,'بهای تمام‌شدهٔ خدمات',rc,0,ds]);E.push([d,S.ap,l.v||'بستانکار',0,rc,ds])}}}));return E};
 const E=ent();const dr=E.reduce((a,e)=>a+e[3],0),cr=E.reduce((a,e)=>a+e[4],0);
 B.innerHTML=`<div class="sx-card fw-form"><header><b>خروجی سند حسابداری</b><small>سند دوطرفهٔ ریالی از ردیف‌های پرونده‌ها · کدهای حساب را با سرفصل نرم‌افزار خود هماهنگ کنید</small></header><div class="fw-g">${fwI('از تاریخ','from',S.from,{t:'date'})}${fwI('تا تاریخ','to',S.to,{t:'date'})}${fwI('حساب درآمد','rev',S.rev,{t:'text'})}${fwI('حساب بهای تمام‌شده','cost',S.cost,{t:'text'})}${fwI('حساب دریافتنی','ar',S.ar,{t:'text'})}${fwI('حساب پرداختنی','ap',S.ap,{t:'text'})}${fwI('پیش‌پرداخت از طرف مشتری','pass',S.pass,{t:'text'})}${fwI('قالب خروجی','fmt',S.fmt,{opts:[['gen','عمومی (CSV)'],['sep','سپیدار — ورود سند از اکسل'],['ham','همکاران سیستم — ورود سند'],['rah','رایورز — ورود سند']]})}</div>
 <div class="ex-kpis">${kpi('ردیف سند',E.length)}${kpi('جمع بدهکار (م.ریال)',dr/1e6,{d:1})}${kpi('جمع بستانکار (م.ریال)',cr/1e6,{d:1})}${kpi('تراز',dr-cr,{sub:dr===cr?'سند متوازن است':'نامتوازن'})}</div><div class="fw-bt"><button class="sx-btn sm pri" data-dl>دانلود فایل سند</button></div>
 <div class="rg-w"><table class="sx-tbl"><thead><tr><th>تاریخ</th><th>کد حساب</th><th>تفصیلی</th><th>بدهکار</th><th>بستانکار</th><th>شرح</th></tr></thead><tbody>${E.slice(0,60).map(e=>`<tr><td>${jdt(e[0])}</td><td dir="ltr">${e[1]}</td><td>${esc(e[2])}</td><td>${e[3]?nf(e[3]):''}</td><td>${e[4]?nf(e[4]):''}</td><td><small>${esc(e[5])}</small></td></tr>`).join('')||'<tr><td colspan="6" class="sx-muted">پرونده‌ای در این بازه نیست.</td></tr>'}</tbody></table></div>${fwNote('ستون‌ها در قالب‌های سپیدار/همکاران/رایورز به ترتیب رایج فایل ورود سند آن‌ها چیده شده‌اند، اما نسخه‌های این نرم‌افزارها متفاوت است؛ پیش از ورود نهایی، یک سند آزمایشی وارد کنید. ارزش افزوده در صورتحساب مؤدیان جداگانه محاسبه می‌شود.')}</div>`;
 fwBind(B,S,(k)=>{if(k==='from'||k==='to'){LED[k]=S[k];return ledAcc(B)}const o={};Object.keys(ACC0).forEach(x=>o[x]=S[x]);LSS('ifa-acc',o);if(k==='fmt')ledAcc(B)});
 $('[data-dl]',B).onclick=()=>{const jd=d=>jdt(d).replace(/[۰-۹]/g,x=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(x));const H={gen:[['date','account','detail','debit','credit','description'],e=>[e[0],e[1],e[2],e[3],e[4],e[5]]],sep:[['تاریخ','کد حساب','کد تفصیلی','شرح','بدهکار','بستانکار'],e=>[jd(e[0]),e[1],e[2],e[5],e[3],e[4]]],ham:[['ردیف','کد معین','تفصیلی','شرح','بدهکار','بستانکار','تاریخ'],(e,i)=>[i+1,e[1],e[2],e[5],e[3],e[4],jd(e[0])]],rah:[['تاریخ سند','کد حساب','شرح ردیف','بدهکار','بستانکار','تفصیل'],e=>[jd(e[0]),e[1],e[5],e[3],e[4],e[2]]]}[S.fmt];dlFile('voucher-'+S.fmt+'-'+S.to+'.csv',toCSV(H[0],E.map(H[1])))}}
function ledPrf(B){const J=LSG('ifa-jobs',[]);const dim=LED.dim||'cust';const G={};J.forEach(j=>{const s=jobSum(j);const keys=dim==='cust'?[j.cust||'بی‌نام']:dim==='route'?[j.route||'نامشخص']:dim==='month'?[String(j.date).slice(0,7)]:[...new Set(j.lines.filter(l=>l.kind!=='dis').map(l=>l.v||'نامشخص'))];
  keys.forEach(k=>{const o=G[k]=G[k]||{n:0,rev:0,cost:0};if(dim==='vend'){j.lines.filter(l=>l.kind!=='dis'&&(l.v||'نامشخص')===k).forEach(l=>{o.rev+=pU(l.sa??l.se,l.cur);o.cost+=pU(l.ba??l.be,l.cur)});o.n++}else{o.n++;o.rev+=s.sa;o.cost+=s.ba}})});
 const R=Object.entries(G).map(([k,o])=>({k,...o,gp:o.rev-o.cost,m:o.rev?(o.rev-o.cost)/o.rev*100:0})).sort((a,b)=>b.gp-a.gp);const mx=Math.max(1,...R.map(r=>Math.abs(r.gp)));const T=R.reduce((a,r)=>({rev:a.rev+r.rev,gp:a.gp+r.gp}),{rev:0,gp:0});
 B.innerHTML=`<div class="sx-row" style="margin-bottom:10px">${tmSeg([['cust','مشتری'],['route','مسیر'],['vend','تأمین‌کننده'],['month','ماه']],dim,'v14-dm')}</div><div class="ex-kpis">${kpi('فروش واقعی',T.rev,{pre:'$'})}${kpi('سود ناخالص',T.gp,{pre:'$'})}${kpi('حاشیهٔ سود',T.rev?T.gp/T.rev*100:0,{suf:'٪',d:1})}${kpi('پرونده‌ها',J.length)}</div>
 <div class="sx-card"><header><b>سودآوری به تفکیک ${({cust:'مشتری',route:'مسیر',vend:'تأمین‌کننده',month:'ماه'})[dim]}</b><small>بر اساس مبالغ واقعی (در نبود، برآوردی) پرونده‌ها · بدون پرداخت‌های واسط</small></header><div class="rg-w"><table class="sx-tbl v14-pf"><thead><tr><th>${({cust:'مشتری',route:'مسیر',vend:'تأمین‌کننده',month:'ماه'})[dim]}</th><th>پرونده</th><th>فروش</th><th>هزینه</th><th>سود ناخالص</th><th>حاشیه</th><th style="width:28%"></th></tr></thead><tbody>${R.map(r=>`<tr><td><b>${esc(r.k)}</b></td><td>${fa(r.n)}</td><td>${usd0(r.rev)}</td><td>${usd0(r.cost)}</td><td class="${r.gp<0?'v14-bad':''}">${usd0(r.gp)}</td><td>${fa(nf(r.m,1))}٪</td><td><span class="v14-hb"><i class="${r.gp<0?'neg':''}" style="width:${Math.abs(r.gp)/mx*100}%"></i></span></td></tr>`).join('')||'<tr><td colspan="7" class="sx-muted">پرونده‌ای نیست.</td></tr>'}</tbody></table></div></div>`;
 $$('.v14-dm button',B).forEach(x=>x.onclick=()=>{LED.dim=x.dataset.v;ledPrf(B)})}
function rLed(b){subTabs(b,V14,'led',[['ar','سن مطالبات و بدهی'],['grt','ضمانت‌نامه و سپرده'],['com','کمیسیون'],['acc','خروجی حسابداری'],['prf','تحلیل سودآوری']],(v,B)=>({ar:ledAr,grt:ledGrt,com:ledCom,acc:ledAcc,prf:ledPrf})[v](B))}

/* ===== v14: special cargo (DG/reefer/OOG), carriers & axle load, claims, unified inbox ===== */
const UNDB=[['0336','آتش‌بازی (Fireworks)','1.4','II',''],['1005','آمونیاک بی‌آب','2.3','','8'],['1072','اکسیژن فشرده','2.2','','5.1'],['1075','گاز مایع نفتی (LPG)','2.1','',''],['1090','استون','3','II',''],['1133','چسب‌ها','3','II',''],['1170','اتانول','3','II',''],['1202','گازوئیل / دیزل','3','III',''],['1203','بنزین','3','II',''],['1230','متانول','3','II','6.1'],['1263','رنگ و محصولات رنگ','3','II',''],['1294','تولوئن','3','II',''],['1307','زایلن','3','II',''],['1361','کربن (منشأ حیوانی/گیاهی)','4.2','III',''],['1381','فسفر سفید/زرد','4.2','I','6.1'],['1402','کاربید کلسیم','4.3','II',''],['1428','سدیم','4.3','I',''],['1789','اسید هیدروکلریک','8','II',''],['1823','سود سوزآور جامد','8','II',''],['1824','محلول سود سوزآور','8','II',''],['1830','اسید سولفوریک','8','II',''],['1845','یخ خشک (CO₂ جامد)','9','',''],['1866','محلول رزین','3','II',''],['1942','نیترات آمونیوم','5.1','III',''],['1950','افشانه‌ها (Aerosols)','2.1','',''],['1978','پروپان','2.1','',''],['1993','مایع قابل اشتعال (N.O.S.)','3','II',''],['2014','پراکسید هیدروژن ۲۰ تا ۶۰٪','5.1','II','8'],['2031','اسید نیتریک','8','II','5.1'],['2067','کود نیترات آمونیوم','5.1','III',''],['2211','دانه‌های پلیمری انبساطی','9','III',''],['2794','باتری اسیدی تر','8','',''],['2810','مایع سمی آلی (N.O.S.)','6.1','II',''],['2811','جامد سمی آلی (N.O.S.)','6.1','II',''],['2908','مواد رادیواکتیو — بستهٔ معاف','7','',''],['3077','مادهٔ زیان‌آور محیط‌زیست، جامد','9','III',''],['3082','مادهٔ زیان‌آور محیط‌زیست، مایع','9','III',''],['3090','باتری لیتیوم فلزی','9','II',''],['3166','خودروی دارای موتور احتراقی','9','',''],['3171','خودرو/تجهیزات باتری‌دار','9','',''],['3291','پسماند بیمارستانی','6.2','II',''],['3480','باتری لیتیوم-یون','9','II',''],['3481','باتری لیتیوم-یون همراه تجهیزات','9','II','']];
const SGC=['1','1.3','1.4','2.1','2.2','2.3','3','4.1','4.2','4.3','5.1','5.2','6.1','6.2','7','8','9'];
const SGM=['***4224444442424X','***4224334442422X','***211222222X422X','442XXX212X22X421X','221XXX1X1XX1X21XX','221XXX2X2XX2X21XX','442212XX2122X32XX','4321XXXX1X12X321X','43221221X1221321X','442XXX1X1X22X221X','4422XX2122X21312X','44221222222X1322X','22XXXXXX1X11X1XXX','4444223332331X33X','222211222212X3X2X','4221XXX11122X32XX','XXXXXXXXXXXXXXXXX'];
const SGL={'*':['ok','—','بین مواد منفجره طبق جدول ۷.۲.۷'],X:['ok','بدون الزام عمومی','فهرست کالای خطرناک (DGL) را برای الزام خاص بررسی کنید'],'1':['warn','دور از (Away from)','در یک کانتینر فقط با تأیید مرجع ذی‌صلاح؛ معمولاً جدا بارگیری شود'],'2':['bad','جدا از (Separated from)','در یک کانتینر مجاز نیست'],'3':['bad','جدا با یک انبار/محفظهٔ کامل','در یک کانتینر مجاز نیست؛ روی عرشه با فاصلهٔ افقی'],'4':['bad','جدا طولی با انبار میانی','در یک کانتینر مجاز نیست؛ محدودیت جدی چیدمان کشتی']};
const sgCls=c=>{c=String(c||'');if(/^1\.[125]/.test(c)||c==='1')return '1';if(/^1\.[36]/.test(c))return '1.3';if(/^1\.4/.test(c))return '1.4';return SGC.includes(c)?c:c.split('.')[0]};
const sgGet=(a,b)=>{const i=SGC.indexOf(sgCls(a)),j=SGC.indexOf(sgCls(b));if(i<0||j<0)return 'X';return (SGM[i]||'')[j]||'X'};
const DGX={sel:null};
function dgDg(B){const S=Object.assign({ref:'',mode:'sea',items:[{un:'1263',qty:40,kg:800,pk:'4G'},{un:'1830',qty:10,kg:400,pk:'1H1'}]},LSG('ifa-dg',{}));const sv=()=>LSS('ifa-dg',S);
 const draw=()=>{const R=S.items.map(x=>{const u=UNDB.find(z=>z[0]===String(x.un).padStart(4,'0'));return {x,u}});const P=[];
  for(let i=0;i<R.length;i++)for(let j=i+1;j<R.length;j++){const a=R[i].u,b=R[j].u;if(!a||!b)continue;const cs=[[a[2],b[2]],...(a[4]?[[a[4],b[2]]]:[]),...(b[4]?[[a[2],b[4]]]:[]),...(a[4]&&b[4]?[[a[4],b[4]]]:[])];let w='X';cs.forEach(([p,q])=>{const v=sgGet(p,q);if('1234'.includes(v)&&(w==='X'||w==='*'||+v>+w))w=v});P.push({a:R[i],b:R[j],v:w})}
  const worst=P.reduce((m,p)=>'1234'.includes(p.v)&&+p.v>m?+p.v:m,0);const cls=[...new Set(R.filter(r=>r.u).flatMap(r=>[r.u[2],r.u[4]].filter(Boolean)))];
  B.innerHTML=`<div class="ex-kpis">${kpi('اقلام خطرناک',R.length)}${kpi('کلاس‌های درگیر',cls.length,{sub:cls.join('، ')||'—'})}${kpi('زوج‌های ناسازگار',P.filter(p=>'234'.includes(p.v)).length,{cls:P.some(p=>'234'.includes(p.v))?'bad':''})}${kpi('وزن کل (kg)',S.items.reduce((a,x)=>a+(+x.kg||0),0))}</div>
  <div class="sx-card"><header><b>اقلام خطرناک در یک کانتینر/وسیله</b><small>جستجوی شمارهٔ UN، کلاس، گروه بسته‌بندی و بررسی تفکیک طبق جدول ۷.۲.۴ کد IMDG</small><span class="sx-sp"></span>${fwI('پرونده','ref',S.ref,{t:'text'})}${fwI('شیوه','mode',S.mode,{opts:[['sea','دریایی (IMDG)'],['road','جاده‌ای (ADR)'],['rail','ریلی (RID/SMGS ضمیمهٔ ۲)'],['air','هوایی (IATA DGR)']]})}<button class="sx-btn sm" data-ad>افزودن قلم</button><button class="sx-btn sm pri" data-pd>چاپ اظهارنامهٔ کالای خطرناک</button></header>
  <div class="rg-w"><table class="sx-tbl v14-lt"><thead><tr><th>UN</th><th>نام حمل</th><th>کلاس</th><th>خطر فرعی</th><th>PG</th><th>تعداد بسته</th><th>وزن (kg)</th><th>کد بسته‌بندی UN</th><th></th></tr></thead><tbody>${R.map((r,i)=>`<tr data-i="${i}"><td><input data-c="un" list="v14-un" value="${esc(r.x.un)}" style="width:70px"></td><td>${r.u?esc(r.u[1]):'<span class="v14-bad">در فهرست نمونه نیست — دستی بررسی شود</span>'}</td><td>${r.u?`<b>${r.u[2]}</b>`:'—'}</td><td>${r.u&&r.u[4]||'—'}</td><td>${r.u&&r.u[3]||'—'}</td><td><input data-c="qty" type="number" value="${r.x.qty}"></td><td><input data-c="kg" type="number" value="${r.x.kg}"></td><td><input data-c="pk" value="${esc(r.x.pk||'')}"></td><td><button class="sx-btn xs" data-x>×</button></td></tr>`).join('')}</tbody></table></div><datalist id="v14-un">${UNDB.map(u=>`<option value="${u[0]}">${u[1]} · ${u[2]}</option>`).join('')}</datalist></div>
  <div class="sx-card"><header><b>نتیجهٔ تفکیک (Segregation)</b><small>${P.length?fa(P.length)+' زوج بررسی شد':'حداقل دو قلم وارد کنید'}</small></header>${P.map(p=>{const L=SGL[p.v]||SGL.X;return `<div class="fw-al ${L[0]==='ok'?'ok':L[0]==='warn'?'':'bad'}"><b>UN${p.a.x.un} (${p.a.u[2]}) ↔ UN${p.b.x.un} (${p.b.u[2]})</b> — ${L[1]}: ${L[2]}</div>`}).join('')}${worst>=2?'<div class="fw-al bad">این ترکیب را در دو کانتینر جداگانه بارگیری کنید و تفکیک چیدمان کشتی را با خط کشتیرانی هماهنگ کنید.</div>':P.length?'<div class="fw-al ok">مانع عمومی برای بارگیری مشترک دیده نشد؛ الزامات خاص هر UN در فهرست کالای خطرناک را بررسی کنید.</div>':''}</div>
  <div class="sx-card"><header><b>چک‌لیست اسناد و الزامات</b></header><ul class="v14-ck">${['اظهارنامهٔ کالای خطرناک (DGD) امضاشده','گواهی بسته‌بندی کانتینر (CPC)','برگهٔ اطلاعات ایمنی (MSDS/SDS) به‌روز','بسته‌بندی دارای کد تأیید UN و برچسب کلاس روی هر بسته','پلاکارد کلاس و شمارهٔ UN روی چهار طرف کانتینر','تأیید پذیرش کالای خطرناک از خط کشتیرانی و ترمینال',S.mode==='road'?'کارت آموزش ADR راننده و تجهیزات ایمنی خودرو':S.mode==='air'?'اظهارنامهٔ فرستنده طبق IATA DGR و محدودیت هواپیمای مسافری/باری':'برنامهٔ واکنش اضطراری (EmS) در صورت حمل دریایی','مجوزهای داخلی لازم (بندر، پلیس راه، دستگاه‌های ناظر) پیش از حمل'].map(t=>`<li>${t}</li>`).join('')}</ul><div class="sx-muted v14-sm">جدول تفکیک و فهرست UN نسخهٔ خلاصه و نمونه است؛ مبنای قطعی آخرین ویرایش کد IMDG/ADR و نظر کارشناس کالای خطرناک است.</div></div>`;
  fwBind($('.sx-card header',B),S,(k)=>{sv();if(k==='mode')draw()});
  $$('.v14-lt input',B).forEach(x=>x.onchange=()=>{const it=S.items[+x.closest('tr').dataset.i];it[x.dataset.c]=x.type==='number'?+x.value:x.value.trim();sv();draw()});$$('.v14-lt [data-x]',B).forEach(x=>x.onclick=()=>{S.items.splice(+x.closest('tr').dataset.i,1);sv();draw()});
  $('[data-ad]',B).onclick=()=>{S.items.push({un:'',qty:1,kg:0,pk:''});sv();draw()};
  $('[data-pd]',B).onclick=()=>openDoc(`<div class="page"><h1 style="text-align:center">Dangerous Goods Declaration · اظهارنامهٔ کالای خطرناک</h1><p>Ref: ${esc(S.ref)} · Mode: ${S.mode.toUpperCase()} · ${fwToday()}</p><table><tr><th>UN No.</th><th>Proper Shipping Name</th><th>Class</th><th>Sub.</th><th>PG</th><th>Pkgs</th><th>Type</th><th>Gross kg</th></tr>${R.map(r=>`<tr><td>UN${esc(r.x.un)}</td><td>${r.u?esc(r.u[1]):''}</td><td>${r.u?r.u[2]:''}</td><td>${r.u?r.u[4]:''}</td><td>${r.u?r.u[3]:''}</td><td>${fa(r.x.qty)}</td><td>${esc(r.x.pk||'')}</td><td>${nf(r.x.kg)}</td></tr>`).join('')}</table><p style="margin-top:20px">I hereby declare that the contents of this consignment are fully and accurately described above by the proper shipping name, and are classified, packaged, marked and labelled/placarded and are in all respects in proper condition for transport according to applicable international and national governmental regulations.</p><p style="margin-top:36px">Name / Signature: ____________________</p></div>`,'DGD '+S.ref)};
 draw()}
const RFT=[['موز','Banana',13,14,13.3,25,90,'حساس به سرمازدگی زیر ۱۲°'],['مرکبات (پرتقال)','Oranges',3,8,5,15,90,''],['لیمو','Lemons',10,13,12,15,90,''],['سیب','Apples',-1,4,1,10,90,'تهویه برای اتیلن'],['انگور','Grapes',-1,0,-0.5,10,90,''],['کیوی','Kiwi',0,1,0,10,90,''],['انار','Pomegranate',5,7,6,15,90,''],['خرما تازه','Fresh dates',-1,0,0,0,75,''],['سیب‌زمینی','Potatoes',4,10,7,25,90,''],['پیاز','Onions',0,2,1,25,70,'رطوبت پایین'],['گوجه‌فرنگی رسیده','Tomatoes',10,13,11,25,90,''],['لبنیات سرد','Chilled dairy',1,4,2,0,0,''],['گوشت سرد','Chilled meat',-1.5,0,-1,0,0,''],['گوشت منجمد','Frozen meat',-25,-18,-18,0,0,'تهویه بسته'],['مرغ منجمد','Frozen poultry',-25,-18,-20,0,0,'تهویه بسته'],['ماهی منجمد','Frozen fish',-25,-18,-20,0,0,''],['میگو منجمد','Frozen shrimp',-25,-18,-20,0,0,''],['بستنی','Ice cream',-28,-25,-25,0,0,''],['دارو (۲ تا ۸)','Pharma 2–8',2,8,5,0,0,'ثبت دما با دیتالاگر'],['دارو (دمای اتاق کنترل‌شده)','Pharma 15–25',15,25,20,0,0,''],['گل شاخه‌بریده','Cut flowers',1,2,1,25,90,''],['شکلات','Chocolate',12,18,15,0,60,''],['خشکبار (پسته/کشمش)','Dried fruit & nuts',0,10,5,0,65,'جلوگیری از آفت و رطوبت']];
function dgRf(B){const S=Object.assign({c:'سیب',set:1,vent:10,hum:90,legs:'دریایی ۲۲ روز؛ ریلی/جاده‌ای ۳ روز',gen:true,log:[]},LSG('ifa-rf',{}));const sv=()=>LSS('ifa-rf',S);
 const draw=()=>{const T=RFT.find(x=>x[0]===S.c)||RFT[0];const ok=S.set>=T[2]&&S.set<=T[3];const ex=S.log.filter(l=>l.t<T[2]-0.5||l.t>T[3]+0.5);
  B.innerHTML=`<div class="fc-g2"><div class="sx-card fw-form"><header><b>تنظیم کانتینر یخچالی</b><small>دمای پیشنهادی بر اساس کالا · مقادیر نمونه، دستور کتبی صاحب کالا ملاک است</small></header><div class="fw-g">${fwI('کالا','c',S.c,{opts:RFT.map(x=>[x[0],x[0]+' · '+x[1]])})}${fwI('دمای تنظیم (°C)','set',S.set,{step:.1})}${fwI('تهویه (CBM/h)','vent',S.vent)}${fwI('رطوبت (٪، صفر = خاموش)','hum',S.hum)}${fwI('مراحل حمل','legs',S.legs,{t:'text',cls:'w2'})}${fwI('ژنست برای مسیر زمینی/ریلی','gen',S.gen,{t:'checkbox'})}</div></div>
  <div class="sx-card"><header><b>محدودهٔ مرجع: ${esc(T[0])}</b><small>${esc(T[1])}</small></header><div class="ex-kpis">${kpi('حداقل',T[2],{suf:'°C',d:1})}${kpi('پیشنهادی',T[4],{suf:'°C',d:1})}${kpi('حداکثر',T[3],{suf:'°C',d:1})}${kpi('تهویهٔ پیشنهادی',T[5],{suf:' CBM/h'})}</div><div class="fw-al ${ok?'ok':'bad'}">${ok?'دمای تنظیم در محدودهٔ مرجع است.':'دمای تنظیم خارج از محدودهٔ مرجع است — با فرستنده هماهنگ کنید.'}</div>${T[7]?`<div class="fw-al">${esc(T[7])}</div>`:''}${!S.gen?'<div class="fw-al bad">در مسیر زمینی/ریلی بدون ژنست یا برق، دمای کانتینر کنترل نمی‌شود.</div>':''}<div class="fw-al">پیش‌سرمایش (Pre-cool) کانتینر و کالا، بررسی PTI و ثبت دیتالاگر را فراموش نکنید.</div></div></div>
  <div class="sx-card"><header><b>ثبت دمای مسیر</b><small>${ex.length?fa(ex.length)+' مورد خارج از محدوده':'بدون انحراف'}</small><span class="sx-sp"></span><input type="datetime-local" class="v14-in rf-t" value="${new Date(Date.now()-new Date().getTimezoneOffset()*6e4).toISOString().slice(0,16)}"><input type="number" step=".1" class="v14-in rf-v" placeholder="°C" style="width:80px"><input class="v14-in rf-p" placeholder="محل/مرحله"><button class="sx-btn sm pri" data-lg>ثبت</button></header><div class="rg-w"><table class="sx-tbl"><thead><tr><th>زمان</th><th>دما</th><th>محل</th><th>وضعیت</th><th></th></tr></thead><tbody>${S.log.map((l,i)=>`<tr><td dir="ltr">${esc(l.d.replace('T',' '))}</td><td><b>${fa(nf(l.t,1))}°</b></td><td>${esc(l.p||'')}</td><td>${l.t<T[2]-0.5||l.t>T[3]+0.5?chip('bad','انحراف'):chip('ok','عادی')}</td><td><button class="sx-btn xs" data-dl="${i}">×</button></td></tr>`).join('')||'<tr><td colspan="5" class="sx-muted">ثبتی وجود ندارد.</td></tr>'}</tbody></table></div></div>`;
  fwBind($('.fw-form',B),S,(k)=>{if(k==='c'){const t=RFT.find(x=>x[0]===S.c);if(t){S.set=t[4];S.vent=t[5];S.hum=t[6]}}sv();draw()});
  $('[data-lg]',B).onclick=()=>{const v=$('.rf-v',B).value;if(v==='')return;S.log.push({d:$('.rf-t',B).value,t:+v,p:$('.rf-p',B).value});S.log.sort((a,b)=>a.d.localeCompare(b.d));sv();draw()};$$('[data-dl]',B).forEach(x=>x.onclick=()=>{S.log.splice(+x.dataset.dl,1);sv();draw()})};draw()}
const OOGT={'20OT':['۲۰ فوت روباز',589,235,234,28200],'40OT':['۴۰ فوت روباز',1203,235,234,26600],'20FR':['۲۰ فوت فلت‌رک',562,224,223,31000],'40FR':['۴۰ فوت فلت‌رک',1166,228,195,40000],'40HC':['۴۰ فوت HC (مقایسه)',1203,235,269,26500],'PL':['پلتفرم ۴۰',1219,244,0,39000]};
function dgOog(B){const S=Object.assign({l:950,w:290,h:260,kg:22000,eq:'40FR',road:true},LSG('ifa-oog',{}));const sv=()=>LSS('ifa-oog',S);
 const draw=()=>{const R=Object.entries(OOGT).map(([k,t])=>{const ow=Math.max(0,(S.w-t[2])/2),ol=Math.max(0,S.l-t[1]),oh=t[3]?Math.max(0,S.h-t[3]):S.h;const ovw=S.kg>t[4];const fit=k.endsWith('OT')?S.w<=t[2]&&S.l<=t[1]:true;const open=k.endsWith('OT')||k.endsWith('FR')||k==='PL';const ok=!ovw&&(open?fit||k!=='40OT'&&k!=='20OT':ow===0&&ol===0&&oh===0);return {k,t,ow,ol,oh,ovw,ok:ok&&(open||(ow+ol+oh===0))}});
  const sel=R.find(r=>r.k===S.eq)||R[0];const lw=sel.ow>0?Math.ceil(sel.ow/20)||1:0,lh=sel.oh>0&&S.eq!=='PL'?1:0;const H=(+S.h||0)+(S.eq.endsWith('FR')?65:S.eq==='PL'?60:150);const W=Math.max(+S.w||0,250);
  B.innerHTML=`<div class="fc-g2"><div class="sx-card fw-form"><header><b>بار فوق‌ابعاد (OOG)</b><small>مقایسهٔ ابعاد بار با تجهیزات ویژه و محدودیت جاده</small></header><div class="fw-g">${fwI('طول (cm)','l',S.l)}${fwI('عرض (cm)','w',S.w)}${fwI('ارتفاع (cm)','h',S.h)}${fwI('وزن (kg)','kg',S.kg)}${fwI('تجهیزات انتخابی','eq',S.eq,{opts:Object.entries(OOGT).map(([k,t])=>[k,k+' — '+t[0]])})}${fwI('حمل جاده‌ای در مبدأ/مقصد','road',S.road,{t:'checkbox'})}</div></div>
  <div class="sx-card"><header><b>نتیجه برای ${S.eq}</b></header><div class="ex-kpis">${kpi('عرض اضافه هر طرف',sel.ow,{suf:' cm'})}${kpi('ارتفاع اضافه',S.eq==='PL'?0:sel.oh,{suf:' cm'})}${kpi('طول اضافه',sel.ol,{suf:' cm'})}${kpi('اسلات ازدست‌رفتهٔ تقریبی',lw*2+lh)}</div>${sel.ovw?'<div class="fw-al bad">وزن بار از ظرفیت مجاز این تجهیزات بیشتر است.</div>':''}${S.eq.endsWith('OT')&&(S.w>sel.t[2]||S.l>sel.t[1])?'<div class="fw-al bad">در کانتینر روباز، عرض و طول باید داخل بدنه باشد؛ فلت‌رک را بررسی کنید.</div>':''}${S.road&&(H>400||W>260)?`<div class="fw-al bad">ارتفاع کل روی تریلی حدود ${fa(nf(H))} cm و عرض ${fa(W)} cm است؛ بیش از حد متعارف جاده (حدود ۴ متر ارتفاع و ۲.۶ متر عرض — مقدار نمونه) — مجوز حمل ترافیکی/بار ترافیکی، اسکورت و بررسی مسیر (پل‌ها، تونل‌ها، کابل‌ها) لازم است.</div>`:S.road?'<div class="fw-al ok">ابعاد در محدودهٔ نمونهٔ حمل جاده‌ای است.</div>':''}<div class="fw-al">نقشهٔ مهاربندی (Lashing plan)، مرکز ثقل و نقاط بلند کردن را از فرستنده بگیرید؛ هزینهٔ اسلات‌های ازدست‌رفته را خط کشتیرانی تعیین می‌کند.</div>
  <svg viewBox="0 0 ${Math.max(W,260)+40} ${Math.max(H,420)+30}" class="v14-oog"><rect x="20" y="${Math.max(H,420)+10-(S.eq.endsWith('FR')?65:S.eq==='PL'?60:0)}" width="${Math.max(W,260)}" height="${S.eq.endsWith('FR')?65:S.eq==='PL'?60:0}" class="d"/>${sel.t[3]?`<rect x="${20+(Math.max(W,260)-sel.t[2])/2}" y="${Math.max(H,420)+10-sel.t[3]-(S.eq.endsWith('FR')?65:0)}" width="${sel.t[2]}" height="${sel.t[3]}" class="c"/>`:''}<rect x="${20+(Math.max(W,260)-S.w)/2}" y="${Math.max(H,420)+10-(S.eq.endsWith('FR')?65:S.eq==='PL'?60:0)-S.h}" width="${S.w}" height="${S.h}" class="b"/><line x1="0" x2="${Math.max(W,260)+40}" y1="${Math.max(H,420)+10-400}" y2="${Math.max(H,420)+10-400}" class="l"/><text x="4" y="${Math.max(H,420)+6-400}">۴ m</text></svg></div></div>
  <div class="sx-card"><header><b>مقایسهٔ همهٔ تجهیزات</b></header><div class="rg-w"><table class="sx-tbl"><thead><tr><th>تجهیزات</th><th>ابعاد داخلی (cm)</th><th>حداکثر بار</th><th>عرض اضافه/طرف</th><th>ارتفاع اضافه</th><th>وضعیت</th></tr></thead><tbody>${R.map(r=>`<tr class="${r.k===S.eq?'on':''}"><td><b>${r.k}</b> ${r.t[0]}</td><td dir="ltr">${r.t[1]}×${r.t[2]}×${r.t[3]||'—'}</td><td>${fa(nf(r.t[4]))} kg</td><td>${fa(r.ow)}</td><td>${r.k==='PL'?'—':fa(r.oh)}</td><td>${r.ovw?chip('bad','اضافه‌وزن'):r.k==='40HC'?(r.ow+r.oh+r.ol===0?chip('ok','داخل کانتینر'):chip('bad','جا نمی‌شود')):r.k.endsWith('OT')&&(S.w>r.t[2]||S.l>r.t[1])?chip('bad','جا نمی‌شود'):r.ow+r.oh+r.ol>0?chip('warn','OOG'):chip('ok','داخل ابعاد')}</td></tr>`).join('')}</tbody></table></div><div class="sx-muted v14-sm">ابعاد داخلی تجهیزات تقریبی است و بین سازندگان متفاوت است.</div></div>`;
  fwBind($('.fw-form',B),S,()=>{sv();draw()})};draw()}
function rDg(b){subTabs(b,V14,'dg',[['dg','کالای خطرناک (IMDG/ADR)'],['rf','یخچالی و دما'],['oog','فوق‌ابعاد (OOG)']],(v,B)=>({dg:dgDg,rf:dgRf,oog:dgOog})[v](B))}

/* ---------- Carriers, drivers, axle load, route restrictions ---------- */
const wbAll=()=>LSG('ifa-wb',[]);
const fltTrips=r=>wbAll().filter(w=>w.st!=='cancel'&&((r.nid&&w.nid===r.nid)||(r.name&&(w.drv===r.name||w.co===r.name)))).length;
const fltExp=r=>['card','ins','lic','tech'].map(k=>r[k]).filter(Boolean).sort()[0]||'';
function fltFl(B){rgUI(B,{key:'ifa-flt',title:'بانک حمل‌کنندگان و رانندگان',sub:'امتیاز، اسناد دارای انقضا و سابقهٔ سفر از دفتر بارنامه',addL:'حمل‌کنندهٔ جدید',
 def:()=>({type:'driver',name:'',co:'',tel:'',nid:'',plate:'',truck:'تریلی کفی',hub:'بندرعباس',lanes:'',rate:4,card:'',ins:'',lic:'',tech:'',blk:false,note:''}),
 fields:[['type','نوع','',[['driver','رانندهٔ مستقل'],['co','شرکت حمل‌ونقل'],['own','ناوگان خودی']]],['name','نام'],['co','شرکت/باربری'],['tel','تلفن'],['nid','کد ملی/شناسه'],['plate','پلاک'],['truck','نوع ناوگان','',['تریلی کفی','تریلی چادری','کمپرسی','یخچالدار','تانکر','لبه‌دار/کمرشکن','کامیون ده‌چرخ','کامیونت'].map(x=>[x,x])],['hub','شهر مبنا'],['lanes','مسیرهای فعال','','',0,'w2'],['rate','امتیاز (۱ تا ۵)','n'],['card','انقضای کارت هوشمند','d'],['ins','انقضای بیمهٔ شخص ثالث/بار','d'],['lic','انقضای گواهی‌نامه','d'],['tech','انقضای معاینهٔ فنی','d'],['blk','لیست سیاه','c'],['note','یادداشت','l']],
 cols:[['نام',r=>`<b>${esc(r.name||'—')}</b>${r.co?`<br><small class="sx-muted">${esc(r.co)}</small>`:''}`],['نوع/ناوگان',r=>esc(r.truck)],['پلاک',r=>`<span dir="ltr">${esc(r.plate)}</span>`],['مسیرها',r=>esc(r.lanes)],['امتیاز',r=>`<span class="v14-stars">${'★'.repeat(Math.round(+r.rate||0))}${'☆'.repeat(5-Math.round(+r.rate||0))}</span>`],['سفرها',r=>fa(fltTrips(r))],['نزدیک‌ترین انقضا',r=>r.blk?chip('bad','لیست سیاه'):fltExp(r)?dchip(fltExp(r),30):'—']],
 sort:(a,b)=>(+b.rate||0)-(+a.rate||0),
 kpis:L=>{const e=L.filter(r=>fltExp(r)&&dleft(fltExp(r))<=30).length;return kpi('حمل‌کنندگان',L.length)+kpi('میانگین امتیاز',L.length?L.reduce((a,r)=>a+(+r.rate||0),0)/L.length:0,{d:1})+kpi('اسناد رو به انقضا',e,{sub:'تا ۳۰ روز آینده',cls:e?'warn':''})+kpi('لیست سیاه',L.filter(r=>r.blk).length)},
 name:r=>esc(r.name||'حمل‌کننده'),after:r=>`<div class="sx-muted v14-sm">سفرهای ثبت‌شده در دفتر بارنامه با همین نام/کد ملی: ${fa(fltTrips(r))}</div>`})}
const AXL={r2:['کامیون دو محور',[['محور جلو',6],['محور عقب',13]],19],r3:['ده‌چرخ (سه محور)',[['محور جلو',6],['محور جفت عقب',19]],26],t5:['تریلی ۵ محور (۲+۳)',[['محور جلو کشنده',6],['محور محرک',13],['سه‌محور تریلر',24]],40],t6:['تریلی ۶ محور (۳+۳)',[['محور جلو کشنده',6],['جفت محور محرک',19],['سه‌محور تریلر',24]],44],t4:['تریلی ۴ محور (۲+۲)',[['محور جلو کشنده',6],['محور محرک',13],['جفت محور تریلر',19]],36]};
const AXS={r2:[.3,.7],r3:[.22,.78],t5:[.13,.32,.55],t6:[.12,.38,.5],t4:[.15,.37,.48]};
function fltAx(B){const S=Object.assign({cfg:'t5',tare:15,pay:25,ax:null,lim:{}},LSG('ifa-axl',{}));const sv=()=>LSS('ifa-axl',S);
 const draw=()=>{const C=AXL[S.cfg];const lim=C[1].map((a,i)=>+((S.lim[S.cfg]||[])[i]??a[1]));const glim=+((S.lim[S.cfg]||[])[C[1].length]??C[2]);const tot=(+S.tare||0)+(+S.pay||0);if(!S.ax||S.ax.length!==C[1].length)S.ax=AXS[S.cfg].map(f=>+(tot*f).toFixed(1));const sum=S.ax.reduce((a,x)=>a+(+x||0),0);
  B.innerHTML=`<div class="fc-g2"><div class="sx-card fw-form"><header><b>کنترل بار محوری و وزن کل</b><small>برای جلوگیری از جریمهٔ باسکول و توقف در محور</small></header><div class="fw-g">${fwI('آرایش محور','cfg',S.cfg,{opts:Object.entries(AXL).map(([k,v])=>[k,v[0]])})}${fwI('وزن خالی ناوگان (تن)','tare',S.tare,{step:.1})}${fwI('وزن بار (تن)','pay',S.pay,{step:.1})}</div><div class="fw-bt"><button class="sx-btn sm" data-es>تخمین توزیع بار روی محورها</button></div>
  <div class="rg-w"><table class="sx-tbl v14-lt"><thead><tr><th>گروه محور</th><th>بار (تن)</th><th>حد مجاز (تن، قابل ویرایش)</th><th>وضعیت</th></tr></thead><tbody>${C[1].map((a,i)=>`<tr><td>${a[0]}</td><td><input type="number" step=".1" data-ax="${i}" value="${S.ax[i]}"></td><td><input type="number" step=".5" data-lm="${i}" value="${lim[i]}"></td><td>${S.ax[i]>lim[i]?chip('bad','+'+fa(nf(S.ax[i]-lim[i],1))+' تن'):chip('ok','مجاز')}</td></tr>`).join('')}<tr><td><b>وزن کل</b></td><td><b>${fa(nf(sum,1))}</b></td><td><input type="number" step=".5" data-lm="${C[1].length}" value="${glim}"></td><td>${sum>glim?chip('bad','+'+fa(nf(sum-glim,1))+' تن'):chip('ok','مجاز')}</td></tr></tbody></table></div></div>
  <div class="sx-card"><header><b>نتیجه</b></header><div class="ex-kpis">${kpi('وزن کل',sum,{d:1,suf:' t'})}${kpi('حد وزن کل',glim,{suf:' t'})}${kpi('ظرفیت باقی‌مانده',glim-sum,{d:1,suf:' t',cls:glim-sum<0?'bad':''})}</div>${Math.abs(sum-tot)>0.3?`<div class="fw-al">جمع بار محورها (${fa(nf(sum,1))}) با وزن خالی + بار (${fa(nf(tot,1))}) برابر نیست؛ اعداد باسکول را وارد کنید یا «تخمین» را بزنید.</div>`:''}${sum>glim||S.ax.some((x,i)=>x>lim[i])?'<div class="fw-al bad">اضافه‌بار محوری/کل — جابه‌جایی بار به جلو/عقب یا کاهش بار لازم است.</div>':'<div class="fw-al ok">بار محوری و وزن کل در محدودهٔ واردشده است.</div>'}<div class="fw-al">حدود پیش‌فرض نمونه و تقریبی است و بر اساس آیین‌نامه و نوع محور/لاستیک تغییر می‌کند؛ حد رسمی جاری را از سازمان راهداری بررسی و در جدول وارد کنید (ذخیره می‌شود).</div></div></div>`;
  fwBind($('.fw-form',B),S,(k)=>{if(k==='cfg'||k==='tare'||k==='pay')S.ax=null;sv();if(k==='cfg')draw()});$$('.fw-form [data-k]',B).forEach(x=>x.addEventListener('change',draw));
  $('[data-es]',B).onclick=()=>{S.ax=null;sv();draw()};$$('[data-ax]',B).forEach(x=>x.onchange=()=>{S.ax[+x.dataset.ax]=+x.value;sv();draw()});
  $$('[data-lm]',B).forEach(x=>x.onchange=()=>{const a=S.lim[S.cfg]=S.lim[S.cfg]||[...C[1].map(z=>z[1]),C[2]];a[+x.dataset.lm]=+x.value;sv();draw()})};draw()}
const RTN0=[['محور هراز و فیروزکوه','زمستان','آب‌وهوا','الزام زنجیر چرخ و احتمال بسته شدن در برف و کولاک'],['جادهٔ چالوس','تعطیلات و آخر هفته','ممنوعیت تردد','محدودیت تردد ناوگان سنگین در ایام پرتردد'],['ورودی‌های تهران','همهٔ سال','ساعت تردد','محدودیت ورود کامیون در ساعات اوج و طرح ترافیک'],['مرز بازرگان','تابستان','صف مرزی','افزایش صف کامیون در فصل اوج ترانزیت ترکیه'],['گردنهٔ حیران (آستارا)','زمستان','آب‌وهوا','شیب تند و یخبندان؛ کامیون سنگین با احتیاط'],['محورهای جنوبی (بندرعباس، بوشهر)','تابستان','دمای بالا','گرمای شدید برای بار حساس و لاستیک؛ حرکت در ساعات خنک'],['ایام نوروز','نوروز','ممنوعیت تردد','محدودیت تردد ناوگان سنگین در روزهای اوج سفر'],['محور سرخس-مشهد','همهٔ سال','ترانزیت','کنترل‌های گمرکی و صف در پایانهٔ مرزی']];
function fltRt(B){rgUI(B,{key:'ifa-rtn',seed:()=>RTN0.map(x=>({id:rgId(),route:x[0],season:x[1],kind:x[2],note:x[3],src:'نمونه — باید تأیید شود',chk:''})),title:'محدودیت‌های مسیر و فصل',sub:'یادداشت‌های عملیاتی؛ قبل از برنامه‌ریزی از اطلاعیه‌های پلیس راه و راهداری به‌روز کنید',addL:'محدودیت جدید',
 def:()=>({route:'',season:'همهٔ سال',kind:'',note:'',src:'',chk:fwToday()}),
 fields:[['route','محور/مسیر'],['season','فصل/زمان','',['همهٔ سال','زمستان','تابستان','نوروز','تعطیلات و آخر هفته'].map(x=>[x,x])],['kind','نوع'],['note','شرح','l'],['src','منبع'],['chk','آخرین بررسی','d']],
 cols:[['محور',r=>`<b>${esc(r.route)}</b>`],['فصل',r=>esc(r.season)],['نوع',r=>esc(r.kind)],['شرح',r=>esc(r.note)],['منبع',r=>`<small>${esc(r.src)}</small>`],['بررسی',r=>r.chk?jdt(r.chk):chip('warn','تأیید نشده')]]})}
function rFlt(b){subTabs(b,V14,'flt',[['fl','حمل‌کنندگان و رانندگان'],['ax','بار محوری و وزن'],['rt','محدودیت مسیر و فصل']],(v,B)=>({fl:fltFl,ax:fltAx,rt:fltRt})[v](B))}

/* ---------- Claims ---------- */
const CRG={hv:['لاهه-ویزبی (دریایی)',0,3,0,365,['pkg',666.67,2]],hb:['هامبورگ (دریایی)',1,15,60,730,['pkg',835,2.5]],cmr:['CMR (جاده‌ای بین‌المللی)',0,7,21,365,['kg',8.33]],cim:['CIM/COTIF (ریلی)',0,7,60,365,['kg',17]],smgs:['SMGS (ریلی شرق)',0,0,0,270,['val']],mc:['کنوانسیون مونترال (هوایی)',14,14,21,730,['kg',26]],ins:['بیمه‌نامهٔ باربری',3,3,3,730,['ins']],dom:['حمل داخلی (بارنامهٔ داخلی)',1,3,7,365,['val']]};
const CDOC=['اعلام کتبی خسارت به حمل‌کننده (Notice)','بارنامه / CMR / راه‌نامه','فاکتور تجاری و فهرست عدل‌بندی','گزارش ارزیاب/سورویر','عکس‌ها و شرح بسته‌ها','رسید تحویل با قید خسارت','صورت‌حساب تعمیر یا فروش کالای آسیب‌دیده','نامهٔ مطالبه با جمع مبلغ','بیمه‌نامه و الحاقیه','رسید جانشینی (Subrogation) پس از پرداخت بیمه'];
const CST=[['open','باز'],['ntc','اعلام شد'],['sub','مطالبه ارسال شد'],['neg','در مذاکره'],['set','تسویه شد'],['rej','رد شد'],['lit','دعوی/داوری']];
const clmDl=r=>{const g=CRG[r.reg]||CRG.hv;const base=r.type==='delay'?(r.dlv||r.disc):r.type==='app'?r.dlv:(r.disc||r.dlv);const nd=r.type==='delay'?g[3]:r.type==='app'?g[1]:g[2];return {notice:base?fwAdd(base,nd):'',suit:r.dlv?fwAdd(r.dlv,g[4]):''}};
const clmLim=r=>{const g=(CRG[r.reg]||CRG.hv)[5];const sdr=+r.sdr||1.36;if(g[0]==='pkg')return Math.max((+r.pkg||0)*g[1],(+r.kg||0)*g[2])*sdr;if(g[0]==='kg')return (+r.kg||0)*g[1]*sdr;if(g[0]==='ins')return +r.insv||0;return +r.val||0};
function rClm(b0){b0.innerHTML='<div class="tm"><div class="tm-b"></div></div>';const b=$('.tm-b',b0);const J=LSG('ifa-jobs',[]);rgUI(b,{key:'ifa-clm',title:'مدیریت خسارت و ادعا',sub:'مهلت اعلام و مرور زمان بر اساس رژیم حقوقی · برآورد سقف مسئولیت',addL:'ادعای جدید',
 def:()=>({no:'CLM-'+fwToday().replace(/-/g,'').slice(2),job:J[0]?.ref||'',cust:J[0]?.cust||'',carrier:'',reg:'hv',type:'non',dlv:fwToday(),disc:fwToday(),amt:0,cur:'USD',kg:0,pkg:0,val:0,insv:0,sdr:1.36,ntc:'',st:'open',set:0,docs:[],note:''}),
 fields:[['no','شمارهٔ ادعا'],['job','پرونده','',[['','—'],...J.map(j=>[j.ref,j.ref+' · '+(j.cust||'')])]],['cust','ذی‌نفع/مشتری'],['carrier','حمل‌کننده/بیمه‌گر'],['reg','رژیم حقوقی','',Object.entries(CRG).map(([k,v])=>[k,v[0]])],['type','نوع خسارت','',[['app','آسیب/کسری آشکار'],['non','آسیب پنهان (غیرآشکار)'],['loss','فقدان کامل'],['delay','تأخیر در تحویل']]],['dlv','تاریخ تحویل (یا موعد تحویل)','d'],['disc','تاریخ کشف خسارت','d'],['amt','مبلغ ادعا','n'],['cur','ارز','',['USD','EUR','IRR','AED','CNY'].map(x=>[x,x])],['kg','وزن ناخالص آسیب‌دیده (kg)','n'],['pkg','تعداد بستهٔ آسیب‌دیده','n'],['val','ارزش کالای آسیب‌دیده','n'],['insv','مبلغ بیمه‌شده','n'],['sdr','نرخ SDR به دلار','n'],['ntc','تاریخ ارسال اعلام کتبی','d'],['st','وضعیت','',CST],['set','مبلغ تسویه‌شده','n'],['note','شرح','l']],
 cols:[['شماره',r=>`<b>${esc(r.no)}</b><br><small class="sx-muted">${esc(r.job)}</small>`],['رژیم',r=>esc((CRG[r.reg]||CRG.hv)[0])],['ادعا',r=>`${nf(+r.amt||0)} ${r.cur}`],['سقف مسئولیت',r=>usd0(clmLim(r))],['مهلت اعلام',r=>r.ntc?chip('ok','ارسال شد'):['set','rej'].includes(r.st)?'—':dchip(clmDl(r).notice,1)],['مرور زمان',r=>['set','rej'].includes(r.st)?'—':dchip(clmDl(r).suit,30)],['وضعیت',r=>chip(r.st==='set'?'ok':r.st==='rej'?'bad':'warn',(CST.find(x=>x[0]===r.st)||CST[0])[1])],['مدارک',r=>fa((r.docs||[]).length)+'/'+fa(CDOC.length)]],
 sort:(a,b)=>String(b.disc).localeCompare(a.disc),
 kpis:L=>{const op=L.filter(r=>!['set','rej'].includes(r.st));const ur=op.filter(r=>!r.ntc&&dleft(clmDl(r).notice)!=null&&dleft(clmDl(r).notice)<=2).length;return kpi('ادعاهای باز',op.length)+kpi('مبلغ ادعای باز',op.reduce((a,r)=>a+(r.cur==='USD'?+r.amt||0:0),0),{pre:'$',sub:'فقط دلاری'})+kpi('اعلام فوری لازم',ur,{cls:ur?'bad':''})+kpi('نرخ وصول',L.filter(r=>r.st==='set').reduce((a,r)=>a+(+r.amt||0),0)?L.reduce((a,r)=>a+(+r.set||0),0)/L.filter(r=>r.st==='set').reduce((a,r)=>a+(+r.amt||0),0)*100:0,{suf:'٪',sub:'تسویه ÷ ادعای تسویه‌شده'})},
 name:r=>esc(r.no),acts:r=>'<button class="sx-btn sm pri" data-lt>چاپ نامهٔ مطالبه</button>',
 after:r=>{const d=clmDl(r),g=CRG[r.reg]||CRG.hv,lim=clmLim(r);return `<div class="ex-kpis">${kpi('آخرین مهلت اعلام',0,{sub:d.notice?jdt(d.notice):'—'}).replace(/<b[^>]*>.*?<\/b>/,`<b>${d.notice?dchip(d.notice,1):'—'}</b>`)}${kpi('مرور زمان اقامهٔ دعوی',0,{sub:d.suit?jdt(d.suit):'—'}).replace(/<b[^>]*>.*?<\/b>/,`<b>${d.suit?dchip(d.suit,30):'—'}</b>`)}${kpi('سقف مسئولیت برآوردی',lim,{pre:'$'})}${kpi('قابل وصول از حمل‌کننده',Math.min(lim,+r.amt||0),{pre:'$'})}</div>${(+r.amt||0)>lim&&g[5][0]!=='ins'?'<div class="fw-al bad">مبلغ ادعا از سقف مسئولیت حمل‌کننده بیشتر است؛ مازاد را از بیمهٔ باربری پیگیری کنید.</div>':''}<div class="fw-al">مهلت‌ها و سقف‌ها برای راهنمایی است (مثلاً لاهه-ویزبی: اعلام خسارت پنهان ۳ روز، دعوی ۱ سال؛ CMR: ۷ روز و تأخیر ۲۱ روز؛ مونترال: ۱۴ روز و تأخیر ۲۱ روز، دعوی ۲ سال). قرارداد، بارنامه و نظر مشاور حقوقی ملاک است.</div><div class="v14-steps">${CDOC.map((t,i)=>`<label class="${(r.docs||[]).includes(i)?'on':''}"><input type="checkbox" data-dc="${i}" ${(r.docs||[]).includes(i)?'checked':''}> ${t}</label>`).join('')}</div>`},
 bindAfter:(E,r,sv,draw)=>{$$('[data-dc]',E).forEach(x=>x.onchange=()=>{const i=+x.dataset.dc;r.docs=(r.docs||[]).filter(z=>z!==i);if(x.checked)r.docs.push(i);sv();x.parentElement.classList.toggle('on',x.checked);const tr=$(`.rg-t tr[data-id="${r.id}"] td:last-child`);if(tr)tr.textContent=fa(r.docs.length)+'/'+fa(CDOC.length)})},
 bindEd:(E,r)=>{$('[data-lt]',E).onclick=()=>{const d=clmDl(r);openDoc(`<div class="page"><p style="text-align:left">${fwToday()} · ${jdt(fwToday())}</p><p>به: ${esc(r.carrier)}</p><h1>موضوع: اعلام و مطالبهٔ خسارت — ${esc(r.no)}</h1><p>احتراماً، به استناد ${esc((CRG[r.reg]||CRG.hv)[0])} و قرارداد حمل مربوط به پروندهٔ ${esc(r.job)}، خسارت ${({app:'آشکار',non:'پنهان',loss:'فقدان کامل',delay:'تأخیر در تحویل'})[r.type]} محموله که در تاریخ ${jdt(r.dlv)} تحویل شده و در تاریخ ${jdt(r.disc)} کشف گردیده است، بدین‌وسیله اعلام و مبلغ <b>${nf(+r.amt||0)} ${r.cur}</b> مطالبه می‌شود.</p><p>${esc(r.note||'')}</p><p>این نامه به منزلهٔ اعلام کتبی در مهلت مقرر است و کلیهٔ حقوق صاحب کالا و بیمه‌گر محفوظ است. خواهشمند است حداکثر ظرف ۳۰ روز پاسخ دهید.</p><hr><p dir="ltr" style="text-align:left">Dear Sirs, we hereby give formal notice of ${({app:'apparent damage',non:'concealed damage',loss:'total loss',delay:'delay in delivery'})[r.type]} concerning shipment ref. ${esc(r.job)} delivered on ${r.dlv} and hold you responsible for the loss, claimed at ${nf(+r.amt||0)} ${r.cur}. All rights reserved. Time bar: ${d.suit}.</p><p style="margin-top:40px">امضا و مهر: ____________________</p></div>`,'ادعای '+r.no)}}})}

/* ---------- Unified inbox (deadlines + tasks) ---------- */
function ibItems(){const I=[];const add=(d,t,s,k,sub,extra)=>{if(!d)return;I.push(Object.assign({d:String(d).slice(0,10),tm:String(d).length>10?String(d).slice(11,16):'',t,s,k,sub},extra||{}))};
 LSG('ifa-bkg',[]).filter(r=>!['ship','canc'].includes(r.st)).forEach(r=>{[['si','کات‌آف SI'],['vgm','کات‌آف VGM'],['doc','کات‌آف اسناد'],['cy','کات‌آف CY']].forEach(([f,n])=>add(r[f],n+' · رزرو '+(r.no||r.vessel||''),'رزرو','bkg','bk'))});
 LSG('ifa-dd-alerts',[]).forEach(a=>add(a.freeEnd,'پایان زمان آزاد '+(a.ctr||'')+' · '+(a.ref||''),'دموراژ','dd'));
 LSG('ifa-trn',[]).filter(r=>r.st==='open'||!r.outD).forEach(r=>r.inD&&add(fwAdd(r.inD,+r.days||0),'مهلت خروج '+(r.kind||'')+' '+(r.no||''),'ترانزیت','cus','trn'));
 LSG('ifa-grt',[]).filter(r=>r.st==='act').forEach(r=>add(r.exp,'سررسید '+r.kind+' '+(r.party||''),'ضمانت‌نامه','led','grt'));
 LSG('ifa-fxc',[]).filter(r=>r.st==='open').forEach(r=>{const x=new Date(r.date+'T00:00:00Z');x.setUTCMonth(x.getUTCMonth()+(+r.months||4));add(x.toISOString().slice(0,10),'مهلت رفع تعهد ارزی کوتاژ '+(r.kot||''),'تعهد ارزی','cus','fxc')});
 LSG('ifa-ctr',[]).forEach(r=>add(r.to,'پایان قرارداد '+(r.cust||''),'قرارداد','sal','ctr'));
 LSG('ifa-leads',[]).filter(r=>!['won','lost'].includes(r.stage)).forEach(r=>add(r.next,'پیگیری استعلام '+(r.cust||'')+' '+(r.lane||''),'فروش','sal','fun'));
 LSG('ifa-clm',[]).filter(r=>!['set','rej'].includes(r.st)).forEach(r=>{const d=clmDl(r);if(!r.ntc)add(d.notice,'مهلت اعلام خسارت '+r.no,'خسارت','clm');add(d.suit,'مرور زمان دعوی '+r.no,'خسارت','clm')});
 LSG('ifa-rates',[]).forEach(r=>r.to&&dleft(r.to)>=-3&&add(r.to,'انقضای نرخ '+[r.pol,r.pod].filter(Boolean).join('→')+' '+(r.vend||r.sup||''),'نرخ','rate'));
 LSG('ifa-flt',[]).filter(r=>!r.blk).forEach(r=>[['card','کارت هوشمند'],['ins','بیمه'],['lic','گواهی‌نامه'],['tech','معاینهٔ فنی']].forEach(([f,n])=>r[f]&&dleft(r[f])<=45&&add(r[f],'انقضای '+n+' '+(r.name||''),'ناوگان','flt','fl')));
 LSG('ifa-einv',[]).filter(x=>x.st==='draft').forEach(x=>add(x.date,'صورت‌حساب پیش‌نویس سریال '+fa(x.serial||''),'مؤدیان','einv'));
 LSG('ifa-wb',[]).filter(w=>['loaded','transit'].includes(w.st)).forEach(w=>add(w.date,'بارنامهٔ در راه '+(w.no||'')+' · '+(w.drv||''),'بارنامه','wb'));
 LSG('ifa-tasks',[]).filter(t=>!t.done).forEach(t=>add(t.due||fwToday(),t.title,'وظیفه','inbox',null,{task:t.id,owner:t.owner,prio:t.prio,job:t.job}));
 return I.sort((a,b)=>(a.d+a.tm).localeCompare(b.d+b.tm))}
const IBX={f:'all',q:''};
function rInbox(b0){b0.innerHTML='<div class="tm"><div class="tm-b"></div></div>';const b=$('.tm-b',b0);const draw=()=>{const A=ibItems();const n=x=>dleft(x.d);const B={od:A.filter(x=>n(x)<0),td:A.filter(x=>n(x)===0),wk:A.filter(x=>n(x)>0&&n(x)<=7),lt:A.filter(x=>n(x)>7)};const S=[...new Set(A.map(x=>x.s))];
  const F=A.filter(x=>(IBX.f==='all'||x.s===IBX.f)&&(!IBX.q||(x.t+x.s).includes(IBX.q)));const grp=[['od','گذشته از موعد','bad'],['td','امروز','warn'],['wk','۷ روز آینده','warn'],['lt','بعداً','ok']];
  const T=LSG('ifa-tasks',[]);
  b.innerHTML=`<div class="ex-kpis">${kpi('گذشته از موعد',B.od.length,{cls:B.od.length?'bad':''})}${kpi('امروز',B.td.length)}${kpi('هفتهٔ پیش رو',B.wk.length)}${kpi('وظایف باز',T.filter(t=>!t.done).length,{sub:fa(T.filter(t=>t.done).length)+' انجام‌شده'})}</div>
  <div class="v14-ib"><div class="sx-card"><header><b>کارتابل مهلت‌ها و کارها</b><small>جمع‌آوری خودکار از رزرو، دموراژ، ترانزیت، ضمانت‌نامه، تعهد ارزی، قرارداد، فروش، خسارت، نرخ، ناوگان، مؤدیان و بارنامه</small><span class="sx-sp"></span><input class="rg-q ib-q" placeholder="جستجو…" value="${esc(IBX.q)}"><button class="sx-btn sm" data-ics>تقویم (ICS)</button></header><div class="sx-row v14-ibf">${tmSeg([['all','همه ('+fa(A.length)+')'],...S.map(s=>[s,s+' ('+fa(A.filter(x=>x.s===s).length)+')'])],IBX.f,'v14-ibs')}</div>
  ${grp.map(([g,n,c])=>{const L=F.filter(x=>B[g].includes(x));return L.length?`<h5 class="v14-ibh ${c}">${n} · ${fa(L.length)}</h5><div class="v14-ibl">${L.map(x=>`<div class="v14-ibi ${c}" ${x.task?`data-tk="${x.task}"`:''}><span class="d">${jdt(x.d)}${x.tm?' · '+fa(x.tm):''}</span><span class="s">${esc(x.s)}</span><b>${esc(x.t)}</b>${x.owner?`<small>${esc(x.owner)}</small>`:''}${x.prio==='h'?chip('bad','فوری'):''}<span class="sx-sp"></span>${dchip(x.d,2)}${x.task?'<button class="sx-btn xs" data-dn>انجام شد</button>':x.k!=='inbox'?`<button class="sx-btn xs" data-go="${x.k}" data-sub="${x.sub||''}">باز کردن ↗</button>`:''}</div>`).join('')}</div>`:''}).join('')||'<div class="sx-empty v14-em">موردی در کارتابل نیست. مهلت‌ها با ثبت رزرو، ترانزیت، ضمانت‌نامه، قرارداد و … به‌صورت خودکار اینجا می‌آیند.</div>'}</div>
  <div class="sx-card fw-form"><header><b>وظیفهٔ جدید</b></header><div class="fw-g v14-tkf"><label class="sx-f fw-f w2"><span>عنوان</span><input class="tk-t" placeholder="مثلاً پیگیری ترخیص پروندهٔ ..."></label><label class="sx-f fw-f"><span>موعد</span><input type="date" class="tk-d" value="${fwAdd(fwToday(),1)}"></label><label class="sx-f fw-f"><span>مسئول</span><input class="tk-o" value="${esc((SV.st.user&&SV.st.user.name)||'')}"></label><label class="sx-f fw-f"><span>پرونده</span><select class="tk-j"><option value="">—</option>${LSG('ifa-jobs',[]).map(j=>`<option>${esc(j.ref)}</option>`).join('')}</select></label><label class="sx-f fw-f"><span>اولویت</span><select class="tk-p"><option value="n">عادی</option><option value="h">فوری</option></select></label></div><div class="fw-bt"><button class="sx-btn sm pri" data-tka>افزودن</button></div>
  <header style="margin-top:12px"><b>وظایف انجام‌شده</b><span class="sx-sp"></span><button class="sx-btn xs" data-cl>پاک کردن</button></header><div class="v14-ibl">${T.filter(t=>t.done).slice(-8).reverse().map(t=>`<div class="v14-ibi off"><s>${esc(t.title)}</s><span class="sx-sp"></span><small>${jdt(t.done)}</small></div>`).join('')||'<div class="sx-muted v14-sm">—</div>'}</div></div></div>`;
  $$('.v14-ibs button',b).forEach(x=>x.onclick=()=>{IBX.f=x.dataset.v;draw()});
  $('.ib-q',b).oninput=e=>{IBX.q=e.target.value;const p=e.target.selectionStart;draw();const q=$('.ib-q',b);q.focus();q.setSelectionRange(p,p)};
  $$('[data-go]',b).forEach(x=>x.onclick=()=>{const k=x.dataset.go;if(x.dataset.sub&&k in V14)V14[k]=x.dataset.sub;window.__STUDIO.nav.go(k)});
  $$('[data-dn]',b).forEach(x=>x.onclick=()=>{const id=x.closest('[data-tk]').dataset.tk;const L=LSG('ifa-tasks',[]);const t=L.find(z=>z.id===id);if(t)t.done=fwToday();LSS('ifa-tasks',L);draw()});
  $('[data-tka]',b).onclick=()=>{const t=$('.tk-t',b).value.trim();if(!t)return;const L=LSG('ifa-tasks',[]);L.push({id:rgId(),title:t,due:$('.tk-d',b).value,owner:$('.tk-o',b).value,job:$('.tk-j',b).value,prio:$('.tk-p',b).value,done:''});LSS('ifa-tasks',L);draw()};
  $('[data-cl]',b).onclick=()=>{LSS('ifa-tasks',LSG('ifa-tasks',[]).filter(t=>!t.done));draw()};
  $('[data-ics]',b).onclick=()=>{const z=s=>s.replace(/-/g,'');dlFile('ifa-inbox.ics','BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//IFA//Inbox//FA\r\n'+A.map((x,i)=>`BEGIN:VEVENT\r\nUID:ifa-${i}-${z(x.d)}@ifa\r\nDTSTAMP:${z(fwToday())}T000000Z\r\nDTSTART;VALUE=DATE:${z(x.d)}\r\nSUMMARY:${(x.s+' — '+x.t).replace(/[,;]/g,' ')}\r\nEND:VEVENT\r\n`).join('')+'END:VCALENDAR\r\n')}};draw()}
/* ---------- layout helper: balance KPI rows (no orphan cards) ---------- */
let kRAF=0;function kpiBal(){$$('.ex-kpis').forEach(g=>{const n=g.children.length;const w=g.clientWidth;if(!w||!n)return;const mn=g.closest('.pl')?128:158;const per=Math.max(1,Math.floor((w+8)/mn));const rows=Math.ceil(n/per);const cols=Math.ceil(n/rows);if(g.style.getPropertyValue('--kc')!==String(cols))g.style.setProperty('--kc',cols)})}
try{new MutationObserver(()=>{cancelAnimationFrame(kRAF);kRAF=requestAnimationFrame(kpiBal)}).observe(document.body,{childList:true,subtree:true});addEventListener('resize',()=>{cancelAnimationFrame(kRAF);kRAF=requestAnimationFrame(kpiBal)})}catch(e){}

/* ===== v15: unified job file, document template builder & B/L drafts, international payment comparison ===== */
const JFS=[['bk','رزرو فضا'],['pk','جمع‌آوری و بارگیری'],['dep','حرکت'],['arr','رسیدن'],['cus','ترخیص'],['dlv','تحویل'],['inv','صورتحساب'],['cls','تسویه و بستن']];
const JFX={q:'',f:'open'};
const jfD=t=>t?new Date(t).toISOString().slice(0,10):'';
function jfLinks(j){const r=j.ref;const by=k=>LSG(k,[]).filter(x=>x.job===r);
 return {bkg:by('ifa-bkg'),dec:by('ifa-dec'),trn:by('ifa-trn'),wb:by('ifa-wb'),grt:by('ifa-grt'),einv:by('ifa-einv'),clm:by('ifa-clm'),com:by('ifa-com'),tasks:by('ifa-tasks'),log:LSG('ifa-jlog',[]).filter(x=>x.job===r),dd:LSG('ifa-dd-alerts',[]).filter(a=>a.ref===r),ship:j.ship?shipsG().find(s=>s.id===j.ship):null,ctr:LSG('ifa-ctr',[]).find(c=>c.cust&&c.cust===j.cust)}}
function jfStages(j,L,s){const ms=(L.ship&&L.ship.ms)||[];const A={};const act=f=>{const m=ms.filter(f).filter(m=>m.act!=null);return m.length?jfD(m[m.length-1].act):''};
 if(L.bkg.some(b=>['conf','ship'].includes(b.st)))A.bk='auto';
 if(L.bkg.some(b=>b.st==='ship')||L.wb.some(w=>['loaded','transit','delivered'].includes(w.st)))A.pk='auto';
 const fd=ms.find(m=>m.k==='dep'&&m.act!=null);if(fd)A.dep=jfD(fd.act);else if(L.wb.some(w=>['transit','delivered'].includes(w.st)))A.dep='auto';
 const arrs=ms.filter(m=>m.k==='arr');if(arrs.length&&arrs[arrs.length-1].act!=null)A.arr=jfD(arrs[arrs.length-1].act);
 if(L.dec.some(d=>(d.steps||[]).length>=DECS.length))A.cus='auto';
 if(L.wb.some(w=>w.st==='delivered'))A.dlv='auto';
 if(s.n&&s.unb===0)A.inv='auto';if(s.n&&s.unb===0&&s.rec===0&&s.pay===0)A.cls='auto';
 const M=(LSG('ifa-jms',{})[j.ref])||{};return JFS.map(([k,n])=>{const m=M[k]||{};const d=m.d||A[k]||'';return {k,n,done:!!d,auto:!m.d&&!!A[k],d:d==='auto'?'':d,o:m.o||''}})}
function jfEvents(j,L){const E=[];const add=(d,t,s,c)=>{if(d)E.push({d:String(d).slice(0,10),t,s,c:c||''})};
 add(j.date,'ایجاد پرونده','پرونده');L.bkg.forEach(b=>{add(b.etd,'ETD کشتی '+(b.vessel||'')+' · رزرو '+(b.no||''),'رزرو',b.st==='ship'?'':'plan')});
 if(L.ship)L.ship.ms.forEach(m=>add(jfD(m.act!=null?m.act:m.pl),m.n+(m.act!=null?'':' (برنامه)'),'رهگیری',m.act!=null?'':'plan'));
 L.dec.forEach(d=>add(d.date,'اظهار گمرکی '+(d.kot||'')+' · '+(d.cus||''),'گمرک'));L.trn.forEach(t=>{add(t.inD,'ورود ترانزیت '+(t.no||''),'ترانزیت');if(t.outD)add(t.outD,'خروج ترانزیت','ترانزیت')});
 L.wb.forEach(w=>add(w.date,'بارنامهٔ داخلی '+(w.no||'')+' · '+wbSt(w.st)[1],'بارنامه'));L.einv.forEach(x=>add(x.date,'صورتحساب مؤدیان سریال '+fa(x.serial||''),'مؤدیان'));
 L.grt.forEach(g=>add(g.issue,g.kind+' '+(g.party||''),'ضمانت‌نامه'));L.clm.forEach(c=>add(c.disc,'ادعای خسارت '+c.no,'خسارت','bad'));
 L.tasks.forEach(t=>add(t.done||t.due,(t.done?'انجام شد: ':'موعد وظیفه: ')+t.title,'وظیفه',t.done?'':'plan'));
 L.log.forEach(x=>add(jfD(x.ts),x.tx,({note:'یادداشت',call:'تماس',mail:'ایمیل',msg:'پیام'})[x.ty]||'یادداشت','log'));
 return E.sort((a,b)=>b.d.localeCompare(a.d))}
const jfOpen=(tab,sub,key,id)=>{if(sub&&tab in V14)V14[tab]=sub;if(key&&id){RGS[key]=RGS[key]||{sel:null,q:''};RGS[key].sel=id;RGS[key].q=''}window.__STUDIO.nav.go(tab)};
function jfNew(key,j){const L=LSG(key,[]);const e=fwAdd(fwToday(),10);const o={id:rgId(),job:j.ref};
 if(key==='ifa-bkg')Object.assign(o,{no:'',carrier:'',vessel:'',voy:'',pol:'',pod:'BND',eq:'40HC',qty:1,etd:e,cy:fwAdd(e,-2)+'T12:00',si:fwAdd(e,-3)+'T12:00',vgm:fwAdd(e,-2)+'T10:00',doc:fwAdd(e,-3)+'T16:00',st:'req',note:''});
 if(key==='ifa-dec')Object.assign(o,{kot:'',date:fwToday(),cus:'گمرک شهید رجایی',type:'واردات قطعی',hs:'',val:0,ch:'',agent:'',steps:[],note:''});
 if(key==='ifa-trn')Object.assign(o,{kind:'ترانزیت خارجی',no:'',inC:'',outC:'',inD:fwToday(),days:30,gAmt:0,gType:'ضمانت‌نامهٔ بانکی',gNo:'',truck:'',st:'open',outD:'',note:''});
 if(key==='ifa-clm')Object.assign(o,{no:'CLM-'+fwToday().replace(/-/g,'').slice(2),cust:j.cust||'',carrier:'',reg:'hv',type:'non',dlv:fwToday(),disc:fwToday(),amt:0,cur:'USD',kg:0,pkg:0,val:0,insv:0,sdr:1.36,ntc:'',st:'open',set:0,docs:[],note:''});
 if(key==='ifa-grt')Object.assign(o,{kind:'سپردهٔ کانتینر',party:'',no:'',amt:0,cur:'USD',issue:fwToday(),exp:fwAdd(fwToday(),90),bank:'',st:'act',note:''});
 L.unshift(o);LSS(key,L);return o}
function rJob(b0,C){const J=LSG('ifa-jobs',[]);let cur=LSG('ifa-job-cur','');
 if(!J.length){b0.innerHTML=`<div class="sx-card v14-em"><b>هنوز پرونده‌ای ثبت نشده است.</b><p class="sx-muted">پرونده را در «سود و زیان پرونده» بسازید؛ همهٔ رزروها، اسناد، گمرک، بارنامه، صورتحساب و خسارت‌های آن اینجا یکجا دیده می‌شوند.</p><button class="sx-btn sm pri" data-gp>رفتن به سود و زیان پرونده</button></div>`;$('[data-gp]',b0).onclick=()=>window.__STUDIO.nav.go('pnl');return}
 let j=J.find(x=>x.id===cur)||J[0];
 const draw=()=>{const s=jobSum(j);const L=jfLinks(j);const S=jfStages(j,L,s);const ci=S.findIndex(x=>!x.done);const E=jfEvents(j,L);const ships=shipsG();
  const list=J.filter(x=>(JFX.f==='all'||(JFX.f==='open'?x.st!=='closed':x.st==='closed'))&&(!JFX.q||[x.ref,x.cust,x.route].join(' ').includes(JFX.q)));
  const card=(t,n,rows,add,go)=>`<div class="sx-card v15-lk"><header><b>${t}</b><small>${fa(n)}</small><span class="sx-sp"></span>${add?`<button class="sx-btn xs" data-nw="${add}">+ جدید</button>`:''}${go?`<button class="sx-btn xs" data-go="${go}">همه ↗</button>`:''}</header>${rows||'<div class="sx-muted v14-sm">موردی ثبت نشده.</div>'}</div>`;
  const row=(a,b,c,open)=>`<div class="v15-r"><b>${a}</b><span>${b||''}</span><span class="sx-sp"></span>${c||''}${open?`<button class="sx-btn xs" data-op="${open}">↗</button>`:''}</div>`;
  b0.innerHTML=`<div class="v15-jf"><aside class="sx-card v15-jl"><header><b>پرونده‌ها</b><small>${fa(J.length)}</small></header><input class="rg-q jf-q" placeholder="جستجوی شماره، مشتری، مسیر…" value="${esc(JFX.q)}">${tmSeg([['open','باز'],['closed','بسته'],['all','همه']],JFX.f,'v15-jfs')}<div class="v15-jli">${list.map(x=>{const ss=jobSum(x);const st=jfStages(x,jfLinks(x),ss);const c=st.findIndex(y=>!y.done);return `<button data-j="${x.id}" class="${x.id===j.id?'on':''}"><b>${esc(x.ref)}</b><small>${esc(x.cust||'بدون مشتری')}</small><small class="sx-muted">${esc(x.route||'')}</small><span>${chip(ss.gpa<0?'bad':'ok',usd0(ss.gpa))}${chip(c<0?'ok':'warn',c<0?'بسته‌شدنی':st[c].n)}</span></button>`}).join('')||'<div class="sx-muted v14-sm">موردی نیست.</div>'}</div></aside>
  <main class="v15-jm"><div class="sx-card v15-jh"><div><h3>${esc(j.ref)} <small>${esc(j.cust||'بدون مشتری')}</small></h3><div class="sx-muted">${esc(j.route||'—')} · ایجاد ${jdt(j.date)}${L.ctr?` · قرارداد تا ${jdt(L.ctr.to)} (اعتبار ${usd0(+L.ctr.credit||0)}، مهلت ${fa(L.ctr.terms||30)} روز)`:''}</div></div><span class="sx-sp"></span>
   <label class="sx-f fw-f"><span>محمولهٔ رهگیری</span><select class="jf-sh"><option value="">— اتصال نیافته —</option>${ships.map(x=>`<option value="${x.id}" ${x.id===j.ship?'selected':''}>${esc(x.ref)} · ${esc(x.name)}</option>`).join('')}</select></label>
   <label class="sx-f fw-f"><span>وضعیت</span><select class="jf-st"><option value="open" ${j.st!=='closed'?'selected':''}>باز</option><option value="closed" ${j.st==='closed'?'selected':''}>بسته</option></select></label>
   <button class="sx-btn sm" data-pn>سود و زیان ↗</button><button class="sx-btn sm" data-tp>قالب اسناد ↗</button><button class="sx-btn sm pri" data-pr>چاپ خلاصهٔ پرونده</button></div>
  <div class="ex-kpis">${kpi('فروش',s.sa,{pre:'$'})}${kpi('بهای تمام‌شده',s.ba,{pre:'$'})}${kpi('سود ناخالص',s.gpa,{pre:'$',sub:'حاشیه '+fa(nf(s.ma,1))+'٪',cls:s.gpa<0?'bad':''})}${kpi('مطالبات باز',s.rec+s.unb,{pre:'$',sub:fa(nf(s.unb))+'$ صورتحساب‌نشده'})}${kpi('بدهی باز',s.pay,{pre:'$'})}${kpi('وظایف باز',L.tasks.filter(t=>!t.done).length)}</div>
  <div class="sx-card"><header><b>چرخهٔ پرونده</b><small>${ci<0?'همهٔ مراحل انجام شده — پرونده را ببندید':'مرحلهٔ جاری: '+S[ci].n} · مراحل خودکار از رزرو، رهگیری، گمرک، بارنامه و صورتحساب تشخیص داده می‌شوند؛ با کلیک دستی تأیید کنید</small></header><div class="v15-stp">${S.map((x,i)=>`<div class="v15-st ${x.done?'ok':i===ci?'cur':''}" data-sg="${x.k}"><i>${x.done?'✓':fa(i+1)}</i><b>${x.n}</b><small>${x.done?(x.auto?'خودکار':jdt(x.d)):i===ci?'جاری':'—'}</small><input class="jf-o" data-o="${x.k}" placeholder="مسئول" value="${esc(x.o)}"></div>`).join('')}</div></div>
  <div class="v15-lg">
   ${card('رزرو و کات‌آف',L.bkg.length,L.bkg.map(x=>row(esc(x.no||x.vessel||'رزرو'),'ETD '+jdt(x.etd),chip((BKS.find(z=>z[0]===x.st)||BKS[0])[2],(BKS.find(z=>z[0]===x.st)||BKS[0])[1]),'bkg|bk|ifa-bkg|'+x.id)).join(''),'ifa-bkg')}
   ${card('گمرک و ترخیص',L.dec.length,L.dec.map(x=>row(esc(x.kot||'اظهارنامه'),esc(x.cus),chip((x.steps||[]).length>=DECS.length?'ok':'warn',fa((x.steps||[]).length)+'/'+fa(DECS.length)),'cus|dec|ifa-dec|'+x.id)).join(''),'ifa-dec')}
   ${card('ترانزیت و تیر',L.trn.length,L.trn.map(x=>row(esc(x.kind),esc(x.no||''),x.outD?chip('ok','خارج شد'):dchip(fwAdd(x.inD,+x.days||0),5),'cus|trn|ifa-trn|'+x.id)).join(''),'ifa-trn')}
   ${card('بارنامهٔ داخلی',L.wb.length,L.wb.map(x=>row(esc(x.no),esc(x.drv||''),chip(wbSt(x.st)[2],wbSt(x.st)[1]),'wb').replace('data-op="wb"','data-op="wb"')).join(''),'','wb')}
   ${card('رهگیری محموله',L.ship?L.ship.ms.length:0,L.ship?L.ship.ms.map(m=>row(esc(m.n),m.act!=null?jdt(jfD(m.act)):'برنامه '+jdt(jfD(m.pl)),m.act!=null?chip('ok','انجام'):dchip(jfD(m.pl),1))).join(''):'<div class="sx-muted v14-sm">از بالای صفحه یک محمولهٔ رهگیری را به پرونده وصل کنید.</div>','','track')}
   ${card('صورتحساب مؤدیان',L.einv.length,L.einv.map(x=>row('سریال '+fa(x.serial||''),jdt(x.date),chip(x.st==='draft'?'warn':'ok',x.st==='draft'?'پیش‌نویس':esc(x.st)))).join(''),'','einv')}
   ${card('ضمانت‌نامه و سپرده',L.grt.length,L.grt.map(x=>row(esc(x.kind),nf(+x.amt||0)+' '+x.cur,x.st==='act'?dchip(x.exp,10):chip('ok','آزاد شد'),'led|grt|ifa-grt|'+x.id)).join(''),'ifa-grt')}
   ${card('خسارت و ادعا',L.clm.length,L.clm.map(x=>row(esc(x.no),nf(+x.amt||0)+' '+x.cur,chip(x.st==='set'?'ok':x.st==='rej'?'bad':'warn',(CST.find(z=>z[0]===x.st)||CST[0])[1]),'clm||ifa-clm|'+x.id)).join(''),'ifa-clm')}
   ${card('هشدار دموراژ',L.dd.length,L.dd.map(x=>row(esc(x.ctr||''),'پایان زمان آزاد '+jdt(x.freeEnd),dchip(x.freeEnd,2))).join(''),'','dd')}
   ${card('کمیسیون',L.com.length,L.com.map(x=>row(esc(x.agent||'—'),fa(x.pct||0)+'٪',chip(x.st==='paid'?'ok':'warn',x.st==='paid'?'پرداخت شد':'قابل پرداخت'),'led|com|ifa-com|'+x.id)).join(''),'','led')}
   <div class="sx-card v15-lk"><header><b>بایگانی اسناد</b><small class="v15-ac">…</small><span class="sx-sp"></span><button class="sx-btn xs" data-go="arc">بایگانی ↗</button></header><div class="v15-arc"><div class="sx-muted v14-sm">در حال خواندن…</div></div></div>
   <div class="sx-card v15-lk"><header><b>وظایف پرونده</b><small>${fa(L.tasks.filter(t=>!t.done).length)} باز</small></header>${L.tasks.map(t=>row(t.done?`<s>${esc(t.title)}</s>`:esc(t.title),esc(t.owner||''),t.done?chip('ok','انجام شد'):`${dchip(t.due,1)}<button class="sx-btn xs" data-td="${t.id}">انجام شد</button>`)).join('')}<div class="v15-tk"><input class="v14-in jf-tt" placeholder="وظیفهٔ جدید برای این پرونده…"><input type="date" class="v14-in jf-td" value="${fwAdd(fwToday(),1)}"><button class="sx-btn xs" data-ta>افزودن</button></div></div>
  </div>
  <div class="fc-g2"><div class="sx-card"><header><b>رویدادهای پرونده</b><small>${fa(E.length)} رویداد · از همهٔ بخش‌ها</small></header><div class="v15-tl">${E.map(e=>`<div class="${e.c}"><span>${jdt(e.d)}</span><em>${esc(e.s)}</em><p>${esc(e.t)}</p></div>`).join('')}</div></div>
   <div class="sx-card fw-form"><header><b>مکاتبات و یادداشت‌ها</b><small>ثبت تماس، ایمیل و پیام‌های مهم پرونده</small></header><div class="v15-lf"><select class="v14-in jf-lt"><option value="note">یادداشت</option><option value="call">تماس</option><option value="mail">ایمیل</option><option value="msg">پیام</option></select><textarea class="v14-ta jf-lx" rows="3" placeholder="خلاصهٔ مکاتبه یا تصمیم…"></textarea><button class="sx-btn sm pri" data-la>ثبت</button></div>
   <div class="v15-tl">${L.log.slice().reverse().map(x=>`<div class="log"><span>${jdt(jfD(x.ts))} · ${new Date(x.ts).toTimeString().slice(0,5)}</span><em>${({note:'یادداشت',call:'تماس',mail:'ایمیل',msg:'پیام'})[x.ty]||''} · ${esc(x.by||'')}</em><p>${esc(x.tx)}</p></div>`).join('')||'<div class="sx-muted v14-sm">هنوز مکاتبه‌ای ثبت نشده.</div>'}</div></div></div></main></div>`;
  $$('.v15-jli button',b0).forEach(x=>x.onclick=()=>{j=J.find(y=>y.id===x.dataset.j);LSS('ifa-job-cur',j.id);draw()});
  $('.jf-q',b0).oninput=e=>{JFX.q=e.target.value;const p=e.target.selectionStart;draw();const q=$('.jf-q',b0);q.focus();q.setSelectionRange(p,p)};
  $$('.v15-jfs button',b0).forEach(x=>x.onclick=()=>{JFX.f=x.dataset.v;draw()});
  const svJ=()=>{const A=LSG('ifa-jobs',[]);const i=A.findIndex(x=>x.id===j.id);if(i>=0){A[i]=j;LSS('ifa-jobs',A)}};
  $('.jf-sh',b0).onchange=e=>{j.ship=e.target.value||null;svJ();setTimeout(draw)};$('.jf-st',b0).onchange=e=>{j.st=e.target.value;svJ();setTimeout(draw)};
  $$('.v15-st',b0).forEach(x=>x.onclick=e=>{if(e.target.tagName==='INPUT')return;const M=LSG('ifa-jms',{});const m=(M[j.ref]=M[j.ref]||{});const k=x.dataset.sg;const st=S.find(y=>y.k===k);m[k]=m[k]||{};if(m[k].d)delete m[k].d;else if(!st.auto)m[k].d=fwToday();LSS('ifa-jms',M);draw()});
  $$('.jf-o',b0).forEach(x=>x.onchange=()=>{const M=LSG('ifa-jms',{});const m=(M[j.ref]=M[j.ref]||{});(m[x.dataset.o]=m[x.dataset.o]||{}).o=x.value;LSS('ifa-jms',M)});
  $$('[data-op]',b0).forEach(x=>x.onclick=()=>{const [t,sb,k,id]=x.dataset.op.split('|');jfOpen(t,sb,k,id)});
  $$('[data-go]',b0).forEach(x=>x.onclick=()=>window.__STUDIO.nav.go(x.dataset.go));
  $$('[data-nw]',b0).forEach(x=>x.onclick=()=>{const k=x.dataset.nw;const o=jfNew(k,j);const m={'ifa-bkg':['bkg','bk'],'ifa-dec':['cus','dec'],'ifa-trn':['cus','trn'],'ifa-clm':['clm',''],'ifa-grt':['led','grt']}[k];jfOpen(m[0],m[1],k,o.id)});
  $('[data-pn]',b0).onclick=()=>{LSS('ifa-job-cur',j.id);window.__STUDIO.nav.go('pnl')};$('[data-tp]',b0).onclick=()=>{LSS('ifa-job-cur',j.id);window.__STUDIO.nav.go('tpl')};
  $('[data-ta]',b0).onclick=()=>{const t=$('.jf-tt',b0).value.trim();if(!t)return;const T=LSG('ifa-tasks',[]);T.push({id:rgId(),title:t,due:$('.jf-td',b0).value,owner:(SV.st.user&&SV.st.user.name)||'',job:j.ref,prio:'n',done:''});LSS('ifa-tasks',T);draw()};
  $$('[data-td]',b0).forEach(x=>x.onclick=()=>{const T=LSG('ifa-tasks',[]);const t=T.find(z=>z.id===x.dataset.td);if(t)t.done=fwToday();LSS('ifa-tasks',T);draw()});
  $('[data-la]',b0).onclick=()=>{const t=$('.jf-lx',b0).value.trim();if(!t)return;const G=LSG('ifa-jlog',[]);G.push({id:rgId(),job:j.ref,ts:Date.now(),by:(SV.st.user&&SV.st.user.name)||'',ty:$('.jf-lt',b0).value,tx:t});LSS('ifa-jlog',G);draw()};
  $('[data-pr]',b0).onclick=()=>openDoc(`<div class="page"><h1>خلاصهٔ پرونده ${esc(j.ref)}</h1><p>مشتری: <b>${esc(j.cust||'—')}</b> · مسیر: ${esc(j.route||'—')} · تاریخ: ${jdt(j.date)} · وضعیت: ${j.st==='closed'?'بسته':'باز'}</p><table><tr><th>فروش</th><th>بهای تمام‌شده</th><th>سود ناخالص</th><th>حاشیه</th><th>مطالبات باز</th><th>بدهی باز</th></tr><tr><td>${usd0(s.sa)}</td><td>${usd0(s.ba)}</td><td>${usd0(s.gpa)}</td><td>${fa(nf(s.ma,1))}٪</td><td>${usd0(s.rec+s.unb)}</td><td>${usd0(s.pay)}</td></tr></table><h2>مراحل</h2><table><tr>${S.map(x=>`<th>${x.n}</th>`).join('')}</tr><tr>${S.map(x=>`<td>${x.done?'✓ '+(x.d?jdt(x.d):'خودکار'):'—'}${x.o?'<br><small>'+esc(x.o)+'</small>':''}</td>`).join('')}</tr></table><h2>ردیف‌های هزینه و فروش</h2><table><tr><th>شرح</th><th>تأمین‌کننده</th><th>خرید</th><th>فروش</th></tr>${j.lines.map(l=>`<tr><td>${esc(l.n)}</td><td>${esc(l.v||'')}</td><td>${usd0(pU(l.ba??l.be,l.cur))}</td><td>${usd0(pU(l.sa??l.se,l.cur))}</td></tr>`).join('')}</table><h2>رویدادها</h2><table>${E.map(e=>`<tr><td>${jdt(e.d)}</td><td>${esc(e.s)}</td><td>${esc(e.t)}</td></tr>`).join('')}</table></div>`,'پرونده '+j.ref);
  (async()=>{try{const F=await ARC.list(j.ref);const E2=$('.v15-arc',b0),c=$('.v15-ac',b0);if(!E2)return;c.textContent=fa(F.length);E2.innerHTML=F.slice(0,8).map(f=>row(esc(f.name),'نسخهٔ '+fa(f.version)+' · '+(f.tags?esc(f.tags):''),'')).join('')||'<div class="sx-muted v14-sm">سندی برای این پرونده بایگانی نشده.</div>'}catch(e){const E2=$('.v15-arc',b0);if(E2)E2.innerHTML='<div class="sx-muted v14-sm">بایگانی در دسترس نیست.</div>'}})()};
 draw()}

/* ---------- Document template builder & transport document drafts ---------- */
const TPL=[['pi','پیش‌فاکتور','Proforma Invoice'],['ci','فاکتور تجاری','Commercial Invoice'],['pl','فهرست عدل‌بندی','Packing List'],['si','دستورالعمل حمل','Shipping Instruction'],['loi','نامهٔ تعهد','Letter of Indemnity'],['bl','پیش‌نویس بارنامهٔ دریایی','Bill of Lading — DRAFT'],['awb','پیش‌نویس بارنامهٔ هوایی','Air Waybill — DRAFT'],['cmr','پیش‌نویس بارنامهٔ جاده‌ای','CMR Consignment Note — DRAFT'],['smgs','پیش‌نویس راه‌نامهٔ ریلی','SMGS/CIM Railway Consignment Note — DRAFT']];
const TPG={pi:['pt','cm'],ci:['pt','sh','cm'],pl:['pt','sh','cm'],si:['pt','sh','cm'],loi:['pt','sh','lo'],bl:['pt','sh'],awb:['pt','ai'],cmr:['pt','rd'],smgs:['pt','rl']};
const TPX={t:'ci'};
const TPF={pt:['طرفین',[['shp','فرستنده / فروشنده (Shipper)'],['shpA','نشانی فرستنده','l'],['cne','گیرنده (Consignee)'],['cneA','نشانی گیرنده','l'],['ntf','طرف اعلام (Notify)']]],
 sh:['حمل دریایی',[['pol','بندر بارگیری (POL)'],['pod','بندر تخلیه (POD)'],['plr','محل تحویل گرفتن (Place of receipt)'],['pdl','محل تحویل (Place of delivery)'],['vsl','کشتی'],['voy','سفر'],['bk','شمارهٔ رزرو'],['bln','شمارهٔ بارنامه'],['ctr','کانتینرها (با فاصله)'],['seal','پلمب‌ها'],['frt','کرایه','',[['PREPAID','PREPAID — پیش‌پرداخت'],['COLLECT','COLLECT — پس‌کرایه']]],['nob','تعداد نسخهٔ اصل'],['marks','علائم و شماره‌ها (Marks)']]],
 cm:['تجاری',[['ino','شمارهٔ فاکتور'],['idt','تاریخ فاکتور','d'],['inc','اینکوترمز','',['EXW','FCA','FAS','FOB','CFR','CIF','CPT','CIP','DAP','DPU','DDP'].map(x=>[x,x])],['cur','ارز','',['USD','EUR','AED','CNY','RUB','TRY'].map(x=>[x,x])],['pay','شرایط پرداخت'],['org','کشور سازنده (Origin)'],['bank','اطلاعات بانکی ذی‌نفع','l'],['valid','اعتبار پیش‌فاکتور (روز)','n']]],
 lo:['نامهٔ تعهد',[['loiTo','خطاب به (خط کشتیرانی/نماینده)'],['loiK','موضوع','',[['nobl','تحویل بار بدون ارائهٔ بارنامهٔ اصل'],['swb','تغییر گیرنده / Switch B/L'],['clean','صدور بارنامهٔ تمیز'],['pod','تغییر بندر تخلیه']]],['loiX','توضیح تکمیلی','l']]],
 ai:['حمل هوایی',[['dep','فرودگاه مبدأ (IATA)'],['dst','فرودگاه مقصد (IATA)'],['car','ایرلاین'],['flt','پرواز/تاریخ'],['awbn','شمارهٔ AWB (۳+۸ رقم)'],['hand','دستورالعمل حمل (Handling)']]],
 rd:['حمل جاده‌ای',[['plr','محل تحویل گرفتن بار'],['pdl','محل تحویل بار'],['car','شرکت حمل'],['truck','کامیون / تریلر'],['plate','پلاک'],['tir','شمارهٔ کارنهٔ تیر'],['frt','کرایه','',[['PREPAID','پرداخت توسط فرستنده'],['COLLECT','پرداخت توسط گیرنده']]]]],
 rl:['حمل ریلی',[['stF','ایستگاه مبدأ'],['stT','ایستگاه مقصد'],['brd','ایستگاه‌های مرزی'],['wagon','شمارهٔ واگن/کانتینر'],['car','راه‌آهن طرف قرارداد'],['frt','پرداخت کرایه','',[['PREPAID','فرستنده'],['COLLECT','گیرنده']]]]]};
function tplDef(j,C){const cg=(C&&C.cargo)||{};const B=LSG('ifa-bkg',[]).find(b=>b.job===j.ref)||{};const kg=+cg.weightKg||10000;
 return {shp:'',shpA:'',cne:j.cust||'',cneA:'',ntf:'SAME AS CONSIGNEE',pol:B.pol||'',pod:B.pod==='BND'?'Bandar Abbas, Iran':(B.pod||''),plr:'',pdl:'',vsl:B.vessel||'',voy:B.voy||'',bk:B.no||'',bln:'',ctr:'',seal:'',frt:'PREPAID',nob:'3',marks:'N/M',ino:'INV-'+j.ref,idt:fwToday(),inc:cg.incoterm||'CFR',cur:'USD',pay:'T/T',org:'',bank:'',valid:30,loiTo:B.carrier||'',loiK:'nobl',loiX:'',dep:'',dst:'IKA',car:'',flt:'',awbn:'',hand:'',truck:'',plate:'',tir:'',stF:'',stT:'',brd:'',wagon:'',
  items:[{dsc:cg.commodity||'',hs:cg.hs||'',pkg:+cg.packages||1,pkt:'PALLETS',nw:Math.round(kg*.98),gw:kg,cbm:+cg.cbm||0,qty:1,unit:'LOT',price:+cg.value||0}]}}
const tpT=D=>D.items.reduce((a,x)=>({pkg:a.pkg+(+x.pkg||0),nw:a.nw+(+x.nw||0),gw:a.gw+(+x.gw||0),cbm:a.cbm+(+x.cbm||0),val:a.val+(+x.qty||0)*(+x.price||0)}),{pkg:0,nw:0,gw:0,cbm:0,val:0});
const tpE=s=>esc(s||'').replace(/\n/g,'<br>');
const TCSS=`<style>.dx{direction:ltr;text-align:left;font-family:Arial,Helvetica,sans-serif;color:#111}.dx h1{font-size:18px;text-align:center;margin:0 0 4px;letter-spacing:.5px}.dx h1 small{display:block;font-size:11px;color:#555;font-weight:400}.dx table{width:100%;border-collapse:collapse;margin-top:6px}.dx td,.dx th{border:1px solid #333;padding:4px 6px;font-size:10.5px;vertical-align:top}.dx th{background:#eee}.dx .lb{display:block;font-size:8.5px;color:#555;text-transform:uppercase;margin-bottom:2px}.dx .r{text-align:right}.dx .wm{position:fixed;top:40%;left:15%;font-size:90px;color:rgba(200,0,0,.08);transform:rotate(-25deg);pointer-events:none}.dx .sg{margin-top:28px;display:flex;justify-content:space-between;font-size:11px}.dx .fa{direction:rtl;text-align:right;font-family:Vazirmatn,Tahoma,sans-serif}</style>`;
const bx=(l,v,cs,rs)=>`<td${cs?` colspan="${cs}"`:''}${rs?` rowspan="${rs}"`:''}><span class="lb">${l}</span>${v}</td>`;
function tplHtml(k,D,j){const T=tpT(D);const it=D.items;const t=TPL.find(x=>x[0]===k);const n=v=>nf(+v||0,2).replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d)).replace(/٬/g,',').replace(/٫/g,'.');
 const goods=(cols)=>`<table><tr>${cols.map(c=>`<th>${c[0]}</th>`).join('')}</tr>${it.map(x=>`<tr>${cols.map(c=>`<td class="${c[2]||''}">${c[1](x)}</td>`).join('')}</tr>`).join('')}<tr>${cols.map((c,i)=>`<th class="${c[2]||''}">${c[3]?c[3]():i===0?'TOTAL':''}</th>`).join('')}</tr></table>`;
 const head=`<h1>${t[2]}<small>${t[1]} · Ref ${esc(j.ref)}</small></h1>`;const dr=['bl','awb','cmr','smgs'].includes(k)?'<div class="wm">DRAFT</div>':'';
 const parties=`<tr>${bx('Shipper / Exporter',tpE(D.shp)+'<br>'+tpE(D.shpA))}${bx('Consignee',tpE(D.cne)+'<br>'+tpE(D.cneA))}</tr>`;
 if(k==='pi'||k==='ci')return `<div class="page dx">${dr}${head}<table>${parties}<tr>${bx(k==='pi'?'Proforma No. / Date':'Invoice No. / Date',esc(D.ino)+' · '+esc(D.idt))}${bx('Terms of delivery (Incoterms® 2020)',esc(D.inc)+' '+esc(k==='pi'?D.pod:D.pod||''))}</tr><tr>${bx('Country of origin',esc(D.org))}${bx('Payment terms',esc(D.pay))}</tr>${k==='ci'?`<tr>${bx('Vessel / Voyage',esc(D.vsl)+' '+esc(D.voy))}${bx('Port of loading → discharge',esc(D.pol)+' → '+esc(D.pod))}</tr>`:''}</table>
  ${goods([['Description of goods',x=>tpE(x.dsc)],['HS code',x=>esc(x.hs)],['Qty',x=>n(x.qty)+' '+esc(x.unit),'r'],['Unit price '+D.cur,x=>n(x.price),'r'],['Amount '+D.cur,x=>n((+x.qty||0)*(+x.price||0)),'r',()=>n(T.val)]])}
  <p style="font-size:11px">Total ${esc(D.cur)} ${n(T.val)} · Gross weight ${n(T.gw)} kg · Net weight ${n(T.nw)} kg · ${n(T.pkg)} packages${k==='pi'?` · Validity ${fa(D.valid||30).replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d))} days`:''}</p>${D.bank?`<p style="font-size:11px"><b>Beneficiary bank:</b><br>${tpE(D.bank)}</p>`:''}<p style="font-size:10.5px">We hereby certify that this invoice is true and correct and that the goods are of the origin stated above.</p><div class="sg"><span>Authorized signature & stamp: ______________</span><span>${esc(D.idt)}</span></div></div>`;
 if(k==='pl')return `<div class="page dx">${head}<table>${parties}<tr>${bx('Invoice No.',esc(D.ino))}${bx('Vessel / POL → POD',esc(D.vsl)+' · '+esc(D.pol)+' → '+esc(D.pod))}</tr><tr>${bx('Containers / Seals',esc(D.ctr)+'<br>'+esc(D.seal),2)}</tr></table>
  ${goods([['Marks',()=>tpE(D.marks)],['Description',x=>tpE(x.dsc)],['Packages',x=>n(x.pkg)+' '+esc(x.pkt),'r',()=>n(T.pkg)],['Net kg',x=>n(x.nw),'r',()=>n(T.nw)],['Gross kg',x=>n(x.gw),'r',()=>n(T.gw)],['CBM',x=>n(x.cbm),'r',()=>n(T.cbm)]])}<div class="sg"><span>Signature & stamp: ______________</span><span>${esc(D.idt)}</span></div></div>`;
 if(k==='si')return `<div class="page dx">${head}<table>${parties}<tr>${bx('Notify party',tpE(D.ntf))}${bx('Booking No.',esc(D.bk))}</tr><tr>${bx('Vessel / Voyage',esc(D.vsl)+' / '+esc(D.voy))}${bx('Place of receipt / POL',esc(D.plr)+' / '+esc(D.pol))}</tr><tr>${bx('POD / Place of delivery',esc(D.pod)+' / '+esc(D.pdl))}${bx('Freight · Originals',esc(D.frt)+' · '+esc(D.nob)+' original B/L')}</tr><tr>${bx('Containers / Seals',esc(D.ctr)+'<br>'+esc(D.seal),2)}</tr></table>
  ${goods([['Marks',()=>tpE(D.marks)],['Description of goods',x=>tpE(x.dsc)+(x.hs?'<br>HS '+esc(x.hs):'')],['Packages',x=>n(x.pkg)+' '+esc(x.pkt),'r',()=>n(T.pkg)],['Gross kg',x=>n(x.gw),'r',()=>n(T.gw)],['CBM',x=>n(x.cbm),'r',()=>n(T.cbm)]])}<p style="font-size:10.5px">Please issue the Bill of Lading exactly as above. Any discrepancy must be advised before issuance.</p><div class="sg"><span>Shipper / Agent: ______________</span><span>${esc(D.idt)}</span></div></div>`;
 if(k==='loi'){const K={nobl:['delivery of cargo without production of the original Bill(s) of Lading','تحویل بار بدون ارائهٔ بارنامهٔ اصل'],swb:['issuance of switch Bill(s) of Lading / change of consignee','صدور بارنامهٔ جایگزین / تغییر گیرنده'],clean:['issuance of clean Bill(s) of Lading','صدور بارنامهٔ تمیز'],pod:['change of port of discharge','تغییر بندر تخلیه']}[D.loiK]||['',''];
  return `<div class="page dx">${head}<p>To: <b>${esc(D.loiTo)}</b><br>Date: ${esc(D.idt)}</p><p>Re: Vessel ${esc(D.vsl)} voy. ${esc(D.voy)} · B/L ${esc(D.bln)} · ${esc(D.pol)} → ${esc(D.pod)} · ${tpE(it.map(x=>x.dsc).join(', '))}</p><p>We hereby request you to proceed with the ${K[0]}. In consideration of your complying with our above request, we hereby agree to indemnify you and hold you harmless in respect of any liability, loss, damage or expense of whatsoever nature which you may sustain by reason of so doing. ${tpE(D.loiX)}</p><p>This indemnity shall be governed by the law and jurisdiction agreed in the contract of carriage.</p><div class="fa" style="margin-top:14px;border-top:1px dashed #999;padding-top:10px">بدین‌وسیله درخواست ${K[1]} را داریم و در قبال اجابت این درخواست، متعهد می‌شویم هرگونه مسئولیت، زیان یا هزینه‌ای را که از این بابت متوجه شما شود جبران کنیم. ${tpE(D.loiX)}</div><div class="sg"><span>For and on behalf of ${esc(D.cne||D.shp)}: ______________</span><span>Bank countersignature (if required): ______________</span></div></div>`}
 if(k==='bl')return `<div class="page dx">${dr}${head}<table><tr>${bx('Shipper',tpE(D.shp)+'<br>'+tpE(D.shpA))}${bx('B/L No.',esc(D.bln||'—'))}${bx('Booking No.',esc(D.bk))}</tr><tr>${bx('Consignee',tpE(D.cne)+'<br>'+tpE(D.cneA))}${bx('Carrier / Agent',esc(D.loiTo||''),2)}</tr><tr>${bx('Notify party',tpE(D.ntf))}${bx('Place of receipt',esc(D.plr))}${bx('Port of loading',esc(D.pol))}</tr><tr>${bx('Ocean vessel / Voyage',esc(D.vsl)+' / '+esc(D.voy))}${bx('Port of discharge',esc(D.pod))}${bx('Place of delivery',esc(D.pdl))}</tr></table>
  ${goods([['Container / Seal · Marks',()=>esc(D.ctr)+'<br>'+esc(D.seal)+'<br>'+tpE(D.marks)],['No. & kind of packages',x=>n(x.pkg)+' '+esc(x.pkt),'',()=>n(T.pkg)],['Description of goods',x=>tpE(x.dsc)+(x.hs?'<br>HS '+esc(x.hs):'')],['Gross weight kg',x=>n(x.gw),'r',()=>n(T.gw)],['Measurement CBM',x=>n(x.cbm),'r',()=>n(T.cbm)]])}
  <table><tr>${bx('Freight & charges',esc(D.frt))}${bx('Number of original B/L',esc(D.nob))}${bx('Place and date of issue',esc(D.pol)+' · ______')}</tr><tr>${bx('SHIPPED ON BOARD',"Date: ______ &nbsp; Carrier's signature: ______",3)}</tr></table><p style="font-size:9.5px">SHIPPER'S LOAD, STOW AND COUNT · SAID TO CONTAIN. Draft for checking only — not a negotiable document.</p></div>`;
 if(k==='awb')return `<div class="page dx">${dr}${head}<table><tr>${bx('Air Waybill No.',esc(D.awbn||'___-________'))}${bx('Issued by (airline)',esc(D.car),2)}</tr><tr>${bx("Shipper's name and address",tpE(D.shp)+'<br>'+tpE(D.shpA))}${bx("Consignee's name and address",tpE(D.cne)+'<br>'+tpE(D.cneA),2)}</tr><tr>${bx('Airport of departure',esc(D.dep))}${bx('Airport of destination',esc(D.dst))}${bx('Flight / Date',esc(D.flt))}</tr><tr>${bx('Handling information',tpE(D.hand)+' · Notify: '+tpE(D.ntf),3)}</tr></table>
  ${goods([['No. of pieces',x=>n(x.pkg),'',()=>n(T.pkg)],['Gross weight kg',x=>n(x.gw),'r',()=>n(T.gw)],['Chargeable weight kg',x=>n(Math.max(+x.gw||0,(+x.cbm||0)*167)),'r',()=>n(it.reduce((a,x)=>a+Math.max(+x.gw||0,(+x.cbm||0)*167),0))],['Nature and quantity of goods (incl. dimensions or volume)',x=>tpE(x.dsc)+' · '+n(x.cbm)+' CBM']])}
  <p style="font-size:9.5px">Chargeable weight = max(actual, volume × 167 kg/m³). Shipper certifies that the particulars on the face hereof are correct. Draft for checking only.</p><div class="sg"><span>Signature of shipper or agent: ______</span><span>Executed on (date) at (place): ______</span></div></div>`;
 if(k==='cmr')return `<div class="page dx">${dr}${head}<table><tr>${bx('1. Sender',tpE(D.shp)+'<br>'+tpE(D.shpA))}${bx('16. Carrier',esc(D.car)+'<br>'+esc(D.truck)+' · '+esc(D.plate))}</tr><tr>${bx('2. Consignee',tpE(D.cne)+'<br>'+tpE(D.cneA))}${bx('17. Successive carriers','')}</tr><tr>${bx('3. Place of delivery of the goods',esc(D.pdl))}${bx('4. Place and date of taking over the goods',esc(D.plr)+' · '+esc(D.idt))}</tr><tr>${bx('5. Documents attached','Invoice '+esc(D.ino)+', Packing list'+(D.tir?', TIR Carnet '+esc(D.tir):''))}${bx('13. Sender\'s instructions (customs, etc.)',D.tir?'TIR Carnet No. '+esc(D.tir):'')}</tr></table>
  ${goods([['6. Marks and Nos',()=>tpE(D.marks)],['7. Number of packages',x=>n(x.pkg),'',()=>n(T.pkg)],['8. Method of packing',x=>esc(x.pkt)],['9. Nature of the goods',x=>tpE(x.dsc)],['10. Statistical No.',x=>esc(x.hs)],['11. Gross weight kg',x=>n(x.gw),'r',()=>n(T.gw)],['12. Volume m³',x=>n(x.cbm),'r',()=>n(T.cbm)]])}
  <table><tr>${bx('14. Cash on delivery','')}${bx('20. To be paid by',D.frt==='COLLECT'?'Consignee':'Sender')}${bx('21. Established in / on',esc(D.plr)+' · '+esc(D.idt))}</tr><tr>${bx('22. Signature and stamp of the sender','<br><br>')}${bx('23. Signature and stamp of the carrier','<br><br>')}${bx('24. Goods received (consignee)','<br><br>')}</tr></table><p style="font-size:9.5px">This carriage is subject, notwithstanding any clause to the contrary, to the Convention on the Contract for the International Carriage of Goods by Road (CMR). Draft for checking only.</p></div>`;
 return `<div class="page dx">${dr}${head}<table><tr>${bx('1. Sender',tpE(D.shp)+'<br>'+tpE(D.shpA))}${bx('2. Station of departure',esc(D.stF))}</tr><tr>${bx('4. Consignee',tpE(D.cne)+'<br>'+tpE(D.cneA))}${bx('5. Station of destination',esc(D.stT))}</tr><tr>${bx('6. Border stations',esc(D.brd))}${bx('7–8. Wagon / container No.',esc(D.wagon||D.ctr))}</tr><tr>${bx('Railway (carrier)',esc(D.car))}${bx('Payment of carriage charges',D.frt==='COLLECT'?'Consignee':'Sender')}</tr></table>
  ${goods([['Marks',()=>tpE(D.marks)],['Kind of packing',x=>esc(x.pkt)],['Description of goods',x=>tpE(x.dsc)],['HS (ETSNG/GNG)',x=>esc(x.hs)],['Number of packages',x=>n(x.pkg),'r',()=>n(T.pkg)],['Mass kg (sender)',x=>n(x.gw),'r',()=>n(T.gw)]])}
  <table><tr>${bx('Documents attached by the sender','Invoice '+esc(D.ino)+', Packing list, Certificate of origin')}${bx("Sender's declarations",'')}</tr><tr>${bx('Signature of sender','<br><br>')}${bx('Date stamp of departure station','<br><br>')}</tr></table><p style="font-size:9.5px">SMGS (OSJD) for the eastern corridor; for routes under COTIF use the CIM/SMGS common consignment note. Draft for checking only.</p></div>`}
function tplChecks(k,D){const W=[];const T=tpT(D);const need={pi:['shp','cne','ino','inc','cur'],ci:['shp','cne','ino','inc','cur','org'],pl:['shp','cne','ino'],si:['shp','cne','pol','pod','bk'],loi:['loiTo','vsl','bln'],bl:['shp','cne','pol','pod','vsl'],awb:['shp','cne','dep','dst','car'],cmr:['shp','cne','plr','pdl','car'],smgs:['shp','cne','stF','stT']}[k]||[];
 const lab={};Object.values(TPF).forEach(g=>g[1].forEach(f=>lab[f[0]]=f[1]));const miss=need.filter(f=>!String(D[f]||'').trim());if(miss.length)W.push(['bad','فیلدهای لازم خالی است: '+miss.map(f=>lab[f]).join('، ')]);
 if(D.items.some(x=>!String(x.dsc||'').trim()))W.push(['bad','شرح کالا در یک یا چند ردیف خالی است.']);
 if(['ci','pi','si','bl','cmr','smgs'].includes(k)&&D.items.some(x=>x.hs&&!/^\d{8}$/.test(String(x.hs).replace(/\D/g,''))))W.push(['warn','کد HS ایران ۸ رقمی است؛ کدهای کوتاه‌تر/بلندتر را بررسی کنید.']);
 if(D.items.some(x=>(+x.nw||0)>(+x.gw||0)))W.push(['bad','وزن خالص از وزن ناخالص بیشتر است.']);
 if(['bl','si','cmr','smgs'].includes(k)){const pre=['CFR','CIF','CPT','CIP','DAP','DPU','DDP'].includes(D.inc);if(pre&&D.frt==='COLLECT'||!pre&&D.frt==='PREPAID'&&['EXW','FCA','FAS','FOB'].includes(D.inc))W.push(['warn',`پرداخت کرایه (${D.frt}) با اینکوترمز ${D.inc} هم‌خوان نیست.`])}
 if(['bl','si','pl'].includes(k)&&D.ctr){const bad=String(D.ctr).split(/[\s,]+/).filter(Boolean).filter(c=>!iso6346(c).ok);if(bad.length)W.push(['bad','رقم کنترل شمارهٔ کانتینر نادرست: '+bad.join('، ')])}
 if(k==='awb'&&D.awbn&&!/^\d{3}-?\d{8}$/.test(D.awbn.trim()))W.push(['warn','قالب شمارهٔ AWB باید ۳ رقم پیشوند ایرلاین + ۸ رقم باشد.']);
 if(k==='awb'&&D.awbn&&/^\d{3}-?\d{8}$/.test(D.awbn.trim())){const d=D.awbn.replace(/\D/g,'');if(+d.slice(3,10)%7!==+d[10])W.push(['bad','رقم کنترل AWB (باقیماندهٔ ۷ رقم سریال بر ۷) نادرست است.'])}
 if(k==='bl'&&/TO ORDER/i.test(D.cne)&&!String(D.ntf||'').trim())W.push(['warn','در بارنامهٔ «به حواله‌کرد» طرف اعلام (Notify) را مشخص کنید.']);
 if(['ci','pi'].includes(k)&&!T.val)W.push(['warn','مبلغ فاکتور صفر است.']);
 return W}
const DCMAP={ci:'inv',pl:'pl',bl:'bl',pi:'pi'};
function rTpl(b0,C){const J=LSG('ifa-jobs',[]);const cur=LSG('ifa-job-cur','');const j=J.find(x=>x.id===cur)||J[0]||{ref:'DRAFT',cust:'',lines:[]};
 const A=LSG('ifa-tpl',{});const D=A[j.ref]=Object.assign(tplDef(j,C),A[j.ref]||{});const sv=()=>{const X=LSG('ifa-tpl',{});X[j.ref]=D;LSS('ifa-tpl',X)};
 const draw=()=>{const k=TPX.t;const G=TPG[k];const W=tplChecks(k,D);const T=tpT(D);
  b0.innerHTML=`<div class="tm"><div class="sx-row tm-top">${tmSeg(TPL.map(x=>[x[0],x[1]]),k,'v15-ts')}<span class="sx-sp"></span><label class="sx-f fw-f"><span>پرونده</span><select class="tp-j">${J.map(x=>`<option value="${x.id}" ${x.ref===j.ref?'selected':''}>${esc(x.ref)} · ${esc(x.cust||'')}</option>`).join('')||'<option>DRAFT</option>'}</select></label></div>
  <div class="v15-tp"><div class="v15-tpf">${G.map(g=>`<div class="sx-card fw-form"><header><b>${TPF[g][0]}</b>${g==='pt'?'<small>داده‌ها بین همهٔ اسناد این پرونده مشترک است</small>':''}</header><div class="fw-g">${TPF[g][1].map(([f,l,t,o])=>t==='l'?`<label class="sx-f fw-f w2"><span>${l}</span><textarea data-k="${f}" rows="2" class="v14-ta">${esc(D[f]||'')}</textarea></label>`:fwI(l,f,D[f],{t:rgT(t),opts:o})).join('')}</div></div>`).join('')}
   <div class="sx-card"><header><b>اقلام کالا</b><small>${fa(D.items.length)} ردیف · ${fa(nf(T.gw))} kg ناخالص · ${fa(nf(T.cbm,2))} m³ · ${D.cur} ${fa(nf(T.val,2))}</small><span class="sx-sp"></span><button class="sx-btn xs" data-ld>از اقلام چیدمان</button><button class="sx-btn xs" data-ai>+ ردیف</button></header><div class="rg-w"><table class="sx-tbl v14-lt v15-it"><thead><tr><th>شرح کالا</th><th>HS</th><th>بسته</th><th>نوع</th><th>خالص kg</th><th>ناخالص kg</th><th>m³</th><th>مقدار</th><th>واحد</th><th>قیمت واحد</th><th></th></tr></thead><tbody>${D.items.map((x,i)=>`<tr data-i="${i}"><td><input data-c="dsc" value="${esc(x.dsc)}" style="min-width:150px"></td><td><input data-c="hs" value="${esc(x.hs)}" dir="ltr"></td><td><input data-c="pkg" type="number" value="${x.pkg}"></td><td><input data-c="pkt" value="${esc(x.pkt)}" dir="ltr"></td><td><input data-c="nw" type="number" value="${x.nw}"></td><td><input data-c="gw" type="number" value="${x.gw}"></td><td><input data-c="cbm" type="number" step=".01" value="${x.cbm}"></td><td><input data-c="qty" type="number" value="${x.qty}"></td><td><input data-c="unit" value="${esc(x.unit)}" dir="ltr"></td><td><input data-c="price" type="number" step=".01" value="${x.price}"></td><td><button class="sx-btn xs" data-x>×</button></td></tr>`).join('')}</tbody></table></div></div></div>
   <div class="v15-tpv"><div class="sx-card"><header><b>${TPL.find(x=>x[0]===k)[1]}</b><small dir="ltr">${TPL.find(x=>x[0]===k)[2]}</small><span class="sx-sp"></span><button class="sx-btn sm" data-ar>ذخیره در بایگانی</button>${DCMAP[k]?'<button class="sx-btn sm" data-dc>ارسال به کنترل هم‌خوانی</button>':''}<button class="sx-btn sm pri" data-pr>چاپ / PDF</button></header>
   <div class="v15-ck">${W.map(w=>`<div class="fw-al ${w[0]}">${w[1]}</div>`).join('')||'<div class="fw-al ok">کنترل‌های پایه بدون ایراد است.</div>'}</div><iframe class="v15-fr" title="پیش‌نمایش"></iframe></div></div></div></div>`;
  const fr=$('.v15-fr',b0);fr.srcdoc=`<!doctype html><html><head><meta charset="utf-8"><style>${RCSS}</style>${TCSS}<style>body{background:#fff;margin:0;zoom:.72}.page{box-shadow:none;margin:0 auto}</style></head><body>${tplHtml(k,D,j)}</body></html>`;
  $$('.v15-ts button',b0).forEach(x=>x.onclick=()=>{TPX.t=x.dataset.v;draw()});
  $('.tp-j',b0).onchange=e=>{LSS('ifa-job-cur',e.target.value);rTpl(b0,C)};
  const upd=()=>{sv();const W2=tplChecks(TPX.t,D);$('.v15-ck',b0).innerHTML=W2.map(w=>`<div class="fw-al ${w[0]}">${w[1]}</div>`).join('')||'<div class="fw-al ok">کنترل‌های پایه بدون ایراد است.</div>';fr.srcdoc=fr.srcdoc.replace(/<body>[\s\S]*<\/body>/,'<body>'+tplHtml(TPX.t,D,j)+'</body>')};
  $$('.v15-tpf [data-k]',b0).forEach(x=>x.addEventListener(x.tagName==='SELECT'||x.type==='date'?'change':'input',()=>{const v=x.type==='number'?+x.value:x.value;D[x.dataset.k]=v;clearTimeout(x._t);x._t=setTimeout(upd,250)}));
  $$('.v15-it input',b0).forEach(x=>x.onchange=()=>{const it=D.items[+x.closest('tr').dataset.i];it[x.dataset.c]=x.type==='number'?+x.value:x.value;sv();setTimeout(draw)});
  $$('.v15-it [data-x]',b0).forEach(x=>x.onclick=()=>{if(D.items.length<2)return;D.items.splice(+x.closest('tr').dataset.i,1);sv();setTimeout(draw)});
  $('[data-ai]',b0).onclick=()=>{D.items.push({dsc:'',hs:'',pkg:1,pkt:'CARTONS',nw:0,gw:0,cbm:0,qty:1,unit:'PCS',price:0});sv();setTimeout(draw)};
  $('[data-ld]',b0).onclick=()=>{const I=(typeof LOAD!=='undefined'&&LOAD.items)||[];if(!I.length){toast('اقلامی در «چیدمان کانتینر» نیست');return}D.items=I.map(x=>({dsc:x.n||'',hs:(C&&C.cargo&&C.cargo.hs)||'',pkg:+x.q||1,pkt:'PACKAGES',nw:Math.round((+x.kg||0)*(+x.q||1)*.97),gw:Math.round((+x.kg||0)*(+x.q||1)),cbm:+((x.L*x.W*x.H/1e6)*(+x.q||1)||0).toFixed(2),qty:+x.q||1,unit:'PCS',price:0}));sv();setTimeout(draw)};
  $('[data-pr]',b0).onclick=()=>openDoc(TCSS+tplHtml(TPX.t,D,j),TPL.find(x=>x[0]===TPX.t)[2]+' · '+j.ref);
  $('[data-ar]',b0).onclick=async()=>{try{const t=TPL.find(x=>x[0]===TPX.t);const html=`<!doctype html><html><head><meta charset="utf-8"><style>${RCSS}</style>${TCSS}</head><body>${tplHtml(TPX.t,D,j)}</body></html>`;const r=await ARC.put(j.ref,new File([html],TPX.t.toUpperCase()+'-'+j.ref+'.html',{type:'text/html'}),'قالب:'+TPX.t,false);toast(r&&r.duplicate?'نسخهٔ یکسان قبلاً بایگانی شده است':'در بایگانی پرونده ذخیره شد (نسخهٔ '+fa((r&&r.version)||1)+')')}catch(e){toast('خطا در بایگانی: '+e.message)}};
  const dc=$('[data-dc]',b0);if(dc)dc.onclick=()=>{const S=Object.assign({v:{},tol:{w:.5,v:3},tg:'inv'},LSG('ifa-doc',{}));const it=D.items;const o={shp:D.shp,cne:D.cne,ntf:D.ntf,dsc:it.map(x=>x.dsc).join(' / '),hs:it.map(x=>x.hs).filter(Boolean).join(' '),org:D.org,pol:D.pol,pod:D.pod,pkg:String(T.pkg),gw:String(T.gw),nw:String(T.nw),cbm:String(T.cbm),ctr:D.ctr,seal:D.seal,val:String(T.val),cur:D.cur,inc:D.inc,ino:D.ino};const key=DCMAP[TPX.t];const cols={inv:['shp','cne','dsc','hs','org','pol','pod','pkg','gw','nw','val','cur','inc','ino'],pl:['shp','cne','dsc','hs','pkg','gw','nw','cbm','ctr','seal','ino'],bl:['shp','cne','ntf','dsc','pol','pod','pkg','gw','cbm','ctr','seal'],pi:['shp','cne','dsc','hs','org','pol','pod','val','cur','inc']}[key];S.v[key]={};cols.forEach(f=>{if(o[f])S.v[key][f]=o[f]});LSS('ifa-doc',S);toast('به ستون «'+key+'» کنترل هم‌خوانی منتقل شد');window.__STUDIO.nav.go('doc')}};
 draw()}

/* ---------- International payment methods comparison ---------- */
const PAYM=[['xh','حوالهٔ صرافی (امارات/ترکیه)',1.0,50,1.5,3,4,'all','پروفرما، قرارداد صرافی، کد رهگیری بانک مرکزی','سریع و منعطف؛ وابسته به اعتبار صرافی و کارگزار خارجی'],
 ['aed','تسویهٔ درهمی از دبی',0.8,40,1.0,2,4,'AE,CN,IN,TR,all','حساب درهمی طرف خارجی یا کارگزار','رایج‌ترین کانال برای واردات از امارات و تأمین‌کنندگان چینی با نمایندگی دبی'],
 ['cny','تسویهٔ یوآنی (کانال چین)',1.2,60,2.0,7,7,'CN','حساب یوآنی، فاکتور فروشنده چینی','برای فروشندگان چینی؛ ریسک برگشت وجه و مسدودی حساب بالاتر'],
 ['rub','تسویهٔ روبلی / اتصال شتاب–میر',0.6,30,1.5,3,2,'RU','حساب روبلی، پیام‌رسان مالی','فقط برای طرف روسی؛ کارمزد پایین‌تر'],
 ['lc','اعتبار اسنادی (بانک داخلی + تأیید خارجی)',1.8,350,0.5,35,1,'all','ثبت سفارش، پروفرما، اسناد حمل، بیمه‌نامه','امن‌ترین برای طرف جدید و مبالغ بالا؛ کند و پرهزینه؛ امکان پرداخت مدت‌دار'],
 ['dc','وصولی اسنادی (CAD/Collection)',0.5,150,0.5,15,2,'all','اسناد حمل از طریق بانک','تعادل امنیت و هزینه برای طرف‌های آشنا'],
 ['nima','بازار مبادله / ارز توافقی (تخصیص)',0.3,20,0,45,3,'all','ثبت سفارش، تخصیص ارز، رفع تعهد','ارزان‌ترین نرخ ریالی ولی منتظر تخصیص؛ فقط برای کالای مشمول'],
 ['bar','تهاتر کالا',3.0,500,0,60,1,'all','قرارداد تهاتر، کالای صادراتی هم‌ارزش','بدون جابه‌جایی پول؛ هزینهٔ تخفیف کالا و زمان طولانی']];
const PAYC=[['CN','چین'],['AE','امارات'],['TR','ترکیه'],['RU','روسیه'],['IN','هند'],['IQ','عراق'],['EU','اروپا'],['OT','سایر']];
function rPay(b0){const P=LSG('ifa-pfx',{});const S=Object.assign({amt:100000,cur:'USD',cty:'CN',days:30,cap:30,free:+(P.free||P.fx||1050000),agr:+(P.agr||P.nima||700000),sev:20,w:{c:50,t:25,r:25},par:{}},LSG('ifa-pay',{}));const sv=()=>LSS('ifa-pay',S);
 const M=()=>PAYM.map(m=>{const o=Object.assign({fee:m[2],fix:m[3],spr:m[4],days:m[5],blk:m[6],on:true},S.par[m[0]]||{});return {k:m[0],n:m[1],cty:m[7],docs:m[8],note:m[9],...o}});
 const draw=()=>{const A=+S.amt||0;const R=M().map(m=>{const avail=m.cty.split(',').some(c=>c==='all'||c===S.cty);const fee=A*(+m.fee||0)/100+(+m.fix||0),spr=A*(+m.spr||0)/100,cap=A*(+S.cap||0)/100*(+m.days||0)/365,risk=A*(+m.blk||0)/100*(+S.sev||0)/100;const usd=fee+spr+cap+risk;const rate=m.k==='nima'?+S.agr:+S.free;const irr=(A+fee+spr)*rate;return {...m,avail,fee,spr,cap,risk,usd,rate,irr,late:+m.days>+S.days}}).filter(m=>m.on);
  const V=R.filter(r=>r.avail);const mn=k=>Math.min(...V.map(r=>r[k])),mx=k=>Math.max(...V.map(r=>r[k]));const nz=(v,a,b)=>b>a?(v-a)/(b-a):0;const W=S.w,ws=(+W.c+ +W.t+ +W.r)||1;
  V.forEach(r=>{r.sc=100-100*((+W.c*nz(r.usd,mn('usd'),mx('usd'))+ +W.t*nz(+r.days,mn('days'),mx('days'))+ +W.r*nz(+r.blk,mn('blk'),mx('blk')))/ws)-(r.late?15:0)});V.sort((a,b)=>b.sc-a.sc);const best=V[0];const cheap=V.slice().sort((a,b)=>a.usd-b.usd)[0];const xu=Math.max(1,...R.map(r=>r.usd));
  b0.innerHTML=`<div class="tm"><div class="fc-g2"><div class="sx-card fw-form"><header><b>مقایسهٔ روش‌های پرداخت بین‌المللی</b><small>هزینهٔ واقعی = کارمزد + اختلاف نرخ تبدیل + هزینهٔ سرمایهٔ معطل + زیان مورد انتظار مسدودی</small></header><div class="fw-g">${fwI('مبلغ پرداخت','amt',S.amt)}${fwI('ارز','cur',S.cur,{opts:['USD','EUR','AED','CNY','RUB'].map(x=>[x,x])})}${fwI('کشور ذی‌نفع','cty',S.cty,{opts:PAYC})}${fwI('حداکثر زمان قابل قبول (روز)','days',S.days)}${fwI('هزینهٔ سرمایه (٪ سالانه)','cap',S.cap)}${fwI('شدت زیان در صورت مسدودی (٪ مبلغ)','sev',S.sev)}${fwI('نرخ بازار آزاد (ریال)','free',S.free)}${fwI('نرخ توافقی/مبادله (ریال)','agr',S.agr)}</div>
   <div class="v15-w"><b>وزن معیارها</b>${[['c','هزینه'],['t','زمان'],['r','ریسک']].map(([k,n])=>`<label class="sx-sl"><span>${n}</span><input type="range" min="0" max="100" step="5" value="${W[k]}" data-w="${k}"><b>${fa(W[k])}</b></label>`).join('')}</div></div>
   <div class="sx-card"><header><b>پیشنهاد</b></header>${best?`<div class="ex-kpis">${kpi('بهترین گزینهٔ وزنی',best.sc,{d:0,sub:best.n})}${kpi('هزینهٔ کل گزینهٔ پیشنهادی',best.usd,{pre:'$',sub:fa(nf(best.usd/A*100,2))+'٪ مبلغ'})}${kpi('ارزان‌ترین',cheap.usd,{pre:'$',sub:cheap.n})}${kpi('زمان تسویه',+best.days,{suf:' روز'})}</div><div class="fw-al ok"><b>${best.n}</b> — ${best.note}</div>${best.late?'<div class="fw-al bad">زمان این روش از حداکثر قابل قبول بیشتر است.</div>':''}<div class="fw-al">اسناد لازم: ${best.docs}</div>`:'<div class="fw-al bad">هیچ روشی برای این کشور فعال نیست.</div>'}<div class="fw-bt"><button class="sx-btn sm" data-ap ${best?'':'disabled'}>افزودن هزینهٔ انتقال به پروندهٔ جاری</button><button class="sx-btn sm" data-cs>CSV</button><button class="sx-btn sm" data-rs>بازنشانی پیش‌فرض‌ها</button></div></div></div>
  <div class="sx-card"><header><b>جدول مقایسه</b><small>پارامترهای هر روش قابل ویرایش است و ذخیره می‌شود · مقادیر پیش‌فرض نمونه و تقریبی است</small></header><div class="rg-w"><table class="sx-tbl v14-lt v15-pt"><thead><tr><th></th><th>روش</th><th>کارمزد ٪</th><th>ثابت $</th><th>اختلاف نرخ ٪</th><th>روز</th><th>احتمال مسدودی ٪</th><th>کارمزد $</th><th>تبدیل $</th><th>سرمایه $</th><th>ریسک $</th><th>جمع $</th><th style="width:14%"></th><th>معادل ریالی</th><th>امتیاز</th></tr></thead><tbody>${R.map(r=>`<tr data-m="${r.k}" class="${!r.avail?'v15-na':r===best?'on':''}"><td><input type="checkbox" data-on ${r.on?'checked':''}></td><td><b>${r.n}</b>${!r.avail?'<br><small class="sx-muted">برای این کشور معمولاً در دسترس نیست</small>':r.late?'<br><small class="v14-bad">کندتر از حد قابل قبول</small>':''}</td>${['fee','fix','spr','days','blk'].map(f=>`<td><input type="number" step=".1" data-p="${f}" value="${r[f]}" style="width:64px"></td>`).join('')}<td>${usd0(r.fee)}</td><td>${usd0(r.spr)}</td><td>${usd0(r.cap)}</td><td>${usd0(r.risk)}</td><td><b>${usd0(r.usd)}</b></td><td><span class="v14-hb"><i class="${r===cheap?'':''}" style="width:${r.usd/xu*100}%"></i></span></td><td>${fa(nf(r.irr/1e7,1))} م.ت</td><td>${r.avail?fa(nf(r.sc||0)):'—'}</td></tr>`).join('')}</tbody></table></div>
  <div class="sx-muted v14-sm">نرخ کارمزد، اختلاف نرخ، زمان و ریسک مسدودی هر کانال بسته به صرافی، بانک، کشور و شرایط تحریم مدام تغییر می‌کند؛ پیش از تصمیم با کارگزار ارزی و مقررات بانک مرکزی (ثبت سفارش، تخصیص و رفع تعهد) تطبیق دهید. «معادل ریالی» = (مبلغ + کارمزد + تبدیل) × نرخ؛ روش بازار مبادله با نرخ توافقی محاسبه می‌شود.</div></div></div>`;
  fwBind($('.fw-form',b0),S,(k)=>{sv();clearTimeout(rPay._t);rPay._t=setTimeout(draw,300)});
  $$('[data-w]',b0).forEach(x=>x.oninput=()=>{S.w[x.dataset.w]=+x.value;x.nextElementSibling.textContent=fa(x.value)});$$('[data-w]',b0).forEach(x=>x.onchange=()=>{sv();setTimeout(draw)});
  $$('.v15-pt [data-p]',b0).forEach(x=>x.onchange=()=>{const k=x.closest('tr').dataset.m;(S.par[k]=S.par[k]||{})[x.dataset.p]=+x.value;sv();setTimeout(draw)});
  $$('.v15-pt [data-on]',b0).forEach(x=>x.onchange=()=>{const k=x.closest('tr').dataset.m;(S.par[k]=S.par[k]||{}).on=x.checked;sv();setTimeout(draw)});
  $('[data-rs]',b0).onclick=()=>{S.par={};sv();setTimeout(draw)};
  $('[data-cs]',b0).onclick=()=>dlFile('payment-compare.csv',toCSV(['method','fee_pct','fixed','spread_pct','days','block_pct','fee_usd','fx_usd','capital_usd','risk_usd','total_usd','irr','score'],R.map(r=>[r.n,r.fee_pct??r.fee,r.fix,r.spr,r.days,r.blk,Math.round(r.fee),Math.round(r.spr),Math.round(r.cap),Math.round(r.risk),Math.round(r.usd),Math.round(r.irr),Math.round(r.sc||0)])));
  const ap=$('[data-ap]',b0);if(ap&&best)ap.onclick=()=>{const J=LSG('ifa-jobs',[]);const cur=LSG('ifa-job-cur','');const j=J.find(x=>x.id===cur)||J[0];if(!j){toast('پرونده‌ای وجود ندارد');return}const c=Math.round(best.fee+best.spr);j.lines.push({id:'L'+Math.random().toString(36).slice(2,8),kind:'chg',n:'کارمزد و تبدیل ارز — '+best.n,v:'',cur:'USD',be:c,ba:null,se:Math.round(c*(1+(+j.mk||0)/100)),sa:null,p:false,b:false,c:false});LSS('ifa-jobs',J);toast('ردیف هزینهٔ انتقال به '+j.ref+' اضافه شد')}};
 draw()}
function payCompare(o){const S=Object.assign({amt:100000,cty:'CN',days:30,cap:30,sev:20},o||{});return PAYM.map(m=>{const A=+S.amt;const usd=A*m[2]/100+m[3]+A*m[4]/100+A*S.cap/100*m[5]/365+A*m[6]/100*S.sev/100;return {method:m[1],key:m[0],available:m[7].split(',').some(c=>c==='all'||c===S.cty),days:m[5],blockRiskPct:m[6],totalCostUSD:Math.round(usd)}}).sort((a,b)=>(b.available-a.available)||a.totalCostUSD-b.totalCostUSD)}
function jobFileApi(ref){const J=LSG('ifa-jobs',[]);const cur=LSG('ifa-job-cur','');const j=ref?J.find(x=>x.ref===ref||x.id===ref):(J.find(x=>x.id===cur)||J[0]);if(!j)return null;const L=jfLinks(j);const s=jobSum(j);
 return {ref:j.ref,customer:j.cust,status:j.st||'open',stages:jfStages(j,L,s).map(x=>({key:x.k,name:x.n,done:!!x.done,date:x.d||null,owner:x.o||null})),links:{bookings:L.bkg.length,declarations:L.dec.length,transits:L.trn.length,waybills:L.wb.length,invoices:L.einv.length,guarantees:L.grt.length,claims:L.clm.length,tasks:L.tasks.length,journal:L.log.length},shipment:L.ship?L.ship.id:null,summary:s}}
function docDraftApi(type,ref){const k=type||'bl';if(!TPL.find(x=>x[0]===k))return null;const J=LSG('ifa-jobs',[]);const cur=LSG('ifa-job-cur','');const j=(ref?J.find(x=>x.ref===ref||x.id===ref):(J.find(x=>x.id===cur)||J[0]))||{ref:'DRAFT',cust:'',lines:[]};const A=LSG('ifa-tpl',{});const D=Object.assign(tplDef(j,null),A[j.ref]||{});return {type:k,job:j.ref,html:tplHtml(k,D,j),warnings:tplChecks(k,D)}}

/* ===== v16 (A): rules of origin, rail wagons, warehouse & VAS ===== */
const V16={org:'calc',rail:'pl',wh:'inv',eta:'pr',dmd:'fc',ocr:'rd'};
const kpT=(l,t,sub,cls)=>`<div class="sx-kpi ${cls||''}"><small>${l}</small><b>${t}</b>${sub?`<em>${sub}</em>`:''}</div>`;
const CTN={IR:'ایران',RU:'روسیه',KZ:'قزاقستان',BY:'بلاروس',AM:'ارمنستان',KG:'قرقیزستان',TR:'ترکیه',PK:'پاکستان',MY:'مالزی',ID:'اندونزی',EG:'مصر',NG:'نیجریه',BD:'بنگلادش',SY:'سوریه',CN:'چین',IN:'هند',AE:'امارات',TM:'ترکمنستان',UZ:'ازبکستان',AZ:'آذربایجان',DE:'آلمان',IT:'ایتالیا',KR:'کرهٔ جنوبی',JP:'ژاپن',XX:'سایر / نامعلوم'};
const v16Job=ref=>{const J=LSG('ifa-jobs',[]);const c=LSG('ifa-job-cur','');return {J,j:ref?J.find(x=>x.ref===ref):(J.find(x=>x.id===c)||J[0])}};
const jobO=()=>[['','—'],...LSG('ifa-jobs',[]).map(j=>[j.ref,j.ref+(j.cust?' · '+j.cust:'')])];
function v16AddLine(n,cost,sale,ref){const {J,j}=v16Job(ref);if(!j){toast('پرونده‌ای پیدا نشد');return false}j.lines.push({id:'L'+Math.random().toString(36).slice(2,8),kind:'chg',n,v:'',cur:'USD',be:Math.round(cost),ba:null,se:Math.round(sale!=null?sale:cost*(1+(+j.mk||0)/100)),sa:null,p:false,b:false,c:false});LSS('ifa-jobs',J);toast('ردیف «'+n+'» به پروندهٔ '+j.ref+' اضافه شد');return true}
function v16Svg(xs,S,o={}){const W=o.w||760,H=o.h||230,T=14,R=12,Bm=26,Lm=50;const all=[];S.forEach(s=>['v','lo','hi'].forEach(k=>(s[k]||[]).forEach(v=>{if(v!=null&&isFinite(v))all.push(v)})));if(!all.length)return '<div class="sx-muted v14-sm">داده‌ای برای نمودار نیست.</div>';
 let mx=Math.max(...all),mn=Math.min(0,...all);if(mx===mn)mx=mn+1;mx+=(mx-mn)*.06;const n=xs.length,X=i=>Lm+(W-Lm-R)*(n<2?.5:i/(n-1)),Y=v=>T+(H-T-Bm)*(1-(v-mn)/(mx-mn));
 let g='';for(let k=0;k<=4;k++){const v=mn+(mx-mn)*k/4,y=Y(v);g+=`<line x1="${Lm}" x2="${W-R}" y1="${y.toFixed(1)}" y2="${y.toFixed(1)}" class="gl"/><text x="${Lm-6}" y="${(y+3).toFixed(1)}" text-anchor="end">${nf(v,Math.abs(mx)<10?1:0)}</text>`}
 const st=Math.max(1,Math.ceil(n/12));xs.forEach((x,i)=>{if(i%st===0||i===n-1)g+=`<text x="${X(i).toFixed(1)}" y="${H-8}" text-anchor="middle">${esc(x)}</text>`});
 if(o.vx!=null)g+=`<line x1="${X(o.vx)}" x2="${X(o.vx)}" y1="${T}" y2="${H-Bm}" class="vx"/>`;
 S.forEach(s=>{if(s.lo&&s.hi){const idx=s.hi.map((v,i)=>v!=null&&s.lo[i]!=null?i:-1).filter(i=>i>=0);if(idx.length>1)g+=`<polygon points="${idx.map(i=>X(i).toFixed(1)+','+Y(s.hi[i]).toFixed(1)).join(' ')} ${idx.slice().reverse().map(i=>X(i).toFixed(1)+','+Y(s.lo[i]).toFixed(1)).join(' ')}" fill="${s.c}" opacity=".16"/>`}
  let d='',pen=false;s.v.forEach((v,i)=>{if(v==null||!isFinite(v)){pen=false;return}d+=(pen?'L':'M')+X(i).toFixed(1)+' '+Y(v).toFixed(1);pen=true});if(d)g+=`<path d="${d}" fill="none" stroke="${s.c}" stroke-width="2" ${s.d?'stroke-dasharray="5 4"':''}/>`;if(s.dots)s.v.forEach((v,i)=>{if(v!=null&&isFinite(v))g+=`<circle cx="${X(i).toFixed(1)}" cy="${Y(v).toFixed(1)}" r="2.4" fill="${s.c}"/>`})});
 const lg=S.filter(s=>s.n).map(s=>`<span><i style="background:${s.c}"></i>${esc(s.n)}</span>`).join('');
 return `<div class="v16-chw"><svg class="v16-ch" viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">${g}</svg>${lg?`<div class="v16-lgd">${lg}</div>`:''}</div>`}
function v16Bars(L,V,o={}){const W=o.w||640,H=o.h||170,Bm=24,T=14,Lm=6;const mx=Math.max(1,...V);const bw=(W-Lm*2)/Math.max(1,L.length);const st=Math.max(1,Math.ceil(L.length/24));
 return `<div class="v16-chw"><svg class="v16-ch" viewBox="0 0 ${W} ${H}">${V.map((v,i)=>{const h=(H-T-Bm)*v/mx;const x=Lm+i*bw;return `<rect x="${(x+1.5).toFixed(1)}" y="${(H-Bm-h).toFixed(1)}" width="${Math.max(2,bw-3).toFixed(1)}" height="${h.toFixed(1)}" rx="2" fill="${o.hl&&o.hl(i)?'#E0A84E':'#5E9FE8'}"/>${v&&bw>14?`<text x="${(x+bw/2).toFixed(1)}" y="${(H-Bm-h-3).toFixed(1)}" text-anchor="middle">${fa(v)}</text>`:''}${i%st===0?`<text x="${(x+bw/2).toFixed(1)}" y="${H-8}" text-anchor="middle">${esc(L[i])}</text>`:''}`}).join('')}</svg></div>`}
/* re-render helper: full redraw for selects/checkboxes, partial for typing */
const v16Bind=(root,S,sv,full,part)=>fwBind(root,S,(k,x)=>{sv();if(x.tagName==='SELECT'||x.type==='checkbox'||x.type==='date')setTimeout(()=>full(k));else part(k)});

/* ---------- 1. Rules of origin ---------- */
const ORA=[
 ['eaeu','تجارت آزاد ایران – اتحادیهٔ اقتصادی اوراسیا','FTA','RU,KZ,BY,AM,KG','موافقت‌نامهٔ موقت از ۱۳۹۸ (۲۰۱۹)؛ تجارت آزاد کامل از اردیبهشت ۱۴۰۴ (مه ۲۰۲۵)','cth_or_rvc',40,10,true,'گواهی مبدأ ویژهٔ موافقت‌نامه از مرجع مجاز کشور صادرکننده',12,'ترجیح فقط برای اقلام فهرست امتیازات است و قواعد ویژهٔ هر محصول (PSR) بر قاعدهٔ عمومی مقدم است.'],
 ['tr','تجارت ترجیحی ایران – ترکیه','PTA','TR','اجرا از دی ۱۳۹۳ (ژانویهٔ ۲۰۱۵)؛ فهرست محدود اقلام','rvc',40,0,false,'گواهی مبدأ ترجیحی موافقت‌نامه',12,'حمل مستقیم الزامی است؛ عبور از کشور ثالث با سند حمل سراسری پذیرفته می‌شود.'],
 ['pk','تجارت ترجیحی ایران – پاکستان','PTA','PK','اجرا از ۱۳۸۵ (۲۰۰۶)','rvc',40,0,false,'گواهی مبدأ ترجیحی',12,'فهرست اقلام مشمول محدود است.'],
 ['d8','تجارت ترجیحی کشورهای D-8','PTA','TR,PK,MY,ID,EG,NG,BD','اجرای محدود؛ اعضای فعال متفاوت‌اند','rvc',40,0,true,'گواهی مبدأ D-8',12,'انباشت مبدأ بین اعضا مجاز است.'],
 ['sy','تجارت آزاد ایران – سوریه','FTA','SY','وضعیت اجرایی را پیش از استفاده بررسی کنید','rvc',40,0,false,'گواهی مبدأ ترجیحی',12,''],
 ['gen','مبدأ غیرترجیحی (عمومی)','—','','برای ثبت سفارش، مجوزها، عوارض ضدّدامپینگ و آمار','cth',0,0,false,'گواهی مبدأ عمومی اتاق بازرگانی',12,'معیار «آخرین تغییر اساسی»؛ در عمل معمولاً تغییر سرفصل تعرفه.']];
const ORR={wo:'تولید کامل (WO)',cth:'تغییر سرفصل تعرفه (CTH، ۴ رقم)',ctsh:'تغییر زیرسرفصل (CTSH، ۶ رقم)',rvc:'حداقل ارزش افزودهٔ منطقه‌ای (RVC)',cth_or_rvc:'CTH یا RVC',cth_and_rvc:'CTH و RVC'};
const orA=k=>ORA.find(a=>a[0]===k)||ORA[0];
const orgDef=()=>({agr:'eaeu',dir:'exp',ex:'RU',hs:'39232100',goods:'کیسه و ساک پلی‌اتیلنی',exw:50000,cif:53000,mfn:10,pref:0,rule:'cth_or_rvc',rvc:40,dm:10,cum:true,mats:[{d:'گرانول پلی‌اتیلن',hs:'39011000',org:'IR',v:18000},{d:'مستربچ رنگ',hs:'32061100',org:'CN',v:4000},{d:'کارتن بسته‌بندی',hs:'48191000',org:'IR',v:1500}]});
function orgEval(S){const a=orA(S.agr);const mem=a[3]?a[3].split(','):[];const exp=S.dir==='exp'?'IR':(S.ex||mem[0]||'XX');const zone=new Set(S.cum&&mem.length?['IR',...mem]:[exp]);
 const ph=String(S.hs||'').replace(/\D/g,'');const exw=+S.exw||0;
 const M=(S.mats||[]).map(m=>{const v=+m.v||0;const h=String(m.hs||'').replace(/\D/g,'');const or=zone.has(m.org);return {...m,v,or,cth:or||(h.length>=4&&ph.length>=4&&h.slice(0,4)!==ph.slice(0,4)),ctsh:or||(h.length>=6&&ph.length>=6&&h.slice(0,6)!==ph.slice(0,6))}});
 const N=M.filter(m=>!m.or).reduce((s,m)=>s+m.v,0),O=M.filter(m=>m.or).reduce((s,m)=>s+m.v,0);const rvc=exw>0?(exw-N)/exw*100:0;
 const fC=M.filter(m=>!m.cth).reduce((s,m)=>s+m.v,0),fS=M.filter(m=>!m.ctsh).reduce((s,m)=>s+m.v,0);const dm=+S.dm||0;
 const okC=exw>0&&fC/exw*100<=dm+1e-9,okS=exw>0&&fS/exw*100<=dm+1e-9,okR=exw>0&&rvc>=(+S.rvc||0),okW=M.length>0&&N===0;
 const ok=!!({wo:okW,cth:okC,ctsh:okS,rvc:okR,cth_or_rvc:okC||okR,cth_and_rvc:okC&&okR})[S.rule];
 const warn=[];if(exw<=0)warn.push('بهای درب کارخانه (EXW) وارد نشده است.');if(M.some(m=>m.v>0&&String(m.hs||'').replace(/\D/g,'').length<4&&!m.or))warn.push('کد HS برخی مواد غیرمبدأ ناقص است؛ این مواد در آزمون تغییر طبقه «رد» حساب شده‌اند.');if(N+O>exw&&exw>0)warn.push('جمع ارزش مواد از بهای EXW بیشتر است.');if(S.agr!=='gen'&&S.dir==='imp'&&!mem.includes(S.ex))warn.push('کشور صادرکننده عضو این موافقت‌نامه نیست.');
 return {a,mem,exp,zone:[...zone],M,N,O,rvc,fC,fS,okC,okS,okR,okW,ok,save:ok?(+S.cif||0)*Math.max(0,(+S.mfn||0)-(+S.pref||0))/100:0,pot:(+S.cif||0)*Math.max(0,(+S.mfn||0)-(+S.pref||0))/100,need:Math.max(0,N-exw*(1-(+S.rvc||0)/100)),warn}}
function rOrg(b){subTabs(b,V16,'org',[['calc','محاسبه‌گر مبدأ'],['agr','موافقت‌نامه‌ها و قواعد'],['coo','دفتر گواهی مبدأ']],(v,B)=>({calc:orgCalc,agr:orgAgr,coo:orgCoo})[v](B))}
function orgCalc(B){const S=Object.assign(orgDef(),LSG('ifa-org',{}));const sv=()=>LSS('ifa-org',S);
 const res=()=>{const R=orgEval(S);const t=(ok,n,d)=>`<div class="fw-al ${ok?'ok':'bad'}">${ok?'✓':'✗'} ${n}${d?` <small>${d}</small>`:''}</div>`;
  return `<div class="ex-kpis">${kpT('نتیجه',R.ok?'واجد مبدأ':'فاقد شرایط',ORR[S.rule],R.ok?'':'warn')}${kpi('ارزش افزودهٔ منطقه‌ای',R.rvc,{d:1,suf:'٪',sub:'حداقل '+fa(S.rvc||0)+'٪'})}${kpi('مواد غیرمبدأ',R.N,{pre:'$',sub:fa(nf(S.exw?R.N/S.exw*100:0,1))+'٪ بهای EXW'})}${kpi('صرفه‌جویی حقوق ورودی',R.save,{pre:'$',sub:R.ok?'با گواهی مبدأ':'بالقوه '+usd0(R.pot)})}</div>
  <div class="sx-card"><header><b>آزمون‌ها</b><small>منطقهٔ مبدأ: ${R.zone.map(c=>CTN[c]||c).join('، ')}</small></header>
  ${t(R.okW,ORR.wo,R.okW?'':'مواد غیرمبدأ وجود دارد')}${t(R.okC,ORR.cth,'مواد ردشده '+usd0(R.fC)+' · حد قاعدهٔ جزئی (de minimis) '+fa(S.dm||0)+'٪')}${t(R.okS,ORR.ctsh,'مواد ردشده '+usd0(R.fS))}${t(R.okR,ORR.rvc,fa(nf(R.rvc,1))+'٪ (روش کسر: (EXW − مواد غیرمبدأ) ÷ EXW)')}
  ${!R.okR&&S.exw>0?`<div class="fw-al warn">برای رسیدن به RVC ${fa(S.rvc)}٪ باید ${usd0(R.need)} از مواد غیرمبدأ با مواد مبدأ جایگزین شود (یا بهای EXW افزایش یابد).</div>`:''}${R.warn.map(w=>`<div class="fw-al warn">${w}</div>`).join('')}
  <p class="sx-muted v14-sm">قاعدهٔ اعمال‌شده: <b>${ORR[S.rule]}</b>. پیش از صدور گواهی، قاعدهٔ ویژهٔ محصول (PSR) کد ${esc(S.hs)} را در پیوست موافقت‌نامه کنترل کنید.</p></div>`};
 const mt=()=>{const R=orgEval(S);return `<table class="sx-tbl v16-mt"><thead><tr><th>شرح ماده/قطعه</th><th>HS</th><th>مبدأ</th><th>ارزش $</th><th>مبدأ؟</th><th>CTH</th><th>CTSH</th><th></th></tr></thead><tbody>${R.M.map((m,i)=>`<tr data-i="${i}"><td><input data-c="d" value="${esc(m.d||'')}"></td><td><input data-c="hs" dir="ltr" value="${esc(m.hs||'')}"></td><td><select data-c="org">${Object.entries(CTN).map(([c,n])=>`<option value="${c}" ${c===m.org?'selected':''}>${n}</option>`).join('')}</select></td><td><input data-c="v" type="number" value="${m.v}"></td><td>${m.or?'<span class="v16-ok">✓</span>':'<span class="v16-no">✗</span>'}</td><td>${m.cth?'<span class="v16-ok">✓</span>':'<span class="v16-no">✗</span>'}</td><td>${m.ctsh?'<span class="v16-ok">✓</span>':'<span class="v16-no">✗</span>'}</td><td><button class="sx-btn xs" data-mx>×</button></td></tr>`).join('')}</tbody><tfoot><tr><td colspan="3">جمع مواد</td><td>${usd0(R.N+R.O)}</td><td colspan="4" class="sx-muted">مبدأ ${usd0(R.O)} · غیرمبدأ ${usd0(R.N)}</td></tr></tfoot></table>`};
 const draw=()=>{const a=orA(S.agr);const mem=a[3]?a[3].split(','):[];
  B.innerHTML=`<div class="v16-g2"><div class="v16-col"><div class="sx-card fw-form"><header><b>کالا و موافقت‌نامه</b><small>${esc(a[4])}</small></header><div class="fw-g">${fwI('موافقت‌نامه','agr',S.agr,{opts:ORA.map(x=>[x[0],x[1]]),cls:'w2'})}${fwI('جهت تجارت','dir',S.dir,{opts:[['exp','صادرات از ایران'],['imp','واردات به ایران']]})}${S.dir==='imp'&&mem.length?fwI('کشور صادرکننده','ex',S.ex,{opts:mem.map(c=>[c,CTN[c]||c])}):''}${fwI('کد HS محصول','hs',S.hs,{t:'text'})}${fwI('شرح محصول','goods',S.goods,{t:'text'})}${fwI('بهای درب کارخانه EXW ($)','exw',S.exw)}${fwI('ارزش گمرکی CIF ($)','cif',S.cif)}${fwI('حقوق ورودی عادی (MFN) ٪','mfn',S.mfn)}${fwI('حقوق ترجیحی ٪','pref',S.pref)}${fwI('قاعدهٔ مبدأ','rule',S.rule,{opts:Object.entries(ORR)})}${fwI('حداقل RVC ٪','rvc',S.rvc)}${fwI('قاعدهٔ جزئی (de minimis) ٪','dm',S.dm)}${fwI('انباشت مبدأ بین اعضا','cum',S.cum,{t:'checkbox'})}</div></div>
  <div class="sx-card"><header><b>صورت مواد (BOM)</b><small>مواد اولیه و قطعات با کشور مبدأ و ارزش</small><span class="sx-sp"></span><button class="sx-btn xs" data-ma>+ ماده</button></header><div class="v16-mtw">${mt()}</div></div></div>
  <div class="v16-col"><div class="v16-res">${res()}</div><div class="sx-card"><header><b>اقدام</b></header><div class="fw-bt"><button class="sx-btn sm pri" data-co>ثبت در دفتر گواهی مبدأ</button><button class="sx-btn sm" data-pr>چاپ برگهٔ محاسبهٔ مبدأ</button><button class="sx-btn sm" data-rs>بازنشانی نمونه</button></div><p class="sx-muted v14-sm">${esc(a[11]||'')}</p></div></div></div>`;
  const part=()=>{$('.v16-res',B).innerHTML=res();$('.v16-mtw',B).innerHTML=mt();bindM()};
  v16Bind($('.fw-form',B),S,sv,k=>{if(k==='agr'){const x=orA(S.agr);S.rule=x[5];S.rvc=x[6];S.dm=x[7];S.cum=x[8];const m=x[3]?x[3].split(','):[];if(m.length&&!m.includes(S.ex))S.ex=m[0];sv()}draw()},part);
  const bindM=()=>{$$('.v16-mt [data-c]',B).forEach(x=>x.onchange=()=>{const m=S.mats[+x.closest('tr').dataset.i];m[x.dataset.c]=x.type==='number'?+x.value:x.value;sv();setTimeout(part)});$$('.v16-mt [data-mx]',B).forEach(x=>x.onclick=()=>{S.mats.splice(+x.closest('tr').dataset.i,1);sv();setTimeout(part)})};bindM();
  $('[data-ma]',B).onclick=()=>{S.mats.push({d:'',hs:'',org:'XX',v:0});sv();part()};
  $('[data-rs]',B).onclick=()=>{Object.assign(S,orgDef());sv();draw()};
  $('[data-co]',B).onclick=()=>{const R=orgEval(S);const L=LSG('ifa-coo',[]);const {j}=v16Job();L.unshift({id:rgId(),job:j?j.ref:'',agr:S.agr,dir:S.dir,hs:S.hs,goods:S.goods,iss:S.dir==='exp'?'اتاق بازرگانی ایران':'مرجع کشور صادرکننده',no:'',date:fwToday(),valid:orA(S.agr)[10],st:'draft',val:+S.cif||0,res:(R.ok?'واجد مبدأ':'فاقد شرایط')+' · '+ORR[S.rule]+' · RVC '+nf(R.rvc,1)+'٪',note:''});LSS('ifa-coo',L);toast('در دفتر گواهی مبدأ ثبت شد');V16.org='coo';rOrg(B.closest('.tm').parentElement)};
  $('[data-pr]',B).onclick=()=>{const R=orgEval(S);openDoc(`<div class="page"><h1>برگهٔ محاسبهٔ مبدأ کالا</h1><p>${esc(S.goods)} · HS <b dir="ltr">${esc(S.hs)}</b> · ${esc(orA(S.agr)[1])} · ${S.dir==='exp'?'صادرات از ایران':'واردات از '+esc(CTN[S.ex]||S.ex)}</p><p>قاعده: <b>${ORR[S.rule]}</b> · نتیجه: <b>${R.ok?'واجد مبدأ':'فاقد شرایط'}</b> · RVC: ${fa(nf(R.rvc,1))}٪ · EXW: ${usd0(S.exw)}</p><table><tr><th>ماده</th><th>HS</th><th>مبدأ</th><th>ارزش</th><th>مبدأ؟</th><th>CTH</th></tr>${R.M.map(m=>`<tr><td>${esc(m.d)}</td><td>${esc(m.hs)}</td><td>${esc(CTN[m.org]||m.org)}</td><td>${usd0(m.v)}</td><td>${m.or?'✓':'✗'}</td><td>${m.cth?'✓':'✗'}</td></tr>`).join('')}</table><p>صرفه‌جویی حقوق ورودی: ${usd0(R.save)}</p><p><small>این برگه راهنماست؛ متن رسمی موافقت‌نامه و نظر مرجع صدور گواهی ملاک است.</small></p></div>`,'محاسبهٔ مبدأ')}};
 draw()}
function orgAgr(B){B.innerHTML=`<div class="sx-card v16-nt"><b>راهنما:</b> این خلاصه‌ها برای برآورد اولیه است. فهرست کالاهای مشمول (فهرست امتیازات)، قواعد ویژهٔ هر محصول و نرخ ترجیحی را از متن رسمی موافقت‌نامه و سامانهٔ گمرک کنترل کنید.</div>
 <div class="v16-ag">${ORA.map(a=>`<div class="sx-card"><header><b>${esc(a[1])}</b><small>${a[2]}</small></header><div class="v16-r2"><span>اعضا</span><b>${a[3]?a[3].split(',').map(c=>`<i class="v16-ch2">${CTN[c]||c}</i>`).join(''):'همهٔ کشورها'}</b></div><div class="v16-r2"><span>وضعیت</span><b>${esc(a[4])}</b></div><div class="v16-r2"><span>قاعدهٔ عمومی</span><b>${ORR[a[5]]}${a[6]?' · RVC '+fa(a[6])+'٪':''}${a[7]?' · de minimis '+fa(a[7])+'٪':''}</b></div><div class="v16-r2"><span>انباشت</span><b>${a[8]?'بین اعضا مجاز':'دوجانبه'}</b></div><div class="v16-r2"><span>گواهی</span><b>${esc(a[9])} · اعتبار ${fa(a[10])} ماه</b></div>${a[11]?`<p class="sx-muted v14-sm">${esc(a[11])}</p>`:''}</div>`).join('')}</div>
 <div class="sx-card"><header><b>مفاهیم و چک‌لیست</b></header><div class="v16-ag">${[['تولید کامل (WO)','کالای استخراج، کشت یا صیدشده در کشور مبدأ، بدون هیچ مادهٔ غیرمبدأ.'],['تغییر طبقهٔ تعرفه (CTH/CTSH)','هر مادهٔ غیرمبدأ باید در سرفصل (۴ رقم) یا زیرسرفصل (۶ رقم) متفاوتی از محصول نهایی طبقه‌بندی شود.'],['ارزش افزودهٔ منطقه‌ای (RVC)','سهم ارزش مبدأ از بهای درب کارخانه؛ روش کسر: (EXW − مواد غیرمبدأ) ÷ EXW.'],['قاعدهٔ جزئی (de minimis)','درصد کوچکی از مواد غیرمبدأ که در آزمون تغییر طبقه نادیده گرفته می‌شود.'],['انباشت مبدأ','مواد مبدأ کشورهای عضو دیگر، مادهٔ مبدأ محسوب می‌شود.'],['عملیات ناکافی','بسته‌بندی، برچسب‌زنی، تفکیک، رقیق‌سازی و مونتاژ ساده مبدأ ایجاد نمی‌کند.'],['حمل مستقیم','کالا نباید در کشور ثالث وارد چرخهٔ تجارت شود؛ سند حمل سراسری نگه دارید.'],['مدارک','فاکتور، صورت مواد، فاکتورهای خرید مواد، گواهی تولید/پروانهٔ بهره‌برداری، سند حمل، درخواست گواهی.']].map(([h,t])=>`<div class="v16-cn"><b>${h}</b><p>${t}</p></div>`).join('')}</div></div>`}
const COOST=[['draft','پیش‌نویس'],['app','درخواست ثبت شد'],['iss','صادر شد'],['rej','رد شد'],['used','استفاده شد']];
function orgCoo(B){rgUI(B,{key:'ifa-coo',title:'دفتر گواهی‌های مبدأ',sub:'درخواست، صدور، انقضا و استفادهٔ گواهی مبدأ هر پرونده',addL:'گواهی جدید',
 def:()=>({job:(v16Job().j||{}).ref||'',agr:'eaeu',dir:'exp',hs:'',goods:'',iss:'اتاق بازرگانی ایران',no:'',date:fwToday(),valid:12,st:'draft',val:0,res:'',note:''}),
 fields:[['job','پرونده','',jobO()],['agr','موافقت‌نامه','',ORA.map(a=>[a[0],a[1]])],['dir','جهت','',[['exp','صادرات'],['imp','واردات']]],['hs','کد HS'],['goods','شرح کالا'],['iss','مرجع صدور'],['no','شمارهٔ گواهی'],['date','تاریخ صدور/درخواست','d'],['valid','اعتبار (ماه)','n'],['st','وضعیت','',COOST],['val','ارزش کالا ($)','n'],['res','نتیجهٔ محاسبه'],['note','یادداشت','l']],
 cols:[['پرونده',r=>esc(r.job||'—')],['موافقت‌نامه',r=>esc(orA(r.agr)[1])],['کالا',r=>esc(r.goods||'')+(r.hs?` <small dir="ltr">${esc(r.hs)}</small>`:'')],['شماره',r=>esc(r.no||'—')],['تاریخ',r=>r.date?jdt(r.date):'—'],['انقضا',r=>{if(!r.date)return '—';const e=fwAdd(r.date,Math.round((+r.valid||12)*30.4));const d=dleft(e);return `${jdt(e)} ${r.st==='iss'?`<span class="v14-c ${d<0?'bad':d<30?'warn':'ok'}">${d<0?'منقضی':fa(d)+' روز'}</span>`:''}`}],['وضعیت',r=>`<span class="v14-c ${r.st==='iss'?'ok':r.st==='rej'?'bad':''}">${(COOST.find(x=>x[0]===r.st)||COOST[0])[1]}</span>`],['نتیجه',r=>`<small>${esc(r.res||'')}</small>`]],
 kpis:L=>{const iss=L.filter(r=>r.st==='iss');const ex=iss.filter(r=>r.date&&dleft(fwAdd(r.date,Math.round((+r.valid||12)*30.4)))<30).length;return kpi('گواهی‌ها',L.length)+kpi('صادرشده و معتبر',iss.length)+kpi('در انتظار',L.filter(r=>['draft','app'].includes(r.st)).length)+kpi('رو به انقضا',ex,{sub:'کمتر از ۳۰ روز',cls:ex?'warn':''})}})}

/* ---------- 2. Rail wagons ---------- */
const RWT=[['fp80','سکوی کانتینربر ۸۰ فوتی',22,69,25.6,0,4],['fp60','سکوی کانتینربر ۶۰ فوتی',20,64,19.6,0,3],['fp40','سکوی کانتینربر ۴۰ فوتی',15,50,14.6,0,2],['gon','لبه‌بلند (گوندولا)',24,69,13.9,76,0],['box','مسقف',24,68,17,120,0],['hop','هاپر فله',23,70,14.7,95,0],['tank','مخزن‌دار',25,66,12,73,0],['plat','لبه‌کوتاه / تخت',22,66,14.6,0,0]];
const rwT=k=>RWT.find(x=>x[0]===k)||RWT[0];
const RRT=[['cn','چین ← قزاقستان ← ترکمنستان ← سرخس ← تهران',950,5400,2,16,'تعویض خط در دوستیک/خورگس (۱۴۳۵←۱۵۲۰) و سرخس (۱۵۲۰←۱۴۳۵، تعویض بوژی یا جابه‌جایی بار)'],['tm','ترکمنستان (سرخس) ← تهران',920,0,1,4,'تعویض بوژی یا جابه‌جایی در سرخس'],['ru','روسیه ← قزاقستان ← ترکمنستان ← اینچه‌برون ← بندرعباس (کریدور شمال–جنوب شرقی)',1700,3200,1,12,'جابه‌جایی یا تعویض بوژی در اینچه‌برون/گرگان'],['az','روسیه ← آذربایجان ← آستارا ← قزوین (کریدور شمال–جنوب غربی)',450,1800,1,9,'جابه‌جایی در آستارا؛ خط رشت–آستارا هنوز تکمیل نشده و این بخش با کامیون حمل می‌شود'],['tr','ترکیه ← رازی ← تهران',1000,2200,0,8,'عرض خط یکسان (۱۴۳۵)؛ کشتی قطاربر دریاچهٔ وان در مسیر ترکیه']];
const railDef=()=>({mode:'ctr',wt:'fp80',ctrs:[{t:'40',n:10,kg:26000},{t:'20',n:6,kg:24000}],bt:'hop',tons:3000,dens:1.4,ax:23.5,axn:4,maxW:57});
function railPack(S){const w=rwT(S.wt);const cap=w[6]||4;const C=[];(S.ctrs||[]).forEach(c=>{for(let i=0;i<Math.min(2000,+c.n||0);i++)C.push({t:c.t,kg:+c.kg||0,teu:c.t==='20'?1:2})});C.sort((a,b)=>b.teu-a.teu||b.kg-a.kg);
 const lim=Math.min(w[3]*1000,(+S.ax||23.5)*1000*(+S.axn||4)-w[2]*1000);const W=[];let over=0;
 C.forEach(c=>{if(c.kg>lim)over++;let x=W.find(v=>v.teu+c.teu<=cap&&v.kg+c.kg<=lim);if(!x){x={teu:0,kg:0,c:[]};W.push(x)}x.teu+=c.teu;x.kg+=c.kg;x.c.push(c)});
 const teu=C.reduce((s,c)=>s+c.teu,0),kg=C.reduce((s,c)=>s+c.kg,0);return {w,W,n:W.length,cap,lim,teu,kg,over,cn:C.length,util:W.length?teu/(W.length*cap):0,trains:Math.ceil(W.length/(+S.maxW||57)),len:W.length*w[4],axl:W.length?Math.max(...W.map(v=>(v.kg/1000+w[2])/(+S.axn||4))):0}}
function railBulk(S){const w=rwT(S.bt);const axCap=(+S.ax||23.5)*(+S.axn||4)-w[2];const byV=w[5]?w[5]*(+S.dens||1):Infinity;const per=Math.max(0.1,Math.min(w[3],axCap,byV));const n=Math.ceil((+S.tons||0)/per);return {w,per,n,byV,axCap,trains:Math.ceil(n/(+S.maxW||57)),len:n*w[4],lim:per===byV?'حجم واگن':per===axCap?'حد بار محوری':'ظرفیت اسمی واگن'}}
function rRail(b){subTabs(b,V16,'rail',[['pl','برنامه‌ریزی واگن'],['tf','هزینه، تعویض خط و توقف'],['wg','دفتر واگن‌ها']],(v,B)=>({pl:railPl,tf:railTf,wg:railWg})[v](B))}
function railPl(B){const S=Object.assign(railDef(),LSG('ifa-rail',{}));const sv=()=>LSS('ifa-rail',S);
 const res=()=>{if(S.mode==='ctr'){const P=railPack(S);return `<div class="ex-kpis">${kpi('واگن لازم',P.n,{sub:esc(P.w[1])})}${kpi('کانتینر',P.cn,{sub:fa(P.teu)+' TEU'})}${kpi('بهره‌وری ظرفیت',P.util*100,{d:0,suf:'٪'})}${kpi('قطار',P.trains,{sub:'حداکثر '+fa(S.maxW)+' واگن'})}${kpi('بیشینهٔ بار محوری',P.axl,{d:1,suf:' t',cls:P.axl>(+S.ax||23.5)?'warn':''})}</div>
  ${P.over?`<div class="fw-al bad">${fa(P.over)} کانتینر از حد بار مجاز یک واگن (${fa(nf(P.lim/1000,1))} تن) سنگین‌تر است.</div>`:''}${!P.w[6]?'<div class="fw-al warn">نوع واگن انتخابی کانتینربر نیست؛ ظرفیت ۴ TEU فرض شد.</div>':''}
  <div class="sx-card"><header><b>چیدمان روی واگن‌ها</b><small>طول قطار (بدون لکوموتیو) ≈ ${fa(nf(P.len,0))} متر</small></header><div class="v16-wgs">${P.W.slice(0,120).map((v,i)=>`<div class="v16-wg" title="واگن ${fa(i+1)}: ${fa(nf(v.kg/1000,1))} تن"><div class="v16-sl">${v.c.map(c=>`<span class="t${c.t}" style="flex:${c.teu}">${c.t}'</span>`).join('')}${v.teu<P.cap?`<span class="e" style="flex:${P.cap-v.teu}"></span>`:''}</div><small>${fa(i+1)} · ${fa(nf(v.kg/1000,1))}t</small></div>`).join('')}${P.W.length>120?`<div class="sx-muted">… و ${fa(P.W.length-120)} واگن دیگر</div>`:''}</div></div>`}
  const R=railBulk(S);return `<div class="ex-kpis">${kpi('واگن لازم',R.n,{sub:esc(R.w[1])})}${kpi('بار هر واگن',R.per,{d:1,suf:' t',sub:'محدودیت: '+R.lim})}${kpi('قطار',R.trains)}${kpi('طول قطار',R.len,{suf:' m'})}</div>${R.w[5]?'':'<div class="fw-al warn">برای این نوع واگن حجم تعریف نشده؛ فقط وزن کنترل شد.</div>'}`};
 const ct=()=>`<table class="sx-tbl v16-mt"><thead><tr><th>نوع</th><th>تعداد</th><th>وزن ناخالص هر کانتینر kg</th><th></th></tr></thead><tbody>${S.ctrs.map((c,i)=>`<tr data-i="${i}"><td><select data-c="t"><option value="20" ${c.t==='20'?'selected':''}>20'</option><option value="40" ${c.t==='40'?'selected':''}>40'</option><option value="45" ${c.t==='45'?'selected':''}>45'</option></select></td><td><input type="number" data-c="n" value="${c.n}"></td><td><input type="number" data-c="kg" value="${c.kg}"></td><td><button class="sx-btn xs" data-cx>×</button></td></tr>`).join('')}</tbody></table>`;
 const draw=()=>{B.innerHTML=`<div class="v16-g2"><div class="v16-col"><div class="sx-card fw-form"><header><b>نوع بار و واگن</b></header><div class="fw-g">${fwI('نوع بار','mode',S.mode,{opts:[['ctr','کانتینری'],['bulk','فله / عمومی']]})}${S.mode==='ctr'?fwI('نوع واگن','wt',S.wt,{opts:RWT.filter(x=>x[6]).map(x=>[x[0],x[1]])}):fwI('نوع واگن','bt',S.bt,{opts:RWT.filter(x=>!x[6]).map(x=>[x[0],x[1]])})}${S.mode==='bulk'?fwI('وزن کل بار (تن)','tons',S.tons)+fwI('چگالی بار (تن/m³)','dens',S.dens,{step:'0.1'}):''}${fwI('حد بار محوری (تن)','ax',S.ax,{step:'0.5'})}${fwI('تعداد محور هر واگن','axn',S.axn)}${fwI('حداکثر واگن در هر قطار','maxW',S.maxW)}</div></div>
  ${S.mode==='ctr'?`<div class="sx-card"><header><b>کانتینرها</b><span class="sx-sp"></span><button class="sx-btn xs" data-ca>+ ردیف</button><button class="sx-btn xs" data-cl>از پروندهٔ چیدمان</button></header>${ct()}</div>`:''}
  <div class="sx-card"><header><b>مشخصات واگن‌ها</b><small>مقادیر نمونه برای خط ۱۵۲۰/۱۴۳۵ میلی‌متر</small></header><div class="v16-mtw"><table class="sx-tbl"><thead><tr><th>نوع</th><th>وزن خالی t</th><th>ظرفیت t</th><th>طول m</th><th>حجم m³</th><th>TEU</th></tr></thead><tbody>${RWT.map(w=>`<tr><td>${w[1]}</td><td>${fa(w[2])}</td><td>${fa(w[3])}</td><td>${fa(w[4])}</td><td>${w[5]?fa(w[5]):'—'}</td><td>${w[6]?fa(w[6]):'—'}</td></tr>`).join('')}</tbody></table></div></div></div>
  <div class="v16-col v16-res">${res()}</div></div>`;
  const part=()=>{$('.v16-res',B).innerHTML=res()};v16Bind($('.fw-form',B),S,sv,draw,part);
  $$('.v16-mt [data-c]',B).forEach(x=>x.onchange=()=>{const c=S.ctrs[+x.closest('tr').dataset.i];c[x.dataset.c]=x.tagName==='SELECT'?x.value:+x.value;sv();part()});
  $$('.v16-mt [data-cx]',B).forEach(x=>x.onclick=()=>{S.ctrs.splice(+x.closest('tr').dataset.i,1);sv();setTimeout(draw)});
  const ca=$('[data-ca]',B);if(ca)ca.onclick=()=>{S.ctrs.push({t:'40',n:1,kg:20000});sv();draw()};
  const cl=$('[data-cl]',B);if(cl)cl.onclick=()=>{const X=ctx();const C=(X&&X.cargo)||{};const kg=+C.weightKg||0;if(!kg){toast('بار پرونده مشخص نیست');return}const eq=String(C.containerType||'40HC');const n=Math.max(1,Math.ceil(kg/(eq.startsWith('20')?21000:26000)));S.ctrs=[{t:eq.startsWith('20')?'20':'40',n,kg:Math.round(kg/n+(eq.startsWith('20')?2300:3800))}];sv();draw()}};
 draw()}
const rtDef=()=>({rt:'cn',kmI:950,kmF:5400,rI:0.9,rF:1.1,gc:2,gcF:350,rent:25,days:16,free:48,idle:72,dem:30,wag:0});
function railTf(B){const S=Object.assign(rtDef(),LSG('ifa-rail-t',{}));const sv=()=>LSS('ifa-rail-t',S);
 const calc=()=>{const P=LSG('ifa-rail',{});const pk=P.mode==='bulk'?railBulk(Object.assign(railDef(),P)):railPack(Object.assign(railDef(),P));const n=+S.wag||pk.n||1;const per={iran:S.kmI*S.rI,frg:S.kmF*S.rF,gc:S.gc*S.gcF,rent:S.rent*S.days,dem:Math.ceil(Math.max(0,S.idle-S.free)/24)*S.dem};const one=Object.values(per).reduce((a,b)=>a+b,0);return {n,per,one,tot:one*n,teu:pk.teu||0,tons:P.mode==='bulk'?(+P.tons||0):(pk.kg||0)/1000}};
 const res=()=>{const R=calc();const rows=[['کرایهٔ بخش ایران',R.per.iran],['کرایهٔ بخش خارجی',R.per.frg],['تعویض خط / جابه‌جایی',R.per.gc],['اجارهٔ واگن در سفر',R.per.rent],['توقف اضافه (دموراژ واگن)',R.per.dem]];return `<div class="ex-kpis">${kpi('هزینهٔ کل',R.tot,{pre:'$',sub:fa(R.n)+' واگن'})}${kpi('هر واگن',R.one,{pre:'$'})}${R.teu?kpi('هر TEU',R.tot/R.teu,{pre:'$'}):''}${R.tons?kpi('هر تن',R.tot/R.tons,{pre:'$',d:1}):''}${kpi('زمان سفر',S.days,{suf:' روز'})}</div>
  <div class="sx-card"><header><b>اجزای هزینهٔ هر واگن</b></header><table class="sx-tbl"><tbody>${rows.map(([n,v])=>`<tr><td>${n}</td><td>${usd0(v)}</td><td><div class="v16-bar"><i style="width:${R.one?v/R.one*100:0}%"></i></div></td></tr>`).join('')}<tr><th>جمع</th><th>${usd0(R.one)}</th><th></th></tr></tbody></table><div class="fw-bt"><button class="sx-btn sm pri" data-aj>افزودن به پروندهٔ جاری</button></div></div>`};
 const draw=()=>{const r=RRT.find(x=>x[0]===S.rt)||RRT[0];B.innerHTML=`<div class="v16-g2"><div class="v16-col"><div class="sx-card fw-form"><header><b>مسیر ریلی و نرخ‌ها</b><small>نرخ‌ها نمونه‌اند؛ با تعرفهٔ روز راه‌آهن و اپراتور جایگزین کنید</small></header><div class="fw-g">${fwI('مسیر','rt',S.rt,{opts:RRT.map(x=>[x[0],x[1]]),cls:'w2'})}${fwI('تعداد واگن (۰ = از برنامه‌ریزی)','wag',S.wag)}${fwI('مسافت در ایران km','kmI',S.kmI)}${fwI('مسافت خارج km','kmF',S.kmF)}${fwI('نرخ ایران $/واگن-km','rI',S.rI,{step:'0.05'})}${fwI('نرخ خارجی $/واگن-km','rF',S.rF,{step:'0.05'})}${fwI('دفعات تعویض خط','gc',S.gc)}${fwI('هزینهٔ هر تعویض $/واگن','gcF',S.gcF)}${fwI('اجارهٔ واگن $/روز','rent',S.rent)}${fwI('روزهای سفر','days',S.days)}${fwI('زمان آزاد تخلیه (ساعت)','free',S.free)}${fwI('توقف واقعی (ساعت)','idle',S.idle)}${fwI('دموراژ واگن $/روز','dem',S.dem)}</div><div class="fw-al warn">${esc(r[6])}</div></div></div><div class="v16-col v16-res">${res()}</div></div>`;
  const bindA=()=>{const a=$('[data-aj]',B);if(a)a.onclick=()=>{const R=calc();v16AddLine('حمل ریلی — '+fa(R.n)+' واگن',R.tot)}};
  v16Bind($('.fw-form',B),S,sv,k=>{if(k==='rt'){const x=RRT.find(y=>y[0]===S.rt);if(x){S.kmI=x[2];S.kmF=x[3];S.gc=x[4];S.days=x[5]}sv()}draw()},()=>{$('.v16-res',B).innerHTML=res();bindA()});bindA()};
 draw()}
function uicOk(s){const d=String(s||'').replace(/\D/g,'');if(d.length!==12)return {ok:false,m:'شمارهٔ UIC باید ۱۲ رقم باشد'};let sum=0;for(let i=0;i<11;i++){const p=+d[i]*(i%2===0?2:1);sum+=p>9?p-9:p}const c=(10-sum%10)%10;return {ok:c===+d[11],c,m:c===+d[11]?'رقم کنترل درست است':'رقم کنترل باید '+c+' باشد'}}
const WGS=[['emp','خالی آمادهٔ بارگیری'],['ld','در حال بارگیری'],['full','بارگیری‌شده'],['tr','در مسیر'],['gc','تعویض خط / مرز'],['arr','رسیده به مقصد'],['unl','تخلیه‌شده'],['ret','عودت‌شده']];
const wgIdle=r=>{if(!r.arr)return 0;const e=r.unl?Date.parse(r.unl):Date.now();return Math.max(0,(e-Date.parse(r.arr))/36e5)};
const wgDem=r=>Math.ceil(Math.max(0,wgIdle(r)-(+r.free||0))/24)*(+r.rate||0);
function railWg(B){rgUI(B,{key:'ifa-wag',title:'دفتر واگن‌ها',sub:'وضعیت هر واگن، ایستگاه فعلی، کنترل شمارهٔ UIC و دموراژ توقف',addL:'واگن جدید',
 def:()=>({no:'',type:'fp80',job:(v16Job().j||{}).ref||'',from:'',to:'',st:'emp',stn:'',ld:fwToday(),kg:0,arr:'',unl:'',free:48,rate:30,note:''}),
 fields:[['no','شمارهٔ واگن (UIC ۱۲ رقمی)'],['type','نوع','',RWT.map(w=>[w[0],w[1]])],['job','پرونده','',jobO()],['from','ایستگاه مبدأ'],['to','ایستگاه مقصد'],['st','وضعیت','',WGS],['stn','ایستگاه/موقعیت فعلی'],['ld','تاریخ بارگیری','d'],['kg','وزن بار kg','n'],['arr','رسیدن به محل تخلیه','datetime-local'],['unl','پایان تخلیه','datetime-local'],['free','زمان آزاد (ساعت)','n'],['rate','دموراژ $/روز','n'],['note','یادداشت','l']],
 cols:[['واگن',r=>{const u=uicOk(r.no);return `<span dir="ltr">${esc(r.no||'—')}</span> ${r.no?`<span class="v14-c ${u.ok?'ok':'bad'}" title="${u.m}">${u.ok?'UIC ✓':'UIC ✗'}</span>`:''}`}],['نوع',r=>esc(rwT(r.type)[1])],['پرونده',r=>esc(r.job||'—')],['مسیر',r=>esc((r.from||'—')+' ← '+(r.to||'—'))],['وضعیت',r=>`<span class="v14-c ${['arr','unl'].includes(r.st)?'ok':r.st==='gc'?'warn':''}">${(WGS.find(x=>x[0]===r.st)||WGS[0])[1]}</span>`],['موقعیت',r=>esc(r.stn||'—')],['بار',r=>r.kg?fa(nf(r.kg/1000,1))+' t':'—'],['توقف / دموراژ',r=>{const h=wgIdle(r);if(!h)return '—';const d=wgDem(r);return `${fa(Math.round(h))} ساعت ${d?`<span class="v14-c bad">${usd0(d)}</span>`:'<span class="v14-c ok">در زمان آزاد</span>'}`}]],
 after:r=>{const u=uicOk(r.no);return r.no?`<div class="fw-al ${u.ok?'ok':'bad'}">${u.m}</div>`:''},
 kpis:L=>{const d=L.reduce((a,r)=>a+wgDem(r),0);return kpi('واگن‌ها',L.length)+kpi('در مسیر',L.filter(r=>['tr','gc','full'].includes(r.st)).length)+kpi('در انتظار تخلیه',L.filter(r=>r.st==='arr').length)+kpi('دموراژ انباشته',d,{pre:'$',cls:d?'warn':''})+kpi('خطای شمارهٔ UIC',L.filter(r=>r.no&&!uicOk(r.no).ok).length)}})}

/* ---------- 3. Warehouse & VAS ---------- */
const whCfg=()=>Object.assign({name:'انبار مرکزی',cap:2000,palCap:800,meth:'cbm',rC:0.5,rP:1.2,free:5,min:10,cp:60},LSG('ifa-wh-cfg',{}));
const whMv=()=>LSG('ifa-whm',[]);
const whBal=(id,d,M)=>(M||whMv()).filter(m=>m.item===id&&(!d||m.d<=d)).reduce((s,m)=>s+(m.ty==='in'?1:-1)*(+m.qty||0),0);
function rWh(b){subTabs(b,V16,'wh',[['inv','موجودی و جابه‌جایی'],['bill','صورتحساب انبارداری'],['vas','خدمات ارزش افزوده']],(v,B)=>({inv:whInv,bill:whBill,vas:whVas})[v](B))}
function whInv(B){const K=whCfg();rgUI(B,{key:'ifa-whi',title:'موجودی انبار',sub:'هر ردیف یک کالا (SKU) با محل، مشتری و پرونده؛ موجودی از ورود و خروج‌ها محاسبه می‌شود',addL:'کالای جدید',
 def:()=>({sku:'SKU-'+String(LSG('ifa-whi',[]).length+1).padStart(4,'0'),dsc:'',cust:'',job:(v16Job().j||{}).ref||'',loc:'A-01-01',unit:'کارتن',cbmU:0.05,upp:40,inD:fwToday(),bond:false,note:''}),
 fields:[['sku','کد کالا (SKU)'],['dsc','شرح'],['cust','مشتری'],['job','پرونده','',jobO()],['loc','محل (ردیف-قفسه-طبقه)'],['unit','واحد'],['cbmU','حجم هر واحد m³','n'],['upp','واحد در هر پالت','n'],['inD','تاریخ ورود','d'],['bond','انبار امانی / تحت نظارت گمرک','c'],['note','یادداشت','l']],
 cols:[['SKU',r=>`<b dir="ltr">${esc(r.sku)}</b>`],['شرح',r=>esc(r.dsc||'')],['مشتری',r=>esc(r.cust||'—')],['پرونده',r=>esc(r.job||'—')],['محل',r=>`<span dir="ltr">${esc(r.loc||'')}</span>`],['موجودی',r=>{const b=whBal(r.id);return `<b>${fa(nf(b))}</b> ${esc(r.unit||'')}`}],['حجم m³',r=>fa(nf(whBal(r.id)*(+r.cbmU||0),1))],['پالت',r=>fa(Math.ceil(whBal(r.id)/Math.max(1,+r.upp||1)))],['ماندگاری',r=>{const d=r.inD?-dleft(r.inD):0;return `${fa(d)} روز${d>90?' <span class="v14-c warn">راکد</span>':''}`}],['',r=>r.bond?'<span class="v14-c">گمرکی</span>':'']],
 kpis:L=>{const M=whMv();const v=L.reduce((a,r)=>a+whBal(r.id,null,M)*(+r.cbmU||0),0),p=L.reduce((a,r)=>a+Math.ceil(whBal(r.id,null,M)/Math.max(1,+r.upp||1)),0);return kpi('اقلام',L.length)+kpi('حجم اشغال',v,{d:1,suf:' m³',sub:fa(nf(K.cap?v/K.cap*100:0,0))+'٪ ظرفیت '+fa(K.cap)+' m³',cls:v>K.cap*.9?'warn':''})+kpi('پالت',p,{sub:'ظرفیت '+fa(K.palCap)})+kpi('راکد بیش از ۹۰ روز',L.filter(r=>r.inD&&-dleft(r.inD)>90&&whBal(r.id,null,M)>0).length)},
 after:r=>{const M=whMv().filter(m=>m.item===r.id).sort((a,b)=>a.d<b.d?-1:1);let run=0;return `<div class="sx-card v16-mv"><header><b>ورود و خروج</b><small>موجودی فعلی ${fa(nf(whBal(r.id)))} ${esc(r.unit||'')}</small></header><div class="v16-tk"><select class="v14-in wm-t"><option value="in">ورود (رسید)</option><option value="out">خروج (حواله)</option></select><input type="number" class="v14-in wm-q" placeholder="مقدار"><input type="date" class="v14-in wm-d" value="${fwToday()}"><input class="v14-in wm-r" placeholder="شمارهٔ رسید/حواله"><button class="sx-btn xs pri" data-mv>ثبت</button></div><table class="sx-tbl"><thead><tr><th>تاریخ</th><th>نوع</th><th>مقدار</th><th>مانده</th><th>مرجع</th><th></th></tr></thead><tbody>${M.map(m=>{run+=(m.ty==='in'?1:-1)*(+m.qty||0);return `<tr><td>${jdt(m.d)}</td><td>${m.ty==='in'?'ورود':'خروج'}</td><td>${fa(nf(m.qty))}</td><td>${fa(nf(run))}</td><td>${esc(m.ref||'')}</td><td><button class="sx-btn xs" data-mx="${m.id}">×</button></td></tr>`}).join('')||'<tr><td colspan="6" class="sx-muted">هنوز جابه‌جایی ثبت نشده.</td></tr>'}</tbody></table></div>`},
 bindAfter:(E,r,sv,draw)=>{const a=$('[data-mv]',E);if(a)a.onclick=()=>{const q=+$('.wm-q',E).value;const ty=$('.wm-t',E).value;if(!(q>0)){toast('مقدار را وارد کنید');return}if(ty==='out'&&q>whBal(r.id)){toast('مقدار خروج بیش از موجودی است');return}const M=whMv();M.push({id:rgId(),item:r.id,ty,qty:q,d:$('.wm-d',E).value||fwToday(),ref:$('.wm-r',E).value});LSS('ifa-whm',M);draw()};$$('[data-mx]',E).forEach(x=>x.onclick=()=>{LSS('ifa-whm',whMv().filter(m=>m.id!==x.dataset.mx));draw()})}})}
function whCalc(S,K){const I=LSG('ifa-whi',[]).filter(r=>!S.cust||r.cust===S.cust);const M=whMv();const out=[];const from=S.from,to=S.to;const n=Math.max(0,fwDiff(from,to))+1;
 I.forEach(r=>{let ud=0,cd=0,ch=0;const mv=M.filter(m=>m.item===r.id);if(!mv.length)return;for(let k=0;k<n&&k<800;k++){const d=fwAdd(from,k);const b=mv.filter(m=>m.d<=d).reduce((s,m)=>s+(m.ty==='in'?1:-1)*(+m.qty||0),0);if(b<=0)continue;const u=K.meth==='cbm'?b*(+r.cbmU||0):Math.ceil(b/Math.max(1,+r.upp||1));ud+=u;const age=r.inD?fwDiff(r.inD,d):99;if(age>=(+K.free||0)){cd+=u;ch+=u*(K.meth==='cbm'?K.rC:K.rP)}}if(ud)out.push({r,ud,cd,ch})});
 const C={};out.forEach(x=>{const c=x.r.cust||'بدون مشتری';(C[c]=C[c]||{c,rows:[],t:0}).rows.push(x);C[c].t+=x.ch});Object.values(C).forEach(c=>{c.minA=Math.max(0,(+K.min||0)-c.t);c.t+=c.minA});return Object.values(C)}
function whBill(B){const K=whCfg();const S=Object.assign({from:fwToday().slice(0,8)+'01',to:fwToday(),cust:''},LSG('ifa-whb',{}));const sv=()=>LSS('ifa-whb',S);const svK=()=>LSS('ifa-wh-cfg',K);
 const custs=[...new Set(LSG('ifa-whi',[]).map(r=>r.cust).filter(Boolean))];
 const res=()=>{const C=whCalc(S,K);const T=C.reduce((a,c)=>a+c.t,0);const un=K.meth==='cbm'?'m³-روز':'پالت-روز';return `<div class="ex-kpis">${kpi('مبلغ دوره',T,{pre:'$',d:0})}${kpi('مشتریان',C.length)}${kpi('واحد-روز مشمول',C.reduce((a,c)=>a+c.rows.reduce((s,x)=>s+x.cd,0),0),{d:0,sub:un})}${kpi('دورهٔ صورتحساب',Math.max(0,fwDiff(S.from,S.to))+1,{suf:' روز'})}</div>
  ${C.map(c=>`<div class="sx-card"><header><b>${esc(c.c)}</b><small>${usd0(c.t)}${c.minA?' · شامل حداقل مبلغ':''}</small></header><table class="sx-tbl"><thead><tr><th>SKU</th><th>شرح</th><th>پرونده</th><th>${un} کل</th><th>مشمول (پس از روز آزاد)</th><th>مبلغ</th><th></th></tr></thead><tbody>${c.rows.map(x=>`<tr><td dir="ltr">${esc(x.r.sku)}</td><td>${esc(x.r.dsc||'')}</td><td>${esc(x.r.job||'—')}</td><td>${fa(nf(x.ud,1))}</td><td>${fa(nf(x.cd,1))}</td><td>${usd0(x.ch)}</td><td>${x.r.job?`<button class="sx-btn xs" data-bj="${esc(x.r.job)}" data-v="${Math.round(x.ch)}" data-s="${esc(x.r.sku)}">به پرونده</button>`:''}</td></tr>`).join('')}</tbody></table></div>`).join('')||'<div class="sx-card sx-muted">برای این دوره موجودی با جابه‌جایی ثبت‌شده‌ای وجود ندارد. ابتدا در «موجودی و جابه‌جایی» کالا و رسید ورود ثبت کنید.</div>'}
  <div class="fw-bt"><button class="sx-btn sm" data-csv>CSV</button><button class="sx-btn sm pri" data-pi>چاپ صورتحساب</button></div>`};
 const bindR=()=>{$$('[data-bj]',B).forEach(x=>x.onclick=()=>v16AddLine('انبارداری '+x.dataset.s+' ('+jdt(S.from)+' تا '+jdt(S.to)+')',+x.dataset.v*(K.cp/100),+x.dataset.v,x.dataset.bj));
  $('[data-csv]',B).onclick=()=>{const C=whCalc(S,K);dlFile('storage-billing.csv',toCSV(['customer','sku','job','unit_days','chargeable','amount_usd'],C.flatMap(c=>c.rows.map(x=>[c.c,x.r.sku,x.r.job,x.ud.toFixed(2),x.cd.toFixed(2),x.ch.toFixed(2)]))))};
  $('[data-pi]',B).onclick=()=>{const C=whCalc(S,K);openDoc(`<div class="page"><h1>صورتحساب انبارداری — ${esc(K.name)}</h1><p>دوره: ${jdt(S.from)} تا ${jdt(S.to)} · روش: ${K.meth==='cbm'?'حجمی ('+K.rC+' $ هر m³ در روز)':'پالتی ('+K.rP+' $ هر پالت در روز)'} · روز آزاد: ${fa(K.free)}</p>${C.map(c=>`<h2>${esc(c.c)}</h2><table><tr><th>SKU</th><th>شرح</th><th>واحد-روز مشمول</th><th>مبلغ</th></tr>${c.rows.map(x=>`<tr><td>${esc(x.r.sku)}</td><td>${esc(x.r.dsc||'')}</td><td>${fa(nf(x.cd,1))}</td><td>${usd0(x.ch)}</td></tr>`).join('')}${c.minA?`<tr><td colspan="3">تکمیل حداقل مبلغ</td><td>${usd0(c.minA)}</td></tr>`:''}<tr><th colspan="3">جمع</th><th>${usd0(c.t)}</th></tr></table>`).join('')}</div>`,'صورتحساب انبارداری')}};
 const draw=()=>{B.innerHTML=`<div class="v16-g2 v16-g2s"><div class="v16-col"><div class="sx-card fw-form v16-p"><header><b>دوره و مشتری</b></header><div class="fw-g">${fwI('از','from',S.from,{t:'date'})}${fwI('تا','to',S.to,{t:'date'})}${fwI('مشتری','cust',S.cust,{opts:[['','همه'],...custs.map(c=>[c,c])]})}</div></div>
  <div class="sx-card fw-form v16-k"><header><b>تعرفهٔ انبار</b></header><div class="fw-g">${fwI('نام انبار','name',K.name,{t:'text'})}${fwI('ظرفیت m³','cap',K.cap)}${fwI('ظرفیت پالت','palCap',K.palCap)}${fwI('روش محاسبه','meth',K.meth,{opts:[['cbm','حجمی (m³-روز)'],['pal','پالتی (پالت-روز)']]})}${fwI('نرخ $/m³/روز','rC',K.rC,{step:'0.05'})}${fwI('نرخ $/پالت/روز','rP',K.rP,{step:'0.1'})}${fwI('روز آزاد','free',K.free)}${fwI('حداقل مبلغ دوره $','min',K.min)}${fwI('بهای تمام‌شده ٪ مبلغ','cp',K.cp)}</div></div></div><div class="v16-col v16-res">${res()}</div></div>`;
  const part=()=>{$('.v16-res',B).innerHTML=res();bindR()};v16Bind($('.v16-p',B),S,sv,draw,part);v16Bind($('.v16-k',B),K,svK,draw,part);bindR()};
 draw()}
const VASL=[['lbl','برچسب‌زنی','عدد',0.15,0.08],['pck','بسته‌بندی مجدد','کارتن',1.2,0.7],['pal','پالت‌بندی','پالت',8,5],['shr','استرچ/شیرینگ','پالت',3,1.5],['fum','فومیگاسیون','کانتینر',120,80],['ins','بازرسی و شمارش','ساعت',15,9],['kit','کیت‌سازی و مونتاژ ساده','عدد',0.6,0.35],['xd','کراس‌داک','پالت',4,2.5],['stf','بارگیری/تخلیهٔ کانتینر','کانتینر',90,55],['ph','عکس‌برداری و گزارش','مورد',10,4]];
const vsN=k=>VASL.find(x=>x[0]===k)||VASL[0];
const VST=[['req','درخواست'],['wip','در حال انجام'],['done','انجام شد'],['bill','ثبت در پرونده']];
function whVas(B){rgUI(B,{key:'ifa-vas',title:'سفارش‌های خدمات ارزش افزوده',sub:'برچسب‌زنی، بسته‌بندی، پالت‌بندی، فومیگاسیون، کیت‌سازی و…؛ مبلغ مستقیم به سود و زیان پرونده می‌رود',addL:'سفارش جدید',
 def:()=>({date:fwToday(),job:(v16Job().j||{}).ref||'',cust:'',svc:'lbl',qty:100,rate:VASL[0][3],cost:VASL[0][4],st:'req',note:''}),
 fields:[['date','تاریخ','d'],['job','پرونده','',jobO()],['cust','مشتری'],['svc','خدمت','',VASL.map(x=>[x[0],x[1]+' ('+x[2]+')'])],['qty','مقدار','n'],['rate','نرخ فروش $/واحد','n'],['cost','بهای تمام‌شده $/واحد','n'],['st','وضعیت','',VST],['note','شرح کار','l']],
 onField:(r,k)=>{if(k==='svc'){const v=vsN(r.svc);r.rate=v[3];r.cost=v[4]}},
 cols:[['تاریخ',r=>jdt(r.date)],['پرونده',r=>esc(r.job||'—')],['خدمت',r=>esc(vsN(r.svc)[1])],['مقدار',r=>fa(nf(r.qty))+' '+vsN(r.svc)[2]],['مبلغ فروش',r=>usd0(r.qty*r.rate)],['سود',r=>usd0(r.qty*(r.rate-r.cost))],['وضعیت',r=>`<span class="v14-c ${r.st==='bill'?'ok':r.st==='done'?'warn':''}">${(VST.find(x=>x[0]===r.st)||VST[0])[1]}</span>`]],
 acts:r=>r.job&&r.st!=='bill'?'<button class="sx-btn sm pri" data-vb>ثبت در سود و زیان پرونده</button>':'',
 bindEd:(E,r,sv,draw)=>{const s=$('[data-k="svc"]',E);if(s)s.addEventListener('change',()=>setTimeout(draw));const b=$('[data-vb]',E);if(b)b.onclick=()=>{if(v16AddLine('خدمات ارزش افزوده: '+vsN(r.svc)[1]+' × '+r.qty,r.qty*r.cost,r.qty*r.rate,r.job)){r.st='bill';sv();draw()}}},
 kpis:L=>kpi('سفارش‌ها',L.length)+kpi('درآمد',L.reduce((a,r)=>a+r.qty*r.rate,0),{pre:'$'})+kpi('سود ناخالص',L.reduce((a,r)=>a+r.qty*(r.rate-r.cost),0),{pre:'$'})+kpi('انجام‌شده و ثبت‌نشده',L.filter(r=>r.st==='done').length,{cls:L.some(r=>r.st==='done')?'warn':''}),
 bottom:()=>`<div class="sx-card"><header><b>نرخ‌نامهٔ خدمات</b><small>نرخ‌های نمونه؛ هنگام ثبت قابل تغییر است</small></header><div class="v16-mtw"><table class="sx-tbl"><thead><tr><th>خدمت</th><th>واحد</th><th>نرخ فروش $</th><th>بهای تمام‌شده $</th><th>حاشیه</th></tr></thead><tbody>${VASL.map(v=>`<tr><td>${v[1]}</td><td>${v[2]}</td><td>${fa(v[3])}</td><td>${fa(v[4])}</td><td>${fa(Math.round((1-v[4]/v[3])*100))}٪</td></tr>`).join('')}</tbody></table></div></div>`})}

/* ===== v16 (B): ETA from history, demand forecast, document OCR ===== */
const mb32=a=>()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
const qt=(T,p)=>{if(!T.length)return null;const i=(T.length-1)*p,lo=Math.floor(i),hi=Math.ceil(i);return T[lo]+(T[hi]-T[lo])*(i-lo)};
const MODES=[['sea','دریایی'],['rail','ریلی'],['road','جاده‌ای'],['air','هوایی']];
const etaK=s=>String(s||'').trim().toLowerCase().replace(/\s*(→|->|←|<-|–|-)\s*/g,' → ').replace(/\s+/g,' ');
function etaSeed(){const r=mb32(42);const LN=[['Shanghai → Bandar Abbas','sea',22,[['COSCO',0],['MSC',1.5],['IRISL',-1],['Emirates Shipping Line',3]]],['Ningbo → Bandar Abbas','sea',23,[['COSCO',0],['IRISL',-.5],['Emirates Shipping Line',2.5]]],['Xian → Tehran','rail',17,[['CR Express',0],['KTZ Express',2]]],['Mersin → Tehran','road',8,[['ترابر سپهر',0],['Trans Anatolia',1]]],['Jebel Ali → Bandar Abbas','sea',3,[['Feeder A',0],['Feeder B',1]]],['Astrakhan → Anzali','sea',5,[['Caspian Line',0]]]];
 const out=[];const now=Date.now();LN.forEach(([lane,mode,base,C])=>{for(let i=0;i<14;i++){const c=C[Math.floor(r()*C.length)];const dep=new Date(now-(20+r()*400)*864e5).toISOString().slice(0,10);const m=+dep.slice(5,7);const cny=(mode!=='road'&&/Shanghai|Ningbo|Xian/.test(lane)&&(m===1||m===2))?base*.15:0;const t=Math.max(1,Math.round(base+c[1]+cny+base*(r()*r()*.45-.05)+(r()<.08?base*.35:0)));out.push({id:rgId(),lane,mode,car:c[0],dep,arr:fwAdd(dep,t),plan:Math.round(base+Math.max(0,c[1])+base*.08),src:'نمونه',note:''})}});return out}
function etaRecs(){let R=LSG('ifa-eh',null);if(!R){R=etaSeed();LSS('ifa-eh',R)}const out=R.filter(r=>r.dep&&r.arr).map(r=>({lane:r.lane,mode:r.mode,car:r.car||'',dep:r.dep,t:fwDiff(r.dep,r.arr),plan:+r.plan||null,src:r.src||'دستی'})).filter(r=>r.t>=0);
 shipsG().forEach(s=>{const ms=s.ms||[];const d=ms.find(m=>m.k==='dep'&&m.act!=null);const A=ms.filter(m=>m.k==='arr');const a=A[A.length-1];if(!d||!a||a.act==null)return;out.push({lane:String(d.n||'').replace('حرکت از ','')+' → '+String(a.n||'').replace('رسیدن به ',''),mode:d.mode||'sea',car:s.carrier||'',dep:new Date(d.act).toISOString().slice(0,10),t:(a.act-d.act)/864e5,plan:(a.pl-d.pl)/864e5,src:'رهگیری'})});return out}
function etaModel(o){const R=etaRecs();const k=etaK(o.lane);let L=R.filter(r=>etaK(r.lane)===k&&(!o.mode||r.mode===o.mode));let basis='همهٔ سوابق این مسیر';
 if(o.carrier){const C=L.filter(r=>r.car&&r.car.toLowerCase()===String(o.carrier).toLowerCase());if(C.length>=3){L=C;basis='سوابق همین حمل‌کننده در این مسیر'}else if(C.length)basis='سابقهٔ حمل‌کننده کافی نیست (کمتر از ۳)؛ از همهٔ سوابق مسیر استفاده شد'}
 const dep=o.dep||fwToday();const plan=+o.plan||null;
 if(!L.length)return {n:0,basis:'بدون سابقه',conf:'—',p10:plan,p50:plan,p80:plan,p90:plan,f:1,T:[],L:[],eta:d=>d==null?null:fwAdd(dep,Math.round(d)),onT:null,dly:null,mean:plan,sd:0};
 const T=L.map(r=>r.t).sort((a,b)=>a-b);const med=qt(T,.5)||1;const mo=+dep.slice(5,7);const Lm=L.filter(r=>+r.dep.slice(5,7)===mo);let f=1;if(Lm.length){const raw=qt(Lm.map(r=>r.t).sort((a,b)=>a-b),.5)/med;f=1+(raw-1)*Lm.length/(Lm.length+3)}
 const P=p=>qt(T,p)*f;const mean=T.reduce((a,b)=>a+b,0)/T.length;const sd=Math.sqrt(T.reduce((a,b)=>a+(b-mean)**2,0)/Math.max(1,T.length-1));const D=L.filter(r=>r.plan).map(r=>r.t-r.plan);
 return {n:L.length,basis,f,p10:P(.1),p50:P(.5),p80:P(.8),p90:P(.9),mean,sd,onT:plan?L.filter(r=>r.t*f<=plan+.5).length/L.length:null,dly:D.length?D.reduce((a,b)=>a+b,0)/D.length:null,conf:L.length>=10?'بالا':L.length>=4?'متوسط':'کم',T,L,eta:d=>d==null?null:fwAdd(dep,Math.round(d))}}
const ETX={lane:'',mode:'',carrier:'',dep:'',plan:''};
function rEta(b){subTabs(b,V16,'eta',[['pr','پیش‌بینی'],['act','محموله‌های در راه'],['hist','سوابق سفر']],(v,B)=>({pr:etaPr,act:etaAct,hist:etaHist})[v](B))}
function etaPr(B){const R=etaRecs();const lanes=[...new Set(R.map(r=>r.lane))];if(!ETX.lane&&lanes.length){const cnt={};R.forEach(r=>cnt[r.lane]=(cnt[r.lane]||0)+1);ETX.lane=Object.keys(cnt).sort((a,b)=>cnt[b]-cnt[a])[0];ETX.mode=(R.find(r=>r.lane===ETX.lane)||{}).mode||'sea'}if(!ETX.dep)ETX.dep=fwToday();
 const res=()=>{const M=etaModel(ETX);const cars=[...new Set(etaRecs().filter(r=>etaK(r.lane)===etaK(ETX.lane)&&(!ETX.mode||r.mode===ETX.mode)).map(r=>r.car).filter(Boolean))];
  if(!M.n)return `<div class="sx-card sx-muted">برای این مسیر و نوع حمل سابقه‌ای ثبت نشده است. سفرهای انجام‌شده را در «سوابق سفر» وارد کنید یا محموله‌ها را در «رهگیری محموله» تا رسیدن دنبال کنید تا خودکار به سوابق اضافه شوند.</div>`;
  const mn=Math.floor(M.T[0]),mx=Math.ceil(M.T[M.T.length-1]);const bins=[];for(let d=mn;d<=mx&&bins.length<60;d++)bins.push(d);const H=bins.map(d=>M.T.filter(t=>Math.round(t)===d).length);
  const CR=cars.map(c=>{const X=etaRecs().filter(r=>etaK(r.lane)===etaK(ETX.lane)&&(!ETX.mode||r.mode===ETX.mode)&&r.car===c);const T=X.map(r=>r.t).sort((a,b)=>a-b);const P=X.filter(r=>r.plan);return {c,n:X.length,m:qt(T,.5),p90:qt(T,.9),on:P.length?P.filter(r=>r.t<=r.plan+.5).length/P.length:null,dl:P.length?P.reduce((a,r)=>a+r.t-r.plan,0)/P.length:null}}).sort((a,b)=>a.m-b.m);
  return `<div class="ex-kpis">${kpT('زمان رسیدن محتمل (P50)',jdt(M.eta(M.p50)),fa(nf(M.p50,1))+' روز پس از حرکت')}${kpT('با اطمینان ۸۰٪ تا',jdt(M.eta(M.p80)),fa(nf(M.p80,1))+' روز')}${kpT('بازهٔ P10 تا P90',fa(nf(M.p10,0))+' تا '+fa(nf(M.p90,0))+' روز',jdt(M.eta(M.p10))+' – '+jdt(M.eta(M.p90)))}${M.onT!=null?kpi('احتمال رسیدن در موعد',M.onT*100,{suf:'٪',sub:'برنامه '+fa(ETX.plan)+' روز',cls:M.onT<.5?'warn':''}):''}${kpT('اعتماد',M.conf,fa(M.n)+' سفر · '+M.basis)}</div>
  <div class="v16-g2"><div class="sx-card"><header><b>توزیع زمان سفر</b><small>روز · ستون نارنجی = پیش‌بینی میانه${Math.abs(M.f-1)>.01?' · ضریب فصلی '+fa(nf(M.f,2)):''}</small></header>${v16Bars(bins.map(fa),H,{hl:i=>bins[i]===Math.round(M.p50)})}<p class="sx-muted v14-sm">میانگین ${fa(nf(M.mean,1))} روز · انحراف معیار ${fa(nf(M.sd,1))} روز${M.dly!=null?' · میانگین تأخیر نسبت به برنامه '+fa(nf(M.dly,1))+' روز':''}</p></div>
  <div class="sx-card"><header><b>مقایسهٔ حمل‌کنندگان این مسیر</b></header>${CR.length?`<table class="sx-tbl"><thead><tr><th>حمل‌کننده</th><th>سفر</th><th>میانه (روز)</th><th>P90</th><th>در موعد</th><th>تأخیر میانگین</th></tr></thead><tbody>${CR.map(x=>`<tr class="${x.c===ETX.carrier?'on':''}"><td>${esc(x.c)}</td><td>${fa(x.n)}</td><td>${fa(nf(x.m,1))}</td><td>${fa(nf(x.p90,1))}</td><td>${x.on==null?'—':fa(Math.round(x.on*100))+'٪'}</td><td>${x.dl==null?'—':fa(nf(x.dl,1))}</td></tr>`).join('')}</tbody></table>`:'<div class="sx-muted v14-sm">حمل‌کننده‌ای ثبت نشده.</div>'}</div></div>
  <p class="sx-muted v14-sm">روش: چندک‌های تجربی زمان سفرهای گذشتهٔ همین مسیر (و در صورت کفایت، همین حمل‌کننده) با ضریب فصلی ماه حرکت که به نسبت تعداد نمونه تعدیل می‌شود.</p>`};
 const draw=()=>{const R=etaRecs();const lanes=[...new Set(R.map(r=>r.lane))];const cars=[...new Set(R.map(r=>r.car).filter(Boolean))];
  B.innerHTML=`<div class="sx-card fw-form v16-eq"><header><b>مشخصات سفر</b><small>${fa(R.length)} سفر در سوابق</small></header><div class="fw-g"><label class="sx-f fw-f w2"><span>مسیر (مبدأ → مقصد)</span><input data-k="lane" list="v16-ln" value="${esc(ETX.lane)}"></label><datalist id="v16-ln">${lanes.map(l=>`<option value="${esc(l)}">`).join('')}</datalist>${fwI('نوع حمل','mode',ETX.mode,{opts:[['','همه'],...MODES]})}<label class="sx-f fw-f"><span>حمل‌کننده (اختیاری)</span><input data-k="carrier" list="v16-cr" value="${esc(ETX.carrier)}"></label><datalist id="v16-cr">${cars.map(l=>`<option value="${esc(l)}">`).join('')}</datalist>${fwI('تاریخ حرکت','dep',ETX.dep,{t:'date'})}${fwI('زمان برنامه‌ای (روز)','plan',ETX.plan)}</div></div><div class="v16-res">${res()}</div>`;
  $$('.v16-eq [data-k]',B).forEach(x=>x.addEventListener('change',()=>{ETX[x.dataset.k]=x.value;$('.v16-res',B).innerHTML=res()}))};
 draw()}
function etaAct(B){const S=shipsG();const act=S.filter(s=>{const ms=s.ms||[];const d=ms.find(m=>m.k==='dep'&&m.act!=null);const A=ms.filter(m=>m.k==='arr');return d&&A.length&&A[A.length-1].act==null});
 const rows=act.map(s=>{const ms=s.ms;const d=ms.find(m=>m.k==='dep'&&m.act!=null);const A=ms.filter(m=>m.k==='arr');const a=A[A.length-1];const lane=String(d.n||'').replace('حرکت از ','')+' → '+String(a.n||'').replace('رسیدن به ','');const dep=new Date(d.act).toISOString().slice(0,10);const M=etaModel({lane,mode:d.mode,carrier:s.carrier||'',dep,plan:(a.pl-d.pl)/864e5});const pl=new Date(a.pl).toISOString().slice(0,10);return {s,lane,dep,pl,M,p50:M.n?M.eta(M.p50):null,p90:M.n?M.eta(M.p90):null}});
 B.innerHTML=`<div class="ex-kpis">${kpi('محموله‌های در راه',rows.length)}${kpi('با پیش‌بینی از سوابق',rows.filter(r=>r.M.n).length)}${kpi('احتمال تأخیر',rows.filter(r=>r.p50&&r.p50>r.pl).length,{sub:'میانهٔ پیش‌بینی بعد از برنامه',cls:rows.some(r=>r.p50&&r.p50>r.pl)?'warn':''})}</div>
 <div class="sx-card"><header><b>پیش‌بینی رسیدن محموله‌های در راه</b><small>از «رهگیری محموله»؛ محموله‌هایی که حرکت کرده‌اند و هنوز نرسیده‌اند</small></header>${rows.length?`<div class="v16-mtw"><table class="sx-tbl"><thead><tr><th>محموله</th><th>مسیر</th><th>حرکت</th><th>رسیدن برنامه‌ای</th><th>پیش‌بینی P50</th><th>تا P90</th><th>اختلاف</th><th>سوابق</th><th></th></tr></thead><tbody>${rows.map((r,i)=>{const df=r.p50?fwDiff(r.pl,r.p50):null;return `<tr><td><b>${esc(r.s.ref||r.s.name||'')}</b></td><td>${esc(r.lane)}</td><td>${jdt(r.dep)}</td><td>${jdt(r.pl)}</td><td>${r.p50?jdt(r.p50):'—'}</td><td>${r.p90?jdt(r.p90):'—'}</td><td>${df==null?'—':`<span class="v14-c ${df>1?'bad':df>0?'warn':'ok'}">${df>0?'+':''}${fa(df)} روز</span>`}</td><td>${fa(r.M.n)}</td><td>${r.p50?`<button class="sx-btn xs" data-sp="${i}">ثبت در محموله</button>`:''}</td></tr>`}).join('')}</tbody></table></div>`:'<div class="sx-muted v14-sm">محموله‌ای در راه نیست. در «رهگیری محموله» محموله بسازید و زمان حرکت واقعی را ثبت کنید.</div>'}</div>`;
 $$('[data-sp]',B).forEach(x=>x.onclick=()=>{const r=rows[+x.dataset.sp];const A=shipsG();const s=A.find(y=>y.id===r.s.id);if(!s)return;s.etaP={p50:r.p50,p90:r.p90,n:r.M.n,ts:Date.now()};shipsS(A);toast('پیش‌بینی در محموله ثبت شد')})}
function etaHist(B){if(!LSG('ifa-eh',null))LSS('ifa-eh',etaSeed());rgUI(B,{key:'ifa-eh',seed:etaSeed,title:'سوابق سفرهای انجام‌شده',sub:'هر سفر کامل؛ سفرهای «رهگیری محموله» پس از رسیدن خودکار به محاسبه اضافه می‌شوند',addL:'سفر جدید',
 def:()=>({lane:'',mode:'sea',car:'',dep:fwAdd(fwToday(),-20),arr:fwToday(),plan:0,src:'دستی',note:''}),
 fields:[['lane','مسیر (مثلاً Shanghai → Bandar Abbas)'],['mode','نوع حمل','',MODES],['car','حمل‌کننده'],['dep','تاریخ حرکت','d'],['arr','تاریخ رسیدن','d'],['plan','زمان برنامه‌ای (روز)','n'],['src','منبع'],['note','یادداشت','l']],
 sort:(a,b)=>a.dep<b.dep?1:-1,
 cols:[['مسیر',r=>esc(r.lane)],['نوع',r=>(MODES.find(m=>m[0]===r.mode)||['',''])[1]],['حمل‌کننده',r=>esc(r.car||'—')],['حرکت',r=>r.dep?jdt(r.dep):'—'],['رسیدن',r=>r.arr?jdt(r.arr):'—'],['روز سفر',r=>r.dep&&r.arr?fa(fwDiff(r.dep,r.arr)):'—'],['تأخیر',r=>{if(!r.plan||!r.dep||!r.arr)return '—';const d=fwDiff(r.dep,r.arr)-r.plan;return `<span class="v14-c ${d>2?'bad':d>0?'warn':'ok'}" dir="ltr">${d>0?'+':''}${fa(d)}</span>`}],['منبع',r=>`<small>${esc(r.src||'')}</small>`]],
 top:L=>L.some(r=>r.src==='نمونه')?`<div class="sx-card v16-nt">${fa(L.filter(r=>r.src==='نمونه').length)} سفر «نمونه» برای نمایش روش وجود دارد. پس از ورود سوابق واقعی آن‌ها را حذف کنید. <button class="sx-btn xs" data-cs>حذف داده‌های نمونه</button></div>`:'',
 bind:(B2,L,sv,draw)=>{const c=$('[data-cs]',B2);if(c)c.onclick=()=>{L.splice(0,L.length,...L.filter(r=>r.src!=='نمونه'));sv();draw()}},
 kpis:L=>{const ok=L.filter(r=>r.dep&&r.arr);return kpi('سفرها',ok.length)+kpi('مسیرها',new Set(ok.map(r=>etaK(r.lane))).size)+kpi('در موعد',ok.filter(r=>r.plan).length?ok.filter(r=>r.plan&&fwDiff(r.dep,r.arr)<=r.plan).length/ok.filter(r=>r.plan).length*100:0,{suf:'٪'})+kpi('از رهگیری',etaRecs().filter(r=>r.src==='رهگیری').length)}})}

/* ---------- Demand forecast ---------- */
const DMX={src:'',H:6,teu:1.6,upp:25};
const ymAdd=(m,k)=>{let [y,mm]=m.split('-').map(Number);mm+=k;while(mm>12){mm-=12;y++}while(mm<1){mm+=12;y--}return y+'-'+String(mm).padStart(2,'0')};
const ymFa=m=>{try{const [y,mm]=m.split('-').map(Number);return new Date(Date.UTC(y,mm-1,15)).toLocaleDateString('fa-IR-u-ca-persian',{year:'2-digit',month:'short'})}catch(e){return m}};
function dmFill(M){const ks=Object.keys(M).sort();if(!ks.length)return [];const out=[];let k=ks[0];const e=ks[ks.length-1];let g=0;while(k<=e&&g++<600){out.push({m:k,v:+M[k]||0});k=ymAdd(k,1)}return out}
function dmSample(){const r=mb32(7);const out=[];const now=new Date();let m=ymAdd(now.toISOString().slice(0,7),-36);const SI=[.92,.85,.86,.84,.98,1.06,1.1,1.04,1.12,1.15,1.04,.95];for(let i=0;i<36;i++){out.push({m,v:Math.round((60+i*1.1)*SI[+m.slice(5)-1]*(.93+r()*.14))});m=ymAdd(m,1)}return out}
function dmSeries(src){if(src==='jobs'||src==='rev'){const M={};LSG('ifa-jobs',[]).forEach(j=>{const m=String(j.date||'').slice(0,7);if(!/^\d{4}-\d{2}$/.test(m))return;M[m]=(M[m]||0)+(src==='jobs'?1:jobSum(j).sa)});return dmFill(M)}if(src==='man'){const M={};(LSG('ifa-dmd',{pts:[]}).pts||[]).forEach(p=>M[p.m]=+p.v);return dmFill(M)}return dmSample()}
const fcF={
 sn:(y,h)=>Array.from({length:h},(_,i)=>{const s=12;return y.length>=s?y[y.length-s+(i%s)]:y[y.length-1]}),
 ma:(y,h)=>{const a=y.slice(-3);const v=a.reduce((p,c)=>p+c,0)/a.length;return Array(h).fill(v)},
 ses:(y,h,p)=>{let l=y[0];for(let i=1;i<y.length;i++)l=p.a*y[i]+(1-p.a)*l;return Array(h).fill(l)},
 holt:(y,h,p)=>{let l=y[0],b=y.length>1?y[1]-y[0]:0;for(let i=1;i<y.length;i++){const pl=l;l=p.a*y[i]+(1-p.a)*(l+b);b=p.b*(l-pl)+(1-p.b)*b}return Array.from({length:h},(_,i)=>l+(i+1)*b*Math.pow(.98,i))},
 hw:(y,h,p)=>{const s=12;if(y.length<2*s)return null;const m1=y.slice(0,s).reduce((a,b)=>a+b,0)/s,m2=y.slice(s,2*s).reduce((a,b)=>a+b,0)/s;let l=m1,b=(m2-m1)/s;const S=y.slice(0,s).map(v=>v-m1);for(let i=s;i<y.length;i++){const pl=l,si=S[i%s];l=p.a*(y[i]-si)+(1-p.a)*(l+b);b=p.b*(l-pl)+(1-p.b)*b;S[i%s]=p.g*(y[i]-l)+(1-p.g)*si}const n=y.length;return Array.from({length:h},(_,i)=>l+(i+1)*b+S[(n+i)%s])}};
const FCN={sn:'فصلی ساده (همان ماه سال قبل)',ma:'میانگین متحرک ۳ ماهه',ses:'هموارسازی نمایی ساده',holt:'هولت (روند میرا)',hw:'هولت–وینترز فصلی'};
function dmGrid(k){if(k==='ses')return [.2,.4,.6,.8].map(a=>({a}));if(k==='holt')return [.2,.4,.6].flatMap(a=>[.05,.15,.3].map(b=>({a,b})));if(k==='hw')return [.2,.4,.6].flatMap(a=>[.02,.1].flatMap(b=>[.1,.3].map(g=>({a,b,g}))));return [{}]}
function demandFc(y,H){const n=y.length;const h=Math.max(1,Math.min(6,Math.floor(n/4)));const tr=y.slice(0,n-h),te=y.slice(n-h);const ev=[];
 Object.keys(fcF).forEach(k=>{let best=null;dmGrid(k).forEach(p=>{if(tr.length<3)return;const f=fcF[k](tr,h,p);if(!f)return;const e=te.map((v,i)=>v-f[i]);const mape=te.reduce((s,v,i)=>s+Math.abs(v-f[i])/Math.max(1,Math.abs(v)),0)/h*100;const rmse=Math.sqrt(e.reduce((s,x)=>s+x*x,0)/h);if(!best||mape<best.mape)best={k,p,mape,rmse}});if(best)ev.push(best)});
 ev.sort((a,b)=>a.mape-b.mape);const B=ev[0]||{k:'ma',p:{},mape:null,rmse:0};const f=(fcF[B.k](y,H,B.p)||fcF.ma(y,H)).map(v=>Math.max(0,v));const sg=B.rmse||0;
 return {ev,best:B,f,lo:f.map((v,i)=>Math.max(0,v-1.28*sg*Math.sqrt(1+i*.15))),hi:f.map((v,i)=>v+1.28*sg*Math.sqrt(1+i*.15)),h}}
function rDmd(b){subTabs(b,V16,'dmd',[['fc','پیش‌بینی و ظرفیت'],['data','دادهٔ دستی']],(v,B)=>({fc:dmFcV,data:dmData})[v](B))}
function dmAuto(){if(dmSeries('jobs').length>=12)return 'jobs';if((LSG('ifa-dmd',{pts:[]}).pts||[]).length>=12)return 'man';return 'smp'}
function dmFcV(B){if(!DMX.src)DMX.src=dmAuto();
 const draw=()=>{const Y=dmSeries(DMX.src);const y=Y.map(p=>p.v);const D=LSG('ifa-dmd',{name:'',unit:''});const unit=DMX.src==='rev'?'$':DMX.src==='man'?(D.unit||'واحد'):'پرونده';
  const seg=tmSeg([['jobs','تعداد پرونده‌ها'],['rev','فروش پرونده‌ها'],['man','سری دستی'+(D.name?' ('+D.name+')':'')],['smp','دادهٔ نمونه']],DMX.src,'v16-ds');
  if(y.length<6){B.innerHTML=`<div class="sx-row">${seg}</div><div class="sx-card sx-muted">برای پیش‌بینی دست‌کم ۶ ماه داده لازم است (این سری ${fa(y.length)} ماه دارد). سری ماهانه را در «دادهٔ دستی» وارد کنید یا «دادهٔ نمونه» را برای دیدن روش انتخاب کنید.</div>`;bindS();return}
  const R=demandFc(y,DMX.H);const last=Y[Y.length-1].m;const fm=Array.from({length:DMX.H},(_,i)=>ymAdd(last,i+1));const hx=Y.slice(-36);const xs=[...hx.map(p=>ymFa(p.m)),...fm.map(ymFa)];const pad=Array(hx.length-1).fill(null);
  const hv=hx.map(p=>p.v);const fv=[...pad,hv[hv.length-1],...R.f];const lo=[...pad,hv[hv.length-1],...R.lo],hi=[...pad,hv[hv.length-1],...R.hi];
  const ly=fm.map(m=>{const p=Y.find(q=>q.m===ymAdd(m,-12));return p?p.v:null});const lyS=ly.every(v=>v!=null)?ly.reduce((a,b)=>a+b,0):null;const fS=R.f.reduce((a,b)=>a+b,0);
  const SI={};Y.forEach(p=>{const k=+p.m.slice(5);(SI[k]=SI[k]||[]).push(p.v)});const avg=y.reduce((a,b)=>a+b,0)/y.length;const pk=Object.entries(SI).map(([k,v])=>[+k,v.reduce((a,b)=>a+b,0)/v.length/avg]).sort((a,b)=>b[1]-a[1])[0];
  const isJ=DMX.src!=='rev';const d=unit==='$'?0:1;
  B.innerHTML=`<div class="sx-row v16-dh">${seg}<span class="sx-sp"></span><label class="sx-f fw-f"><span>افق</span><select class="dm-h">${[3,6,12].map(h=>`<option value="${h}" ${h===DMX.H?'selected':''}>${fa(h)} ماه</option>`).join('')}</select></label></div>
  <div class="ex-kpis">${kpi('ماه آینده',R.f[0],{d,pre:unit==='$'?'$':'',sub:ymFa(fm[0])+' · بازه '+fa(nf(R.lo[0],0))+' تا '+fa(nf(R.hi[0],0))})}${kpi('جمع '+fa(DMX.H)+' ماه آینده',fS,{d:0,pre:unit==='$'?'$':''})}${lyS!=null?kpi('تغییر نسبت به سال قبل',(fS/Math.max(1,lyS)-1)*100,{d:1,suf:'٪',cls:fS<lyS?'warn':''}):''}${kpT('بهترین روش',FCN[R.best.k],R.best.mape!=null?'خطای آزمون (MAPE) '+fa(nf(R.best.mape,1))+'٪':'')}${pk?kpT('ماه اوج فصلی',new Date(Date.UTC(2024,pk[0]-1,15)).toLocaleDateString('fa-IR-u-ca-gregory',{month:'long'})+' (میلادی)',fa(nf((pk[1]-1)*100,0))+'٪ بالاتر از میانگین'):''}</div>
  <div class="sx-card"><header><b>سری زمانی و پیش‌بینی</b><small>${esc(unit)} در ماه · ناحیهٔ رنگی = بازهٔ ۸۰٪</small></header>${v16Svg(xs,[{v:[...hv,...Array(DMX.H).fill(null)],c:'#8A8984',n:'واقعی',dots:true},{v:fv,lo,hi,c:'#5E9FE8',d:true,n:'پیش‌بینی'}],{vx:hx.length-1})}</div>
  <div class="v16-g2"><div class="sx-card"><header><b>پیش‌بینی ماهانه${isJ?' و ظرفیت لازم':''}</b>${isJ?`<span class="sx-sp"></span><label class="sx-f fw-f v16-in"><span>TEU هر پرونده</span><input type="number" step="0.1" class="dm-t" value="${DMX.teu}"></label><label class="sx-f fw-f v16-in"><span>پرونده به ازای هر کارشناس</span><input type="number" class="dm-u" value="${DMX.upp}"></label>`:''}</header><div class="v16-mtw"><table class="sx-tbl"><thead><tr><th>ماه</th><th>کم (P10)</th><th>پیش‌بینی</th><th>زیاد (P90)</th><th>سال قبل</th>${isJ?'<th>TEU لازم</th><th>کارشناس عملیات</th>':''}</tr></thead><tbody>${fm.map((m,i)=>`<tr><td>${ymFa(m)}</td><td>${fa(nf(R.lo[i],d))}</td><td><b>${fa(nf(R.f[i],d))}</b></td><td>${fa(nf(R.hi[i],d))}</td><td>${ly[i]==null?'—':fa(nf(ly[i],d))}</td>${isJ?`<td>${fa(nf(R.f[i]*DMX.teu,0))}</td><td>${fa(Math.ceil(R.hi[i]/Math.max(1,DMX.upp)))}</td>`:''}</tr>`).join('')}</tbody></table></div>${isJ?'<p class="sx-muted v14-sm">تعداد کارشناس بر پایهٔ سناریوی زیاد (P90) گرد به بالا محاسبه شده است.</p>':''}</div>
  <div class="sx-card"><header><b>مقایسهٔ روش‌ها</b><small>آزمون روی ${fa(R.h)} ماه آخر</small></header><table class="sx-tbl"><thead><tr><th>روش</th><th>MAPE</th><th>RMSE</th><th>پارامترها</th></tr></thead><tbody>${R.ev.map(e=>`<tr class="${e===R.best?'on':''}"><td>${FCN[e.k]}</td><td>${fa(nf(e.mape,1))}٪</td><td>${fa(nf(e.rmse,1))}</td><td dir="ltr"><small>${Object.entries(e.p).map(([k,v])=>k+'='+v).join(' ')}</small></td></tr>`).join('')}</tbody></table><div class="fw-bt"><button class="sx-btn sm" data-csv>CSV پیش‌بینی</button></div></div></div>`;
  bindS();$('.dm-h',B).onchange=e=>{DMX.H=+e.target.value;draw()};const t=$('.dm-t',B),u=$('.dm-u',B);if(t)t.onchange=()=>{DMX.teu=+t.value||1;draw()};if(u)u.onchange=()=>{DMX.upp=+u.value||1;draw()};
  $('[data-csv]',B).onclick=()=>dlFile('demand-forecast.csv',toCSV(['month','p10','forecast','p90'],fm.map((m,i)=>[m,R.lo[i].toFixed(2),R.f[i].toFixed(2),R.hi[i].toFixed(2)])))};
 const bindS=()=>$$('.v16-ds button',B).forEach(x=>x.onclick=()=>{DMX.src=x.dataset.v;draw()});
 draw()}
function dmParse(t){const out=[];String(t||'').replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d)).split(/\r?\n/).forEach(l=>{const m=l.match(/(\d{4})[-\/.](\d{1,2})\s*[,;\t ]\s*(-?[\d.,]+)/);if(m)out.push({m:m[1]+'-'+String(+m[2]).padStart(2,'0'),v:+m[3].replace(/,/g,'')})});const M={};out.forEach(p=>M[p.m]=p.v);return Object.keys(M).sort().map(m=>({m,v:M[m]}))}
function dmData(B){const D=Object.assign({name:'',unit:'',pts:[]},LSG('ifa-dmd',{}));const txt=()=>D.pts.map(p=>p.m+','+p.v).join('\n');
 B.innerHTML=`<div class="v16-g2"><div class="sx-card fw-form"><header><b>سری ماهانهٔ دستی</b><small>هر خط: سال-ماه (میلادی)، مقدار — مثلاً 2024-03,118</small></header><div class="fw-g">${fwI('نام سری','name',D.name,{t:'text'})}${fwI('واحد','unit',D.unit,{t:'text'})}</div><textarea class="v14-ta dm-x" rows="14" dir="ltr">${esc(txt())}</textarea><div class="fw-bt"><button class="sx-btn sm pri" data-sv>ذخیره</button><button class="sx-btn sm" data-fj>کپی از پرونده‌ها</button><button class="sx-btn sm" data-fs>درج دادهٔ نمونه</button><button class="sx-btn sm" data-cl>پاک کردن</button></div><div class="dm-s sx-muted v14-sm">${fa(D.pts.length)} ماه ذخیره شده.</div></div>
 <div class="sx-card"><header><b>پیش‌نمایش</b></header><div class="dm-p">${D.pts.length?v16Svg(D.pts.map(p=>ymFa(p.m)),[{v:D.pts.map(p=>p.v),c:'#5E9FE8',dots:true}]):'<div class="sx-muted v14-sm">داده‌ای وارد نشده.</div>'}</div><p class="sx-muted v14-sm">برای پیش‌بینی، در زبانهٔ «پیش‌بینی و ظرفیت» گزینهٔ «سری دستی» را انتخاب کنید. می‌توانید حجم TEU، تناژ، تعداد کامیون یا فروش را وارد کنید.</p></div></div>`;
 fwBind($('.fw-form',B),D,()=>{});
 $('[data-sv]',B).onclick=()=>{D.pts=dmParse($('.dm-x',B).value);LSS('ifa-dmd',D);DMX.src='man';toast(fa(D.pts.length)+' ماه ذخیره شد');dmData(B)};
 $('[data-fj]',B).onclick=()=>{$('.dm-x',B).value=dmSeries('jobs').map(p=>p.m+','+p.v).join('\n')};
 $('[data-fs]',B).onclick=()=>{$('.dm-x',B).value=dmSample().map(p=>p.m+','+p.v).join('\n')};
 $('[data-cl]',B).onclick=()=>{$('.dm-x',B).value=''}}

/* ---------- Document reading (PDF text layer + OCR) ---------- */
const b2s=u=>{let s='';for(let i=0;i<u.length;i+=8192)s+=String.fromCharCode.apply(null,u.subarray(i,i+8192));return s};
const s2b=s=>{const u=new Uint8Array(s.length);for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i)&255;return u};
async function pdfInfl(u){for(const f of ['deflate','deflate-raw']){try{const ds=new DecompressionStream(f);const w=ds.writable.getWriter();w.write(f==='deflate'?u:u.subarray(2)).catch(()=>{});w.close().catch(()=>{});return new Uint8Array(await new Response(ds.readable).arrayBuffer())}catch(e){}}return null}
