 g(/PORT OF LOADING\s*[:\-]?\s*([^\n]{3,40})/i,'pol');g(/PORT OF DISCHARGE\s*[:\-]?\s*([^\n]{3,40})/i,'pod');g(/AIRPORT OF DEPARTURE\s*[:\-]?\s*([^\n]{3,40})/i,'pol',.85);g(/AIRPORT OF DESTINATION\s*[:\-]?\s*([^\n]{3,40})/i,'pod',.85);
 const C=[...new Set((t.match(/\b[A-Z]{3}[UJZ]\s?\d{6}\s?-?\s?\d\b/g)||[]).map(x=>x.replace(/[\s-]/g,'')))];if(C.length)put('ctr',C.join(' '),C.every(c=>iso6346(c).ok)?.95:.7);
 g(/SEAL\s*(?:NO\.?|#|NUMBER)\s*[:\-]?\s*([A-Z0-9][A-Z0-9\-]{4,15})/i,'seal',.85);{const m=/SEAL\b[^A-Z0-9\n]*([A-Z0-9][A-Z0-9\-]{4,15})/i.exec(t);if(m&&!/^[A-Z]{3}[UJZ]\d{7}$/.test(m[1])&&!/^NO$/i.test(m[1]))put('seal',m[1],.7)}
 const w=(re,k)=>{const m=re.exec(t);if(!m)return;let v=ocNum(m[1]);if(v==null)return;const u=(m[2]||'').toUpperCase();if(/^(MT|TON|TONS|T)$/.test(u))v*=1000;else if(/LB/.test(u))v*=.4536;put(k,String(Math.round(v*100)/100),.85)};
 w(/(?:GROSS\s*(?:WEIGHT|WT\.?)|G\.\s?W\.?|وزن ناخالص)\s*(?:\((?:KGS?|KG)\))?\s*[:\-]?\s*([\d.,]+)\s*(KGS?|KG|MT|TONS?|LBS?)?/i,'gw');w(/(?:NET\s*(?:WEIGHT|WT\.?)|N\.\s?W\.?|وزن خالص)\s*(?:\((?:KGS?|KG)\))?\s*[:\-]?\s*([\d.,]+)\s*(KGS?|KG|MT|TONS?|LBS?)?/i,'nw');
 g(/([\d.,]+)\s*(?:CBM|M3|M³|CU\.?\s?M)\b/i,'cbm',.8);const pk=/\b(\d[\d,]*)\s*(PALLETS?|CARTONS?|CTNS?|PKGS?|PACKAGES|BAGS|DRUMS|CASES|BALES|CRATES|ROLLS|BOXES)\b/i.exec(t);if(pk){put('pkg',pk[1].replace(/,/g,''),.8);put('pkt',pk[2].toUpperCase(),.8)}
 blk(/^(DESCRIPTION OF (GOODS|PACKAGES AND GOODS)|DESCRIPTION|شرح کالا)\b[^\n]*?/i,'dsc');
 const H=[...new Set((t.match(/(?:HS\s*(?:CODE)?|H\.S\.(?:\s*CODE)?|TARIFF)\s*[:\-#]?\s*(\d{4}[.\s]?\d{2}(?:[.\s]?\d{2})?)/gi)||[]).map(x=>x.replace(/^\D+/,'').replace(/\D/g,'')))];if(H.length)put('hs',H.join(' '),.9);
 g(/INVOICE\s*(?:NO\.?|NUMBER|#)\s*[:\-]?\s*([A-Z0-9][A-Z0-9\/\-]{2,24})/i,'ino');g(/(?:DATE|تاریخ)\s*[:\-]?\s*(\d{4}[-\/.]\d{1,2}[-\/.]\d{1,2}|\d{1,2}[-\/.]\d{1,2}[-\/.]\d{2,4}|\d{1,2}\s+[A-Z]{3,9}\.?\s+\d{4}|[A-Z]{3,9}\.?\s+\d{1,2},?\s+\d{4})/i,'idt',.8);
 const tv=/(?:GRAND TOTAL|TOTAL AMOUNT|TOTAL VALUE|AMOUNT DUE|TOTAL|جمع کل)\s*(?:\(?[A-Z]{3}\)?)?\s*[:\-]?\s*(USD|EUR|CNY|RMB|AED|RUB|TRY|US\$|\$|€|¥)?\s*([\d.,]{3,})/i.exec(t);if(tv){put('val',String(ocNum(tv[2])),.85);if(tv[1])put('cur',{'US$':'USD','$':'USD','€':'EUR','¥':'CNY',RMB:'CNY'}[tv[1].toUpperCase()]||tv[1].toUpperCase(),.85)}
 g(/\b(USD|EUR|CNY|RMB|AED|RUB|TRY|INR)\b/,'cur',.6);g(/\b(EXW|FCA|FAS|FOB|CFR|CIF|CPT|CIP|DAP|DPU|DDP)\b/,'inc',.85);
 g(/(?:COUNTRY OF ORIGIN|ORIGIN OF GOODS|MADE IN|کشور مبدأ)\s*[:\-]?\s*([A-Z][A-Za-z .]{2,30}|[\u0600-\u06FF ]{2,20})/i,'org',.85);g(/(?:TRUCK|PLATE|VEHICLE)\s*(?:NO\.?|NUMBER)?\s*[:\-]?\s*([A-Z0-9][A-Z0-9 \-]{3,14})/i,'plate',.7);
 if(F.dsc){const v=F.dsc.v.split(/\s+(?:HS\s*CODE|H\.S\.|\d[\d,]*\s+(?:USD|EUR|CNY|AED|US\$|\$))/i)[0].trim();if(v)F.dsc.v=v}
 if(F.cur&&F.cur.v==='RMB')F.cur.v='CNY';return F}
function ocrChk(F,type){const W=[];if(F.ctr)F.ctr.v.split(/\s+/).forEach(c=>{if(!iso6346(c).ok)W.push(['bad','رقم کنترل کانتینر نادرست: '+c])});if(F.awbn&&!awbOk2(F.awbn.v))W.push(['bad','رقم کنترل بارنامهٔ هوایی نادرست است']);if(F.hs)F.hs.v.split(/\s+/).forEach(h=>{if(h.length<8)W.push(['warn','کد HS کمتر از ۸ رقم: '+h])});const g=F.gw&&ocNum(F.gw.v),n=F.nw&&ocNum(F.nw.v);if(g&&n&&n>g)W.push(['bad','وزن خالص از ناخالص بیشتر است']);if(F.cne&&/TO ORDER/i.test(F.cne.v)&&!F.ntf)W.push(['warn','گیرنده «TO ORDER» است ولی طرف اعلام پیدا نشد']);
 const need={bl:['shp','cne','pol','pod','gw'],inv:['ino','val','cur'],pl:['gw','pkg'],awb:['awbn','gw'],cmr:['shp','cne','gw']}[type]||[];const miss=need.filter(k=>!F[k]);if(miss.length)W.push(['warn','پیدا نشد: '+miss.map(k=>OCF.find(f=>f[0]===k)[1]).join('، ')]);Object.entries(F).forEach(([k,x])=>{if(x.c<.75)W.push(['info','«'+OCF.find(f=>f[0]===k)[1]+'» با اطمینان کم خوانده شد؛ بازبینی کنید'])});return W}
const OCX={name:'',file:null,text:'',type:'oth',F:{},st:'',src:'',langs:{eng:true,fas:true}};
function ocrRun(){OCX.type=ocrClass(OCX.text);OCX.F=ocrX(OCX.text)}
function rOcr(b){subTabs(b,V16,'ocr',[['rd','خواندن سند'],['hist','تاریخچه']],(v,B)=>({rd:ocrRd,hist:ocrHist})[v](B))}
function ocrRd(B){
 const draw=()=>{const W=OCX.text?ocrChk(OCX.F,OCX.type):[];
  B.innerHTML=`<div class="v16-g2"><div class="v16-col"><div class="sx-card"><header><b>ورودی</b><small>${esc(OCX.name||'')}</small></header><label class="v16-dz"><input type="file" class="oc-f" accept=".pdf,.png,.jpg,.jpeg,.webp,.bmp,.tif,.tiff,.txt,.csv,.eml,.html,.htm,image/*,application/pdf,text/*"><b>فایل را اینجا رها کنید یا برای انتخاب کلیک کنید</b><small>PDF دارای متن بدون اینترنت و روی همین مرورگر خوانده می‌شود. تصویر و PDF اسکن‌شده با موتور OCR (فارسی و انگلیسی) پردازش می‌شوند؛ این موتور بار اول از اینترنت بارگیری می‌شود ولی فایل شما به جایی ارسال نمی‌شود.</small></label>
  <div class="v16-lgs"><span>زبان OCR:</span><label><input type="checkbox" data-lg="eng" ${OCX.langs.eng?'checked':''}> انگلیسی</label><label><input type="checkbox" data-lg="fas" ${OCX.langs.fas?'checked':''}> فارسی</label></div>
  <div class="oc-s fw-al ${/خطا/.test(OCX.st)?'bad':OCX.st?'info':''}" ${OCX.st?'':'hidden'}>${esc(OCX.st)}</div>
  <label class="sx-f fw-f w2"><span>متن خوانده‌شده (قابل ویرایش؛ می‌توانید متن را مستقیم بچسبانید)</span><textarea class="v14-ta oc-t" rows="16" dir="auto">${esc(OCX.text)}</textarea></label><div class="fw-bt"><button class="sx-btn sm pri" data-rx>استخراج فیلدها از متن</button><button class="sx-btn sm" data-cl>پاک کردن</button></div></div></div>
  <div class="v16-col"><div class="sx-card"><header><b>فیلدهای استخراج‌شده</b><span class="sx-sp"></span><label class="sx-f fw-f v16-in"><span>نوع سند</span><select class="oc-ty">${[...Object.entries(OCT).map(([k,v])=>[k,v[0]]),['oth','سایر']].map(([k,n])=>`<option value="${k}" ${k===OCX.type?'selected':''}>${n}</option>`).join('')}</select></label></header>
  ${OCX.text?`<div class="v16-of">${OCF.map(([k,l])=>{const x=OCX.F[k];return `<label class="sx-f fw-f ${['shp','cne','ntf','dsc'].includes(k)?'w2':''} ${x?'':'v16-em'}"><span>${l}${x?` <i class="v16-cf ${x.c>=.85?'hi':x.c>=.75?'md':'lo'}">${fa(Math.round(x.c*100))}٪</i>`:''}</span>${['shp','cne','ntf','dsc'].includes(k)?`<textarea data-f="${k}" rows="2" class="v14-ta" dir="auto">${esc(x?x.v:'')}</textarea>`:`<input data-f="${k}" dir="auto" value="${esc(x?x.v:'')}">`}</label>`}).join('')}</div>
  <div class="v15-ck">${W.map(w=>`<div class="fw-al ${w[0]}">${esc(w[1])}</div>`).join('')||'<div class="fw-al ok">کنترل‌های پایه بدون ایراد است.</div>'}</div>
  <div class="fw-bt"><button class="sx-btn sm pri" data-tt>انتقال به قالب اسناد پرونده</button><button class="sx-btn sm" data-td>ارسال به کنترل هم‌خوانی</button>${OCX.file?'<button class="sx-btn sm" data-ta>بایگانی فایل در پرونده</button>':''}<button class="sx-btn sm" data-th>ذخیره در تاریخچه</button></div>`:'<div class="sx-muted v14-sm">ابتدا فایل را بارگذاری یا متن را وارد کنید.</div>'}</div></div></div>`;
  const fi=$('.oc-f',B);fi.onchange=()=>{if(fi.files[0])ocrFile(fi.files[0],draw)};const dz=$('.v16-dz',B);dz.ondragover=e=>{e.preventDefault();dz.classList.add('on')};dz.ondragleave=()=>dz.classList.remove('on');dz.ondrop=e=>{e.preventDefault();dz.classList.remove('on');const f=e.dataTransfer.files[0];if(f)ocrFile(f,draw)};
  $$('[data-lg]',B).forEach(x=>x.onchange=()=>{OCX.langs[x.dataset.lg]=x.checked});
  $('[data-rx]',B).onclick=()=>{OCX.text=$('.oc-t',B).value;ocrRun();OCX.st=OCX.text?'فیلدها از متن استخراج شد · نوع: '+(OCT[OCX.type]?OCT[OCX.type][0]:'سایر'):'';draw()};
  $('[data-cl]',B).onclick=()=>{Object.assign(OCX,{name:'',file:null,text:'',type:'oth',F:{},st:'',src:''});draw()};
  $('.oc-ty',B).onchange=e=>{OCX.type=e.target.value;draw()};
  $$('[data-f]',B).forEach(x=>x.onchange=()=>{const k=x.dataset.f;if(x.value.trim())OCX.F[k]={v:x.value.trim(),c:1};else delete OCX.F[k]});
  const fv=k=>OCX.F[k]?OCX.F[k].v:'';
  const tt=$('[data-tt]',B);if(tt)tt.onclick=()=>{const {j}=v16Job();if(!j){toast('ابتدا پرونده بسازید');return}const A=LSG('ifa-tpl',{});const D=A[j.ref]=A[j.ref]||{};['shp','cne','ntf','pol','pod','vsl','voy','bln','bk','seal','ino','inc','cur','org','plate'].forEach(k=>{if(fv(k))D[k==='bk'?'bk':k]=fv(k)});if(fv('ctr'))D.ctr=fv('ctr').split(/\s+/)[0];if(fv('awbn'))D.awbn=fv('awbn');if(fv('plate'))D.plate=fv('plate');const it=(D.items&&D.items[0])?D.items:[{dsc:'',hs:'',pkg:1,pkt:'PACKAGES',nw:0,gw:0,cbm:0,qty:1,unit:'LOT',price:0}];const i0=it[0];if(fv('dsc'))i0.dsc=fv('dsc').split('\n')[0];if(fv('hs'))i0.hs=fv('hs').split(/\s+/)[0];if(fv('pkg'))i0.pkg=ocNum(fv('pkg'));if(fv('pkt'))i0.pkt=fv('pkt');if(fv('gw'))i0.gw=ocNum(fv('gw'));if(fv('nw'))i0.nw=ocNum(fv('nw'));if(fv('cbm'))i0.cbm=ocNum(fv('cbm'));if(fv('val')&&it.length===1){i0.qty=1;i0.price=ocNum(fv('val'))}D.items=it;LSS('ifa-tpl',A);toast('به قالب اسناد پروندهٔ '+j.ref+' منتقل شد');ocrSave()};
  const td=$('[data-td]',B);if(td)td.onclick=()=>{const key={bl:'bl',awb:'bl',cmr:'bl',inv:'inv',pl:'pl',co:'co'}[OCX.type]||'inv';const S=Object.assign({v:{},tol:{w:.5,v:3},tg:'inv'},LSG('ifa-doc',{}));S.v=S.v||{};const o={};['shp','cne','ntf','dsc','hs','org','pol','pod','pkg','gw','nw','cbm','ctr','seal','val','cur','inc','ino'].forEach(k=>{if(fv(k))o[k]=k==='dsc'||k==='shp'||k==='cne'||k==='ntf'?fv(k).split('\n')[0]:fv(k)});S.v[key]=Object.assign(S.v[key]||{},o);LSS('ifa-doc',S);ocrSave();toast('به ستون «'+key+'» کنترل هم‌خوانی منتقل شد');window.__STUDIO.nav.go('doc')};
  const ta=$('[data-ta]',B);if(ta)ta.onclick=async()=>{const {j}=v16Job();try{await ARC.put(j?j.ref:'—',OCX.file,'OCR:'+OCX.type,false);toast('فایل در بایگانی ذخیره شد')}catch(e){toast('خطا در بایگانی: '+e.message)}};
  const th=$('[data-th]',B);if(th)th.onclick=()=>{ocrSave();toast('در تاریخچه ذخیره شد')}};
 draw()}
function ocrSave(){const H=LSG('ifa-ocr',[]);const f={};Object.entries(OCX.F).forEach(([k,x])=>f[k]=x.v);const last=H[0];if(last&&last.name===OCX.name&&JSON.stringify(last.f)===JSON.stringify(f))return;H.unshift({id:rgId(),ts:Date.now(),name:OCX.name||'متن واردشده',type:OCX.type,src:OCX.src||'text',job:(v16Job().j||{}).ref||'',f});LSS('ifa-ocr',H.slice(0,50))}
async function ocrFile(f,draw){Object.assign(OCX,{name:f.name,file:f,st:'در حال خواندن «'+f.name+'»…',src:''});draw();const langs=Object.keys(OCX.langs).filter(k=>OCX.langs[k]).join('+')||'eng';const prog=(s,x)=>{const e=document.querySelector('.oc-s');if(e){e.hidden=false;e.textContent='OCR: '+s+(x!=null?' · '+Math.round(x*100)+'٪':'')}};
 try{let t='';if(/pdf$/i.test(f.type)||/\.pdf$/i.test(f.name)){const r=await pdfText(await f.arrayBuffer());t=r.text;OCX.src='pdf';if(t.replace(/\s/g,'').length<30){OCX.st='این PDF لایهٔ متنی ندارد (اسکن است)؛ اجرای OCR…';draw();t=await ocrScan(f,langs,prog);OCX.src='ocr'}else OCX.st='متن '+fa(r.pages)+' صفحه از لایهٔ متنی PDF خوانده شد (بدون OCR)'}
  else if(/^image\//.test(f.type)||/\.(png|jpe?g|webp|bmp|tiff?)$/i.test(f.name)){OCX.st='اجرای OCR روی تصویر…';draw();t=await ocrImg(f,langs,prog);OCX.src='ocr';OCX.st='تصویر با OCR خوانده شد؛ فیلدها را بازبینی کنید'}
  else{t=await f.text();if(/\.html?$/i.test(f.name)){const d=new DOMParser().parseFromString(t,'text/html');t=d.body?d.body.textContent:t}OCX.src='text';OCX.st='فایل متنی خوانده شد'}
  OCX.text=t;ocrRun();OCX.st+=' · نوع سند: '+(OCT[OCX.type]?OCT[OCX.type][0]:'نامشخص')}
 catch(e){OCX.st='خطا: '+e.message+(/OCR|pdf\.js/.test(e.message)?' — برای تصویر و PDF اسکن‌شده اتصال اینترنت (بار اول) لازم است؛ می‌توانید متن را دستی بچسبانید.':'')}draw()}
function ocrHist(B){const H=LSG('ifa-ocr',[]);B.innerHTML=`<div class="sx-card"><header><b>تاریخچهٔ خواندن اسناد</b><small>فقط فیلدهای استخراج‌شده نگه داشته می‌شود (حداکثر ۵۰ مورد)</small></header>${H.length?`<div class="v16-mtw"><table class="sx-tbl"><thead><tr><th>زمان</th><th>فایل</th><th>نوع</th><th>روش</th><th>پرونده</th><th>فیلدها</th><th></th></tr></thead><tbody>${H.map((h,i)=>`<tr><td>${jdt(new Date(h.ts).toISOString().slice(0,10))}</td><td>${esc(h.name)}</td><td>${OCT[h.type]?OCT[h.type][0]:'سایر'}</td><td>${({pdf:'لایهٔ متنی PDF',ocr:'OCR',text:'متن'})[h.src]||h.src}</td><td>${esc(h.job||'—')}</td><td><small>${Object.keys(h.f).length} فیلد · ${esc(Object.entries(h.f).slice(0,3).map(([k,v])=>v.split('\n')[0]).join(' · ').slice(0,90))}</small></td><td><button class="sx-btn xs" data-ld="${i}">باز کردن</button> <button class="sx-btn xs" data-dl="${i}">×</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="sx-muted v14-sm">هنوز سندی خوانده نشده است.</div>'}</div>`;
 $$('[data-ld]',B).forEach(x=>x.onclick=()=>{const h=H[+x.dataset.ld];Object.assign(OCX,{name:h.name,file:null,type:h.type,src:h.src,F:Object.fromEntries(Object.entries(h.f).map(([k,v])=>[k,{v,c:1}])),text:Object.entries(h.f).map(([k,v])=>(OCF.find(f=>f[0]===k)||[k,k])[1]+': '+v).join('\n'),st:'از تاریخچه بارگذاری شد'});V16.ocr='rd';rOcr(B.closest('.tm').parentElement)});
 $$('[data-dl]',B).forEach(x=>x.onclick=()=>{H.splice(+x.dataset.dl,1);LSS('ifa-ocr',H);ocrHist(B)})}

/* ===== v18: China logistics ecosystem directory (6,981 entities · 12 layers) ===== */
const CND_B64='