';let CTYD=null,ctyP=null;
function ctyData(){if(CTYD)return Promise.resolve(CTYD);if(ctyP)return ctyP;ctyP=(async()=>{const bin=Uint8Array.from(atob(CTY_B64),c=>c.charCodeAt(0));const st=new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'));CTYD=JSON.parse(await new Response(st).text());return CTYD})();return ctyP}
Object.assign(ISO,{KG:['Kyrgyzstan','قرقیزستان'],TJ:['Tajikistan','تاجیکستان'],BY:['Belarus','بلاروس'],PL:['Poland','لهستان'],KW:['Kuwait','کویت'],SA:['Saudi Arabia','عربستان سعودی'],JO:['Jordan','اردن'],SY:['Syria','سوریه'],LB:['Lebanon','لبنان'],IL:['Israel','اسرائیل'],YE:['Yemen','یمن'],MN:['Mongolia','مغولستان'],BD:['Bangladesh','بنگلادش'],NP:['Nepal','نپال'],MM:['Myanmar','میانمار'],LA:['Laos','لائوس'],VN:['Vietnam','ویتنام'],TH:['Thailand','تایلند'],KH:['Cambodia','کامبوج'],UA:['Ukraine','اوکراین'],MD:['Moldova','مولداوی'],RO:['Romania','رومانی'],SK:['Slovakia','اسلواکی'],CZ:['Czech Republic','چک'],SI:['Slovenia','اسلوونی'],HR:['Croatia','کرواسی'],BA:['Bosnia','بوسنی و هرزگوین'],ME:['Montenegro','مونته‌نگرو'],AL:['Albania','آلبانی'],MK:['North Macedonia','مقدونیه شمالی'],FI:['Finland','فنلاند'],NO:['Norway','نروژ'],SE:['Sweden','سوئد'],EE:['Estonia','استونی'],LV:['Latvia','لتونی'],LT:['Lithuania','لیتوانی'],DK:['Denmark','دانمارک'],FR:['France','فرانسه'],ES:['Spain','اسپانیا'],PT:['Portugal','پرتغال'],GB:['UK','بریتانیا'],CH:['Switzerland','سوئیس'],PS:['Palestine','فلسطین'],KP:['North Korea','کره شمالی'],BT:['Bhutan','بوتان'],XK:['Kosovo','کوزوو']});
const CTYS={sel:null,q:'',grp:'',sub:'sum',oppDir:''};
const flagE=c=>/^[A-Z]{2}$/.test(c||'')&&c!=='XK'?String.fromCodePoint(...[...c].map(x=>0x1F1E6+x.charCodeAt(0)-65)):'🏳️';
const ctyName=(D,c)=>(D&&D[c]&&D[c].fa)||cfa(c);
const XNET=()=>window.__IFA_GPD||{nodes:[],links:[],cal:{},VR:[]};
const numv=s=>{const m=String(s||'').replace(/,/g,'').match(/-?\d+(\.\d+)?/);return m?+m[0]:null};
const GRPFA={'Batch 1':'همسایگان و کریدورهای بلافصل','Batch 2':'آسیای مرکزی، جنوب و شرق آسیا','Batch 3':'اروپا و خاورمیانه'};
const grpFa=g=>{const k=Object.keys(GRPFA).find(k=>String(g||'').startsWith(k));return k?GRPFA[k]:(g||'سایر')};
function ctyKpis(c){const P=c.prof||[];const f=re=>P.find(r=>re.test(r[1])&&numv(r[4])!=null);
 const g=f(/^GDP \(current/),ind=f(/^Industry value added/),man=f(/^Manufacturing value/),ex=f(/^Merchandise exports/),im=f(/^Merchandise imports/),rail=f(/^Railways, goods/),lpi=f(/^Logistics performance index overall/),pop=f(/^Population/);
 const iranX=P.filter(r=>/exports to Iran/i.test(r[1])),iranM=P.filter(r=>/imports from Iran/i.test(r[1]));
 const uniq=a=>{const m={};a.filter(r=>numv(r[4])!=null&&(r[2]||r[3])).forEach(r=>{const k=r[3]||r[2];const v=numv(r[4])||0;if(!m[k]||m[k].v<v)m[k]={hs:r[3],n:r[2],v,u:r[5],y:r[6]}});return Object.values(m).sort((a,b)=>b.v-a.v)};
 return {g,ind,man,ex,im,rail,lpi,pop,toIr:uniq(iranX),fromIr:uniq(iranM),topX:uniq(P.filter(r=>/Top export HS2/i.test(r[1]))),topM:uniq(P.filter(r=>/Top import HS2/i.test(r[1]))),tf:ctyTF(c)}}
function ctyTF(c){const t=(c.tb||[]).find(t=>/Trade Flow/i.test(t.t));if(!t||!t.rows||!t.rows.length)return null;const r=t.rows.find(r=>r[0]!=='§')||t.rows[0];const o={};t.cols.forEach((h,i)=>o[h]=r[i]);return {tot:o['تجارت کل (M USD)'],x:o['صادرات به ایران'],m:o['واردات از ایران'],g:o['کالاهای اصلی'],rt:o['مسیر اصلی'],cap:o['ظرفیت بالقوه (M تن)'],cf:o['اطمینان']}}
function ctyTFBox(K,dir){const t=K.tf;const v=t&&(dir==='x'?t.x:t.m);if(!t||!v||v==='—')return '<div class="sx-empty sm">دادهٔ کالایی HS2 در منبع خالی است (Comtrade)؛ رقم کلی هم ثبت نشده</div>';const n=numv(String(v).replace(/,/g,''));
 return `<div class="ct-tf"><b>${n!=null?'$'+nf(n,0)+' M':esc(v)}</b><small>${dir==='x'?'صادرات به ایران':'واردات از ایران'} · تجارت کل $${esc(fa(t.tot||'—'))} M</small>${t.g?`<p>کالاهای اصلی: ${esc(t.g)}</p>`:''}${t.rt?`<p>مسیر اصلی: ${esc(t.rt)}</p>`:''}<em>منبع: جدول جریان تجاری ۲۹ کشور (ToT/BFS) ${esc(t.cf||'')} — دادهٔ تفکیکی HS2 در Comtrade خالی است</em></div>`}
function ctyNet(code){const C=ctx();if(!C)return null;const G=C.G;const N=G.nodes.filter(n=>n.country===code);const ids=new Set(N.map(n=>n.id));const E=G.edges.filter(e=>ids.has(e.from)||ids.has(e.to));const XB=E.filter(e=>e.crossBorder);
 const cors=G.corridors.filter(k=>k.edges.some(e=>ids.has(e.from)||ids.has(e.to)));const nb=[...new Set(XB.map(e=>{const o=ids.has(e.from)?e.to:e.from;return G.nodeById[o]&&G.nodeById[o].country}))].filter(Boolean);
 return {N,E,XB,cors,nb,bord:N.filter(n=>n.type==='border'),onRoute:!!(C.R&&C.R.countries.includes(code))}}
function rCty(b,C){b.innerHTML='<div class="sx-empty"><span class="sx-spin"></span> بارگذاری پرونده‌های کشورها…</div>';ctyData().then(D=>{if(!b.isConnected)return;ctyMain(b,C,D)}).catch(e=>{b.innerHTML='<div class="sx-empty">خطا در بارگذاری داده‌ها: '+esc(e.message)+'</div>'})}
function ctyList(D){const S=DS.strategic;const ks=new Set([...Object.keys(D),...S.map(s=>Object.keys(ISO).find(k=>ISO[k][0].toLowerCase()===s.en.toLowerCase())).filter(Boolean)]);
 return [...ks].map(k=>{const c=D[k]||{id:k,fa:cfa(k),en:(ISO[k]||[k])[0],prof:[],opp:[],rte:[],tb:[],src:[],ff:{}};const s=strat(k);const tot=s?['sanc','transit','pay','comp','stab','fta'].reduce((a,x)=>a+(s[x]||0),0):null;return {k,c,s,tot,rank:s?s.rank:999}})}
function ctyMain(b,C,D){const L=ctyList(D);const R=C.R;
 if(!CTYS.sel){const f=R&&R.countries.find(c=>c!=='IR'&&D[c]);CTYS.sel=f||'TR'}
 const grps=[...new Set(L.map(x=>grpFa(x.c.grp)))];
 b.innerHTML=`<div class="ct"><aside class="sx-card ct-side"><header><b>پرونده‌های کشور</b><small>${fa(L.length)} کشور · ${fa(Object.keys(D).length)} پروندهٔ کامل</small></header>
  <input class="ct-q" placeholder="جستجوی کشور… (فارسی/انگلیسی/ISO)" value="${esc(CTYS.q)}"><div class="sx-seg ct-g"><button data-g="" class="${!CTYS.grp?'on':''}">همه</button><button data-g="route" class="${CTYS.grp==='route'?'on':''}">روی مسیر</button><button data-g="net" class="${CTYS.grp==='net'?'on':''}">در شبکه</button>${grps.filter(g=>g!=='سایر').map(g=>`<button data-g="${esc(g)}" class="${CTYS.grp===g?'on':''}" title="${esc(g)}">${esc(g.split(/[، ]/)[0])}</button>`).join('')}</div>
  <div class="ct-l"></div></aside><section class="ct-main"></section></div>`;
 const lst=$('.ct-l',b);const G=C.G;const netC=new Set(G.nodes.map(n=>n.country));
 const drawL=()=>{const q=CTYS.q.trim().toLowerCase();const F=L.filter(x=>(!q||[x.k,x.c.fa,x.c.en,x.c.iso3].join(' ').toLowerCase().includes(q))&&(!CTYS.grp||(CTYS.grp==='route'?(R&&R.countries.includes(x.k)):CTYS.grp==='net'?netC.has(x.k):grpFa(x.c.grp)===CTYS.grp))).sort((a,b2)=>a.rank-b2.rank||String(a.c.fa).localeCompare(String(b2.c.fa),'fa'));
  lst.innerHTML=F.map((x,i)=>`<button data-k="${x.k}" class="${x.k===CTYS.sel?'on':''}" style="--d:${Math.min(i,24)*14}ms"><span class="fl">${flagE(x.k)}</span><span><b>${esc(x.c.fa||cfa(x.k))}</b><small>${esc(x.c.en||'')} ${x.s?'· رتبهٔ '+fa(x.s.rank):''}</small></span><em>${netC.has(x.k)?'<i class="nt" title="در شبکهٔ مسیریابی"></i>':''}${R&&R.countries.includes(x.k)?'<i class="rt" title="روی مسیر فعلی"></i>':''}</em><u>${x.c.opp&&x.c.opp.length?fa(x.c.opp.length):''}</u></button>`).join('')||'<div class="sx-empty">یافت نشد</div>';
  $$('button',lst).forEach(x=>x.onclick=()=>{CTYS.sel=x.dataset.k;$$('button',lst).forEach(y=>y.classList.toggle('on',y===x));ctyDetail($('.ct-main',b),C,D,L)})};
 drawL();let qt=0;$('.ct-q',b).oninput=e=>{clearTimeout(qt);qt=setTimeout(()=>{CTYS.q=e.target.value;drawL()},150)};
 $$('.ct-g button',b).forEach(x=>x.onclick=()=>{CTYS.grp=x.dataset.g;$$('.ct-g button',b).forEach(y=>y.classList.toggle('on',y===x));drawL()});
 ctyDetail($('.ct-main',b),C,D,L)}
const ctT=(cols,rows,lim=300,cls='')=>rows.length?`<div class="sx-tw ct-tw"><table class="sx-tbl ${cls}"><thead><tr>${cols.map(c=>`<th>${esc(c)}</th>`).join('')}</tr></thead><tbody>${rows.slice(0,lim).map(r=>String(r[0]).startsWith('§')?`<tr class="sec"><td colspan="${cols.length}">${esc(String(r[0]).slice(1))}</td></tr>`:`<tr>${cols.map((_,i)=>{const s=String(r[i]??'');return `<td>${/^https?:\/\//.test(s)?`<a href="${esc(s)}" target="_blank" rel="noopener">${esc(s.replace(/^https?:\/\/(www\.)?/,'').slice(0,30))}</a>`:esc(s.length>220?s.slice(0,220)+'…':s)||'<span class="na">—</span>'}</td>`}).join('')}</tr>`).join('')}</tbody></table></div>${rows.length>lim?`<p class="sx-note">${fa(lim)} از ${fa(rows.length)} ردیف</p>`:''}`:'<div class="sx-empty sm">داده‌ای ثبت نشده</div>';
const ctSec=(t,body,n,open=true)=>`<details class="ct-sec"${open?' open':''}><summary>${t}${n!=null?` <small>${fa(n)}</small>`:''}</summary>${body}</details>`;
function ctyDetail(M,C,D,L){const k=CTYS.sel;const x=L.find(z=>z.k===k)||L[0];const c=x.c,s=x.s;const K=ctyKpis(c);const net=ctyNet(k);
 const subs=[['sum','خلاصه'],['eco','اقتصاد و تولید'],['ir','تجارت با ایران'],['opp','فرصت‌های محصول'],['log','لجستیک، گذرگاه و مسیر'],['reg','گمرک و مقررات'],['src','جدول‌ها و منابع']];
 const kv=(r,d=1)=>r?nf(numv(r[4]),d):'—';
 M.innerHTML=`<div class="sx-card ct-hd"><div class="ct-fl">${flagE(k)}</div><div class="ct-ti"><h3>${esc(c.fa||cfa(k))} <small>${esc(c.en||'')} · ${esc(c.iso3||k)}</small></h3><p>${esc(grpFa(c.grp))}${net&&net.N.length?` · ${fa(net.N.length)} گره و ${fa(net.E.length)} یال در شبکهٔ مسیریابی`:' · خارج از شبکهٔ مسیریابی فعلی'}${net&&net.onRoute?' · <b class="ct-on">روی مسیر برگزیده</b>':''}</p></div>
  <div class="ex-kpis ct-k">${kpi('تولید ناخالص داخلی',numv(K.g&&K.g[4])||0,{d:1,pre:'$',suf:'B',sub:K.g?esc(K.g[6]+' · '+(K.g[7]||'')):'داده ناموجود'})}${kpi('صادرات کالا',numv(K.ex&&K.ex[4])||0,{d:1,pre:'$',suf:'B',sub:K.ex?esc(K.ex[6]):'—'})}${kpi('شاخص LPI',numv(K.lpi&&K.lpi[4])||0,{d:2,sub:K.lpi?'از ۵ · '+esc(K.lpi[6]):'—'})}${kpi('حمل ریلی',numv(K.rail&&K.rail[4])||0,{suf:' M tkm',sub:K.rail?esc(K.rail[6]):'—'})}${kpi('امتیاز راهبردی',x.tot||0,{sub:s?'رتبهٔ '+fa(s.rank)+' از '+fa(DS.strategic.length):'بدون رتبه'})}</div></div>
  <div class="sx-seg ct-sub">${subs.map(([a,n])=>`<button data-v="${a}" class="${CTYS.sub===a?'on':''}">${n}</button>`).join('')}<span class="sx-sp"></span></div><div class="ct-b"></div>`;countUp(M);
 $$('.ct-sub button',M).forEach(z=>z.onclick=()=>{CTYS.sub=z.dataset.v;$$('.ct-sub button',M).forEach(y=>y.classList.toggle('on',y===z));body()});
 const B=()=>$('.ct-b',M);
 const tbs=re=>(c.tb||[]).filter(t=>re.test(t.s+' '+t.t));
 const showT=(arr,open=false)=>arr.map(t=>ctSec(esc(t.t||t.s)+` <em class="ct-s">${esc(t.s)}</em>`,ctT(t.cols,t.rows),t.rows.length,open)).join('');
 const bars=(arr,lab)=>{const mx=Math.max(1,...arr.map(a=>a.v));return arr.length?`<ul class="ct-bars">${arr.slice(0,10).map(a=>`<li><span>${esc(a.n||'—')}${a.hs?` <small>HS ${esc(a.hs)}</small>`:''}</span><i><u style="width:${a.v/mx*100}%"></u></i><b>${nf(a.v,1)} <small>${esc(a.u||'')}</small></b></li>`).join('')}</ul>`:`<div class="sx-empty sm">${lab}</div>`};
 function body(){const b0=B();const v=CTYS.sub;
  if(v==='sum'){const sum=ctySummary(k,c,s,K,net);
   b0.innerHTML=`<div class="ct-g2"><div class="sx-card"><header><b>خلاصهٔ پرونده</b><small>تولید خودکار از داده‌های بارگذاری‌شده</small><span class="sx-sp"></span><button class="sx-btn sm ct-cp">کپی</button></header><p class="ct-sum">${sum}</p>
     <div class="ct-chips">${(net?net.cors:[]).map(q=>`<span class="sx-chip">${esc(q.nameFa)}</span>`).join('')}${net&&net.nb.length?`<span class="sx-chip">همسایه در شبکه: ${net.nb.map(z=>esc(cfa(z))).join('، ')}</span>`:''}</div></div>
    <div class="sx-card ct-rd"><header><b>امتیاز راهبردی برای تجارت با ایران</b><small>Strategic Analysis · ۱ تا ۱۰</small></header>${s?ctyRadar(s)+`<ul class="op-adj">${[['sanc','ریسک تحریم'],['transit','ترانزیت'],['pay','پرداخت'],['comp','مکمل‌بودن'],['stab','ثبات'],['fta','پوشش FTA']].map(([a,n])=>`<li><span>${n}</span><b>${fa(s[a]||0)}</b></li>`).join('')}<li><span>حجم تجارت · رشد</span><b>$${nf(s.trade||0,1)}B · ${nf(s.growth||0)}٪</b></li></ul>`:'<div class="sx-empty sm">این کشور در ماتریس راهبردی رتبه ندارد.</div>'}</div></div>
    <div class="ct-g3"><div class="sx-card"><header><b>صادرات به ایران</b><small>HS2 · USD million</small></header>${(K.toIr.length?bars(K.toIr):ctyTFBox(K,'x'))}</div><div class="sx-card"><header><b>واردات از ایران</b><small>HS2 · USD million</small></header>${(K.fromIr.length?bars(K.fromIr):ctyTFBox(K,'m'))}</div>
    <div class="sx-card"><header><b>برترین فرصت‌های محصول</b><small>امتیاز ۰ تا ۱۰۰</small></header>${(c.opp||[]).length?`<ul class="ct-op">${oppS(c.opp).slice(0,6).map(o=>`<li><i style="--v:${o[0]/100}">${fa(Math.round(o[0]))}</i><span>${esc(oppN(o))}${o[3]?` <small>HS ${esc(o[3])}</small>`:''}<small>${esc(o[4]||'')} · ${esc(o[1]||'')}</small></span></li>`).join('')}</ul>`:'<div class="sx-empty sm">داده ناموجود</div>'}</div></div>`;
   $('.ct-cp',b0).onclick=()=>{navigator.clipboard&&navigator.clipboard.writeText($('.ct-sum',b0).textContent);toast('خلاصه کپی شد')};return}
  if(v==='eco'){const P=c.prof||[];const sec=[...new Set(P.map(r=>r[0]))];
   b0.innerHTML=sec.map(sn=>{const rr=P.filter(r=>r[0]===sn);return ctSec(esc(sn),ctT(['شاخص / ردیف','کالا','HS','مقدار','واحد','سال','روند ۱۰ساله','ارتباط با ایران','منبع'],rr.map(r=>[r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[8],r[11]])),rr.length,/sectors|capacity|exported/i.test(sn))}).join('')+showT(tbs(/تامین|اقتصادی|PRODUCTION|ECONOMY|MINING|ENERGY|AGRIC/i))||'<div class="sx-empty">داده‌ای نیست</div>';return}
  if(v==='ir'){const P=(c.prof||[]).filter(r=>/Iran/i.test(r[1])||/Trade with Iran/i.test(r[0]));const pt=(c.tb||[]).filter(t=>/Iran_Trade_Partners/.test(t.s));
   const ir=pt.map(t=>({...t,rows:t.rows.filter(r=>/iran|ایران|bilateral|دوجانبه|payment|پرداخت/i.test(r.join(' ')))})).filter(t=>t.rows.length);
   b0.innerHTML=`<div class="ct-g2"><div class="sx-card"><header><b>صادرات ${esc(c.fa)} به ایران</b></header>${(K.toIr.length?bars(K.toIr):ctyTFBox(K,'x'))}</div><div class="sx-card"><header><b>واردات ${esc(c.fa)} از ایران</b></header>${(K.fromIr.length?bars(K.fromIr):ctyTFBox(K,'m'))}</div></div>`+
    ctSec('ردیف‌های تجارت با ایران (Comtrade/WDI)',ctT(['ردیف','کالا','HS','مقدار','واحد','سال','جهت/ارتباط','منبع'],P.map(r=>[r[1],r[2],r[3],r[4],r[5],r[6],r[8],r[11]])),P.length)+showT(ir,true)+showT(tbs(/مقایسهٔ بین‌کشوری/),true);return}
  if(v==='opp'){const O=oppS(c.opp).filter(o=>!CTYS.oppDir||String(o[4]).includes(CTYS.oppDir));const dirs=[...new Set((c.opp||[]).map(o=>o[4]).filter(Boolean))];
   b0.innerHTML=`<div class="sx-card"><header><b>شاخص فرصت محصول</b><small>Phase 2 · Product_Opportunity_Index</small><span class="sx-sp"></span><div class="sx-seg ct-od"><button data-d="" class="${!CTYS.oppDir?'on':''}">همه</button>${dirs.slice(0,5).map(d=>`<button data-d="${esc(d)}" class="${CTYS.oppDir===d?'on':''}">${esc(d.slice(0,24))}</button>`).join('')}</div><button class="sx-btn sm ct-ocsv">CSV</button></header>
    ${O.length?`<div class="sx-tw ct-tw"><table class="sx-tbl ct-ot"><thead><tr><th>امتیاز</th><th>کالا</th><th>HS</th><th>جهت</th><th>مقدار</th><th>سال</th><th>تجارت با ایران</th><th>تعرفه</th><th>موانع غیرتعرفه‌ای</th><th>تحریم/بانک/لجستیک</th><th>رده</th></tr></thead><tbody>${O.map(o=>`<tr><td><span class="ct-sc" style="--v:${o[0]/100}">${fa(Math.round(o[0]))}</span></td><td>${esc(oppN(o))}</td><td>${esc(o[3])}</td><td>${esc(o[4])}</td><td>${esc(o[5])} ${esc(o[6])}</td><td>${esc(o[7])}</td><td>${esc(o[8])}</td><td>${esc(o[9]||o[10])}</td><td>${esc(String(o[11]).slice(0,120))}</td><td>${esc(String(o[12]).slice(0,120))}</td><td>${esc(o[1])}</td></tr>`).join('')}</tbody></table></div>`:'<div class="sx-empty sm">برای این کشور فرصتی ثبت نشده</div>'}<p class="sx-note">امتیازها غربالگری تحلیلی‌اند (نه توصیهٔ تجاری)؛ تعرفه و مقررات را پیش از اقدام با WITS/گمرک مقصد تطبیق دهید.</p></div>`;
   $$('.ct-od button',b0).forEach(z=>z.onclick=()=>{CTYS.oppDir=z.dataset.d;body()});$('.ct-ocsv',b0).onclick=()=>dlFile('opportunities-'+k+'.csv',[['score','class','product','hs','direction','value','unit','year','trade_iran','tariff','ntb','sanctions']].concat(O.map(o=>o.slice(0,12).map((v,i)=>i===10?o[9]:v))).map(r=>r.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\n'));return}
  if(v==='log'){const X=DS.crossings.filter(z=>[z.sheet,z.a,z.b].some(t=>String(t||'').toLowerCase().startsWith(String((ISO[k]||[c.en])[0]).toLowerCase())||String(t||'').toLowerCase().startsWith(String(c.en||'').toLowerCase())));
   const P=XNET();const cal=Object.entries(P.cal||{}).filter(([id])=>id.startsWith(k+'_'));const nn=(P.nodes||[]).filter(n=>n.country===k);
   b0.innerHTML=`${net&&net.N.length?`<div class="sx-card"><header><b>گره‌های این کشور در شبکهٔ مسیریابی</b><small>${fa(net.N.length)} گره · ${fa(net.XB.length)} یال مرزی</small></header><div class="ct-nodes">${net.N.map(n=>{const cl=P.cal&&P.cal[n.id];return `<div class="ct-n ${n.v9?'new':''}"><b>${esc(n.nameFa)} <small>${esc(n.nameEn)}</small></b><small>${esc(({seaport:'بندر',hub:'هاب',city:'شهر',border:'مرز',rail:'ریلی',caspian:'بندر خزر',airport:'فرودگاه'})[n.type]||n.type)} · توقف ${fa(n.avgDwellHours)} ساعت${cl?` <em>(قبلاً ${fa(cl.old)})</em>`:''} · هزینهٔ عملیات $${fa(n.handlingCostUSD)}</small>${n.xinfo?ctyXi(n.xinfo):''}${n.v9?'<i>جدید v9</i>':''}</div>`}).join('')}</div></div>`:''}
    ${ctSec('گذرگاه‌های مرزی (پایگاه گذرگاه‌های ۶۳ کشور)',ctT(['گذرگاه','نام محلی','نوع','کشور مقابل','کامیون/روز','واگن/روز','ساعات کار (تابستان)','زمستان','ترخیص (ساعت)','محور/وزن','خدمات','وضعیت'],X.map(z=>[z.n,z.l,z.t,(String(z.a).toLowerCase().startsWith(String(c.en).toLowerCase())||z.sheet===c.en)?z.b:z.a,z.truck,z.rail,z.hs,z.hw,z.clr,[z.axle,z.gvw].filter(Boolean).join(' / '),z.svc,z.st])),X.length)}
    ${ctSec('سناریوهای مسیر زمینی/ریلی',ctT(['مقصد/کشور مقابل','کشورهای عبوری','شیوه','هاب/گذرگاه','نقطهٔ مقابل','هزینه','زمان','ظرفیت','گلوگاه‌ها','مزیت','اطمینان'],c.rte||[]),(c.rte||[]).length)}
    ${showT(tbs(/گذرگاه‌ها|ظرفیت حمل|TRANSIT|INFRA|LOGISTICS|ROUTES|CN_/i))}`;return}
  if(v==='reg'){const f=c.ff||{};const tr=(c.prof||[]).filter(r=>/Tariff/i.test(r[0]+r[1]));
   b0.innerHTML=showT(tbs(/CUSTOMS|گمرک|PAYMENT|TRANSIT LAWS|REGULATION|تعرفه/i),true)+ctSec('یادداشت‌های تعرفه و محدودیت',ctT(['ردیف','مقدار/یادداشت','منبع'],tr.map(r=>[r[1],r[4]||r[9],r[11]])),tr.length)+
    ctSec('مقررات بین‌المللی مرتبط (Freight Forwarding Operating Model)',ctT(['کد','مقررات','حوزه','قلمرو','الزام','وضعیت','منبع'],f.reg||[]),(f.reg||[]).length)+ctSec('رویه‌های گمرکی مرتبط',ctT(['کد','قلمرو','رویه','الزام','مرجع','زمان‌بندی','تضمین'],f.cus||[]),(f.cus||[]).length,false)+
    ((f.nodes||[]).length?ctSec('گره‌های لجستیکی جهانی در این کشور',ctT(['گره','نوع','شهر','ظرفیت/توان','کارکرد','محدودیت','تأیید','منبع'],f.nodes),f.nodes.length):'')+((f.ent||[]).length?ctSec('شرکت‌های فورواردر/لجستیک با دفتر مرکزی در این کشور',ctT(['شرکت','نوع','شهر','خدمات','مدل شبکه','وب‌سایت'],f.ent),f.ent.length,false):'')+((f.car||[]).length?ctSec('حمل‌کنندگان اصلی',ctT(['حمل‌کننده','شیوه','اتحاد','ناوگان','خطوط'],f.car),f.car.length,false):'');return}
