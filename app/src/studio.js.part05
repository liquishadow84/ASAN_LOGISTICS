 body()}
function ctyXi(x){const a=[];if(x.truck)a.push(fa(x.truck)+' کامیون/روز');if(x.rail)a.push(fa(x.rail)+' واگن/روز');if(x.clr)a.push('ترخیص '+fa(x.clr)+' ساعت');if(x.hs)a.push('ساعات: '+x.hs);if(x.axle)a.push('محور '+fa(x.axle)+'t');if(x.cold&&!/^N/.test(x.cold))a.push('سردخانه: '+x.cold);return `<p class="ct-xi" title="${esc(x.n||'')} · ${esc(x.sheet||'')}">${esc(x.n||'')} — ${esc(a.join(' · ').slice(0,260))}</p>`}
function ctyRadar(s){const ax=[['sanc','تحریم'],['transit','ترانزیت'],['pay','پرداخت'],['comp','مکمل'],['stab','ثبات'],['fta','FTA']];const S=180,c=S/2,r=S/2-24;const P=(i,v)=>{const a=-Math.PI/2+i/ax.length*Math.PI*2;return [c+Math.cos(a)*r*v,c+Math.sin(a)*r*v]};
 return `<svg class="in-rad" viewBox="0 0 ${S} ${S}" width="${S}" height="${S}">${[.33,.66,1].map(k=>`<polygon points="${ax.map((_,i)=>P(i,k).join(',')).join(' ')}"/>`).join('')}${ax.map((a,i)=>`<line x1="${c}" y1="${c}" x2="${P(i,1)[0]}" y2="${P(i,1)[1]}"/><text x="${P(i,1.2)[0]}" y="${P(i,1.2)[1]+3}" text-anchor="middle">${a[1]}</text>`).join('')}<polygon class="v" points="${ax.map((a,i)=>P(i,(s[a]||0)/10).join(',')).join(' ')}"/></svg>`}
const OPPFA={'Reporter imports from Iran by HS2':'واردات از ایران (HS2)','Reporter exports to Iran by HS2':'صادرات به ایران (HS2)','Top export HS2 chapter to world':'سرفصل اصلی صادرات به جهان (HS2)','Top import HS2 chapter from world':'سرفصل اصلی واردات از جهان (HS2)'};
const oppN=o=>OPPFA[o[2]]?OPPFA[o[2]]+(o[5]===''||o[5]==null?' — بدون کالای مشخص':''):(o[2]||'—');
const oppS=a=>(a||[]).slice().sort((x,y)=>((y[5]!==''&&y[5]!=null)-(x[5]!==''&&x[5]!=null))||y[0]-x[0]);
function ctySummary(k,c,s,K,net){const n=c.fa||cfa(k);const p=[];
 if(K.g)p.push(`تولید ناخالص داخلی ${n} حدود $${nf(numv(K.g[4]),1)} میلیارد (${fa(K.g[6])}) است${K.g[7]?` و روند ده‌ساله ${fa(K.g[7].replace('→','–'))} بوده`:''}.`);
 if(K.ex)p.push(`صادرات کالایی آن $${nf(numv(K.ex[4]),1)} میلیارد است${K.lpi?` و شاخص عملکرد لجستیک (LPI) ${nf(numv(K.lpi[4]),2)} از ۵ دارد`:''}.`);
 if(K.toIr.length)p.push(`مهم‌ترین اقلام صادراتی به ایران: ${K.toIr.slice(0,3).map(a=>a.n).join('، ')}.`);
 if(K.fromIr.length)p.push(`عمده واردات از ایران: ${K.fromIr.slice(0,3).map(a=>a.n).join('، ')}.`);
 if(!K.toIr.length&&K.tf&&K.tf.x&&K.tf.x!=='—')p.push(`طبق جدول جریان تجاری، صادرات به ایران حدود ${fa(K.tf.x)} و واردات از ایران ${fa(K.tf.m||'—')} میلیون دلار است${K.tf.g?` (کالاهای اصلی: ${K.tf.g})`:''}.`);
 if(s)p.push(`در ماتریس راهبردی رتبهٔ ${fa(s.rank)} را با حجم تجارت $${nf(s.trade||0,1)}B دارد؛ امتیاز تحریم ${fa(s.sanc)}، ترانزیت ${fa(s.transit)} و پرداخت ${fa(s.pay)} از ۱۰.`);
 {const o=oppS(c.opp).find(o=>o[5]!==''&&o[5]!=null&&!OPPFA[o[2]]);if(o)p.push(`بالاترین فرصت محصول: ${o[2]}${o[3]?' (HS '+o[3]+')':''} با امتیاز ${fa(Math.round(o[0]))}.`)}
 if(net&&net.N.length)p.push(`در شبکهٔ مسیریابی ${fa(net.N.length)} گره${net.bord.length?` (${fa(net.bord.length)} گذرگاه مرزی)`:''} دارد و از ${fa(net.cors.length)} کریدور استفاده می‌شود${net.nb.length?`؛ اتصال زمینی به ${net.nb.map(cfa).join('، ')}`:''}.`);else p.push('این کشور هنوز در شبکهٔ مسیریابی گره ندارد؛ داده‌های آن برای غربالگری بازار و ترانزیت استفاده می‌شود.');
 if(c.rte&&c.rte.length)p.push(`${fa(c.rte.length)} سناریوی مسیر زمینی/ریلی و ${fa(DS.crossings.filter(z=>z.sheet===c.en).length)} گذرگاه مرزی ثبت شده است.`);
 if(c.gap)p.push(`${fa(c.gap)} مقدار نیازمند بررسی محلی است.`);return esc(p.join(' '))}
/* ---- network upgrade view (used in intel) ---- */
function netUpg(B,C){const P=XNET();const G=C.G;const nn=P.nodes||[];const cal=Object.entries(P.cal||{});const nl=(P.links||[]).length;
 const e9=G.edges.filter(e=>nn.some(n=>n.id===e.from||n.id===e.to));const vr=(P.VR||[]).map(v=>G.corridors.find(k=>k.id===v.id)).filter(Boolean);
 B.innerHTML=`<div class="ex-kpis">${kpi('گره جدید',nn.length,{sub:[...new Set(nn.map(n=>n.country))].map(cfa).join('، ')})}${kpi('یال جدید',e9.length,{sub:'جاده‌ای و ریلی'})}${kpi('کریدور جدید',vr.length,{sub:'+ گسترش ۳ کریدور موجود'})}${kpi('گذرگاه کالیبره‌شده',cal.length,{sub:'زمان توقف از دادهٔ ترخیص'})}${kpi('کل شبکه',G.nodes.length,{suf:' گره',sub:fa(G.edges.length)+' یال'})}</div>
  <div class="ct-g2"><div class="sx-card"><header><b>کریدورهای افزوده</b><small>بر پایهٔ پایگاه گذرگاه‌ها، ToT/BFS و RTE-003</small></header>${vr.map(v=>`<div class="ct-cor"><b>${esc(v.nameFa)}</b><small>${esc(v.desc)}</small><p>${fa(v.edges.length)} یال · ${fa(v.days[0])}–${fa(v.days[1])} روز · ریسک ${fa(v.risk)}/۵</p><div>${(v.pros||[]).map(p=>`<span class="sx-chip ct-pro">${esc(p)}</span>`).join('')}${(v.cons||[]).map(p=>`<span class="sx-chip ct-con">${esc(p)}</span>`).join('')}</div></div>`).join('')}</div>
  <div class="sx-card"><header><b>گره‌های جدید</b></header><div class="ct-nodes">${nn.map(n=>`<div class="ct-n new"><b>${flagE(n.country)} ${esc(n.nameFa)} <small>${esc(n.nameEn)}</small></b><small>${esc(n.notes||'')} · توقف ${fa(n.avgDwellHours)} ساعت</small>${n.xinfo?ctyXi(n.xinfo):''}</div>`).join('')}</div></div></div>
  ${ctSec('یال‌های جدید و پارامترها',ctT(['از','به','شیوه','فاصله (km)','تواتر','قابلیت اطمینان','زمان اضافهٔ مرز (ساعت)','یادداشت'],e9.map(e=>[nname(e.from),nname(e.to),e.mode,fa(e.distanceKm),e.frequency,nf(e.reliability*100)+'٪',fa(e.extraHours||0),e.note])),e9.length)}
  ${ctSec('کالیبراسیون گره‌های مرزی موجود با دادهٔ ترخیص گذرگاه‌ها',ctT(['گره','زمان توقف قبلی','زمان توقف جدید','گذرگاه منطبق','ترخیص (ساعت)','کامیون/روز','ساعات کار'],cal.map(([id,v])=>[nname(id),fa(v.old),fa(v.avgDwellHours),v.xinfo.n,v.xinfo.clr!=null?fa(v.xinfo.clr):'—',v.xinfo.truck!=null?fa(v.xinfo.truck):'—',v.xinfo.hs||'—'])),cal.length)}
  <p class="sx-note">زمان توقف جدید = ۷۰٪ مقدار قبلی (شامل صف) + ۳۰٪ میانگین ترخیص ثبت‌شده. قابلیت اطمینان یال‌های مرزی بر اساس ساعات کار، فصلی بودن و وضعیت گذرگاه تنظیم شده است.</p>`;countUp(B)}

/* ===== v11: shared data (operating model, China–Iran corridor, sourcing) ===== */
const X11_B64='';let X11=null,x11P=null;
function x11(){if(X11)return Promise.resolve(X11);if(x11P)return x11P;x11P=(async()=>{const bin=Uint8Array.from(atob(X11_B64),c=>c.charCodeAt(0));const st=new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'));X11=JSON.parse(await new Response(st).text());omIndex();return X11})();return x11P}
function x11Wrap(b,fn){b.innerHTML='<div class="sx-empty"><span class="sx-spin"></span> بارگذاری داده…</div>';x11().then(()=>{if(b.isConnected)fn()}).catch(e=>{b.innerHTML='<div class="sx-empty">خطا در بارگذاری داده: '+esc(e.message)+'</div>'})}
const subNav=(subs,cur,cls='')=>`<div class="sx-seg ct-sub x-sub ${cls}">${subs.map(([a,n])=>`<button data-v="${a}" class="${cur===a?'on':''}">${n}</button>`).join('')}</div>`;
const nkey=s=>String(s||'').toLowerCase().replace(/\u200c/g,'').replace(/ي/g,'ی').replace(/ك/g,'ک').replace(/\s+/g,' ').trim();
const toCSV=(cols,rows)=>[cols,...rows].map(r=>r.map(x=>'"'+String(x??'').replace(/"/g,'""')+'"').join(',')).join('\n');
