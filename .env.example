# Copy to .env and adjust. Never commit the real .env file.
IFA_BIND=8080
# Initial admin password (only used when the database is empty). Leave empty to generate a random one.
IFA_ADMIN_PASS=
# Public HTTPS address used in customer-portal links
IFA_PUBLIC_URL=https://atlas.example.ir
# Set to 1 only when the server runs behind a reverse proxy (Caddy/nginx) that sets X-Forwarded-For
IFA_TRUST_PROXY=0
DOMAIN=atlas.example.ir
# Market data collectors (1 = on, 0 = off) and optional free EIA key
IFA_MARKET=1
IFA_EIA_KEY=
# Notification channels (optional)
IFA_BALE_TOKEN=
IFA_TELEGRAM_TOKEN=
IFA_KAVENEGAR_KEY=
IFA_KAVENEGAR_SENDER=
IFA_WEBHOOK_URL=
IFA_WEBHOOK_SECRET=
# DCSA Track & Trace v2 (optional)
IFA_DCSA_URL=
IFA_DCSA_KEY=
